{
  "id": "octopus.kubernetesdeploysecret",
  "title": "Deploy Kubernetes Secret",
  "description": "Create or update a Kubernetes Secret.",
  "version": "1.0.0",
  "groups": [
    {
      "id": "cluster",
      "title": "Cluster Connection",
