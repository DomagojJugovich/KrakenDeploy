<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <KrakenStepPackageId>kraken.script</KrakenStepPackageId>
    <KrakenStepPackageVersion>1.1.0</KrakenStepPackageVersion>
    <KrakenStepPackageDisplayName>Run a Script</KrakenStepPackageDisplayName>
    <KrakenStepPackageExecutorTypeName>KrakenDeploy.Steps.Script.ScriptStepHandler</KrakenStepPackageExecutorTypeName>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- SC1: claimed step types + per-type picker metadata → manifest stepTypes
       objects. Both Kraken-native and Octopus-imported scripts share this
       package. -->
  <ItemGroup>
    <KrakenStepType Include="Kraken.Script" DisplayName="Run a Script" Category="script" Description="Inline PowerShell, Bash, C#, F#, or Python script." Featured="true" />
    <KrakenStepType Include="Octopus.Script" DisplayName="Run a Script (Octopus)" Category="script" Description="Octopus.Script-compatible inline script step." />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
    <!-- ScriptRunner lives in Steps.Common (shared with KrakenIis + WindowsService). -->
    <ProjectReference Include="..\KrakenDeploy.Steps.Common\KrakenDeploy.Steps.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakenDeploy.Steps.Script.Tests" />
  </ItemGroup>

  <Import Project="..\KrakenStepPackage.targets" />

</Project>
