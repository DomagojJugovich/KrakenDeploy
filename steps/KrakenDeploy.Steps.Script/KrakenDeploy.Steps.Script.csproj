<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <KrakenStepPackageId>kraken.script</KrakenStepPackageId>
    <KrakenStepPackageVersion>1.0.0</KrakenStepPackageVersion>
    <KrakenStepPackageDisplayName>Run a Script</KrakenStepPackageDisplayName>
    <!-- Both Kraken-native and Octopus-imported scripts share this package;
         the targets file expands the comma into a JSON array in manifest.json. -->
    <KrakenStepPackageStepTypes>Kraken.Script,Octopus.Script</KrakenStepPackageStepTypes>
    <KrakenStepPackageExecutorTypeName>KrakenDeploy.Steps.Script.ScriptStepHandler</KrakenStepPackageExecutorTypeName>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakenDeploy.Steps.Script.Tests" />
  </ItemGroup>

  <Import Project="..\KrakenStepPackage.targets" />

</Project>
