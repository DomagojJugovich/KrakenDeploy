<Project>

  <!--
    Shared pack target for Kraken step packages (Phase D-8).

    Convention: each KrakenDeploy.Steps.* project sets the metadata properties
    (KrakenStepPackageId, KrakenStepPackageVersion, etc.) in its .csproj and
    imports this targets file. On `dotnet build` the project produces both its
    regular bin output AND a `{id}-{version}.kdeploy-step` archive in the
    output directory, ready to be consumed by:
      - the server's StepPackageSeeder (built-ins seeded on first run)
      - the StepPackageService's manual-upload path (D-3)
      - the agent's loader after download (D-5)

    The pack target lays out:
        manifest.json     ← JSON-serialised StepPackageManifest
        executor/         ← project DLL + non-framework runtime deps
        ui/ui-schema.json ← optional, when ui-schema.json is present in the project
  -->

  <PropertyGroup>
    <KrakenStepPackageArchiveName>$(KrakenStepPackageId)-$(KrakenStepPackageVersion).kdeploy-step</KrakenStepPackageArchiveName>

    <!-- Class libraries don't copy NuGet runtime DLLs to $(OutputPath) by
         default. The pack target below globs that directory for *.dll, so
         without this every step package's archive would carry only the
         project's own DLL — the agent's AssemblyDependencyResolver would
         then fail to resolve any third-party NuGet runtime dep at
         HandleAsync time. Early step packages happened to work because
         their deps (Octostache, gRPC) are also in the agent host and the
         D-4 ALC delegation fell back there, but that's a leak in the
         contract — anything the agent doesn't host (AWSSDK.S3,
         AWSSDK.CloudFront, ...) would break. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="PackKrakenStepPackage"
          AfterTargets="Build">

    <!-- Properties depending on OutputPath / IntermediateOutputPath are
         evaluated INSIDE the target body — at parse-time those are empty
         on the .csproj first load. -->
    <PropertyGroup>
      <KrakenStepPackageArchivePath>$(OutputPath)$(KrakenStepPackageArchiveName)</KrakenStepPackageArchivePath>
      <KrakenStepPackageStagingDir>$(IntermediateOutputPath)kraken-step-package\</KrakenStepPackageStagingDir>
    </PropertyGroup>

    <!-- Clean staging dir for a deterministic layout. -->
    <RemoveDir Directories="$(KrakenStepPackageStagingDir)" />
    <MakeDir Directories="$(KrakenStepPackageStagingDir);$(KrakenStepPackageStagingDir)executor\;$(KrakenStepPackageStagingDir)ui\" />

    <!-- Stage executor/ — the project DLL plus any non-host runtime DLLs
         that landed in $(OutputPath). The agent's StepPackageAssemblyLoadContext
         delegates anything matching the Default ALC's loaded assemblies back
         to the default ALC (Phase D-4), so DLLs the agent already hosts are
         excluded here to keep archives lean.

         The excluded set is deterministic — everything Contracts pulls in
         transitively shows up in $(OutputPath) and is guaranteed to be in
         the agent's host process (since the agent IS the consumer of the
         gRPC + protobuf wire transport). Bundling these would just add
         ~1 MB of dead weight per package; the agent's copies win on type
         identity either way.

         Microsoft.Extensions.Logging.Abstractions is the one non-Contracts
         transitive that's reliably in the agent host (via Serilog + the
         generic Host abstractions); excluded for the same reason. -->
    <ItemGroup>
      <_KrakenExecutorDlls Include="$(OutputPath)*.dll"
                           Exclude="$(OutputPath)KrakenDeploy.Contracts.dll;
                                    $(OutputPath)Google.Protobuf.dll;
                                    $(OutputPath)Grpc.*.dll;
                                    $(OutputPath)Microsoft.Extensions.Logging.Abstractions.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_KrakenExecutorDlls)"
          DestinationFolder="$(KrakenStepPackageStagingDir)executor\" />

    <!-- Project-supplied UI schema, if present. -->
    <ItemGroup>
      <_KrakenStepUiSchema Include="$(MSBuildProjectDirectory)\ui-schema.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_KrakenStepUiSchema)"
          DestinationFolder="$(KrakenStepPackageStagingDir)ui\"
          Condition="Exists('$(MSBuildProjectDirectory)\ui-schema.json')" />

    <!-- manifest.json. We synthesise it here from the .csproj properties so
         every package gets a canonical shape — same JSON the server's
         StepPackageService verifies on upload and the agent's loader reads. -->
    <ItemGroup>
      <_KrakenManifestLines Include="{" />
      <_KrakenManifestLines Include="  &quot;id&quot;: &quot;$(KrakenStepPackageId)&quot;," />
      <_KrakenManifestLines Include="  &quot;version&quot;: &quot;$(KrakenStepPackageVersion)&quot;," />
      <_KrakenManifestLines Include="  &quot;displayName&quot;: &quot;$(KrakenStepPackageDisplayName)&quot;," />
      <_KrakenManifestLines Include="  &quot;targetFramework&quot;: &quot;$(TargetFramework)&quot;," />
      <_KrakenManifestLines Include="  &quot;stepTypes&quot;: [ &quot;$(KrakenStepPackageStepTypes.Replace(`,`, `&quot;, &quot;`))&quot; ]," />
      <_KrakenManifestLines Include="  &quot;executorAssembly&quot;: &quot;$(TargetFileName)&quot;," />
      <_KrakenManifestLines Include="  &quot;executorTypeName&quot;: &quot;$(KrakenStepPackageExecutorTypeName)&quot;," />
      <_KrakenManifestLines Include="  &quot;signedBy&quot;: &quot;kraken-project&quot;," />
      <_KrakenManifestLines Include="  &quot;signature&quot;: &quot;unsigned-dev-build&quot;" />
      <_KrakenManifestLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(KrakenStepPackageStagingDir)manifest.json"
                      Lines="@(_KrakenManifestLines)"
                      Overwrite="true"
                      Encoding="UTF-8" />

    <!-- Zip the staged tree into {id}-{version}.kdeploy-step. -->
    <ZipDirectory SourceDirectory="$(KrakenStepPackageStagingDir)"
                  DestinationFile="$(KrakenStepPackageArchivePath)"
                  Overwrite="true" />

    <Message Importance="high"
             Text="Kraken step package built: $(KrakenStepPackageArchivePath)" />
  </Target>

</Project>
