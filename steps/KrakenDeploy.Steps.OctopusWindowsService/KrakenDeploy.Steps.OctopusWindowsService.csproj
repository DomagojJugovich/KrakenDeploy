<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <KrakenStepPackageId>octopus.windowsservice</KrakenStepPackageId>
    <KrakenStepPackageVersion>1.1.0</KrakenStepPackageVersion>
    <KrakenStepPackageDisplayName>Deploy a Windows Service</KrakenStepPackageDisplayName>
    <KrakenStepPackageExecutorTypeName>KrakenDeploy.Steps.OctopusWindowsService.OctopusWindowsServiceStepHandler</KrakenStepPackageExecutorTypeName>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- SC1: claimed step types + per-type picker metadata → manifest stepTypes objects. -->
  <ItemGroup>
    <KrakenStepType Include="Octopus.WindowsService" DisplayName="Deploy a Windows Service" Category="windows-service" Description="Install or update a Windows service from the deployed package." />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Octostache" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Steps.Common\KrakenDeploy.Steps.Common.csproj" />
  </ItemGroup>

  <Import Project="..\KrakenStepPackage.targets" />

</Project>
