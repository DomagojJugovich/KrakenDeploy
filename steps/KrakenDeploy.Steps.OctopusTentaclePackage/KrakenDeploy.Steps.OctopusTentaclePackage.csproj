<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <KrakenStepPackageId>octopus.tentaclepackage</KrakenStepPackageId>
    <KrakenStepPackageVersion>1.0.1</KrakenStepPackageVersion>
    <KrakenStepPackageDisplayName>Deploy a Package</KrakenStepPackageDisplayName>
    <!-- 1.0.1 (SC0): the 1.0.0 row on existing installs was seeded from a
         manifest that predates the Kraken.DeployPackage alias (and the
         seeder skips an already-installed (name, version)), so the claim
         fix has to arrive as a new version. -->
    <KrakenStepPackageStepTypes>Octopus.TentaclePackage,Kraken.DeployPackage</KrakenStepPackageStepTypes>
    <KrakenStepPackageExecutorTypeName>KrakenDeploy.Steps.OctopusTentaclePackage.OctopusTentaclePackageStepHandler</KrakenStepPackageExecutorTypeName>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Web.Xdt drives Octopus.Features.ConfigurationTransforms.
         Octostache resolves #{Var} placeholders inside config strings (e.g.
         CustomInstallationDirectory). -->
    <PackageReference Include="Microsoft.Web.Xdt" />
    <PackageReference Include="Octostache" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes the path-safety classifier + managed-dir marker name to the
         test project (pure, side-effect-free unit tests for the purge guard). -->
    <InternalsVisibleTo Include="KrakenDeploy.Steps.OctopusTentaclePackage.Tests" />
  </ItemGroup>

  <Import Project="..\KrakenStepPackage.targets" />

</Project>
