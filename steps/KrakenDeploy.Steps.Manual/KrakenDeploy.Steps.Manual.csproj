<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Step-package metadata. Pack target below reads these values. -->
    <KrakenStepPackageId>octopus.manual</KrakenStepPackageId>
    <!-- 1.2.0 (SC4): declares executionLocus=server so the registry routes
         Octopus.Manual server-side (task-global gate) — the pre-SC4 versions
         carry no locus and would classify as an agent step. -->
    <KrakenStepPackageVersion>1.2.0</KrakenStepPackageVersion>
    <KrakenStepPackageDisplayName>Manual Intervention</KrakenStepPackageDisplayName>
    <KrakenStepPackageExecutorTypeName>KrakenDeploy.Steps.Manual.ManualInterventionStepHandler</KrakenStepPackageExecutorTypeName>

    <!-- Don't litter the install dir with NuGet symbols / docs. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- SC1: claimed step types + per-type picker metadata → manifest stepTypes objects. -->
  <ItemGroup>
    <KrakenStepType Include="Octopus.Manual" DisplayName="Manual Intervention" Category="other" Description="Pause the deployment until a responsible team approves or rejects." Locus="server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Octostache" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK surface. Step packages depend ONLY on Contracts so they
         compile + ship without a transitive Agent dependency. The agent's
         StepPackageLoader delegates Contracts back to the default ALC at
         load time (Phase D-4) so types identify cleanly across the
         boundary. -->
    <ProjectReference Include="..\..\src\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
  </ItemGroup>

  <Import Project="..\KrakenStepPackage.targets" />

</Project>
