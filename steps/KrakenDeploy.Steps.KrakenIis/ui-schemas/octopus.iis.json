{
  "id": "octopus.iis",
  "title": "Deploy to IIS (Octopus shape)",
  "description": "Configures an IIS web site, sub-application, or virtual directory.",
  "version": "1.0.0",
  "groups": [
    {
      "id": "type",
      "title": "Deployment Type",
      "collapsed": false
    },
    {
      "id": "site",
      "title": "Web Site",
      "collapsed": false
    },
    {
      "id": "web-app",
      "title": "Web Application",
      "collapsed": false
    },
    {
      "id": "vdir",
      "title": "Virtual Directory",
      "collapsed": false
    },
    {
      "id": "app-pool",
      "title": "App Pool",
      "collapsed": false
    },
    {
      "id": "auth",
      "title": "Authentication",
      "collapsed": false
    },
    {
      "id": "bindings",
      "title": "Bindings",
      "collapsed": false
    },
    {
      "id": "package",
      "title": "Package payload",
      "collapsed": false
    }
  ],
  "properties": {
    "Octopus.Action.IISWebSite.DeploymentType": {
      "type": "string",
      "widget": "select",
      "label": "Deployment type",
      "group": "type",
      "default": "webSite",
      "enumValues": [
        {
          "value": "webSite",
          "label": "Web site"
        },
        {
          "value": "webApplication",
          "label": "Web application"
        },
        {
          "value": "virtualDirectory",
          "label": "Virtual directory"
        }
      ]
    },
    "Octopus.Action.IISWebSite.WebSiteName": {
      "type": "string",
      "widget": "text",
      "label": "Site name",
      "group": "site",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webSite"
      }
    },
    "Octopus.Action.IISWebSite.CreateOrUpdateWebSite": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Create or update web site",
      "group": "site",
      "default": "true",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webSite"
      }
    },
    "Octopus.Action.IISWebSite.StartWebSite": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Start web site",
      "group": "site",
      "default": "true",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webSite"
      }
    },
    "Octopus.Action.IISWebSite.StartApplicationPool": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Start application pool",
      "group": "site",
      "default": "true",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webSite"
      }
    },
    "Octopus.Action.IISWebSite.WebRootType": {
      "type": "string",
      "widget": "select",
      "label": "Web root type",
      "group": "site",
      "default": "packageRoot",
      "enumValues": [
        {
          "value": "packageRoot",
          "label": "Package root"
        },
        {
          "value": "packageDirectory",
          "label": "Package subdirectory"
        }
      ],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webSite"
      }
    },
