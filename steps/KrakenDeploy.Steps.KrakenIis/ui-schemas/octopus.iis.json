      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webApplication"
      }
    },
    "Octopus.Action.IISWebSite.WebApplication.CreateOrUpdate": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Create or update web application",
      "group": "web-app",
      "default": "true",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webApplication"
      }
    },
    "Octopus.Action.IISWebSite.VirtualDirectory.WebSiteName": {
      "type": "string",
      "widget": "text",
      "label": "Parent site name",
      "group": "vdir",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "virtualDirectory"
      }
    },
    "Octopus.Action.IISWebSite.VirtualDirectory.VirtualPath": {
      "type": "string",
      "widget": "text",
      "label": "Virtual path",
      "placeholder": "/static-content",
      "group": "vdir",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "virtualDirectory"
      }
    },
    "Octopus.Action.IISWebSite.VirtualDirectory.CreateOrUpdate": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Create or update virtual directory",
      "group": "vdir",
      "default": "true",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "virtualDirectory"
      }
    },
    "Octopus.Action.IISWebSite.ApplicationPoolName": {
      "type": "string",
      "widget": "text",
      "label": "App pool name",
      "group": "app-pool",
      "enumValues": []
    },
    "Octopus.Action.IISWebSite.ApplicationPoolFrameworkVersion": {
      "type": "string",
      "widget": "select",
      "label": ".NET framework version",
      "group": "app-pool",
      "default": "v4.0",
      "enumValues": [
        {
          "value": "v4.0",
          "label": "v4.0"
        },
        {
          "value": "v2.0",
          "label": "v2.0"
        },
        {
          "value": "",
          "label": "No Managed Code"
        }
      ]
    },
    "Octopus.Action.IISWebSite.ApplicationPoolIdentityType": {
      "type": "string",
      "widget": "select",
      "label": "Identity",
      "group": "app-pool",
      "default": "ApplicationPoolIdentity",
      "enumValues": [
        {
          "value": "ApplicationPoolIdentity",
          "label": "ApplicationPoolIdentity"
        },
        {
          "value": "LocalSystem",
          "label": "LocalSystem"
        },
        {
          "value": "LocalService",
          "label": "LocalService"
        },
        {
          "value": "NetworkService",
          "label": "NetworkService"
        },
        {
          "value": "SpecificUser",
          "label": "Specific user"
        }
      ]
    },
    "Octopus.Action.IISWebSite.ApplicationPoolUsername": {
      "type": "string",
      "widget": "text",
      "label": "Username",
      "group": "app-pool",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.ApplicationPoolIdentityType",
        "operator": "equals",
        "value": "SpecificUser"
      }
    },
    "Octopus.Action.IISWebSite.ApplicationPoolPassword": {
      "type": "string",
      "widget": "sensitive",
      "label": "Password",
      "group": "app-pool",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.ApplicationPoolIdentityType",
        "operator": "equals",
        "value": "SpecificUser"
      }
    },
    "Octopus.Action.IISWebSite.EnableAnonymousAuthentication": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Anonymous",
      "group": "auth",
      "enumValues": []
    },
    "Octopus.Action.IISWebSite.EnableBasicAuthentication": {
      "type": "boolean",
      "widget": "checkbox",
      "label": "Basic",
      "group": "auth",
      "enumValues": []
