      "type": "string",
      "widget": "json-editor",
      "label": "Bindings (JSON array)",
      "helpText": "JSON array of binding objects with keys protocol/ipAddress/port/host/thumbprint/certificateVariable/requireSni/enabled.",
      "group": "bindings",
      "enumValues": []
    },
    "Octopus.Action.Package.CustomInstallationDirectory": {
      "type": "string",
      "widget": "text",
      "label": "Custom installation directory",
      "helpText": "Where the package is extracted. Blank uses the agent\u0027s per-step staging dir.",
      "group": "package",
      "enumValues": []
    }
  }
}
