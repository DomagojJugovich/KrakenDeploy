      "type": "string",
      "widget": "text",
      "label": "Parent site name",
      "group": "web-app",
      "enumValues": [],
      "visibleWhen": {
        "field": "Octopus.Action.IISWebSite.DeploymentType",
        "operator": "equals",
        "value": "webApplication"
      }
    },
