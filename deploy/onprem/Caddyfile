# KrakenDeploy — Caddy reverse-proxy for on-prem deployment
# -----------------------------------------------------------
# Caddy provides automatic HTTPS (Let's Encrypt), HTTP/2 for
# gRPC bidirectional streaming, WebSocket upgrade for SignalR
# control-plane, and gzip/zstd compression for static assets.
#
# PREREQUISITES
#  1. A public DNS A/AAAA record pointing to this host
#  2. Ports 80 and 443 reachable from the public internet
#     (Let's Encrypt HTTP-01 challenge)
#  3. The KrakenDeploy Server container reachable at
#     kraken-server:5080 on the internal Docker network
#
# USAGE
#  Set the DOMAIN environment variable before starting Caddy:
#    export DOMAIN=kraken.example.com
#    docker compose up -d
#
# UPSTREAM (BG1/T5)
#  Caddy is the TLS front in EVERY on-prem install; the upstream differs by
#  compose profile:
#    single (default):  kraken-server:5080 (no env needed)
#    bluegreen:         set in .env —
#                         KRAKEN_UPSTREAM=kraken-router:8080
#                         KRAKEN_GRPC_UPSTREAM=kraken-router:8080
#  The YARP router never terminates TLS; it only pins sessions to releases.

{$DOMAIN:localhost} {
    # ── Compression ─────────────────────────────────────────────────
    encode gzip zstd

    # ── Logging ─────────────────────────────────────────────────────
    log {
        output file /var/log/caddy/kraken.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 720h # 30 days
        }
        format json
    }

    # ── SignalR hubs — WebSocket upgrade, long timeouts ─────────────
    handle /hubs/* {
        reverse_proxy {$KRAKEN_UPSTREAM:kraken-server:5080} {
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── Blazor Server circuits — SignalR WebSocket ──────────────────
    handle /_blazor* {
        reverse_proxy {$KRAKEN_UPSTREAM:kraken-server:5080} {
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── gRPC — HTTP/2 required, bidirectional streaming ──────────────
    # Proto package `krakendeploy.v1` → wire paths /krakendeploy.v1.<Service>/<Method>.
    # (A /kraken.* matcher never matches these and would drop gRPC to the h1 fallback.)
    handle /krakendeploy.v1.* {
        reverse_proxy h2c://{$KRAKEN_GRPC_UPSTREAM:kraken-server:5080} {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── Everything else — standard HTTP reverse-proxy ────────────────
    handle {
        reverse_proxy {$KRAKEN_UPSTREAM:kraken-server:5080} {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── Security headers ────────────────────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
