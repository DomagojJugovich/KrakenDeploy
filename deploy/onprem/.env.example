# KrakenDeploy — On-Prem Environment Configuration
# Copy this file to .env and fill in the required values.
# All values marked "Required" must be set before starting.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=krakendeploy
POSTGRES_USER=kraken
POSTGRES_PASSWORD=            # Required — choose a strong password

# ── Server secrets ────────────────────────────────────────────────────────
# Generate: Convert.ToBase64String(RandomNumberGenerator.GetBytes(32))
AGENT_JWT_KEY=                # Required — minimum 32 characters (agent auth)
# ENCRYPTION_KEY is the master key (KEK) wrapping the DB data-encryption key.
# It is NOT included in backups (a dump must not carry the key that decrypts
# it) — a database dump is undecryptable without the SAME key here. Preserve it
# in a secrets manager / offline vault, independently of the DB backup. Losing
# it is unrecoverable. kraken-init and kraken-server both read this one value.
ENCRYPTION_KEY=               # Required — base64-encoded 32-byte key (KEK). See note above.

# ── DataProtection key-ring cert (Linux) ───────────────────────────────────
# The server container is Linux (no Windows DPAPI), so the ASP.NET
# DataProtection key ring — which signs/encrypts auth + antiforgery cookies —
# is encrypted at rest with an X.509 certificate. Without it the ring is
# plaintext and the server refuses to boot. Generate a self-signed PFX (see
# the README) and keep it OUTSIDE the data volume; DP_CERT_PATH is the host
# path to it. In an HA pair, every node mounts the SAME PFX.
DP_CERT_PATH=                 # Required — host path to the DataProtection PFX (e.g. ./secrets/dp-cert.pfx)
DP_CERT_PASSWORD=             # PFX password (may be empty if the PFX has none; a password is recommended)

# ── Step-package signing trust anchor (SC7) ────────────────────────────────
# Step packages (the executable plugins deployment steps run) are signed
# archives; the server verifies uploads, catalog installs AND its own seeded
# built-ins against this public key. The matching PRIVATE key signed the
# archives when the server image was built (see the README's "Step-package
# signing" section for key generation + the docker build --secret command).
STEP_SIGNING_PUBKEY_PATH=     # Required — host path to the signing PUBLIC key PEM (e.g. ./secrets/kraken-signing.pub.pem)
# CLI/API keys are per-user (M13.C.4) — mint them in the UI (Configuration →
# API Keys) or on the server box: dotnet KrakenDeploy.Server.dll apikeys create

# ── License ───────────────────────────────────────────────────────────────
KRAKEN_LICENSE_KEY=           # Paste your license key here, or upload via UI at /settings/license

# ── Networking ────────────────────────────────────────────────────────────
DOMAIN=                       # Your public domain (e.g., kraken.example.com). Leave empty for localhost.
HA_MODE=                      # Set to "Postgres" for HA pair mode (two server nodes, shared Postgres)

# ── Server image ──────────────────────────────────────────────────────────
SERVER_IMAGE=krakendeploy-server:latest

# ── Topology (BG1) ──────────────────────────────────────────────────────────
# single (default): one kraken-server; upgrades are stop -> upgrade -> start.
# bluegreen: 3 slots + router; zero-downtime rolling upgrades, but the install
#   COMMITS to additive-only migrations between live releases — non-additive
#   upgrades ([StopTheWorld] migrations, Hangfire storage bumps) need the
#   stop-the-world runbook (docs/on-prem-guide.md). To switch, set ALL FOUR:
#   COMPOSE_PROFILES=bluegreen
#   KRAKEN_TOPOLOGY=OnPremBlueGreen
#   KRAKEN_UPSTREAM=kraken-router:8080
#   KRAKEN_GRPC_UPSTREAM=kraken-router:8080
COMPOSE_PROFILES=single
KRAKEN_TOPOLOGY=OnPrem
#KRAKEN_UPSTREAM=kraken-router:8080
#KRAKEN_GRPC_UPSTREAM=kraken-router:8080

# ── Blue-green profile only ─────────────────────────────────────────────────
# Router image + ops token (protects POST /kd-router/invalidate).
#ROUTER_IMAGE=krakendeploy-router:latest
#ROUTER_OPS_TOKEN=
# Per-slot release identity + image. A rolling upgrade retargets ONLY the
# retired slot: set its IMAGE + RELEASE_ID, `docker compose up -d kraken-slot-<n>`,
# then `releases register --id <release-id> --slot <n>`, health-gate, `releases flip`.
#SLOT1_IMAGE=krakendeploy-server:latest
#SLOT1_RELEASE_ID=
#SLOT2_IMAGE=krakendeploy-server:latest
#SLOT2_RELEASE_ID=
#SLOT3_IMAGE=krakendeploy-server:latest
#SLOT3_RELEASE_ID=
