# KrakenDeploy — Caddy reverse-proxy reference deployment
# -----------------------------------------------------------
# Caddy provides automatic HTTPS (Let's Encrypt), HTTP/2 for
# gRPC bidirectional streaming, WebSocket upgrade for SignalR
# control-plane, and gzip/zstd compression for static assets.
#
# PREREQUISITES
#  1. A public DNS A/AAAA record pointing to this host
#  2. Ports 80 and 443 reachable from the public internet
#     (Let's Encrypt HTTP-01 challenge)
#  3. The KrakenDeploy Server container reachable at
#     kraken-server:5080 on the internal Docker network
#
# USAGE
#  Replace {$DOMAIN} with your domain, or set the DOMAIN
#  environment variable before starting Caddy:
#    export DOMAIN=kraken.example.com
#    docker compose up -d

{$DOMAIN:localhost} {
    # ── Compression ─────────────────────────────────────────────────
    encode gzip zstd

    # ── Logging ─────────────────────────────────────────────────────
    log {
        output file /var/log/caddy/kraken.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 720h # 30 days
        }
        format json
    }

    # ── SignalR hubs — WebSocket upgrade, long timeouts ─────────────
    # Caddy defaults to 3-minute read/write timeouts; SignalR
    # connections are long-lived and must not be terminated.
    handle /hubs/* {
        reverse_proxy kraken-server:5080 {
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── Blazor Server circuits — SignalR WebSocket ──────────────────
    handle /_blazor* {
        reverse_proxy kraken-server:5080 {
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── gRPC — HTTP/2 required, bidirectional streaming ──────────────
    # The proto package is `krakendeploy.v1`, so gRPC wire paths are
    # /krakendeploy.v1.PackageDelivery/*, /krakendeploy.v1.StepPackageDelivery/*,
    # /krakendeploy.v1.ArtifactUpload/* (the csharp_namespace does NOT affect the wire
    # path). A /kraken.* matcher never matches these. Caddy negotiates H2C to the
    # backend via h2c:// transport so gRPC streaming works.
    handle /krakendeploy.v1.* {
        # B8: 5081 is the server's dedicated Http2-only h2c endpoint — one
        # cleartext port cannot serve HTTP/1.1 and HTTP/2 (no ALPN), so the
        # old h2c://kraken-server:5080 target was answered with
        # HTTP_1_1_REQUIRED and every agent gRPC call through Caddy failed.
        reverse_proxy h2c://kraken-server:5081 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── Everything else — standard HTTP reverse-proxy ────────────────
    handle {
        reverse_proxy kraken-server:5080 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ── Security headers ────────────────────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
