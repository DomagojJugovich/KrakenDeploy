# ── Build stage ──────────────────────────────────────────────────────────────
# Debian-based (glibc), NOT Alpine: KrakenDeploy.Contracts compiles .proto via
# Grpc.Tools, whose bundled protoc is a glibc binary that fails to exec under
# Alpine's musl libc (MSB6003).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central Package Management + the SDK pin + .editorconfig first (rarely change
# → cached layer). .editorconfig carries the analyzer suppressions the Release
# build relies on under TreatWarningsAsErrors.
COPY Directory.Build.props Directory.Packages.props global.json .editorconfig ./

# The agent's project graph spans src/ (Agent, Agent.Transport, Contracts,
# Execution) and steps/ (Steps.Common). Copy both wholesale rather than listing
# individual .csproj files, which drifts out of date and silently breaks the
# restore whenever a project is added. .dockerignore keeps bin/obj out.
COPY src/ ./src/
COPY steps/ ./steps/

RUN dotnet restore src/KrakenDeploy.Agent/KrakenDeploy.Agent.csproj

RUN dotnet publish src/KrakenDeploy.Agent/KrakenDeploy.Agent.csproj \
    --configuration Release \
    --no-restore \
    --output /app

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

RUN groupadd --system kraken \
 && useradd --system --gid kraken kraken

COPY --from=build /app ./

# The agent writes its identity file to /var/lib/krakendeploy-agent (Linux default).
# Give the kraken user ownership so it can write there.
RUN mkdir -p /var/lib/krakendeploy-agent \
 && chown kraken:kraken /var/lib/krakendeploy-agent

USER kraken

ENTRYPOINT ["dotnet", "KrakenDeploy.Agent.dll"]
