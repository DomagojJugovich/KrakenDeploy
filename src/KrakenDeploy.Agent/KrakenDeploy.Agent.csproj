<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-KrakenDeploy.Agent-96821dca-2f1e-4ccb-b1f2-837568793d00</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.Xdt" />
    <!-- A8/T1-12: DPAPI protection of the at-rest bearer token (Windows only). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Octostache" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KrakenDeploy.Agent.Transport\KrakenDeploy.Agent.Transport.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
    <!-- Shared transport-agnostic per-step orchestration decisions
         (StepConditionEvaluator + StepRetryRunner). Lets the offline
         runner apply identical run-condition / retry / timeout semantics
         to the online server path without referencing Server.Core /
         Server.Transport. -->
    <ProjectReference Include="..\KrakenDeploy.Execution\KrakenDeploy.Execution.csproj" />
    <!-- M11.E.7 — AdhocScriptExecutor reuses ScriptRunner directly (rather
         than going through the step-package loader) because ad-hoc actions
         don't have a step package and the executor needs the raw process
         exit code in its per-target result. -->
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.Common\KrakenDeploy.Steps.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakenDeploy.Agent.Tests" />
  </ItemGroup>
</Project>
