<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The published binary / dotnet tool is invoked as "kraken" -->
    <AssemblyName>kraken</AssemblyName>
    <RootNamespace>KrakenDeploy.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kraken</ToolCommandName>
    <PackageId>KrakenDeploy.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>Command-line interface for KrakenDeploy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts carries StepPackageSigner + StepPackageManifestJson,
         the same signing recipe the server + agent verify against.
         The CLI's `pack` verb calls Sign() directly so authors don't
         re-implement the recipe outside the SDK. -->
    <ProjectReference Include="..\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakenDeploy.Cli.Tests" />
  </ItemGroup>

</Project>
