<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- M14.2: Variable-condition expressions (#{...} truthy/falsy) are
         evaluated via Octostache — the same engine the orchestrator uses
         for Config substitution. -->
    <PackageReference Include="Octostache" />
  </ItemGroup>

  <ItemGroup>
    <!-- StepCondition + the shared StepConditionEvaluator live in
         KrakenDeploy.Execution so both the server orchestrator and the
         offline agent runner evaluate run conditions through one
         implementation. Server.Core's domain entities (DeploymentStep,
         StepSnapshot, StepExecutionKnobs) reference the StepCondition enum. -->
    <ProjectReference Include="..\KrakenDeploy.Execution\KrakenDeploy.Execution.csproj" />
  </ItemGroup>

</Project>
