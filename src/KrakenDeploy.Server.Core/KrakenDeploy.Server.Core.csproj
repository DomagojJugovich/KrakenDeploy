<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- M14.2: StepConditionEvaluator uses Octostache to evaluate
         Variable-condition expressions (#{...} truthy/falsy). Same
         engine the orchestrator already uses for Config substitution. -->
    <PackageReference Include="Octostache" />
  </ItemGroup>

</Project>
