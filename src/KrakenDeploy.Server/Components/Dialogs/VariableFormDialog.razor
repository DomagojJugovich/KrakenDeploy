@using KrakenDeploy.Server.Core.Domain.Variables
@using KrakenDeploy.Server.Core.Domain.Environments
@using KrakenDeploy.Server.Core.Domain.Tenants
@using KrakenDeploy.Server.Core.Domain.Channels
@inject DialogService Dialog
@inject VariableService VariableSvc
@inject EnvironmentService EnvironmentSvc
@inject TenantService TenantSvc
@inject ChannelService ChannelSvc
@inject ProcessService ProcessSvc
@inject TargetService TargetSvc
@inject UiActionGuard Guard

@*
    Add / edit a variable in a project's VariableSet or a library VariableSet.

    To add to a project: pass ProjectId; leave Variable null.
    To add to a library set: pass SetId; leave Variable null.
    To edit: pass Variable; ProjectId / SetId may also be passed (but aren't used).

    Sensitive values are NEVER decrypted to the form — when editing a
    Sensitive variable the user must re-type the value or leave it blank
    to keep the existing one (handled via the "Keep existing value"
    checkbox shown only in edit mode for Sensitive type).
*@

<div style="min-width: 580px; padding: 0.25rem 0;">
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <div>
                <RadzenLabel Text="Name *" />
                <RadzenTextBox @bind-Value="_model.Name" Style="width:100%"
                               aria-label="Name"
                               Placeholder="e.g. ConnectionString or Database.Name" />
                <ValidationMessage For="() => _model.Name" class="kraken-validation-error" />
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem"
                         AlignItems="AlignItems.End">
                <div style="flex: 1;">
                    <RadzenLabel Text="Type *" />
                    <RadzenDropDown TValue="VariableType" @bind-Value="_model.Type"
                                    Data="@_typeOptions" TextProperty="Label"
                                    ValueProperty="Value" Style="width:100%" />
                </div>
                @if (_isEdit && _model.Type == VariableType.Sensitive)
                {
                    <div style="flex: 0 0 auto; padding-bottom: 0.4rem;">
                        <RadzenCheckBox @bind-Value="_model.KeepSensitiveValue"
                                        Name="keep-existing" />
                        <RadzenLabel Text="Keep existing value" Component="keep-existing"
                                     Style="margin-left: 0.4rem; cursor: pointer;" />
                    </div>
                }
            </RadzenStack>

            @if (!(_isEdit && _model.Type == VariableType.Sensitive
                   && _model.KeepSensitiveValue))
            {
                <div>
                    <RadzenLabel Text="@(_model.Type == VariableType.Sensitive ? "Value *" : "Value")" />
                    @if (_model.Type == VariableType.Sensitive)
                    {
                        <RadzenPassword @bind-Value="_model.Value" Style="width:100%"
                                        aria-label="Value" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            Encrypted at rest with AES-256-GCM. Never logged.
                        </RadzenText>
                    }
                    else if (_model.Type == VariableType.StringArray)
                    {
                        <RadzenTextArea @bind-Value="_model.Value" Rows="3"
                                        Style="width:100%" aria-label="Value"
                                        Placeholder='Comma-separated, or JSON array: ["a","b","c"]' />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            Stored as JSON array. Comma-separated input is converted automatically.
                        </RadzenText>
                    }
                    else
                    {
                        <RadzenTextArea @bind-Value="_model.Value" Rows="3"
                                        Style="width:100%" aria-label="Value" />
                    }
                </div>
            }

            @* ── Scope ───────────────────────────────────────────────────── *@
            <RadzenFieldset Text="Scope" class="rz-mt-2">
                <RadzenStack Gap="0.85rem">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                        <div style="flex: 1;">
                            <RadzenLabel Text="Environment" />
                            <RadzenDropDown TValue="Guid?" @bind-Value="_model.EnvironmentId"
                                            Data="@_environments" TextProperty="Name"
                                            ValueProperty="Id" AllowClear="true"
                                            Placeholder="(any environment)"
                                            Style="width:100%" />
                        </div>
                        <div style="flex: 1;">
                            <RadzenLabel Text="Tenant" />
                            <RadzenDropDown TValue="Guid?" @bind-Value="_model.TenantId"
                                            Data="@_tenants" TextProperty="Name"
                                            ValueProperty="Id" AllowClear="true"
                                            Placeholder="(any tenant)"
                                            Style="width:100%" />
                        </div>
                    </RadzenStack>
                    @if (ProjectId is not null && _channels.Count > 0)
                    {
                        <div>
                            <RadzenLabel Text="Channel" />
                            <RadzenDropDown TValue="Guid?" @bind-Value="_model.ChannelId"
                                            Data="@_channels" TextProperty="Name"
                                            ValueProperty="Id" AllowClear="true"
                                            Placeholder="(any channel)"
                                            Style="width:100%" />
                        </div>
                    }
                    @if (ProjectId is not null && _steps.Count > 0)
                    {
                        <div>
                            <RadzenLabel Text="Step" />
                            <RadzenDropDown TValue="string" @bind-Value="_model.StepName"
                                            Data="@_steps" AllowClear="true"
                                            Placeholder="(any step)" Style="width:100%" />
                        </div>
                    }
                    <div>
                        <RadzenLabel Text="Target Roles" />
                        <RadzenDropDown TValue="IEnumerable<string>" @bind-Value="_model.Roles"
                                        Data="@_availableRoles" Multiple="true" Chips="true"
                                        AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="(any role)" Style="width:100%" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            Variable applies only to targets whose roles overlap this list.
                            Leave empty to apply to all roles. Roles are defined on
                            deployment targets and process steps.
                        </RadzenText>
                    </div>
                </RadzenStack>
            </RadzenFieldset>

            @if (_errorMessage is not null)
            {
                <div class="kraken-login-error rz-text-body2">@_errorMessage</div>
            }

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => Dialog.Close(false))" />
                <RadzenButton Text="Save" ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>
    </EditForm>
</div>

@code {
    [Parameter] public Guid? ProjectId { get; set; }
    [Parameter] public Guid? SetId { get; set; }
    [Parameter] public Variable? Variable { get; set; }

    private readonly FormModel _model = new();
    private string? _errorMessage;
    private bool _isEdit;

    private List<DeploymentEnvironment> _environments = [];
    private List<Tenant> _tenants = [];
    private List<Channel> _channels = [];
    private List<string> _steps = [];
    private List<string> _availableRoles = [];

    private record TypeOption(VariableType Value, string Label);
    private readonly TypeOption[] _typeOptions =
    [
        new(VariableType.Text,        "Text"),
        new(VariableType.Sensitive,   "Sensitive (encrypted)"),
        new(VariableType.StringArray, "String array"),
    ];

    protected override async Task OnInitializedAsync()
    {
        // Include archived so editing a variable already scoped to a
        // since-archived environment still resolves + preserves that scope.
        _environments = await EnvironmentSvc.GetAllOrderedAsync(includeArchived: true);
        _tenants = await TenantSvc.GetAllAsync();

        // Roles offered for scoping: every role on a deployment target, plus
        // (for project variables) roles referenced by the project's steps,
        // plus whatever is already on the variable being edited — so a stale
        // role stays selectable instead of silently disappearing on save.
        var roles = new SortedSet<string>(
            await TargetSvc.GetAllRolesAsync(), StringComparer.OrdinalIgnoreCase);

        // Channels are project-specific, so only offer them for project variables.
        if (ProjectId is { } pid)
        {
            _channels = await ChannelSvc.GetForProjectAsync(pid);
            var process = await ProcessSvc.GetAsync(pid);
            _steps = process?.Steps.Select(s => s.Name).ToList() ?? [];
            foreach (var role in process?.Steps.SelectMany(s => s.TargetRoles) ?? [])
            {
                roles.Add(role);
            }
        }

        if (Variable?.Scope.Roles is { Count: > 0 } existing)
        {
            foreach (var role in existing)
            {
                roles.Add(role);
            }
        }

        _availableRoles = [.. roles];
    }

    protected override void OnParametersSet()
    {
        if (Variable is not null)
        {
            _isEdit = true;
            _model.Name = Variable.Name;
            _model.Type = Variable.Type;
            // For Sensitive vars we never decrypt to the form. The user gets
            // a "Keep existing value" checkbox (default true).
            if (Variable.Type == VariableType.Sensitive)
            {
                _model.Value = "";
                _model.KeepSensitiveValue = true;
            }
            else
            {
                _model.Value = Variable.Value;
            }
            _model.EnvironmentId = Variable.Scope.EnvironmentId;
            _model.TenantId = Variable.Scope.TenantId;
            // Carried even when the picker is hidden, so a non-project edit
            // preserves any existing channel/step scope instead of wiping it.
            _model.ChannelId = Variable.Scope.ChannelId;
            _model.StepName = Variable.Scope.StepName;
            _model.Roles = Variable.Scope.Roles?.ToList() ?? [];
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        // Server-side recheck: the Blazor circuit bypasses the HTTP authz
        // middleware, and the project-variable opener (Variables.razor) has no
        // pre-open gate. Library-set edits require LibraryVariableSetEdit; project
        // and standalone variables require VariableEdit.
        if (!await Guard.AllowAsync(
            SetId is not null ? Permission.LibraryVariableSetEdit : Permission.VariableEdit))
        {
            return;
        }

        // Sensitive variable: must have a value unless user is keeping existing.
        if (_model.Type == VariableType.Sensitive
            && !(_isEdit && _model.KeepSensitiveValue)
            && string.IsNullOrEmpty(_model.Value))
        {
            _errorMessage = "A sensitive variable requires a value.";
            return;
        }

        var roles = _model.Roles
            .Where(r => !string.IsNullOrWhiteSpace(r))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var scope = new VariableScope
        {
            EnvironmentId = _model.EnvironmentId,
            TenantId = _model.TenantId,
            ChannelId = _model.ChannelId,
            StepName = _model.StepName,
            Roles = roles.Count > 0 ? roles : null,
        };

        try
        {
            if (_isEdit)
            {
                // Sensitive + keep-existing -> pass null so the service
                // skips the value update and keeps the ciphertext untouched.
                var valueToSend = (_model.Type == VariableType.Sensitive
                                   && _model.KeepSensitiveValue)
                    ? null
                    : _model.Value ?? "";

                await VariableSvc.UpdateVariableAsync(
                    Variable!.Id, _model.Name, valueToSend, _model.Type, scope, await Guard.CurrentCallerAsync());
            }
            else if (SetId is { } setId)
            {
                await VariableSvc.CreateVariableInSetAsync(
                    setId, _model.Name, _model.Value ?? "", _model.Type, scope, await Guard.CurrentCallerAsync());
            }
            else if (ProjectId is { } projectId)
            {
                await VariableSvc.CreateVariableAsync(
                    projectId, _model.Name, _model.Value ?? "", _model.Type, scope, await Guard.CurrentCallerAsync());
            }
            else
            {
                _errorMessage = "Missing target set — cannot create a variable.";
                return;
            }

            Dialog.Close(true);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = "";

        public VariableType Type { get; set; } = VariableType.Text;
        public string? Value { get; set; }
        public bool KeepSensitiveValue { get; set; }
        public Guid? EnvironmentId { get; set; }
        public Guid? TenantId { get; set; }
        public Guid? ChannelId { get; set; }
        public string? StepName { get; set; }
        public IEnumerable<string> Roles { get; set; } = [];
    }
}
