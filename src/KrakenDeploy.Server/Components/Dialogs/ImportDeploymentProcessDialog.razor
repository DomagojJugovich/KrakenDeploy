@using KrakenDeploy.Server.Data.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProcessService ProcessSvc
@inject DialogService DialogService
@inject UiActionGuard Guard

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
        Paste or upload an <strong>Octopus deploymentprocess</strong> JSON — the
        response body from
        <code>GET /api/{spaceId}/deploymentprocesses/{processId}</code> on an
        existing Octopus instance, or the equivalent JSON export an admin can
        produce from a project's process page. Each <code>Step</code> becomes a
        KrakenDeploy <code>DeploymentStep</code>; the action's
        <code>Properties</code> bag is preserved verbatim under the step's
        <code>Config</code> so the runtime handler reads the original Octopus
        property keys.
    </RadzenText>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <InputFile OnChange="@OnFileSelectedAsync" accept=".json,.txt" />
        @if (!string.IsNullOrEmpty(_fileName))
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                Loaded <code>@_fileName</code>.
            </RadzenText>
        }
    </RadzenStack>

    <RadzenFormField Text="JSON" Variant="Variant.Outlined" style="width:100%">
        <RadzenTextArea @bind-Value="_json" Rows="14"
                        Style="width:100%; font-family: var(--rz-mono-font, monospace);"
                        Placeholder='{ "Id": "...", "Steps": [ ... ] }' />
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenCheckBox @bind-Value="_replace" TValue="bool" Name="replace" />
        <RadzenLabel Text="Replace existing steps" Component="replace" />
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
            (when unchecked, imported steps are appended after existing ones)
        </RadzenText>
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter">@_error</RadzenAlert>
    }

    @if (_result is not null)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">Import summary</RadzenText>
            <div class="rz-grid-table" style="grid-template-columns: auto 1fr;">
                <span class="rz-color-secondary">Imported</span><span>@_result.Imported step(s)</span>
                <span class="rz-color-secondary">Replaced</span><span>@_result.ReplacedExisting existing step(s)</span>
                <span class="rz-color-secondary">Warnings</span><span>@_result.Warnings.Count</span>
            </div>
            @if (_result.Warnings.Count > 0)
            {
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-3 rz-mb-1">Warnings</RadzenText>
                <RadzenDataGrid Data="@_result.Warnings" TItem="ImportDeploymentProcessWarning"
                                AllowPaging="false" AllowSorting="false"
                                Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn TItem="ImportDeploymentProcessWarning" Property="StepName" Title="Step">
                            <Template Context="w"><code>@w.StepName</code></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ImportDeploymentProcessWarning" Property="Message" Title="Message" />
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenCard>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="@(_result is null ? "Cancel" : "Close")"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@(() => DialogService.Close(_result is not null))" />
        @if (_result is null)
        {
            <RadzenButton Text="Import" ButtonStyle="ButtonStyle.Primary"
                          Icon="cloud_download" IsBusy="@_busy" Click="@RunAsync" />
        }
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    private string _json = string.Empty;
    private string _fileName = string.Empty;
    private string _error = string.Empty;
    private bool _replace;
    private bool _busy;
    private ImportDeploymentProcessResult? _result;

    private const long MaxFileSize = 20 * 1024 * 1024; // 20 MB

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = string.Empty;
        if (e.File is null) return;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: MaxFileSize);
            using var reader = new StreamReader(stream);
            _json = await reader.ReadToEndAsync();
            _fileName = e.File.Name;
        }
        catch (Exception ex)
        {
            _error = $"Failed to read file: {ex.Message}";
        }
    }

    private async Task RunAsync()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_json))
        {
            _error = "Paste the JSON or pick a file.";
            return;
        }

        if (!await Guard.AllowAsync(Permission.ProcessEdit)) return;

        _busy = true;
        try
        {
            _result = await ProcessSvc.ImportDeploymentProcessAsync(ProjectId, _json, _replace);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
