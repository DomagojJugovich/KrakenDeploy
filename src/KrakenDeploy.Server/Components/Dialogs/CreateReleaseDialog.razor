@using KrakenDeploy.Server.Core.Domain.Channels
@inject DialogService Dialog
@inject ChannelService ChannelSvc
@inject ReleaseService ReleaseSvc

@*
    Create a new release for a project. The deployment process snapshot
    and package versions are resolved server-side; the form only gathers
    the version, channel, and notes.
*@

<div style="min-width: 480px; padding: 0.25rem 0;">
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <div>
                <RadzenLabel Text="Version *" />
                <RadzenTextBox @bind-Value="_form.Version" Style="width: 100%;"
                               Placeholder="e.g. 1.2.3 or 2026.05.07" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    SemVer or date-stamp. Must be unique within the project, and
                    must satisfy the chosen channel's version range if any.
                </RadzenText>
                <ValidationMessage For="() => _form.Version"
                                   class="kraken-validation-error" />
            </div>

            <div>
                <RadzenLabel Text="Channel" />
                <RadzenDropDown TValue="Guid?" @bind-Value="_form.ChannelId"
                                Data="@_channels" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true"
                                Placeholder="(use project default)"
                                Style="width: 100%;" />
            </div>

            <div>
                <RadzenLabel Text="Release notes" />
                <RadzenTextArea @bind-Value="_form.ReleaseNotes" Rows="4"
                                Style="width: 100%;"
                                Placeholder="What's in this release? Markdown is fine." />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="kraken-login-error rz-text-body2">@_errorMessage</div>
            }

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => Dialog.Close(false))" />
                <RadzenButton Text="Create release" ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>
    </EditForm>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private readonly FormModel _form = new();
    private List<Channel> _channels = [];
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _channels = await ChannelSvc.GetForProjectAsync(ProjectId);
        // Pre-select the default channel if one exists.
        var def = _channels.FirstOrDefault(c => c.IsDefault);
        if (def is not null)
        {
            _form.ChannelId = def.Id;
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        try
        {
            await ReleaseSvc.CreateAsync(
                ProjectId, _form.Version,
                packageVersions: null,
                releaseNotes: _form.ReleaseNotes,
                channelId: _form.ChannelId);
            Dialog.Close(true);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(64)]
        public string Version { get; set; } = "";

        public Guid? ChannelId { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(8000)]
        public string? ReleaseNotes { get; set; }
    }
}
