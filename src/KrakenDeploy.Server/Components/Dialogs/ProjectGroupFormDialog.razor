@inject DialogService Dialog
@inject ProjectService ProjectSvc
@inject UiActionGuard Guard

<div style="min-width: 460px; padding: 0.25rem 0;">
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <div>
                <RadzenLabel Text="Name *" />
                <RadzenTextBox @bind-Value="_model.Name"
                               Change="@OnNameChanged"
                               Style="width:100%"
                               aria-label="Name" />
                <ValidationMessage For="() => _model.Name" class="kraken-validation-error" />
            </div>
            <div>
                <RadzenLabel Text="Slug *" />
                <RadzenTextBox @bind-Value="_model.Slug"
                               Style="width:100%"
                               aria-label="Slug" />
                <ValidationMessage For="() => _model.Slug" class="kraken-validation-error" />
            </div>
            <div>
                <RadzenLabel Text="Description" />
                <RadzenTextArea @bind-Value="_model.Description"
                                Rows="3"
                                Style="width:100%"
                                aria-label="Description" />
                <ValidationMessage For="() => _model.Description" class="kraken-validation-error" />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="kraken-login-error rz-text-body2">@_errorMessage</div>
            }

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem">
                <RadzenButton Text="Cancel"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => Dialog.Close(false))" />
                <RadzenButton Text="Save"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>
    </EditForm>
</div>

@code {
    /// <summary>When set, the dialog edits this group; otherwise it creates a new one.</summary>
    [Parameter] public ProjectGroup? Group { get; set; }

    private bool IsEdit => Group is not null;

    private readonly FormModel _model = new();
    private string? _errorMessage;
    private string _lastAutoSlug = "";
    private bool _initialized;

    protected override void OnParametersSet()
    {
        // OnParametersSet runs on every parameter-set cycle (e.g. a parent
        // re-render while the dialog is open); initialize only once so user
        // edits aren't clobbered by the original group values.
        if (_initialized || Group is null) return;
        _initialized = true;

        _model.Name = Group.Name;
        _model.Slug = Group.Slug;
        _model.Description = Group.Description;
        // In edit mode the slug is user-managed; disable auto-slug from name.
        _lastAutoSlug = Group.Slug;
    }

    private void OnNameChanged(string? value)
    {
        if (value is null) return;
        if (IsEdit) return; // editing keeps the existing slug unless changed by hand
        if (_model.Slug != _lastAutoSlug) return;

        _lastAutoSlug = ProjectService.Slugify(value);
        _model.Slug = _lastAutoSlug;
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        var permission = IsEdit ? Permission.ProjectGroupEdit : Permission.ProjectGroupCreate;
        if (!await Guard.AllowAsync(permission))
        {
            return;
        }

        try
        {
            if (IsEdit)
            {
                await ProjectSvc.UpdateGroupAsync(Group!.Id, _model.Name, _model.Slug, _model.Description);
            }
            else
            {
                await ProjectSvc.CreateGroupAsync(_model.Name, _model.Slug, _model.Description);
            }
            Dialog.Close(true);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(64)]
        [System.ComponentModel.DataAnnotations.RegularExpression(
            @"^[a-z0-9][a-z0-9\-]*[a-z0-9]$|^[a-z0-9]$",
            ErrorMessage = "Slug must be lowercase letters, digits, and hyphens (no leading/trailing hyphens).")]
        public string Slug { get; set; } = "";

        [System.ComponentModel.DataAnnotations.MaxLength(2000)]
        public string? Description { get; set; }
    }
}
