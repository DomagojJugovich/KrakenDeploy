@using KrakenDeploy.Contracts.Steps
@using KrakenDeploy.Server.Core.Domain.StepPackages
@using KrakenDeploy.Server.Core.Domain.StepTemplates
@using KrakenDeploy.Server.Data.Services

@inject StepTypeRegistry TypeRegistry
@inject StepTemplateService TemplateSvc
@inject StepTemplateCatalogService CatalogSvc
@inject StepPackageCatalogService PackageCatalogSvc
@inject NotificationService Notify
@inject DialogService Dialog

@* SC5 — source-sectioned Add-Step picker (SD-9). Cards come from three
   sources: installed step TYPES (the step-type registry — what packages
   actually serve), PRESETS (community/user step templates over a base
   type), and the community catalog (uninstallable presets, one-click
   Install-and-Add). A preset whose base type no package serves gets an
   "unrunnable" badge and a guarded Add. *@

<RadzenStack Gap="0.75rem" Style="min-width:900px; max-height:75vh; overflow:auto;">
    <RadzenTextBox @bind-Value="_search"
                   Placeholder="Filter by name, step type, category or description…"
                   Style="width:100%;"
                   Change="@(() => InvokeAsync(StateHasChanged))" />

    @if (_loading)
    {
        <RadzenText class="rz-color-secondary">Loading step catalog…</RadzenText>
    }
    else
    {
        <RadzenRow Gap="1rem">
            @* ── Left filter pane ─────────────────────────────────────── *@
            <RadzenColumn Size="3">
                @{
                    RenderFragment FilterButton(string? bucket, string label) => @<RadzenButton
                        Text="@label"
                        ButtonStyle="@(bucket == _currentBucket ? ButtonStyle.Primary : ButtonStyle.Light)"
                        Variant="Variant.Flat" Size="ButtonSize.Small"
                        class="rz-mb-1"
                        style="width:100%; justify-content:flex-start; text-align:left;"
                        Click="@(() => SetBucket(bucket))" />;
                }

                @FilterButton("Featured", $"Featured ({_featuredCount})")
                @FilterButton("Installed", $"Installed ({_installedCount})")
                @FilterButton("Presets", $"Presets ({_presetCount})")
                @FilterButton("Community", $"Community ({_communityCount})")
                @FilterButton(null, $"All ({_cards.Count})")

                <RadzenText TextStyle="TextStyle.Caption"
                            class="rz-color-secondary rz-mt-3 rz-mb-1">
                    By category
                </RadzenText>
                @foreach (var bucket in _bigBuckets)
                {
                    @FilterButton(bucket, $"{bucket} ({_bucketCounts[bucket]})")
                }
            </RadzenColumn>

            @* ── Right: sections of cards ─────────────────────────────── *@
            <RadzenColumn Size="9">
                @{
                    var visible = FilterCards().ToList();
                }
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-2">
                    @visible.Count card(s) shown.
                </RadzenText>

                @if (visible.Count == 0)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">
                        Nothing matches the filter.
                    </RadzenAlert>
                }
                else
                {
                    foreach (var section in Sections)
                    {
                        var sectionCards = visible.Where(c => c.Section == section).ToList();
                        if (sectionCards.Count == 0) { continue; }

                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2 rz-mb-1">
                            @SectionTitle(section)
                        </RadzenText>
                        <RadzenRow Gap="0.75rem">
                            @foreach (var card in sectionCards)
                            {
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenCard Style="height:100%; display:flex; flex-direction:column;">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                                     AlignItems="AlignItems.Start" class="rz-mb-2">
                                            @if (!string.IsNullOrWhiteSpace(card.LogoUrl))
                                            {
                                                <img src="@card.LogoUrl" alt="" loading="lazy"
                                                     style="width:28px;height:28px;object-fit:contain;flex:0 0 auto;" />
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="@card.Icon"
                                                            Style="font-size:24px;flex:0 0 auto;" />
                                            }
                                            <div style="min-width:0;">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0"
                                                            Style="word-break:break-word;">@card.Title</RadzenText>
                                                @if (!string.IsNullOrWhiteSpace(card.Subtitle))
                                                {
                                                    <RadzenText TextStyle="TextStyle.Caption"
                                                                class="rz-color-secondary">@card.Subtitle</RadzenText>
                                                }
                                            </div>
                                        </RadzenStack>

                                        <div style="flex:1 1 auto;">
                                            @if (!string.IsNullOrWhiteSpace(card.Description))
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2"
                                                            class="rz-color-secondary"
                                                            Style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                                                    @card.Description
                                                </RadzenText>
                                            }
                                        </div>

                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem"
                                                     AlignItems="AlignItems.Center" class="rz-mt-2" Wrap="FlexWrap.Wrap">
                                            @if (card.PackageBadge is not null)
                                            {
                                                <RadzenBadge Text="@card.PackageBadge" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                                            }
                                            @if (card.Unrunnable)
                                            {
                                                <RadzenBadge Text="@($"requires {card.BaseType} — not installed")"
                                                             BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                                            }
                                            @if (card.Section == CardSection.Community)
                                            {
                                                <RadzenBadge Text="Community" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                            }
                                            @if (!string.IsNullOrWhiteSpace(card.Category))
                                            {
                                                <RadzenBadge Text="@card.Category" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                            }
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal"
                                                     JustifyContent="JustifyContent.End" Gap="0.4rem"
                                                     class="rz-mt-2">
                                            <RadzenButton Text="@card.ButtonLabel"
                                                          Icon="@card.ButtonIcon"
                                                          ButtonStyle="ButtonStyle.Primary"
                                                          Size="ButtonSize.Small"
                                                          IsBusy="@(_busyCardKey == card.Key)"
                                                          Disabled="@(_busyCardKey is not null || card.Unrunnable)"
                                                          Click="@(() => ChooseAsync(card))" />
                                        </RadzenStack>
                                    </RadzenCard>
                                </RadzenColumn>
                            }
                        </RadzenRow>
                    }
                }
            </RadzenColumn>
        </RadzenRow>
    }

    @* ── Feed health strip (SD-9) ─────────────────────────────────────── *@
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">
            Community templates: @FormatSync(_templateFeedSync) · Step packages: @FormatSync(_packageFeedSync)
        </RadzenText>
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Dialog.Close(null))" />
    </RadzenStack>
</RadzenStack>

@code {
    private bool _loading = true;
    private string _search = "";
    private string? _currentBucket;
    private string? _busyCardKey;

    private List<Card> _cards = [];
    private DateTimeOffset? _templateFeedSync;
    private DateTimeOffset? _packageFeedSync;

    private int _featuredCount;
    private int _installedCount;
    private int _presetCount;
    private int _communityCount;
    private IReadOnlyList<string> _bigBuckets = [];
    private Dictionary<string, int> _bucketCounts = new(StringComparer.OrdinalIgnoreCase);

    private enum CardSection { Featured, Installed, Presets, Community }

    private static readonly CardSection[] Sections =
        [CardSection.Featured, CardSection.Installed, CardSection.Presets, CardSection.Community];

    private static string SectionTitle(CardSection s) => s switch
    {
        CardSection.Featured  => "Featured",
        CardSection.Installed => "Installed step types",
        CardSection.Presets   => "Presets",
        CardSection.Community => "Available to install",
        _                     => s.ToString(),
    };

    protected override async Task OnInitializedAsync()
    {
        var types     = await TypeRegistry.GetAllAsync();
        var presets   = await TemplateSvc.GetAllAsync();
        var community = await CatalogSvc.GetAllAsync();
        _templateFeedSync = await CatalogSvc.GetLastSyncAsync();
        _packageFeedSync  = await PackageCatalogSvc.GetLastSyncAsync();

        BuildCards(types, presets, community);
        _loading = false;
    }

    private void BuildCards(
        List<StepTypeEntry> types,
        List<StepTemplate> presets,
        List<StepTemplateCatalogEntry> community)
    {
        _cards = [];

        var servedTypeIds = types.Select(t => t.TypeId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        // ── Installed step types (the registry — what packages serve) ──
        foreach (var t in types)
        {
            // System row with no serving package and no editor of its own:
            // octopus.deployrelease is orchestrated through its dedicated
            // flow, not authorable from the picker (pre-SC5 behavior kept).
            var isStepGroup = t.TypeId.Equals("kraken.stepgroup", StringComparison.OrdinalIgnoreCase);
            if (t.Source == StepTypeEntrySource.System && !isStepGroup) { continue; }

            _cards.Add(new Card
            {
                Key          = $"type:{t.TypeId}",
                Title        = t.DisplayName,
                Subtitle     = t.TypeId,
                Description  = t.Description,
                Icon         = isStepGroup ? "folder" : "extension",
                Category     = t.Category,
                PackageBadge = t.ServingPackageName is null
                    ? null
                    : $"{t.ServingPackageName} {t.ServingPackageVersion}",
                ButtonLabel  = isStepGroup ? "Add Group" : "Add Step",
                ButtonIcon   = "add",
                Section      = t.Featured ? CardSection.Featured : CardSection.Installed,
                IsFeatured   = t.Featured,
                TypeId       = t.TypeId,
                TypeDisplayName = t.DisplayName,
                IsStepGroup  = isStepGroup,
            });
        }

        // ── Presets (community/user templates over a base type) ────────
        foreach (var p in presets)
        {
            var runnable = servedTypeIds.Contains(p.ActionType);
            _cards.Add(new Card
            {
                Key         = $"preset:{p.Id}",
                Title       = p.Name,
                Subtitle    = p.ActionType,
                Description = p.Description,
                Icon        = "bookmark",
                LogoUrl     = p.LogoUrl,
                Category    = p.Category,
                ButtonLabel = "Add Step",
                ButtonIcon  = "add",
                Section     = CardSection.Presets,
                Unrunnable  = !runnable,
                BaseType    = p.ActionType,
                Preset      = p,
            });
        }

        // ── Community catalog — exclude entries already installed ──────
        var installedCommunityIds = presets
            .Where(t => !string.IsNullOrWhiteSpace(t.CommunityTemplateId))
            .Select(t => t.CommunityTemplateId!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var c in community)
        {
            if (installedCommunityIds.Contains(c.CommunityTemplateId)) { continue; }
            var runnable = servedTypeIds.Contains(c.ActionType);
            _cards.Add(new Card
            {
                Key         = $"community:{c.Id}",
                Title       = c.Name,
                Subtitle    = string.IsNullOrWhiteSpace(c.Author) ? c.ActionType : $"By {c.Author}",
                Description = c.Description,
                Icon        = "cloud_download",
                LogoUrl     = c.LogoUrl,
                Category    = c.Category,
                ButtonLabel = "Install and Add",
                ButtonIcon  = "download",
                Section     = CardSection.Community,
                Unrunnable  = !runnable,
                BaseType    = c.ActionType,
                CommunityEntry = c,
            });
        }

        _featuredCount  = _cards.Count(c => c.Section == CardSection.Featured);
        _installedCount = _cards.Count(c => c.Section == CardSection.Installed);
        _presetCount    = _cards.Count(c => c.Section == CardSection.Presets);
        _communityCount = _cards.Count(c => c.Section == CardSection.Community);

        // Big-bucket counts across the whole card set.
        _bucketCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in _cards)
        {
            var bucket = StepTemplateCategoryMap.GetBigBucket(c.Category);
            _bucketCounts.TryGetValue(bucket, out var n);
            _bucketCounts[bucket] = n + 1;
        }
        _bigBuckets = [.. StepTemplateCategoryMap.BigBuckets.Where(b => _bucketCounts.ContainsKey(b))];

        _currentBucket = _featuredCount > 0 ? "Featured" : null;
    }

    private void SetBucket(string? bucket) => _currentBucket = bucket;

    private IEnumerable<Card> FilterCards()
    {
        IEnumerable<Card> q = _cards;

        q = _currentBucket switch
        {
            "Featured"  => q.Where(c => c.Section == CardSection.Featured),
            "Installed" => q.Where(c => c.Section is CardSection.Installed or CardSection.Featured),
            "Presets"   => q.Where(c => c.Section == CardSection.Presets),
            "Community" => q.Where(c => c.Section == CardSection.Community),
            null        => q,
            _           => q.Where(c =>
                StepTemplateCategoryMap.GetBigBucket(c.Category)
                    .Equals(_currentBucket, StringComparison.OrdinalIgnoreCase)),
        };

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(c =>
                c.Title.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (c.Subtitle?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.Category?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return q.OrderByDescending(c => c.IsFeatured)
                .ThenByDescending(c => c.IsStepGroup)
                .ThenBy(c => c.Title);
    }

    private async Task ChooseAsync(Card card)
    {
        _busyCardKey = card.Key;
        try
        {
            if (card.IsStepGroup)
            {
                Dialog.Close(ChooseStepTemplateResult.Group);
                return;
            }

            if (card.TypeId is not null)
            {
                Dialog.Close(ChooseStepTemplateResult.FromStepType(
                    card.TypeId, card.TypeDisplayName ?? card.TypeId));
                return;
            }

            if (card.CommunityEntry is not null)
            {
                try
                {
                    var installed = await CatalogSvc.InstallAsync(card.CommunityEntry.Id);
                    Dialog.Close(ChooseStepTemplateResult.FromTemplate(installed));
                    return;
                }
                catch (Exception ex)
                {
                    Notify.Notify(NotificationSeverity.Error, "Install failed", ex.Message, 5000);
                    return;
                }
            }

            if (card.Preset is not null)
            {
                Dialog.Close(ChooseStepTemplateResult.FromTemplate(card.Preset));
            }
        }
        finally
        {
            _busyCardKey = null;
        }
    }

    private static string FormatSync(DateTimeOffset? lastSync)
    {
        if (lastSync is null) { return "never synced"; }
        var age = DateTimeOffset.UtcNow - lastSync.Value;
        return age switch
        {
            { TotalMinutes: < 2 }  => "synced just now",
            { TotalHours: < 2 }    => $"synced {(int)age.TotalMinutes} min ago",
            { TotalDays: < 2 }     => $"synced {(int)age.TotalHours} h ago",
            _                      => $"synced {(int)age.TotalDays} d ago",
        };
    }

    private sealed class Card
    {
        public string Key { get; init; } = "";
        public string Title { get; init; } = "";
        public string? Subtitle { get; init; }
        public string? Description { get; init; }
        public string Icon { get; init; } = "extension";
        public string? LogoUrl { get; init; }
        public string? Category { get; init; }
        public string? PackageBadge { get; init; }
        public string ButtonLabel { get; init; } = "Add Step";
        public string ButtonIcon { get; init; } = "add";
        public CardSection Section { get; init; }
        public bool IsFeatured { get; init; }
        public bool IsStepGroup { get; init; }
        public bool Unrunnable { get; init; }
        public string? BaseType { get; init; }
        public string? TypeId { get; init; }
        public string? TypeDisplayName { get; init; }
        public StepTemplate? Preset { get; init; }
        public StepTemplateCatalogEntry? CommunityEntry { get; init; }
    }
}
