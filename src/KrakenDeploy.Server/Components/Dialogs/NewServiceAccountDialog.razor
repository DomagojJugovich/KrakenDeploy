@inject UserService UserSvc
@inject DialogService Dialog
@inject UiActionGuard Guard
@using KrakenDeploy.Server.Core.Domain.Licensing

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
        Service accounts authenticate only via API keys — they cannot sign in
        with a password or SSO. Use them for Hangfire jobs, MCP tool callers,
        and external automation that needs to act on its own identity (so the
        audit log shows "deployment-bot" instead of phantom humans).
    </RadzenText>

    <RadzenFormField Text="Display name *" style="width:100%">
        <RadzenTextBox @bind-Value="_name"
                       Placeholder="deployment-bot"
                       style="width:100%" />
    </RadzenFormField>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false">
            @_errorMessage
        </RadzenAlert>
    }

    @if (_created is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="false">
            <p>Service account created.</p>
            <p style="margin: 0.25rem 0;">
                <strong>Username:</strong> <code>@_created.UserName</code>
            </p>
            <p style="margin: 0; font-size: 0.85em;">
                Next step: issue an API key for this account
                (coming in M13.C.4). Until then the account exists but has
                no way to sign in.
            </p>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                 JustifyContent="JustifyContent.End">
        @if (_created is null)
        {
            <RadzenButton Text="Create" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@_busy" Click="CreateAsync" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Dialog.Close(false))" />
        }
        else
        {
            <RadzenButton Text="Done" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Dialog.Close(true))" />
        }
    </RadzenStack>
</RadzenStack>

@code {
    private string _name         = "";
    private string _errorMessage = "";
    private bool   _busy;
    private KrakenDeploy.Server.Data.Identity.ApplicationUser? _created;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = "Display name is required.";
            return;
        }

        if (!await Guard.AllowAsync(Permission.UserInvite)) return;

        _busy         = true;
        _errorMessage = "";

        try
        {
            _created = await UserSvc.CreateServiceAccountAsync(_name.Trim());
        }
        catch (LicenseLimitException ex)
        {
            // Same gate as human invite — service accounts count against
            // MaxUsers. Render with a "See License Usage" hint.
            _errorMessage = $"{ex.Message} See Configuration → License Usage.";
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
