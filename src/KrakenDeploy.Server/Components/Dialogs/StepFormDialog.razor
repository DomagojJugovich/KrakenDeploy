@using System.Globalization
@using System.Text.Json
@using KrakenDeploy.Contracts.Steps
@using KrakenDeploy.Execution
@using KrakenDeploy.Server.Components.Shared
@using KrakenDeploy.Server.Core.Domain.Processes
@using KrakenDeploy.Server.Core.Domain.StepPackages
@using KrakenDeploy.Server.Core.Domain.StepTemplates
@using KrakenDeploy.Server.Data.Services

@inject DialogService Dialog
@inject StepTemplateService TemplateSvc
@inject StepPackageService StepPackageSvc
@inject StepPackageResolver StepPackageRes
@inject NotificationService Notifications
@inject FeatureFlagService FeatureFlags
@inject VariableService VariableSvc
@inject KrakenDeploy.Server.Data.Services.Ai.SpaceAiSettingsService AiSettingsSvc
@inject KrakenDeploy.Server.Data.Services.Ai.Assistant.ProcessAssistantService AssistantSvc
@inject UiActionGuard Guard

@*
    Unified step add/edit dialog. Replaces the legacy script-only StepFormDialog
    and TemplatedStepFormDialog with one schema-driven flow.

    Inputs (use ONE of):
      Add a new step:
        ProjectId + Template      — schema derived from template parameters
        ProjectId + ActionType    — schema looked up in BuiltInStepSchemas
                                     (also the blank "Run a Script" path —
                                      pass "Kraken.Script")
      Edit an existing step:
        Step                      — schema resolved from BuiltInStepSchemas
                                     first; falls back to the matching
                                     template by ActionType.

    Renders:
      - Common Step columns (Name, Package ID, Target Roles) as chrome.
      - Schema-driven body via <StepUiSchemaForm /> for the Config bag.
      - Conditional referenced-packages grid for script step types
        (Kraken.Script / Octopus.Script) since that's a structured list
        the v1 schema vocabulary doesn't yet model as a widget.

    Save flow:
      - Schema validator runs on the snapshot; errors show inline + block close.
      - Common-field validation: Name + PackageId required.
      - Persist via ProcessService.AddStepAsync / UpdateStepAsync.
*@

<div style="min-width:640px; padding:0.25rem 0;">
    <RadzenStack Gap="1rem">

        @* M15 — Kraken.StepGroup has no schema (it's a container). Skip
           the no-schema warning and render the group-specific body
           (Target Roles + optional ForEach panel). *@
        @if (_schema is null && !_isStepGroup)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">
                    No schema available for this step type.
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    @(_resolveError ?? "Step type is missing both a built-in schema and a matching step template.")
                </RadzenText>
            </RadzenAlert>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => Dialog.Close(false))" />
            </RadzenStack>
            return;
        }

        @* ── Common Step columns ─────────────────────────────────────────── *@
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">Step</RadzenText>
            <RadzenStack Gap="0.75rem">
                <RadzenFormField Text="Name" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_name" Style="width:100%"
                                   Placeholder="e.g. Deploy WebApp" />
                </RadzenFormField>

                <RadzenFormField Text="Package ID" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_packageId" Style="width:100%"
                                   Placeholder="Logical package identifier (optional for some step types)" />
                </RadzenFormField>

                <RadzenFormField Text="Target roles" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_targetRolesCsv" Style="width:100%"
                                   Placeholder="Comma-separated, e.g. SERVER, TERMINAL" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    Only deployment targets whose roles overlap this list run the step.
                    Leave empty to run on every target.
                </RadzenText>
            </RadzenStack>
        </RadzenCard>

        @* ── Step-package version pin (Phase D-7) ─────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(_stepPackageName))
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="extension" />
                    <RadzenStack Gap="0.1rem" Style="flex:1;">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                            Step package
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            <code>@_stepPackageName</code>
                        </RadzenText>
                    </RadzenStack>
                    <RadzenFormField Text="Version" Variant="Variant.Outlined">
                        <RadzenDropDown TValue="string"
                                        Data="@_availableVersions"
                                        Value="@_stepPackageVersion"
                                        Change="@(v => OnPickVersionAsync(v as string))"
                                        Style="min-width:140px;" />
                    </RadzenFormField>
                    @if (_stepPackageVersion is not null
                         && _availableVersions.Count > 0
                         && _stepPackageVersion != _availableVersions[0])
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" IsPill="true"
                                         Text="@($"Update: {_availableVersions[0]}")"
                                         title="A newer version of this step package is installed." />
                            <RadzenButton Icon="@(_changelogVisible ? "expand_less" : "description")"
                                          Size="ButtonSize.ExtraSmall"
                                          Variant="Variant.Text"
                                          ButtonStyle="ButtonStyle.Light"
                                          title="@(_changelogVisible ? "Hide changelog" : "Show changelog")"
                                          Click="@(() => _changelogVisible = !_changelogVisible)" />
                        </RadzenStack>
                    }
                </RadzenStack>

                @* ── Phase D-12.4: changelog for the latest installed version ── *@
                @if (_changelogVisible
                     && _availableVersions.Count > 0
                     && _versionRows.TryGetValue(_availableVersions[0], out var _latestRow))
                {
                    <RadzenCard Variant="Variant.Outlined" class="rz-mt-2 rz-p-2">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                            Changelog — @(_availableVersions[0])
                        </RadzenText>
                        @if (string.IsNullOrWhiteSpace(_latestRow.ChangelogMarkdown))
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                                <em>No changelog provided.</em>
                            </RadzenText>
                        }
                        else
                        {
                            <pre style="white-space:pre-wrap; font-family:var(--rz-mono-font-family,monospace); font-size:0.85em; max-height:240px; overflow-y:auto; margin:0;">
@_latestRow.ChangelogMarkdown
                            </pre>
                        }
                    </RadzenCard>
                }
            </RadzenCard>
        }

        @* ── Execution knobs (M14) ────────────────────────────────────────── *@
        @* Gated by:
           1. The ui.show-advanced-step-fields feature toggle (M13.F.5)
              — typical operators stick with defaults; sysadmins flip
              the flag on.
           2. Host.SupportsExecutionKnobs — runbook step entities don't
              carry the M14 fields at all, so the card hides regardless
              of the feature toggle when the host is the runbook editor. *@
        @if (_showAdvancedFields && (Host?.SupportsExecutionKnobs ?? true))
        {
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                        Execution
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Per-step run condition, retry policy, timeout, and parallel
                        execution. These mirror Octopus's Process Editor knobs.
                    </RadzenText>

                    @* ── Start Trigger ───────────────────────────────────── *@
                    <RadzenFormField Text="Start Trigger" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenRadioButtonList @bind-Value="_startTrigger"
                                               TValue="StepStartTrigger"
                                               Orientation="Orientation.Vertical">
                            <Items>
                                <RadzenRadioButtonListItem
                                    Text="Wait for all previous steps to complete, then start"
                                    Value="StepStartTrigger.StartAfterPrevious" />
                                <RadzenRadioButtonListItem
                                    Text="Run in parallel with the previous step"
                                    Value="StepStartTrigger.StartWithPrevious" />
                            </Items>
                        </RadzenRadioButtonList>
                    </RadzenFormField>

                    @* ── Run Condition ───────────────────────────────────── *@
                    <RadzenFormField Text="Run Condition" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenRadioButtonList @bind-Value="_condition"
                                               TValue="StepCondition"
                                               Orientation="Orientation.Vertical">
                            <Items>
                                <RadzenRadioButtonListItem
                                    Text="@_successConditionLabel"
                                    Value="StepCondition.Success" />
                                @if (!_isFirstStep)
                                {
                                    <RadzenRadioButtonListItem
                                        Text="Failure: only run when previous steps fail"
                                        Value="StepCondition.Failure" />
                                }
                                <RadzenRadioButtonListItem
                                    Text="Always run"
                                    Value="StepCondition.Always" />
                                <RadzenRadioButtonListItem
                                    Text="Variable: only run when the variable expression is true"
                                    Value="StepCondition.Variable" />
                            </Items>
                        </RadzenRadioButtonList>
                    </RadzenFormField>

                    @* Condition=Variable → show the expression input. The
                       orchestrator evaluates it via Octostache and treats
                       truthy ("true"/"1" case-insensitive) as "run". *@
                    @if (_condition == StepCondition.Variable)
                    {
                        <RadzenFormField Text="Condition expression" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_conditionVariableExpression"
                                           Style="width:100%"
                                           Placeholder="#{Octopus.Environment.Name == &quot;Production&quot;}" />
                        </RadzenFormField>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            Octostache expression. Truthy values: <code>true</code>,
                            <code>1</code> (case-insensitive). Falsy / unresolved
                            (referenced variable missing) skips the step.
                        </RadzenText>
                    }

                    @* Warn when a Failure-conditioned step ended up first — the
                       orchestrator will never run it. Operator hint to fix. *@
                    @if (_isFirstStep && _condition == StepCondition.Failure)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat"
                                     Shade="Shade.Lighter" AllowClose="false" Icon="warning">
                            This step has Condition=Failure but is now first in the
                            process — it will never run. Change to Success or Always,
                            or move it later in the process.
                        </RadzenAlert>
                    }

                    @* ── Required ───────────────────────────────────────── *@
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenSwitch @bind-Value="_required" />
                        <RadzenStack Gap="0.1rem">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                <strong>Required</strong>
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                                When on, a step failure aborts the deployment. When
                                off, the deployment continues but ends with
                                <code>SucceededWithWarnings</code> status.
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>

                    @* ── Retries + Timeout ──────────────────────────────── *@
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                        <RadzenFormField Text="Max retries" Variant="Variant.Outlined" Style="flex:1;">
                            <RadzenNumeric @bind-Value="_maxRetries"
                                           Min="0" Max="20" Step="1"
                                           TValue="int" />
                        </RadzenFormField>
                        <RadzenFormField Text="Retry delay (seconds)" Variant="Variant.Outlined" Style="flex:1;">
                            <RadzenNumeric @bind-Value="_retryDelaySeconds"
                                           Min="0" Max="3600" Step="5"
                                           TValue="int" />
                        </RadzenFormField>
                        <RadzenFormField Text="Timeout (seconds)" Variant="Variant.Outlined" Style="flex:1;">
                            <RadzenNumeric @bind-Value="_timeoutSeconds"
                                           Min="0" Max="86400" Step="60"
                                           TValue="int" />
                        </RadzenFormField>
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Retries = 0 disables. Timeout = 0 means unlimited. Server
                        kills the step + treats as failure on timeout (subject to
                        the Required flag).
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        }

        @* M15 — Step Group body: optional ForEach panel.
           Renders ONLY when the step is a Kraken.StepGroup; the schema-
           driven body below is suppressed for groups. *@
        @if (_isStepGroup)
        {
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                        Loop body over collection
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Turn this Step Group into a ForEach loop. Each iteration
                        re-emits every child step with <code>#{item}</code> +
                        <code>#{index}</code> bound to the current value. Leave
                        the collection blank to keep it a plain container.
                    </RadzenText>

                    <RadzenFormField Text="Collection variable name"
                                     Variant="Variant.Outlined" Style="width:100%">
                        @* M15 follow-up — autocomplete over the project's
                           StringArray variables. Operators pick a known
                           array OR type a template expression (e.g.
                           "#{env}-instances") for nested-ForEach lazy
                           resolution. Free-text always accepted; missing
                           names are caught at deployment dispatch via
                           Deployment.ForEachUnresolved. *@
                        <RadzenAutoComplete @bind-Value="_foreachCollection"
                                            Data="@_arrayVariableNames"
                                            Style="width:100%"
                                            Placeholder="@AutocompletePlaceholder" />
                    </RadzenFormField>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Pick a <code>StringArray</code> project variable, or type a
                        template expression (e.g. <code>#{env}-instances</code>)
                        for nested ForEach. Missing names fail the deployment
                        with a <code>Deployment.ForEachUnresolved</code> audit.
                    </RadzenText>

                    @* M-RollingDeployments Phase 2 — rolling-window cap.
                       Lives inside the Step Group card alongside ForEach
                       because both are step-group-scoped properties. Empty
                       input = no cap (the resolver treats null / <=0 /
                       garbage as "no batching" so a typo can't accidentally
                       serialise the deployment to one-at-a-time). *@
                    <RadzenStack Gap="0.25rem">
                        <RadzenFormField Text="Max parallelism (rolling window)"
                                         Variant="Variant.Outlined" Style="width:100%">
                            <RadzenNumeric @bind-Value="_maxParallelism"
                                           TValue="int?"
                                           Min="1" Max="1000"
                                           Placeholder="No cap"
                                           Style="width:100%" />
                        </RadzenFormField>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            When set, the orchestrator dispatches each
                            target-side wave inside this group to at most
                            this many targets at a time; subsequent batches
                            run after each batch settles (concurrency cap,
                            not full Octopus canary semantics — a Required
                            failure inside a batch stops later batches).
                            Blank / 0 = fan out to every target at once
                            (Phase 1b default).
                        </RadzenText>
                    </RadzenStack>

                    @if (!string.IsNullOrWhiteSpace(_foreachCollection))
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                            <RadzenFormField Text="Iteration variable name"
                                             Variant="Variant.Outlined" Style="flex:1;">
                                <RadzenTextBox @bind-Value="_foreachIterationVariable"
                                               Placeholder="item" />
                            </RadzenFormField>
                            <RadzenFormField Text="Index variable name"
                                             Variant="Variant.Outlined" Style="flex:1;">
                                <RadzenTextBox @bind-Value="_foreachIndexVariable"
                                               Placeholder="index" />
                            </RadzenFormField>
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenSwitch @bind-Value="_foreachParallel" />
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                    <strong>Iterations run in parallel</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption"
                                            class="rz-color-secondary">
                                    All iterations dispatch together as one wave.
                                    Last-writer-wins applies if two iterations
                                    write the same output variable — use unique
                                    names per iteration.
                                </RadzenText>
                            </RadzenStack>
                        </RadzenStack>

                        @if (_foreachParallel)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info"
                                         Variant="Variant.Flat" Shade="Shade.Lighter"
                                         AllowClose="false">
                                Parallel iterations may produce variable
                                collisions. Use unique output variable names
                                per iteration; an audit row fires for any
                                collision (deployment status stays Succeeded).
                            </RadzenAlert>
                        }
                    }
                </RadzenStack>
            </RadzenCard>
        }

        @* M15 — Parent step dropdown (Edit path only). Lets the operator
           reparent an existing step to another Step Group (or back to
           top-level via the "None" option). Add path uses the picker's
           pre-fill via the ParentStepId parameter; no in-dialog dropdown. *@
        @if (_isEdit && _availableParents.Count > 0)
        {
            <RadzenCard>
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                        Parent step
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Move this step into a Step Group's children list, or
                        back to top-level. The step's own descendants are
                        hidden from the choices to prevent cycles.
                    </RadzenText>
                    <RadzenDropDown @bind-Value="_selectedParentStepId"
                                    TValue="Guid?"
                                    Data="@ParentOptions"
                                    TextProperty="Label"
                                    ValueProperty="Value"
                                    AllowClear="false"
                                    Style="width:100%" />
                </RadzenStack>
            </RadzenCard>
        }

        @* ── Schema-driven config body ────────────────────────────────────── *@
        @if (!_isStepGroup)
        {
            <StepUiSchemaForm Schema="@_schema" Values="@_values" />
        }

        @* ── M11.D.3 — Explain a field (process assistant) ─────────────────
           Spec called for a per-field AI icon; the schema body is rendered
           by a manual RenderTreeBuilder in StepUiSchemaForm, so a single
           field-picker block here delivers the same capability without
           threading icons through that builder. Shown only when the
           per-Space assistant is enabled and the step has schema fields. *@
        @if (_assistantEnabled && !_isStepGroup && _schema is not null && _schema.Properties.Count > 0)
        {
            <RadzenCard>
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                 AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="help" />
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                            Explain a field
                        </RadzenText>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                 AlignItems="AlignItems.Center">
                        <RadzenDropDown @bind-Value="_explainFieldKey"
                                        Data="@_schema.Properties.Keys"
                                        AllowClear="false" Style="flex:1;"
                                        Placeholder="Pick a field…" />
                        <RadzenButton Text="Explain" Icon="auto_awesome"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      IsBusy="@_explainBusy"
                                      Disabled="@string.IsNullOrEmpty(_explainFieldKey)"
                                      Click="@ExplainFieldAsync" />
                    </RadzenStack>
                    @if (!string.IsNullOrWhiteSpace(_explainText))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat"
                                     Shade="Shade.Lighter" AllowClose="false" class="rz-mb-0">
                            @_explainText
                        </RadzenAlert>
                    }
                </RadzenStack>
            </RadzenCard>
        }

        @* ── Referenced packages grid — script types only ─────────────────── *@
        @if (IsScriptStepType(_stepType))
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.Subtitle1">Referenced packages</RadzenText>
                    <RadzenButton Icon="add_circle_outline" Size="ButtonSize.ExtraSmall"
                                  Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                  Text="Add" Click="@AddReferencedPackage" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-2">
                    Extra packages this step depends on. Each is extracted to
                    <code>refs/&lt;Name&gt;/</code> and surfaced as
                    <code>$OctopusParameters["Octopus.Action.Package[Name].ExtractedPath"]</code>.
                    Version blank = latest at dispatch time.
                </RadzenText>
                @if (_referencedPackages.Count > 0)
                {
                    <table style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Name</th>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Package ID</th>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Version</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _referencedPackages.Count; i++)
                            {
                                var idx = i;
                                <tr>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_referencedPackages[idx].Name"
                                                       Placeholder="helper" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_referencedPackages[idx].PackageId"
                                                       Placeholder="MyHelperLib" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_referencedPackages[idx].Version"
                                                       Placeholder="(latest)" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall"
                                                      Variant="Variant.Text"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Click="@(() => _referencedPackages.RemoveAt(idx))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </RadzenCard>
        }

        @* ── M11.D.2 — script assistant (streaming) ────────────────────────
           Script step types only, and only when the per-Space assistant is
           enabled. Explicit "Generate" rather than debounced-on-keystroke —
           predictable + no wasted LLM calls per keystroke. Streams the
           model's response chunk-by-chunk; "Use as script body" drops the
           result into the script field. *@
        @if (_assistantEnabled && IsScriptStepType(_stepType))
        {
            <RadzenCard>
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                 AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="auto_awesome" />
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                            Script assistant
                        </RadzenText>
                    </RadzenStack>
                    <RadzenFormField Text="Describe what the script should do"
                                     Variant="Variant.Outlined" Style="width:100%">
                        <RadzenTextArea @bind-Value="_scriptRequest" Rows="2" Style="width:100%"
                                        Placeholder="e.g. stop the Argosy service, back up its config, then restart it" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="Generate" Icon="auto_awesome"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      IsBusy="@_scriptBusy"
                                      Disabled="@string.IsNullOrWhiteSpace(_scriptRequest)"
                                      Click="@GenerateScriptAsync" />
                        @if (!string.IsNullOrEmpty(_scriptSuggestion) && !_scriptBusy)
                        {
                            <RadzenButton Text="Use as script body" Icon="content_paste_go"
                                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@UseSuggestedScript" />
                        }
                    </RadzenStack>
                    @if (!string.IsNullOrEmpty(_scriptSuggestion))
                    {
                        <pre style="margin:0; white-space:pre-wrap; word-break:break-word;
                                    background:var(--surface-2); color:var(--text);
                                    border:1px solid var(--surface-3); padding:0.75rem;
                                    border-radius:4px; max-height:320px; overflow-y:auto;
                                    font-family:var(--rz-mono-font, monospace); font-size:0.85rem;">@_scriptSuggestion</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(_scriptError))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat"
                                     Shade="Shade.Lighter" AllowClose="false" class="rz-mb-0">
                            @_scriptError
                        </RadzenAlert>
                    }
                </RadzenStack>
            </RadzenCard>
        }

        @if (_errors.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" ShowIcon="true">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">
                    Please fix the following before saving:
                </RadzenText>
                <ul class="rz-mb-0">
                    @foreach (var msg in _errors) { <li>@msg</li> }
                </ul>
            </RadzenAlert>
        }

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                          Click="@(_ => Dialog.Close(false))" />
            <RadzenButton Text="@(_isEdit ? "Save" : "Add step")"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="save" Click="@OnSaveAsync" />
        </RadzenStack>
    </RadzenStack>
</div>

@code {
    /// <summary>
    /// M15 follow-up — the editing host. Routes save / lookup calls to
    /// the right service: process editor passes <see cref="ProcessService"/>,
    /// runbook editor passes <see cref="RunbookService"/>. Required.
    /// </summary>
    [Parameter] public IStepEditingHost? Host { get; set; }

    /// <summary>
    /// Required for Add: the container ID the step is added to. For the
    /// process editor this is the project id; for the runbook editor it's
    /// the runbook id. The host resolves the rest (project id for
    /// variable lookup, snapshot tree for parent dropdown, etc.).
    /// </summary>
    [Parameter] public Guid? ProjectId { get; set; }

    /// <summary>
    /// Required for Edit: the existing step row (a <see cref="ProcessStep"/>,
    /// which implements <see cref="IComposableStep"/>). Post schema-
    /// unification every step is a ProcessStep, so M14 execution-knob
    /// hydration applies to all steps.
    /// </summary>
    [Parameter] public IComposableStep? Step { get; set; }

    /// <summary>
    /// Optional. Add path with a template — the schema is derived from the
    /// template's parameters via <see cref="StepTemplateSchemaAdapter"/>.
    /// </summary>
    [Parameter] public StepTemplate? Template { get; set; }

    /// <summary>
    /// Optional. Add path without a template — the schema is looked up by
    /// step type in <see cref="BuiltInStepSchemas"/>. Used for blank
    /// "Run a Script" and any future built-in step type added directly.
    /// </summary>
    [Parameter] public string? ActionType { get; set; }

    /// <summary>
    /// M15 — Add path. When set, the new step is created as a child of
    /// the given Step Group. Ignored on Edit (use the in-dialog
    /// "Parent step" dropdown). Null = top-level step.
    /// </summary>
    [Parameter] public Guid? ParentStepId { get; set; }

    private string _name           = "";
    private string _packageId      = "";
    private string _targetRolesCsv = "";

    /// <summary>The flat config-bag values the schema renderer mutates.</summary>
    private readonly Dictionary<string, string> _values =
        new(StringComparer.Ordinal);
    /// <summary>Resolved per-step-type schema. Null = no schema available.</summary>
    private StepUiSchema? _schema;
    private string  _stepType      = "";
    private string? _resolveError;
    private bool _isEdit;
    private readonly List<PackageRefRow> _referencedPackages = [];
    private List<string> _errors = [];

    // ── Phase D-7: per-step package version pin ──────────────────────────
    /// <summary>The installed package that owns this step type (e.g. "kraken.iis").
    /// Empty/null = no step package claims the type — header card is hidden.</summary>
    private string? _stepPackageName;
    /// <summary>The currently-selected version in the dropdown. Bound two-way
    /// to the RadzenDropDown; persisted into the step on Save.</summary>
    private string? _stepPackageVersion;
    /// <summary>All installed versions of <see cref="_stepPackageName"/>,
    /// sorted highest semver first so index 0 is "latest installed".</summary>
    private List<string> _availableVersions = [];

    /// <summary>Indexed by version string so the dropdown's Change handler
    /// can look up the picked row's UiSchemaJson without an extra DB hit.
    /// Populated alongside <see cref="_availableVersions"/>.</summary>
    private Dictionary<string, StepPackage> _versionRows =
        new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// D-12.4: drives the expand-changelog toggle next to the "Update
    /// available" badge. Off by default so the dialog stays compact for
    /// users who don't care about release notes; on when the user clicks
    /// the description-icon button.
    /// </summary>
    private bool _changelogVisible;

    // ── M14 execution knobs (bound to the Execution card) ────────────────
    private StepCondition _condition = StepCondition.Success;
    private string? _conditionVariableExpression;
    private bool _required = true;
    private int _maxRetries;
    private int _retryDelaySeconds;
    private int _timeoutSeconds;
    private StepStartTrigger _startTrigger = StepStartTrigger.StartAfterPrevious;

    /// <summary>Gated by M13.F.5 <c>ui.show-advanced-step-fields</c>.
    /// Resolved in OnParametersSetAsync; defaults false so power-user
    /// knobs stay hidden for typical operators.</summary>
    private bool _showAdvancedFields;

    /// <summary>True when this step is first in the process (no prior
    /// siblings). Used to hide the Failure run-condition option (no
    /// prior step could have failed) and adjust the Success label.</summary>
    private bool _isFirstStep;

    /// <summary>Matches Octopus's first-step Success label variant. The
    /// non-first label drops the "(or is first step)" suffix.</summary>
    private string _successConditionLabel =>
        _isFirstStep
            ? "Success: only run when previous steps succeed (or is first step)"
            : "Success: only run when previous steps succeed";

    // ── M15 step composition (Step Group + ForEach + parent dropdown) ────
    /// <summary>True when this step is a Kraken.StepGroup — render the
    /// group-specific body (no schema, optional ForEach panel) instead of
    /// the schema-driven form.</summary>
    private bool _isStepGroup;
    /// <summary>The selected parent step on Edit. Mirrors Step.ParentStepId
    /// at load time; written back via ProcessService.UpdateParent on Save.
    /// Null = top-level (no parent).</summary>
    private Guid? _selectedParentStepId;
    /// <summary>Candidate parents for the "Parent step" dropdown — every
    /// Kraken.StepGroup in the same process EXCEPT the step's own
    /// descendants (filtered to prevent cycles). Loaded on Edit.
    /// Typed as <see cref="IComposableStep"/> so the dialog works for
    /// both deployment-process and runbook editors.</summary>
    private List<IComposableStep> _availableParents = [];
    /// <summary>ForEach collection variable name (binds to
    /// Octopus.Action.ForEach.Collection in Config). Empty = plain
    /// container.</summary>
    private string _foreachCollection = "";
    /// <summary>ForEach iteration variable name. Defaults to "item".</summary>
    private string _foreachIterationVariable = "item";
    /// <summary>ForEach index variable name. Defaults to "index".</summary>
    private string _foreachIndexVariable = "index";
    /// <summary>"Iterations run in parallel" checkbox. Sets
    /// Octopus.Action.ForEach.Parallel = "true" in Config.</summary>
    private bool _foreachParallel;

    // ── M11.D.3 — field-explanation assistant ────────────────────────────
    private bool _assistantEnabled;
    private string? _explainFieldKey;
    private string _explainText = "";
    private bool _explainBusy;
    // Per-dialog cache: explaining the same field twice doesn't re-call the LLM.
    private readonly Dictionary<string, string> _explainCache = new(StringComparer.Ordinal);

    // ── M11.D.2 — script assistant (streaming) ───────────────────────────
    private string _scriptRequest = "";
    private string _scriptSuggestion = "";
    private string _scriptError = "";
    private bool _scriptBusy;

    /// <summary>
    /// M-RollingDeployments Phase 2 — rolling-window cap on a
    /// <c>Kraken.StepGroup</c>. When set to a positive integer, the
    /// orchestrator batches the group's target-side waves to at most
    /// N targets at a time per wave; subsequent batches run after each
    /// batch settles. 0 / blank = no cap (the deployment's full target
    /// set fans out at once, Phase 1b behaviour).
    /// <para>
    /// Bound to a nullable int so the input distinguishes "not set"
    /// (blank field, no Config key) from "explicitly zero" (which is
    /// nonsense and treated as "no cap" by the resolver). Imported
    /// Octopus rolling-deployment steps land here verbatim.
    /// </para>
    /// </summary>
    private int? _maxParallelism;

    /// <summary>
    /// M15 follow-up — names of every <c>StringArray</c> variable in the
    /// project's variable set. Powers the autocomplete on the Collection
    /// field. Loaded once per dialog open via
    /// <see cref="VariableService.GetVariablesAsync"/> filtered to
    /// <c>Type == "StringArray"</c>. Empty if the project has no
    /// array variables defined yet — the autocomplete still accepts
    /// free-text (operators can type a templated expression like
    /// <c>#{env}-instances</c> for nested ForEach lazy resolution).
    /// </summary>
    private List<string> _arrayVariableNames = [];

    protected override async Task OnParametersSetAsync()
    {
        _isEdit = Step is not null;

        // M13.F.5: gate advanced Execution card on the feature flag.
        _showAdvancedFields = await FeatureFlags
            .IsEnabledAsync("ui.show-advanced-step-fields");

        // "First step" determination — used by the Run Condition picker
        // to hide the Failure option + adjust the Success label. On Edit,
        // SortOrder=0 means first. On Add, the new step goes to the end
        // of the list, so it's first iff the process is empty (we don't
        // load the existing step count here — the parent passes ProjectId
        // but not a "current step count", so we conservatively treat Add
        // as non-first unless explicitly first by SortOrder).
        _isFirstStep = Step?.SortOrder == 0;

        if (Step is not null)
        {
            // ── Edit path ───────────────────────────────────────────────────
            _stepType = Step.StepType;
            _name = Step.Name;
            _packageId = Step.PackageId;
            _targetRolesCsv = string.Join(", ", Step.TargetRoles);
            _stepPackageName    = Step.StepPackageName;
            _stepPackageVersion = Step.StepPackageVersion;

            // M14 — hydrate Execution knobs. All steps are now ProcessStep
            // (post schema-unification), so every step carries these fields;
            // the runbook editor still hides the Execution card entirely via
            // Host.SupportsExecutionKnobs.
            if (Step is ProcessStep dStep)
            {
                _condition                   = dStep.Condition;
                _conditionVariableExpression = dStep.ConditionVariableExpression;
                _required                    = dStep.Required;
                _maxRetries                  = dStep.MaxRetries;
                _retryDelaySeconds           = dStep.RetryDelaySeconds;
                _timeoutSeconds              = dStep.TimeoutSeconds;
                _startTrigger                = dStep.StartTrigger;
            }

            await LoadPackageVersionsAsync(Step.StepPackageName);

            _schema = await ResolveSchemaAsync(Step.StepType);

            // Seed _values from existing Step.Config (overlaying schema
            // defaults where Config has no entry yet).
            if (_schema is not null)
            {
                foreach (var (key, field) in _schema.Properties)
                {
                    _values[key] = Step.Config.TryGetValue(key, out var v)
                        ? v
                        : (field.Default ?? string.Empty);
                }

                // D3 — RunOnServer is a typed column now, not a Config key, but it
                // is still authored via the schema checkbox. Seed the checkbox
                // value from the typed column so an edit round-trips it (the Config
                // no longer carries the key, so the loop above would have used the
                // schema default). On Save it is lifted back out of _values into
                // the execution knobs.
                if (_schema.Properties.ContainsKey(KrakenScriptConfigKeys.RunOnServer)
                    && Step is ProcessStep rosStep)
                {
                    _values[KrakenScriptConfigKeys.RunOnServer] =
                        rosStep.RunOnServer ? "true" : "false";
                }
            }

            // Preserve any pre-existing Config keys the schema doesn't know
            // about (legacy data, hand-edits) by keeping a parallel cache for
            // the Save merge.
            _extraConfigKeys = new(Step.Config.Where(kv =>
                _schema is null || !_schema.Properties.ContainsKey(kv.Key)),
                StringComparer.Ordinal);

            HydrateReferencedPackagesFromConfig(Step.Config);
        }
        else
        {
            // ── Add path ────────────────────────────────────────────────────
            if (Template is not null)
            {
                _stepType = Template.ActionType;
                _name = Template.Name;

                // Template's Properties seed the bag before the schema fields
                // overlay it. This carries any template-author defaults that
                // the schema doesn't include as a field default.
                foreach (var (k, v) in Template.Properties) { _values[k] = v; }

                _schema = StepTemplateSchemaAdapter.BuildSchema(Template);

                // Overlay schema defaults for keys without an existing value.
                foreach (var (key, field) in _schema.Properties)
                {
                    if (!_values.ContainsKey(key) && !string.IsNullOrEmpty(field.Default))
                    {
                        _values[key] = field.Default!;
                    }
                }
            }
            else if (!string.IsNullOrWhiteSpace(ActionType))
            {
                _stepType = ActionType;
                _schema   = await ResolveSchemaAsync(ActionType);

                if (_schema is not null)
                {
                    foreach (var (key, field) in _schema.Properties)
                    {
                        _values[key] = field.Default ?? string.Empty;
                    }
                }
            }

            // Auto-pin the latest installed step-package version for the
            // chosen step type. Mirrors what ProcessService.AddStepAsync's
            // server-side auto-resolve does — surfacing it here so the user
            // sees and can override the pick before save (D-7).
            if (!string.IsNullOrWhiteSpace(_stepType))
            {
                var pin = await StepPackageRes
                    .ResolveLatestForStepTypeAsync(_stepType);
                if (pin is not null)
                {
                    _stepPackageName    = pin.Name;
                    _stepPackageVersion = pin.Version;
                    await LoadPackageVersionsAsync(pin.Name);
                }
            }
        }

        // ── M15 hydration ───────────────────────────────────────────────
        _isStepGroup = string.Equals(_stepType, "Kraken.StepGroup",
            StringComparison.OrdinalIgnoreCase);

        if (_isStepGroup)
        {
            // D3 — the loop collection, parallel flag, and rolling-window cap are
            // typed columns now; hydrate them from the entity (Edit path) or leave
            // at defaults (Add path). ForEach.IterationVariable / .IndexVariable
            // stay in Config (out of D3 scope).
            var sourceConfig = Step?.Config ?? new Dictionary<string, string>();
            if (Step is ProcessStep groupStep)
            {
                _foreachCollection = groupStep.ForEachCollection ?? "";
                _foreachParallel   = groupStep.ForEachParallel;
                _maxParallelism    = groupStep.MaxParallelism is > 0 ? groupStep.MaxParallelism : null;
            }
            if (sourceConfig.TryGetValue("Octopus.Action.ForEach.IterationVariable", out var iter))
            {
                _foreachIterationVariable = iter;
            }
            if (sourceConfig.TryGetValue("Octopus.Action.ForEach.IndexVariable", out var idx))
            {
                _foreachIndexVariable = idx;
            }
        }

        // Add path: take ParentStepId from the picker's pre-fill.
        // Edit path: load it from the existing row + populate the
        // "Parent step" dropdown's candidate list.
        if (Step is not null)
        {
            _selectedParentStepId = Step.ParentStepId;
            await LoadAvailableParentsAsync(Step);
        }
        else
        {
            _selectedParentStepId = ParentStepId;
        }

        // M15 follow-up — load array variable names for the ForEach
        // collection autocomplete. Only needed when editing a Step Group
        // or adding one; everything else hides the panel. The host
        // resolves the project id (process editor: containerId IS the
        // project id; runbook editor: containerId is the runbook id +
        // walks via Runbook.ProjectId). Lookup tolerates a missing host
        // / project (no autocomplete suggestions; free-text still works).
        if (_isStepGroup && Host is not null)
        {
            var projectIdForVars = await Host.ResolveProjectIdAsync(
                containerId: ProjectId,
                processId:   Step?.ProcessId,
                ct:          default);
            if (projectIdForVars is not null)
            {
                var allVars = await VariableSvc
                    .GetVariablesAsync(projectIdForVars.Value);
                _arrayVariableNames = allVars
                    .Where(v => string.Equals(v.Type, "StringArray",
                                              StringComparison.OrdinalIgnoreCase))
                    .Select(v => v.Name)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
        }

        // M11.D.3 — show the field-explanation assistant only when the
        // per-Space process assistant is enabled. Fail-closed on error.
        try
        {
            var aiSettings = await AiSettingsSvc.GetAsync();
            _assistantEnabled = aiSettings.AssistantEnabled;
        }
        catch
        {
            _assistantEnabled = false;
        }
    }

    /// <summary>
    /// M11.D.3 — asks the process assistant to explain the selected step-
    /// config field. Caches per dialog session so re-picking the same field
    /// doesn't re-call the LLM. AI-unavailable surfaces inline.
    /// </summary>
    private async Task ExplainFieldAsync()
    {
        if (string.IsNullOrEmpty(_explainFieldKey) || _schema is null) { return; }

        if (_explainCache.TryGetValue(_explainFieldKey, out var cached))
        {
            _explainText = cached;
            return;
        }

        _explainBusy = true;
        _explainText = "";
        try
        {
            _schema.Properties.TryGetValue(_explainFieldKey, out var field);
            var text = await AssistantSvc.ExplainFieldAsync(
                _stepType, _explainFieldKey, field?.Label, field?.HelpText);
            _explainCache[_explainFieldKey] = text;
            _explainText = text;
        }
        catch (KrakenDeploy.Ai.KrakenAiDisabledException)
        {
            _explainText = "AI is disabled for this Space — enable a provider in Configuration → AI Settings.";
        }
        catch (KrakenDeploy.Ai.KrakenAiFeatureDisabledException)
        {
            _explainText = "The process assistant is disabled — enable it in Configuration → AI Settings.";
        }
        catch (KrakenDeploy.Ai.KrakenAiBudgetExceededException ex)
        {
            _explainText = $"AI budget exceeded: {ex.Message}";
        }
        catch (Exception ex)
        {
            _explainText = $"Explanation failed: {ex.Message}";
        }
        finally
        {
            _explainBusy = false;
        }
    }

    /// <summary>
    /// M11.D.2 — streams a script suggestion from the assistant, appending
    /// each chunk to the output area for "typing" feedback. AI-unavailable
    /// surfaces inline.
    /// </summary>
    private async Task GenerateScriptAsync()
    {
        if (string.IsNullOrWhiteSpace(_scriptRequest)) { return; }
        _scriptBusy = true;
        _scriptSuggestion = "";
        _scriptError = "";
        try
        {
            var current = _values.GetValueOrDefault(KrakenScriptConfigKeys.ScriptBody);
            var contextNote = $"KrakenDeploy script step (type {_stepType}).";
            await foreach (var chunk in AssistantSvc.StreamScriptSuggestionAsync(
                _scriptRequest, current, contextNote))
            {
                _scriptSuggestion += chunk;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (KrakenDeploy.Ai.KrakenAiDisabledException)
        {
            _scriptError = "AI is disabled for this Space — enable a provider in Configuration → AI Settings.";
        }
        catch (KrakenDeploy.Ai.KrakenAiFeatureDisabledException)
        {
            _scriptError = "The process assistant is disabled — enable it in Configuration → AI Settings.";
        }
        catch (KrakenDeploy.Ai.KrakenAiBudgetExceededException ex)
        {
            _scriptError = $"AI budget exceeded: {ex.Message}";
        }
        catch (Exception ex)
        {
            _scriptError = $"Script generation failed: {ex.Message}";
        }
        finally
        {
            _scriptBusy = false;
        }
    }

    /// <summary>Drops the streamed suggestion into the script-body field so
    /// the schema form picks it up. The operator can still edit before save.</summary>
    private void UseSuggestedScript()
    {
        if (!string.IsNullOrEmpty(_scriptSuggestion))
        {
            _values[KrakenScriptConfigKeys.ScriptBody] = _scriptSuggestion;
        }
    }

    /// <summary>
    /// M15 — loads the list of candidate parents for the "Parent step"
    /// dropdown. Returns every Kraken.StepGroup in the same process
    /// EXCEPT the step's own descendants (DFS walk) so the user can't
    /// accidentally introduce a cycle. The defensive
    /// <see cref="ProcessValidator"/> catches the cycle case server-side
    /// too, but filtering up front gives a cleaner UX.
    ///
    /// <para>
    /// M15 follow-up: uses <see cref="IStepEditingHost.GetProcessStepsAsync"/>
    /// so the same logic works for runbook step composition.
    /// </para>
    /// </summary>
    private async Task LoadAvailableParentsAsync(IComposableStep editing)
    {
        if (Host is null)
        {
            _availableParents = [];
            return;
        }

        var siblings = await Host
            .GetProcessStepsAsync(editing.ProcessId, default);
        if (siblings.Count == 0)
        {
            _availableParents = [];
            return;
        }

        // Build the set of descendants (step itself + any descendant) to
        // exclude. DFS over ParentStepId chains.
        var descendants = new HashSet<Guid> { editing.Id };
        bool changed;
        do
        {
            changed = false;
            foreach (var s in siblings)
            {
                if (s.ParentStepId is { } p
                    && descendants.Contains(p)
                    && descendants.Add(s.Id))
                {
                    changed = true;
                }
            }
        } while (changed);

        _availableParents = siblings
            .Where(s => string.Equals(s.StepType, KrakenStepTypes.StepGroup,
                                      StringComparison.OrdinalIgnoreCase))
            .Where(s => !descendants.Contains(s.Id))
            .OrderBy(s => s.SortOrder)
            .ToList();
    }

    /// <summary>
    /// Populates <see cref="_availableVersions"/> with every installed
    /// version of <paramref name="packageName"/>, sorted highest semver
    /// first so the dropdown's first row is always "latest installed"
    /// and the "Update available" badge can compare against it cheaply.
    /// </summary>
    private async Task LoadPackageVersionsAsync(string? packageName)
    {
        if (string.IsNullOrWhiteSpace(packageName))
        {
            _availableVersions = [];
            _versionRows.Clear();
            return;
        }

        var rows = await StepPackageSvc.GetVersionsAsync(packageName);
        _availableVersions = StepPackageResolver.OrderByHighestSemver(rows.Select(r => r.Version));
        _versionRows = rows.ToDictionary(r => r.Version, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Handles the version dropdown's Change event (Phase D-7.2). Pulls the
    /// new version's per-version <c>UiSchemaJson</c> from the cached row
    /// and swaps it into the dialog's schema, carrying over any field values
    /// that exist in both the old and new schemas. Fields added in the new
    /// schema get their declared default. Fields dropped in the new schema
    /// fire a single toast naming each one — the value is lost on the next
    /// Save but the user has been warned.
    /// </summary>
    private async Task OnPickVersionAsync(string? newVersion)
    {
        if (string.IsNullOrWhiteSpace(newVersion)
            || string.Equals(newVersion, _stepPackageVersion, StringComparison.Ordinal))
        {
            return;
        }

        // Snapshot the current values BEFORE we swap the schema so we can
        // diff the property sets and decide what carries over.
        var previousValues = new Dictionary<string, string>(_values, StringComparer.Ordinal);
        var previousSchema = _schema;

        // Resolve the new schema. Prefer the row's per-version UiSchemaJson —
        // that's the canonical source for what this exact package version
        // expects. Fall back to BuiltInStepSchemas by step type only when
        // the row has no schema (legacy / pre-D-3 install).
        StepUiSchema? newSchema = null;
        if (_versionRows.TryGetValue(newVersion, out var row)
            && !string.IsNullOrWhiteSpace(row.UiSchemaJson))
        {
            try
            {
                newSchema = StepUiSchemaJson.Deserialize(row.UiSchemaJson);
            }
            catch (JsonException ex)
            {
                Notifications.Notify(NotificationSeverity.Error, "Schema parse failed",
                    $"Could not load {row.Name} {newVersion} ui-schema.json: {ex.Message}. " +
                    "Keeping the previous version selected.", 6000);
                return;
            }
        }

        // Either no per-version schema or it failed to load → fall back.
        newSchema ??= await ResolveSchemaAsync(_stepType);

        // Diff the property sets so we know what to carry over and what to
        // warn about. Schemas can be null when no built-in covers the step
        // type either — in that case we keep the values verbatim.
        if (newSchema is not null)
        {
            var droppedKeys = new List<string>();
            var rebuilt     = new Dictionary<string, string>(StringComparer.Ordinal);

            foreach (var (key, field) in newSchema.Properties)
            {
                rebuilt[key] = previousValues.TryGetValue(key, out var carried)
                    ? carried
                    : (field.Default ?? string.Empty);
            }

            if (previousSchema is not null)
            {
                foreach (var oldKey in previousSchema.Properties.Keys)
                {
                    if (!newSchema.Properties.ContainsKey(oldKey))
                    {
                        droppedKeys.Add(oldKey);
                    }
                }
            }

            // Drop the values for keys the new schema doesn't know about
            // from the in-memory bag. Keep the _extraConfigKeys cache (legacy
            // / hand-edited keys outside any schema) intact — those still
            // travel into the final Config on Save.
            _values.Clear();
            foreach (var (k, v) in rebuilt) { _values[k] = v; }

            if (droppedKeys.Count > 0)
            {
                Notifications.Notify(NotificationSeverity.Warning,
                    $"{droppedKeys.Count} field(s) dropped",
                    "These fields aren't in the new version's schema and will not be saved: "
                    + string.Join(", ", droppedKeys),
                    8000);
            }
        }

        _schema             = newSchema;
        _stepPackageVersion = newVersion;
        StateHasChanged();
    }

    private async Task<StepUiSchema?> ResolveSchemaAsync(string stepType)
    {
        // Built-in schemas first (covers Kraken.IIS, Kraken.Script,
        // Octopus.IIS, Octopus.TentaclePackage, Octopus.Manual, …).
        var built = BuiltInStepSchemas.GetForStepType(stepType);
        if (built is not null) { return built; }

        // Fall back to a community-library template's parameter schema.
        try
        {
            var all = await TemplateSvc.GetAllAsync();
            var match = all.FirstOrDefault(t =>
                t.ActionType.Equals(stepType, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                return StepTemplateSchemaAdapter.BuildSchema(match);
            }
        }
        catch (Exception ex)
        {
            _resolveError = $"Failed to look up step template: {ex.Message}";
            return null;
        }

        _resolveError =
            $"No built-in schema or step template matches step type '{stepType}'.";
        return null;
    }

    // ── Referenced packages helpers ─────────────────────────────────────────

    private static bool IsScriptStepType(string stepType)
        => stepType.Equals("Kraken.Script", StringComparison.OrdinalIgnoreCase)
        || stepType.Equals("Octopus.Script", StringComparison.OrdinalIgnoreCase);

    private void HydrateReferencedPackagesFromConfig(Dictionary<string, string> config)
    {
        if (!config.TryGetValue(KrakenScriptConfigKeys.PackageReferences, out var json)
            || string.IsNullOrWhiteSpace(json))
        {
            return;
        }
        try
        {
            var parsed = JsonSerializer.Deserialize<List<PackageReference>>(
                json, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (parsed is null) { return; }
            foreach (var r in parsed)
            {
                _referencedPackages.Add(new PackageRefRow
                {
                    Name      = r.Name      ?? "",
                    PackageId = r.PackageId ?? "",
                    Version   = r.Version   ?? "",
                });
            }
        }
        catch (JsonException)
        {
            // Tolerate malformed JSON — surface as an empty list.
        }
    }

    private void AddReferencedPackage()
        => _referencedPackages.Add(new PackageRefRow());

    // ── Save ────────────────────────────────────────────────────────────────

    private Dictionary<string, string> _extraConfigKeys = new(StringComparer.Ordinal);

    /// <summary>Permission required to persist — defaults to ProcessEdit for
    /// project processes; runbook step editing passes RunbookEdit.</summary>
    [Parameter] public Permission EditPermission { get; set; } = Permission.ProcessEdit;

    private async Task OnSaveAsync()
    {
        _errors = [];

        if (!await Guard.AllowAsync(EditPermission)) return;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errors.Add("Name is required.");
        }

        // M15 — Step Groups don't have a schema (they're a container).
        // Skip the schema-required guard + schema-validator pass; the
        // group form has its own minimal validation.
        if (!_isStepGroup)
        {
            if (_schema is null)
            {
                _errors.Add("No schema is available for this step type.");
                return;
            }

            // Schema validator — handles per-field required, enum membership,
            // length / pattern / numeric range.
            var snapshot = new Dictionary<string, string>(_values, StringComparer.Ordinal);
            var schemaErrors = StepUiSchemaValidator.Validate(_schema, snapshot);
            foreach (var e in schemaErrors)
            {
                _errors.Add(e.Message);
            }
        }

        if (_errors.Count > 0)
        {
            StateHasChanged();
            return;
        }

        // ── Build the final Config bag ──────────────────────────────────────
        // Order: extra (pre-existing keys the schema doesn't know about) +
        // schema values (latest user-entered) + referenced-packages JSON
        // (for script types). Later assignments win.
        var config = new Dictionary<string, string>(_extraConfigKeys, StringComparer.Ordinal);
        foreach (var (k, v) in _values) { config[k] = v; }

        // D3 — RunOnServer is authored via the schema checkbox (so it rides in
        // _values) but persists to a typed column, not Config. Lift it out here
        // and pass it through the execution knobs below.
        var runOnServer = config.TryGetValue(KrakenScriptConfigKeys.RunOnServer, out var rosVal)
            && string.Equals(rosVal?.Trim(), "true", StringComparison.OrdinalIgnoreCase);
        config.Remove(KrakenScriptConfigKeys.RunOnServer);

        // M15 / D3 — Step Group save path. The loop Collection, Parallel flag
        // and rolling MaxParallelism persist to TYPED COLUMNS (via the execution
        // knobs below), NOT Config. Only the ForEach Iteration/Index variable
        // NAMES remain Config strings (out of D3 scope), and only while the loop
        // is enabled.
        if (_isStepGroup)
        {
            if (!string.IsNullOrWhiteSpace(_foreachCollection))
            {
                config["Octopus.Action.ForEach.IterationVariable"] =
                    string.IsNullOrWhiteSpace(_foreachIterationVariable)
                        ? "item"
                        : _foreachIterationVariable.Trim();
                config["Octopus.Action.ForEach.IndexVariable"] =
                    string.IsNullOrWhiteSpace(_foreachIndexVariable)
                        ? "index"
                        : _foreachIndexVariable.Trim();
            }
            else
            {
                config.Remove("Octopus.Action.ForEach.IterationVariable");
                config.Remove("Octopus.Action.ForEach.IndexVariable");
            }

            // Defensive: never let the promoted keys linger in Config (e.g. a
            // pre-D3 hand-edit captured in _extraConfigKeys) — the columns own them.
            config.Remove("Octopus.Action.ForEach.Collection");
            config.Remove("Octopus.Action.ForEach.Parallel");
            config.Remove("Octopus.Action.MaxParallelism");
        }

        if (IsScriptStepType(_stepType))
        {
            var refs = _referencedPackages
                .Where(r => !string.IsNullOrWhiteSpace(r.Name)
                         && !string.IsNullOrWhiteSpace(r.PackageId))
                .Select(r => new PackageReference
                {
                    Name      = r.Name.Trim(),
                    PackageId = r.PackageId.Trim(),
                    Version   = string.IsNullOrWhiteSpace(r.Version) ? null : r.Version.Trim(),
                    Extract   = true,
                })
                .ToList();
            if (refs.Count > 0)
            {
                config[KrakenScriptConfigKeys.PackageReferences] = JsonSerializer.Serialize(
                    refs, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            }
            else
            {
                config.Remove(KrakenScriptConfigKeys.PackageReferences);
            }
        }

        var roles = ParseCsv(_targetRolesCsv);

        try
        {
            // M14: bundle the Execution-card values. When the advanced
            // fields card is hidden (toggle off) we still pass the knobs
            // — they're either the row's existing values (Edit) or the
            // defaults (Add), so the round-trip is non-destructive.
            var executionKnobs = new StepExecutionKnobs(
                Condition:                   _condition,
                ConditionVariableExpression: string.IsNullOrWhiteSpace(_conditionVariableExpression)
                                                ? null
                                                : _conditionVariableExpression.Trim(),
                Required:                    _required,
                MaxRetries:                  _maxRetries,
                RetryDelaySeconds:           _retryDelaySeconds,
                TimeoutSeconds:              _timeoutSeconds,
                StartTrigger:                _startTrigger,
                // D3 — RunOnServer on leaf steps; the three group flags only on a
                // Step Group (and ForEach.Parallel only when a collection is set).
                RunOnServer:                 runOnServer,
                MaxParallelism:              _isStepGroup && _maxParallelism is > 0
                                                ? _maxParallelism
                                                : null,
                ForEachCollection:           _isStepGroup && !string.IsNullOrWhiteSpace(_foreachCollection)
                                                ? _foreachCollection.Trim()
                                                : null,
                ForEachParallel:             _isStepGroup && _foreachParallel
                                                && !string.IsNullOrWhiteSpace(_foreachCollection));

            if (Host is null)
            {
                _errors.Add("Missing editing host — cannot save the step.");
                StateHasChanged();
                return;
            }

            if (_isEdit && Step is not null)
            {
                // D-7: pass the explicit pin pair if the user picked a non-null
                // pair. If both are null, UpdateStepAsync keeps whatever pin
                // already lived on the row — never clears a pin from this UI.
                //
                // M15: only pass UpdateParent when the user actually picked a
                // different parent. Same-parent saves leave the FK untouched
                // to avoid spurious modified rows + audit churn.
                var parentUpdate = _selectedParentStepId != Step.ParentStepId
                    ? UpdateParent.To(_selectedParentStepId)
                    : null;
                await Host.UpdateStepAsync(
                    Step.Id, _name, _packageId, roles, config,
                    _stepPackageName, _stepPackageVersion,
                    executionKnobs,
                    parentUpdate,
                    await Guard.CurrentCallerAsync(),
                    default);
            }
            else
            {
                if (ProjectId is null)
                {
                    _errors.Add("Missing ProjectId — cannot create a step.");
                    StateHasChanged();
                    return;
                }
                // D-7: pass the auto-resolved (or user-picked) pin pair.
                // When _stepPackageName is null the host falls back to its
                // own auto-resolve via the StepPackageResolver — keeping the
                // contract honest.
                // M15: pass the picker's pre-filled parent so the new step
                // lands inside a Step Group when "+Add child" launched the form.
                await Host.AddStepAsync(
                    ProjectId.Value, _name, _stepType, _packageId, roles, config,
                    _stepPackageName, _stepPackageVersion,
                    executionKnobs,
                    parentStepId: _selectedParentStepId,
                    caller: await Guard.CurrentCallerAsync(),
                    ct: default);
            }
            Dialog.Close(true);
        }
        catch (ProcessValidationException ex)
        {
            // M15 — surface every validator error inline; the editor's
            // top-of-form banner renders them.
            foreach (var err in ex.Result.Errors)
            {
                _errors.Add(err.Message);
            }
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _errors.Add(ex.Message);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Save failed", ex.Message, 6000);
            _errors.Add(ex.Message);
            StateHasChanged();
        }
    }

    private static List<string> ParseCsv(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return []; }
        return [.. raw.Split(',',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
    }

    /// <summary>
    /// M15 — flattened list of choices for the "Parent step" dropdown.
    /// First entry is the "None" sentinel that puts the step back at
    /// top-level; subsequent entries are Kraken.StepGroup steps in
    /// SortOrder. The step's own descendants are filtered out by
    /// <see cref="LoadAvailableParentsAsync"/> upstream.
    /// </summary>
    private List<ParentOption> ParentOptions => [
        new ParentOption(null, "None (top-level)"),
        .. _availableParents.Select(g => new ParentOption(g.Id, g.Name)),
    ];

    private sealed record ParentOption(Guid? Value, string Label);

    /// <summary>
    /// M15 follow-up — placeholder text for the ForEach Collection
    /// autocomplete. Hints at available array vars when the project
    /// has any; falls back to a generic prompt otherwise.
    /// </summary>
    private string AutocompletePlaceholder => _arrayVariableNames.Count switch
    {
        0   => "e.g. envs (no array variables in this project yet — type a name or template)",
        1   => $"e.g. {_arrayVariableNames[0]}",
        _   => $"e.g. {_arrayVariableNames[0]} ({_arrayVariableNames.Count} array variables in this project)",
    };

    private sealed class PackageRefRow
    {
        public string Name { get; set; } = "";
        public string PackageId { get; set; } = "";
        public string Version { get; set; } = "";
    }
}
