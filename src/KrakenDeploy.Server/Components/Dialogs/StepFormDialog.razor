@using System.Text.Json
@using KrakenDeploy.Contracts.Steps
@using KrakenDeploy.Server.Core.Domain.Processes
@inject DialogService Dialog
@inject ProcessService ProcessSvc

@*
    Add / edit a deployment step. The only step type currently supported is
    Kraken.Script — fields here capture: Name, Package ID, Target Roles
    (comma-separated tags), and the script body + syntax that will run
    during deployment. Config keys are Octopus-compatible
    (Octopus.Action.Script.*) so processes import unchanged.

    To add: pass ProjectId; leave Step null.
    To edit: pass Step; ProjectId is ignored.
*@

<div style="min-width: 560px; padding: 0.25rem 0;">
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <div>
                <RadzenLabel Text="Name *" />
                <RadzenTextBox @bind-Value="_model.Name" Style="width:100%"
                               aria-label="Name" Placeholder="e.g. Deploy WebApp" />
                <ValidationMessage For="() => _model.Name" class="kraken-validation-error" />
            </div>

            <div>
                <RadzenLabel Text="Package ID *" />
                <RadzenTextBox @bind-Value="_model.PackageId" Style="width:100%"
                               aria-label="Package ID"
                               Placeholder="Logical package identifier (e.g. ArgosyBASE)" />
                <ValidationMessage For="() => _model.PackageId" class="kraken-validation-error" />
            </div>

            <div>
                <RadzenLabel Text="Target Roles" />
                <RadzenTextBox @bind-Value="_model.TargetRolesCsv" Style="width:100%"
                               aria-label="Target Roles"
                               Placeholder="Comma-separated, e.g. SERVER, TERMINAL, WORKSTATION" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    Only deployment targets whose roles overlap this list run the step.
                    Leave empty to run on every target.
                </RadzenText>
            </div>

            <div>
                <RadzenLabel Text="Execution Location" />
                <RadzenRadioButtonList @bind-Value="_model.RunOnServer" TValue="bool"
                                       Orientation="Orientation.Vertical">
                    <Items>
                        <RadzenRadioButtonListItem Text="Run on each deployment target" Value="false" />
                        <RadzenRadioButtonListItem Text="Run on the KrakenDeploy Server" Value="true" />
                    </Items>
                </RadzenRadioButtonList>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    Server execution runs the script in the server process —
                    useful for steps that talk to external APIs (Slack, JIRA, …)
                    or perform pre/post deployment work without needing a target.
                    Set Target Roles on a server step to act on behalf of the
                    deployment target (Octopus's "Server on behalf of each
                    deployment target" mode).
                </RadzenText>
            </div>

            <div>
                <RadzenLabel Text="Script Syntax" />
                <RadzenDropDown @bind-Value="_model.ScriptSyntax"
                                Data="@_syntaxOptions"
                                Style="width: 200px" />
            </div>

            <div>
                <RadzenLabel Text="Script Body" />
                <RadzenTextArea @bind-Value="_model.ScriptBody"
                                Rows="10" Style="width:100%; font-family: var(--rz-mono-font, monospace);"
                                aria-label="Script Body"
                                Placeholder="# Script that runs on the target during deployment" />
            </div>

            <div>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             AlignItems="AlignItems.Center" class="rz-mb-1">
                    <RadzenLabel Text="Referenced Packages" />
                    <RadzenButton Icon="add_circle_outline" Size="ButtonSize.ExtraSmall"
                                  Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                  Text="Add" Click="@AddReferencedPackage" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                    Extra packages this step depends on. Each is extracted to
                    <code>refs/&lt;Name&gt;/</code> and surfaced as
                    <code>$OctopusParameters["Octopus.Action.Package[Name].ExtractedPath"]</code>
                    + <code>OCTOPUS_REFERENCED_PACKAGE_&lt;NAME&gt;_PATH</code>.
                    Version blank = latest at dispatch time.
                </RadzenText>
                @if (_model.ReferencedPackages.Count > 0)
                {
                    <table style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Name</th>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Package ID</th>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Version</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _model.ReferencedPackages.Count; i++)
                            {
                                var idx = i;
                                <tr>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_model.ReferencedPackages[idx].Name"
                                                       Placeholder="helper" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_model.ReferencedPackages[idx].PackageId"
                                                       Placeholder="MyHelperLib" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_model.ReferencedPackages[idx].Version"
                                                       Placeholder="(latest)" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall"
                                                      Variant="Variant.Text"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Click="@(() => _model.ReferencedPackages.RemoveAt(idx))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (_errorMessage is not null)
            {
                <div class="kraken-login-error rz-text-body2">@_errorMessage</div>
            }

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => Dialog.Close(false))" />
                <RadzenButton Text="Save" ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>
    </EditForm>
</div>

@code {
    [Parameter] public Guid? ProjectId { get; set; }
    [Parameter] public DeploymentStep? Step { get; set; }

    private readonly FormModel _model = new();
    private string? _errorMessage;
    private bool _isEdit;
    private readonly string[] _syntaxOptions = ["PowerShell", "Bash"];

    protected override void OnParametersSet()
    {
        if (Step is not null)
        {
            _isEdit = true;
            _model.Name = Step.Name;
            _model.PackageId = Step.PackageId;
            _model.TargetRolesCsv = string.Join(", ", Step.TargetRoles);
            _model.ScriptSyntax = Step.Config.GetValueOrDefault("Octopus.Action.Script.Syntax", "PowerShell");
            _model.ScriptBody = Step.Config.GetValueOrDefault("Octopus.Action.Script.ScriptBody", "");
            _model.RunOnServer = string.Equals(
                Step.Config.GetValueOrDefault("Octopus.Action.RunOnServer"),
                "true", StringComparison.OrdinalIgnoreCase);

            // Parse the referenced-packages JSON back into form rows.
            if (Step.Config.TryGetValue(KrakenScriptConfigKeys.PackageReferences, out var refsJson)
                && !string.IsNullOrWhiteSpace(refsJson))
            {
                try
                {
                    var parsed = JsonSerializer.Deserialize<List<PackageReference>>(refsJson,
                        new JsonSerializerOptions(JsonSerializerDefaults.Web));
                    if (parsed is not null)
                    {
                        _model.ReferencedPackages = [..
                            parsed.Select(r => new PackageRefRow
                            {
                                Name      = r.Name ?? "",
                                PackageId = r.PackageId ?? "",
                                Version   = r.Version ?? "",
                            })];
                    }
                }
                catch (JsonException)
                {
                    // Tolerate malformed JSON — surface as an empty list.
                }
            }
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        try
        {
            var roles = ParseCsv(_model.TargetRolesCsv);
            var config = new Dictionary<string, string>
            {
                ["Octopus.Action.Script.Syntax"]     = _model.ScriptSyntax,
                ["Octopus.Action.Script.ScriptBody"] = _model.ScriptBody ?? "",
                ["Octopus.Action.RunOnServer"]       = _model.RunOnServer ? "true" : "false",
            };

            // Serialise the referenced-packages grid back to JSON, dropping empty rows.
            var refs = _model.ReferencedPackages
                .Where(r => !string.IsNullOrWhiteSpace(r.Name)
                         && !string.IsNullOrWhiteSpace(r.PackageId))
                .Select(r => new PackageReference
                {
                    Name      = r.Name.Trim(),
                    PackageId = r.PackageId.Trim(),
                    Version   = string.IsNullOrWhiteSpace(r.Version) ? null : r.Version.Trim(),
                    Extract   = true,
                })
                .ToList();

            if (refs.Count > 0)
            {
                config[KrakenScriptConfigKeys.PackageReferences] = JsonSerializer.Serialize(refs,
                    new JsonSerializerOptions(JsonSerializerDefaults.Web));
            }

            if (_isEdit)
            {
                await ProcessSvc.UpdateStepAsync(
                    Step!.Id, _model.Name, _model.PackageId, roles, config);
            }
            else
            {
                if (ProjectId is null)
                {
                    _errorMessage = "Missing ProjectId — cannot create a step.";
                    return;
                }

                await ProcessSvc.AddStepAsync(
                    ProjectId.Value, _model.Name, "Kraken.Script",
                    _model.PackageId, roles, config);
            }

            Dialog.Close(true);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private static List<string> ParseCsv(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return [];
        }
        return raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                  .ToList();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string PackageId { get; set; } = "";

        public string TargetRolesCsv { get; set; } = "";
        public string ScriptSyntax { get; set; } = "PowerShell";
        public string? ScriptBody { get; set; }
        public bool RunOnServer { get; set; }
        public List<PackageRefRow> ReferencedPackages { get; set; } = [];
    }

    private sealed class PackageRefRow
    {
        public string Name { get; set; } = "";
        public string PackageId { get; set; } = "";
        public string Version { get; set; } = "";
    }

    private void AddReferencedPackage()
        => _model.ReferencedPackages.Add(new PackageRefRow());
}
