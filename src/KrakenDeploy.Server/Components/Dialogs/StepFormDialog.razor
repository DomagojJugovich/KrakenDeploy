@using System.Text.Json
@using KrakenDeploy.Contracts.Steps
@using KrakenDeploy.Server.Components.Shared
@using KrakenDeploy.Server.Core.Domain.Processes
@using KrakenDeploy.Server.Core.Domain.StepPackages
@using KrakenDeploy.Server.Core.Domain.StepTemplates
@using KrakenDeploy.Server.Data.Services

@inject DialogService Dialog
@inject ProcessService ProcessSvc
@inject StepTemplateService TemplateSvc
@inject StepPackageService StepPackageSvc
@inject StepPackageResolver StepPackageRes
@inject NotificationService Notifications
@inject FeatureFlagService FeatureFlags

@*
    Unified step add/edit dialog. Replaces the legacy script-only StepFormDialog
    and TemplatedStepFormDialog with one schema-driven flow.

    Inputs (use ONE of):
      Add a new step:
        ProjectId + Template      — schema derived from template parameters
        ProjectId + ActionType    — schema looked up in BuiltInStepSchemas
                                     (also the blank "Run a Script" path —
                                      pass "Kraken.Script")
      Edit an existing step:
        Step                      — schema resolved from BuiltInStepSchemas
                                     first; falls back to the matching
                                     template by ActionType.

    Renders:
      - Common Step columns (Name, Package ID, Target Roles) as chrome.
      - Schema-driven body via <StepUiSchemaForm /> for the Config bag.
      - Conditional referenced-packages grid for script step types
        (Kraken.Script / Octopus.Script) since that's a structured list
        the v1 schema vocabulary doesn't yet model as a widget.

    Save flow:
      - Schema validator runs on the snapshot; errors show inline + block close.
      - Common-field validation: Name + PackageId required.
      - Persist via ProcessService.AddStepAsync / UpdateStepAsync.
*@

<div style="min-width:640px; padding:0.25rem 0;">
    <RadzenStack Gap="1rem">

        @if (_schema is null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">
                    No schema available for this step type.
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    @(_resolveError ?? "Step type is missing both a built-in schema and a matching step template.")
                </RadzenText>
            </RadzenAlert>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => Dialog.Close(false))" />
            </RadzenStack>
            return;
        }

        @* ── Common Step columns ─────────────────────────────────────────── *@
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">Step</RadzenText>
            <RadzenStack Gap="0.75rem">
                <RadzenFormField Text="Name" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_name" Style="width:100%"
                                   Placeholder="e.g. Deploy WebApp" />
                </RadzenFormField>

                <RadzenFormField Text="Package ID" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_packageId" Style="width:100%"
                                   Placeholder="Logical package identifier (optional for some step types)" />
                </RadzenFormField>

                <RadzenFormField Text="Target roles" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_targetRolesCsv" Style="width:100%"
                                   Placeholder="Comma-separated, e.g. SERVER, TERMINAL" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    Only deployment targets whose roles overlap this list run the step.
                    Leave empty to run on every target.
                </RadzenText>
            </RadzenStack>
        </RadzenCard>

        @* ── Step-package version pin (Phase D-7) ─────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(_stepPackageName))
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="extension" />
                    <RadzenStack Gap="0.1rem" Style="flex:1;">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                            Step package
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            <code>@_stepPackageName</code>
                        </RadzenText>
                    </RadzenStack>
                    <RadzenFormField Text="Version" Variant="Variant.Outlined">
                        <RadzenDropDown TValue="string"
                                        Data="@_availableVersions"
                                        Value="@_stepPackageVersion"
                                        Change="@(v => OnPickVersionAsync(v as string))"
                                        Style="min-width:140px;" />
                    </RadzenFormField>
                    @if (_stepPackageVersion is not null
                         && _availableVersions.Count > 0
                         && _stepPackageVersion != _availableVersions[0])
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" IsPill="true"
                                         Text="@($"Update: {_availableVersions[0]}")"
                                         title="A newer version of this step package is installed." />
                            <RadzenButton Icon="@(_changelogVisible ? "expand_less" : "description")"
                                          Size="ButtonSize.ExtraSmall"
                                          Variant="Variant.Text"
                                          ButtonStyle="ButtonStyle.Light"
                                          title="@(_changelogVisible ? "Hide changelog" : "Show changelog")"
                                          Click="@(() => _changelogVisible = !_changelogVisible)" />
                        </RadzenStack>
                    }
                </RadzenStack>

                @* ── Phase D-12.4: changelog for the latest installed version ── *@
                @if (_changelogVisible
                     && _availableVersions.Count > 0
                     && _versionRows.TryGetValue(_availableVersions[0], out var _latestRow))
                {
                    <RadzenCard Variant="Variant.Outlined" class="rz-mt-2 rz-p-2">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                            Changelog — @(_availableVersions[0])
                        </RadzenText>
                        @if (string.IsNullOrWhiteSpace(_latestRow.ChangelogMarkdown))
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                                <em>No changelog provided.</em>
                            </RadzenText>
                        }
                        else
                        {
                            <pre style="white-space:pre-wrap; font-family:var(--rz-mono-font-family,monospace); font-size:0.85em; max-height:240px; overflow-y:auto; margin:0;">
@_latestRow.ChangelogMarkdown
                            </pre>
                        }
                    </RadzenCard>
                }
            </RadzenCard>
        }

        @* ── Execution knobs (M14) ────────────────────────────────────────── *@
        @* Gated by the ui.show-advanced-step-fields feature toggle (M13.F.5)
           — typical operators stick with defaults; sysadmins flip the flag on. *@
        @if (_showAdvancedFields)
        {
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                        Execution
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Per-step run condition, retry policy, timeout, and parallel
                        execution. These mirror Octopus's Process Editor knobs.
                    </RadzenText>

                    @* ── Start Trigger ───────────────────────────────────── *@
                    <RadzenFormField Text="Start Trigger" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenRadioButtonList @bind-Value="_startTrigger"
                                               TValue="StepStartTrigger"
                                               Orientation="Orientation.Vertical">
                            <Items>
                                <RadzenRadioButtonListItem
                                    Text="Wait for all previous steps to complete, then start"
                                    Value="StepStartTrigger.StartAfterPrevious" />
                                <RadzenRadioButtonListItem
                                    Text="Run in parallel with the previous step"
                                    Value="StepStartTrigger.StartWithPrevious" />
                            </Items>
                        </RadzenRadioButtonList>
                    </RadzenFormField>

                    @* ── Run Condition ───────────────────────────────────── *@
                    <RadzenFormField Text="Run Condition" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenRadioButtonList @bind-Value="_condition"
                                               TValue="StepCondition"
                                               Orientation="Orientation.Vertical">
                            <Items>
                                <RadzenRadioButtonListItem
                                    Text="@_successConditionLabel"
                                    Value="StepCondition.Success" />
                                @if (!_isFirstStep)
                                {
                                    <RadzenRadioButtonListItem
                                        Text="Failure: only run when previous steps fail"
                                        Value="StepCondition.Failure" />
                                }
                                <RadzenRadioButtonListItem
                                    Text="Always run"
                                    Value="StepCondition.Always" />
                                <RadzenRadioButtonListItem
                                    Text="Variable: only run when the variable expression is true"
                                    Value="StepCondition.Variable" />
                            </Items>
                        </RadzenRadioButtonList>
                    </RadzenFormField>

                    @* Condition=Variable → show the expression input. The
                       orchestrator evaluates it via Octostache and treats
                       truthy ("true"/"1" case-insensitive) as "run". *@
                    @if (_condition == StepCondition.Variable)
                    {
                        <RadzenFormField Text="Condition expression" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_conditionVariableExpression"
                                           Style="width:100%"
                                           Placeholder="#{Octopus.Environment.Name == &quot;Production&quot;}" />
                        </RadzenFormField>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            Octostache expression. Truthy values: <code>true</code>,
                            <code>1</code> (case-insensitive). Falsy / unresolved
                            (referenced variable missing) skips the step.
                        </RadzenText>
                    }

                    @* Warn when a Failure-conditioned step ended up first — the
                       orchestrator will never run it. Operator hint to fix. *@
                    @if (_isFirstStep && _condition == StepCondition.Failure)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat"
                                     Shade="Shade.Lighter" AllowClose="false" Icon="warning">
                            This step has Condition=Failure but is now first in the
                            process — it will never run. Change to Success or Always,
                            or move it later in the process.
                        </RadzenAlert>
                    }

                    @* ── Required ───────────────────────────────────────── *@
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenSwitch @bind-Value="_required" />
                        <RadzenStack Gap="0.1rem">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                <strong>Required</strong>
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                                When on, a step failure aborts the deployment. When
                                off, the deployment continues but ends with
                                <code>SucceededWithWarnings</code> status.
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>

                    @* ── Retries + Timeout ──────────────────────────────── *@
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                        <RadzenFormField Text="Max retries" Variant="Variant.Outlined" Style="flex:1;">
                            <RadzenNumeric @bind-Value="_maxRetries"
                                           Min="0" Max="20" Step="1"
                                           TValue="int" />
                        </RadzenFormField>
                        <RadzenFormField Text="Retry delay (seconds)" Variant="Variant.Outlined" Style="flex:1;">
                            <RadzenNumeric @bind-Value="_retryDelaySeconds"
                                           Min="0" Max="3600" Step="5"
                                           TValue="int" />
                        </RadzenFormField>
                        <RadzenFormField Text="Timeout (seconds)" Variant="Variant.Outlined" Style="flex:1;">
                            <RadzenNumeric @bind-Value="_timeoutSeconds"
                                           Min="0" Max="86400" Step="60"
                                           TValue="int" />
                        </RadzenFormField>
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Retries = 0 disables. Timeout = 0 means unlimited. Server
                        kills the step + treats as failure on timeout (subject to
                        the Required flag).
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        }

        @* ── Schema-driven config body ────────────────────────────────────── *@
        <StepUiSchemaForm Schema="@_schema" Values="@_values" />

        @* ── Referenced packages grid — script types only ─────────────────── *@
        @if (IsScriptStepType(_stepType))
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.Subtitle1">Referenced packages</RadzenText>
                    <RadzenButton Icon="add_circle_outline" Size="ButtonSize.ExtraSmall"
                                  Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                  Text="Add" Click="@AddReferencedPackage" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-2">
                    Extra packages this step depends on. Each is extracted to
                    <code>refs/&lt;Name&gt;/</code> and surfaced as
                    <code>$OctopusParameters["Octopus.Action.Package[Name].ExtractedPath"]</code>.
                    Version blank = latest at dispatch time.
                </RadzenText>
                @if (_referencedPackages.Count > 0)
                {
                    <table style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Name</th>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Package ID</th>
                                <th style="text-align:left; font-weight:500; padding:4px 8px;">Version</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _referencedPackages.Count; i++)
                            {
                                var idx = i;
                                <tr>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_referencedPackages[idx].Name"
                                                       Placeholder="helper" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_referencedPackages[idx].PackageId"
                                                       Placeholder="MyHelperLib" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenTextBox @bind-Value="_referencedPackages[idx].Version"
                                                       Placeholder="(latest)" Style="width:100%;" />
                                    </td>
                                    <td style="padding:2px 8px;">
                                        <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall"
                                                      Variant="Variant.Text"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Click="@(() => _referencedPackages.RemoveAt(idx))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </RadzenCard>
        }

        @if (_errors.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" ShowIcon="true">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">
                    Please fix the following before saving:
                </RadzenText>
                <ul class="rz-mb-0">
                    @foreach (var msg in _errors) { <li>@msg</li> }
                </ul>
            </RadzenAlert>
        }

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                          Click="@(_ => Dialog.Close(false))" />
            <RadzenButton Text="@(_isEdit ? "Save" : "Add step")"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="save" Click="@OnSaveAsync" />
        </RadzenStack>
    </RadzenStack>
</div>

@code {
    /// <summary>Required for Add: the project the step is added to.</summary>
    [Parameter] public Guid? ProjectId { get; set; }

    /// <summary>Required for Edit: the existing step row.</summary>
    [Parameter] public DeploymentStep? Step { get; set; }

    /// <summary>
    /// Optional. Add path with a template — the schema is derived from the
    /// template's parameters via <see cref="StepTemplateSchemaAdapter"/>.
    /// </summary>
    [Parameter] public StepTemplate? Template { get; set; }

    /// <summary>
    /// Optional. Add path without a template — the schema is looked up by
    /// step type in <see cref="BuiltInStepSchemas"/>. Used for blank
    /// "Run a Script" and any future built-in step type added directly.
    /// </summary>
    [Parameter] public string? ActionType { get; set; }

    private string _name           = "";
    private string _packageId      = "";
    private string _targetRolesCsv = "";

    /// <summary>The flat config-bag values the schema renderer mutates.</summary>
    private readonly Dictionary<string, string> _values =
        new(StringComparer.Ordinal);
    /// <summary>Resolved per-step-type schema. Null = no schema available.</summary>
    private StepUiSchema? _schema;
    private string  _stepType      = "";
    private string? _resolveError;
    private bool _isEdit;
    private readonly List<PackageRefRow> _referencedPackages = [];
    private List<string> _errors = [];

    // ── Phase D-7: per-step package version pin ──────────────────────────
    /// <summary>The installed package that owns this step type (e.g. "kraken.iis").
    /// Empty/null = no step package claims the type — header card is hidden.</summary>
    private string? _stepPackageName;
    /// <summary>The currently-selected version in the dropdown. Bound two-way
    /// to the RadzenDropDown; persisted into the step on Save.</summary>
    private string? _stepPackageVersion;
    /// <summary>All installed versions of <see cref="_stepPackageName"/>,
    /// sorted highest semver first so index 0 is "latest installed".</summary>
    private List<string> _availableVersions = [];

    /// <summary>Indexed by version string so the dropdown's Change handler
    /// can look up the picked row's UiSchemaJson without an extra DB hit.
    /// Populated alongside <see cref="_availableVersions"/>.</summary>
    private Dictionary<string, StepPackage> _versionRows =
        new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// D-12.4: drives the expand-changelog toggle next to the "Update
    /// available" badge. Off by default so the dialog stays compact for
    /// users who don't care about release notes; on when the user clicks
    /// the description-icon button.
    /// </summary>
    private bool _changelogVisible;

    // ── M14 execution knobs (bound to the Execution card) ────────────────
    private StepCondition _condition = StepCondition.Success;
    private string? _conditionVariableExpression;
    private bool _required = true;
    private int _maxRetries;
    private int _retryDelaySeconds;
    private int _timeoutSeconds;
    private StepStartTrigger _startTrigger = StepStartTrigger.StartAfterPrevious;

    /// <summary>Gated by M13.F.5 <c>ui.show-advanced-step-fields</c>.
    /// Resolved in OnParametersSetAsync; defaults false so power-user
    /// knobs stay hidden for typical operators.</summary>
    private bool _showAdvancedFields;

    /// <summary>True when this step is first in the process (no prior
    /// siblings). Used to hide the Failure run-condition option (no
    /// prior step could have failed) and adjust the Success label.</summary>
    private bool _isFirstStep;

    /// <summary>Matches Octopus's first-step Success label variant. The
    /// non-first label drops the "(or is first step)" suffix.</summary>
    private string _successConditionLabel =>
        _isFirstStep
            ? "Success: only run when previous steps succeed (or is first step)"
            : "Success: only run when previous steps succeed";

    protected override async Task OnParametersSetAsync()
    {
        _isEdit = Step is not null;

        // M13.F.5: gate advanced Execution card on the feature flag.
        _showAdvancedFields = await FeatureFlags
            .IsEnabledAsync("ui.show-advanced-step-fields")
            .ConfigureAwait(false);

        // "First step" determination — used by the Run Condition picker
        // to hide the Failure option + adjust the Success label. On Edit,
        // SortOrder=0 means first. On Add, the new step goes to the end
        // of the list, so it's first iff the process is empty (we don't
        // load the existing step count here — the parent passes ProjectId
        // but not a "current step count", so we conservatively treat Add
        // as non-first unless explicitly first by SortOrder).
        _isFirstStep = Step?.SortOrder == 0;

        if (Step is not null)
        {
            // ── Edit path ───────────────────────────────────────────────────
            _stepType = Step.StepType;
            _name = Step.Name;
            _packageId = Step.PackageId;
            _targetRolesCsv = string.Join(", ", Step.TargetRoles);
            _stepPackageName    = Step.StepPackageName;
            _stepPackageVersion = Step.StepPackageVersion;

            // M14 — hydrate Execution knobs from the existing row.
            _condition                   = Step.Condition;
            _conditionVariableExpression = Step.ConditionVariableExpression;
            _required                    = Step.Required;
            _maxRetries                  = Step.MaxRetries;
            _retryDelaySeconds           = Step.RetryDelaySeconds;
            _timeoutSeconds              = Step.TimeoutSeconds;
            _startTrigger                = Step.StartTrigger;

            await LoadPackageVersionsAsync(Step.StepPackageName).ConfigureAwait(false);

            _schema = await ResolveSchemaAsync(Step.StepType).ConfigureAwait(false);

            // Seed _values from existing Step.Config (overlaying schema
            // defaults where Config has no entry yet).
            if (_schema is not null)
            {
                foreach (var (key, field) in _schema.Properties)
                {
                    _values[key] = Step.Config.TryGetValue(key, out var v)
                        ? v
                        : (field.Default ?? string.Empty);
                }
            }

            // Preserve any pre-existing Config keys the schema doesn't know
            // about (legacy data, hand-edits) by keeping a parallel cache for
            // the Save merge.
            _extraConfigKeys = new(Step.Config.Where(kv =>
                _schema is null || !_schema.Properties.ContainsKey(kv.Key)),
                StringComparer.Ordinal);

            HydrateReferencedPackagesFromConfig(Step.Config);
        }
        else
        {
            // ── Add path ────────────────────────────────────────────────────
            if (Template is not null)
            {
                _stepType = Template.ActionType;
                _name = Template.Name;

                // Template's Properties seed the bag before the schema fields
                // overlay it. This carries any template-author defaults that
                // the schema doesn't include as a field default.
                foreach (var (k, v) in Template.Properties) { _values[k] = v; }

                _schema = StepTemplateSchemaAdapter.BuildSchema(Template);

                // Overlay schema defaults for keys without an existing value.
                foreach (var (key, field) in _schema.Properties)
                {
                    if (!_values.ContainsKey(key) && !string.IsNullOrEmpty(field.Default))
                    {
                        _values[key] = field.Default!;
                    }
                }
            }
            else if (!string.IsNullOrWhiteSpace(ActionType))
            {
                _stepType = ActionType;
                _schema   = await ResolveSchemaAsync(ActionType).ConfigureAwait(false);

                if (_schema is not null)
                {
                    foreach (var (key, field) in _schema.Properties)
                    {
                        _values[key] = field.Default ?? string.Empty;
                    }
                }
            }

            // Auto-pin the latest installed step-package version for the
            // chosen step type. Mirrors what ProcessService.AddStepAsync's
            // server-side auto-resolve does — surfacing it here so the user
            // sees and can override the pick before save (D-7).
            if (!string.IsNullOrWhiteSpace(_stepType))
            {
                var pin = await StepPackageRes
                    .ResolveLatestForStepTypeAsync(_stepType).ConfigureAwait(false);
                if (pin is not null)
                {
                    _stepPackageName    = pin.Name;
                    _stepPackageVersion = pin.Version;
                    await LoadPackageVersionsAsync(pin.Name).ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>
    /// Populates <see cref="_availableVersions"/> with every installed
    /// version of <paramref name="packageName"/>, sorted highest semver
    /// first so the dropdown's first row is always "latest installed"
    /// and the "Update available" badge can compare against it cheaply.
    /// </summary>
    private async Task LoadPackageVersionsAsync(string? packageName)
    {
        if (string.IsNullOrWhiteSpace(packageName))
        {
            _availableVersions = [];
            _versionRows.Clear();
            return;
        }

        var rows = await StepPackageSvc.GetVersionsAsync(packageName).ConfigureAwait(false);
        _availableVersions = StepPackageResolver.OrderByHighestSemver(rows.Select(r => r.Version));
        _versionRows = rows.ToDictionary(r => r.Version, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Handles the version dropdown's Change event (Phase D-7.2). Pulls the
    /// new version's per-version <c>UiSchemaJson</c> from the cached row
    /// and swaps it into the dialog's schema, carrying over any field values
    /// that exist in both the old and new schemas. Fields added in the new
    /// schema get their declared default. Fields dropped in the new schema
    /// fire a single toast naming each one — the value is lost on the next
    /// Save but the user has been warned.
    /// </summary>
    private async Task OnPickVersionAsync(string? newVersion)
    {
        if (string.IsNullOrWhiteSpace(newVersion)
            || string.Equals(newVersion, _stepPackageVersion, StringComparison.Ordinal))
        {
            return;
        }

        // Snapshot the current values BEFORE we swap the schema so we can
        // diff the property sets and decide what carries over.
        var previousValues = new Dictionary<string, string>(_values, StringComparer.Ordinal);
        var previousSchema = _schema;

        // Resolve the new schema. Prefer the row's per-version UiSchemaJson —
        // that's the canonical source for what this exact package version
        // expects. Fall back to BuiltInStepSchemas by step type only when
        // the row has no schema (legacy / pre-D-3 install).
        StepUiSchema? newSchema = null;
        if (_versionRows.TryGetValue(newVersion, out var row)
            && !string.IsNullOrWhiteSpace(row.UiSchemaJson))
        {
            try
            {
                newSchema = StepUiSchemaJson.Deserialize(row.UiSchemaJson);
            }
            catch (JsonException ex)
            {
                Notifications.Notify(NotificationSeverity.Error, "Schema parse failed",
                    $"Could not load {row.Name} {newVersion} ui-schema.json: {ex.Message}. " +
                    "Keeping the previous version selected.", 6000);
                return;
            }
        }

        // Either no per-version schema or it failed to load → fall back.
        newSchema ??= await ResolveSchemaAsync(_stepType).ConfigureAwait(false);

        // Diff the property sets so we know what to carry over and what to
        // warn about. Schemas can be null when no built-in covers the step
        // type either — in that case we keep the values verbatim.
        if (newSchema is not null)
        {
            var droppedKeys = new List<string>();
            var rebuilt     = new Dictionary<string, string>(StringComparer.Ordinal);

            foreach (var (key, field) in newSchema.Properties)
            {
                rebuilt[key] = previousValues.TryGetValue(key, out var carried)
                    ? carried
                    : (field.Default ?? string.Empty);
            }

            if (previousSchema is not null)
            {
                foreach (var oldKey in previousSchema.Properties.Keys)
                {
                    if (!newSchema.Properties.ContainsKey(oldKey))
                    {
                        droppedKeys.Add(oldKey);
                    }
                }
            }

            // Drop the values for keys the new schema doesn't know about
            // from the in-memory bag. Keep the _extraConfigKeys cache (legacy
            // / hand-edited keys outside any schema) intact — those still
            // travel into the final Config on Save.
            _values.Clear();
            foreach (var (k, v) in rebuilt) { _values[k] = v; }

            if (droppedKeys.Count > 0)
            {
                Notifications.Notify(NotificationSeverity.Warning,
                    $"{droppedKeys.Count} field(s) dropped",
                    "These fields aren't in the new version's schema and will not be saved: "
                    + string.Join(", ", droppedKeys),
                    8000);
            }
        }

        _schema             = newSchema;
        _stepPackageVersion = newVersion;
        StateHasChanged();
    }

    private async Task<StepUiSchema?> ResolveSchemaAsync(string stepType)
    {
        // Built-in schemas first (covers Kraken.IIS, Kraken.Script,
        // Octopus.IIS, Octopus.TentaclePackage, Octopus.Manual, …).
        var built = BuiltInStepSchemas.GetForStepType(stepType);
        if (built is not null) { return built; }

        // Fall back to a community-library template's parameter schema.
        try
        {
            var all = await TemplateSvc.GetAllAsync().ConfigureAwait(false);
            var match = all.FirstOrDefault(t =>
                t.ActionType.Equals(stepType, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                return StepTemplateSchemaAdapter.BuildSchema(match);
            }
        }
        catch (Exception ex)
        {
            _resolveError = $"Failed to look up step template: {ex.Message}";
            return null;
        }

        _resolveError =
            $"No built-in schema or step template matches step type '{stepType}'.";
        return null;
    }

    // ── Referenced packages helpers ─────────────────────────────────────────

    private static bool IsScriptStepType(string stepType)
        => stepType.Equals("Kraken.Script", StringComparison.OrdinalIgnoreCase)
        || stepType.Equals("Octopus.Script", StringComparison.OrdinalIgnoreCase);

    private void HydrateReferencedPackagesFromConfig(Dictionary<string, string> config)
    {
        if (!config.TryGetValue(KrakenScriptConfigKeys.PackageReferences, out var json)
            || string.IsNullOrWhiteSpace(json))
        {
            return;
        }
        try
        {
            var parsed = JsonSerializer.Deserialize<List<PackageReference>>(
                json, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (parsed is null) { return; }
            foreach (var r in parsed)
            {
                _referencedPackages.Add(new PackageRefRow
                {
                    Name      = r.Name      ?? "",
                    PackageId = r.PackageId ?? "",
                    Version   = r.Version   ?? "",
                });
            }
        }
        catch (JsonException)
        {
            // Tolerate malformed JSON — surface as an empty list.
        }
    }

    private void AddReferencedPackage()
        => _referencedPackages.Add(new PackageRefRow());

    // ── Save ────────────────────────────────────────────────────────────────

    private Dictionary<string, string> _extraConfigKeys = new(StringComparer.Ordinal);

    private async Task OnSaveAsync()
    {
        _errors = [];

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errors.Add("Name is required.");
        }

        if (_schema is null)
        {
            _errors.Add("No schema is available for this step type.");
            return;
        }

        // Schema validator — handles per-field required, enum membership,
        // length / pattern / numeric range.
        var snapshot = new Dictionary<string, string>(_values, StringComparer.Ordinal);
        var schemaErrors = StepUiSchemaValidator.Validate(_schema, snapshot);
        foreach (var e in schemaErrors)
        {
            _errors.Add(e.Message);
        }

        if (_errors.Count > 0)
        {
            StateHasChanged();
            return;
        }

        // ── Build the final Config bag ──────────────────────────────────────
        // Order: extra (pre-existing keys the schema doesn't know about) +
        // schema values (latest user-entered) + referenced-packages JSON
        // (for script types). Later assignments win.
        var config = new Dictionary<string, string>(_extraConfigKeys, StringComparer.Ordinal);
        foreach (var (k, v) in _values) { config[k] = v; }

        if (IsScriptStepType(_stepType))
        {
            var refs = _referencedPackages
                .Where(r => !string.IsNullOrWhiteSpace(r.Name)
                         && !string.IsNullOrWhiteSpace(r.PackageId))
                .Select(r => new PackageReference
                {
                    Name      = r.Name.Trim(),
                    PackageId = r.PackageId.Trim(),
                    Version   = string.IsNullOrWhiteSpace(r.Version) ? null : r.Version.Trim(),
                    Extract   = true,
                })
                .ToList();
            if (refs.Count > 0)
            {
                config[KrakenScriptConfigKeys.PackageReferences] = JsonSerializer.Serialize(
                    refs, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            }
            else
            {
                config.Remove(KrakenScriptConfigKeys.PackageReferences);
            }
        }

        var roles = ParseCsv(_targetRolesCsv);

        try
        {
            // M14: bundle the Execution-card values. When the advanced
            // fields card is hidden (toggle off) we still pass the knobs
            // — they're either the row's existing values (Edit) or the
            // defaults (Add), so the round-trip is non-destructive.
            var executionKnobs = new StepExecutionKnobs(
                Condition:                   _condition,
                ConditionVariableExpression: string.IsNullOrWhiteSpace(_conditionVariableExpression)
                                                ? null
                                                : _conditionVariableExpression.Trim(),
                Required:                    _required,
                MaxRetries:                  _maxRetries,
                RetryDelaySeconds:           _retryDelaySeconds,
                TimeoutSeconds:              _timeoutSeconds,
                StartTrigger:                _startTrigger);

            if (_isEdit && Step is not null)
            {
                // D-7: pass the explicit pin pair if the user picked a non-null
                // pair. If both are null, UpdateStepAsync keeps whatever pin
                // already lived on the row — never clears a pin from this UI.
                await ProcessSvc.UpdateStepAsync(
                    Step.Id, _name, _packageId, roles, config,
                    _stepPackageName, _stepPackageVersion,
                    executionKnobs).ConfigureAwait(false);
            }
            else
            {
                if (ProjectId is null)
                {
                    _errors.Add("Missing ProjectId — cannot create a step.");
                    StateHasChanged();
                    return;
                }
                // D-7: pass the auto-resolved (or user-picked) pin pair.
                // When _stepPackageName is null the service falls back to its
                // own auto-resolve via the StepPackageResolver — keeping the
                // ProcessService.AddStepAsync contract honest.
                await ProcessSvc.AddStepAsync(
                    ProjectId.Value, _name, _stepType, _packageId, roles, config,
                    _stepPackageName, _stepPackageVersion,
                    executionKnobs).ConfigureAwait(false);
            }
            Dialog.Close(true);
        }
        catch (InvalidOperationException ex)
        {
            _errors.Add(ex.Message);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Save failed", ex.Message, 6000);
            _errors.Add(ex.Message);
            StateHasChanged();
        }
    }

    private static List<string> ParseCsv(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return []; }
        return [.. raw.Split(',',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
    }

    private sealed class PackageRefRow
    {
        public string Name { get; set; } = "";
        public string PackageId { get; set; } = "";
        public string Version { get; set; } = "";
    }
}
