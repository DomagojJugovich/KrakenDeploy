@page "/login"
@layout EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using KrakenDeploy.Server.Auth
@using KrakenDeploy.Server.Data.Identity
@using KrakenDeploy.Server.Data.Services
@using KrakenDeploy.Server.Core.Domain.Security
@using KrakenDeploy.Server.Core.Domain.Accounts
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityProviderService IdpSvc
@inject IAccountContext AccountCtx
@inject FeatureFlagService FeatureFlags
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@attribute [AllowAnonymous]

<PageTitle>Sign in - KrakenDeploy</PageTitle>

<div class="login-wrap">
    @* ── Left: brand hero ── *@
    <div class="login-hero">
        <img class="login-hero-watermark" src="kraken-mark.png" alt="" aria-hidden="true" />
        <div class="login-hero-inner">
            <div class="login-brand">
                <img src="kraken-mark.png" alt="KrakenDeploy" />
                <span class="login-brand-name">KrakenDeploy</span>
            </div>
            <h1 class="login-hero-title">Ship to every target,<br />on your own terms.</h1>
            <p class="login-hero-sub">
                Self-hosted, .NET-native deployment automation — projects, releases,
                environments and tenants, with reverse-tunnel agents that need no
                inbound firewall rules.
            </p>
            <ul class="login-feats">
                <li><RadzenIcon Icon="vpn_lock" /> Reverse-tunnel agents over outbound HTTPS</li>
                <li><RadzenIcon Icon="cloud_off" /> Offline drop for air-gapped targets</li>
                <li><RadzenIcon Icon="extension" /> Octopus step-template compatible</li>
            </ul>
        </div>
    </div>

    @* ── Right: sign-in card ── *@
    <div class="login-form-col">
        <div class="login-themetoggle">
            <button type="button" data-theme="light" onclick="krakenLoginTheme('light')" title="Light"><RadzenIcon Icon="light_mode" /></button>
            <button type="button" data-theme="dark" onclick="krakenLoginTheme('dark')" title="Dark"><RadzenIcon Icon="dark_mode" /></button>
        </div>

        <div class="login-card">
            <h2 class="login-card-title">Sign in</h2>
            <p class="login-card-sub">Welcome back. Continue to KrakenDeploy.</p>

            @* ── External / OIDC providers ── *@
            @if (_oidcProviders.Count > 0)
            {
                @foreach (var idp in _oidcProviders)
                {
                    // Multi-account: the scheme is per-tenant (oidc_{accountId}_{providerId});
                    // single-instance: oidc_{providerId}. The account is resolved from the host.
                    var schemeName = AccountCtx.IsResolved
                        ? OidcRegistrar.SchemeName(AccountCtx.CurrentAccountId, idp.Id)
                        : OidcRegistrar.SchemeName(idp.Id);
                    var challengeUrl = $"/login/external?provider={schemeName}&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
                    <a class="oidc-btn" href="@challengeUrl">
                        <span class="oidc-mark">@(idp.Name.Length > 0 ? idp.Name[0].ToString().ToUpperInvariant() : "?")</span>
                        <span>Continue with @idp.Name</span>
                    </a>
                }

                @if (_showLocalForm)
                {
                    <div class="login-divider">or sign in with email</div>
                }
            }

            @* ── Local password form ── *@
            @if (_showLocalForm)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="login-err"><RadzenIcon Icon="error" /> @_errorMessage</div>
                    }

                    <div class="login-field">
                        <label for="login-email">Email</label>
                        <div class="login-input">
                            <RadzenIcon Icon="mail" />
                            <InputText id="login-email" @bind-Value="Input.Email" autocomplete="username" />
                        </div>
                        <ValidationMessage For="() => Input.Email" class="login-validation" />
                    </div>

                    <div class="login-field">
                        <label for="login-password">Password</label>
                        <div class="login-input">
                            <RadzenIcon Icon="lock" />
                            <InputText id="login-password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
                        </div>
                        <ValidationMessage For="() => Input.Password" class="login-validation" />
                    </div>

                    <button type="submit" class="login-submit">Sign in</button>

                    <div class="login-foot">
                        @* Self-service password reset isn't implemented (no
                           /forgot-password route exists); an admin resets via
                           Configuration → Users. Don't render a dead link. *@
                        <span class="login-ver">MIT</span>
                    </div>
                </EditForm>
            }

            @* Remote failure / provisioning error banner *@
            @if (Error is { Length: > 0 })
            {
                <div class="login-err" style="margin-top:14px;">
                    <RadzenIcon Icon="error" />
                    @ErrorMessages.GetValueOrDefault(Error, "An error occurred during sign-in.")
                </div>
            }
        </div>
    </div>
</div>

@* Login-scoped theme toggle (static SSR — no Blazor circuit for the page). Swaps
   the Radzen stylesheet link + persists to localStorage; honours the saved choice
   on load. The <RadzenTheme> component in App.razor is InteractiveServer even
   here, so after Blazor boots it re-asserts its default stylesheet — the
   MutationObserver re-applies the saved choice whenever the link is reset. *@
<script suppress-error="BL9992">
    (function () {
        var current = 'light';
        try { var s = localStorage.getItem('kraken-theme'); if (s && s.indexOf('dark') >= 0) current = 'dark'; } catch (e) { }

        function hrefFor(t, h) {
            return t === 'dark' ? h.replace('material-base', 'material-dark-base')
                                : h.replace('material-dark-base', 'material-base');
        }
        function enforce() {
            var l = document.getElementById('radzen-theme-link');
            if (!l) { return; }
            var h = l.getAttribute('href') || '';
            var want = hrefFor(current, h);
            if (want !== h) { l.setAttribute('href', want); }
        }
        function applyTheme(t) {
            current = t;
            enforce();
            document.querySelectorAll('.login-themetoggle button').forEach(function (b) {
                b.classList.toggle('on', b.getAttribute('data-theme') === t);
            });
        }
        window.krakenLoginTheme = function (t) {
            try { localStorage.setItem('kraken-theme', t === 'dark' ? 'material-dark' : 'material'); } catch (e) { }
            applyTheme(t);
        };
        applyTheme(current);

        if (window.MutationObserver) {
            new MutationObserver(enforce).observe(document.head, {
                childList: true, subtree: true, attributes: true, attributeFilter: ['href']
            });
        }
    })();
</script>

@code {
    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>Error code from an OIDC callback failure (e.g. "no_email").</summary>
    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    private string? _errorMessage;
    private List<IdentityProvider> _oidcProviders = [];

    // Show the local form when there are no external providers, or always
    // (admins need a break-glass local login regardless).
    private bool _showLocalForm = true;

    private static readonly IReadOnlyDictionary<string, string> ErrorMessages =
        new Dictionary<string, string>
        {
            ["no_email"]         = "The identity provider did not return an email address.",
            ["not_provisioned"]  = "Your account has not been provisioned. Contact an administrator.",
            ["provision_failed"] = "Account creation failed. Contact an administrator.",
            ["remote_failure"]   = "The identity provider returned an error. Please try again.",
            ["unknown_provider"] = "Unknown identity provider.",
            ["oidc_disabled"]    = "Single sign-on is currently disabled. Use a local account or contact an administrator.",
        };

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // M13.F.5 master kill-switch — when off, hide the OIDC buttons.
        // The /login/external endpoint refuses the challenge anyway, but
        // hiding the entry point keeps the UI honest.
        var oidcAllowed = await FeatureFlags.IsEnabledAsync("security.allow-oidc-sign-in");
        if (!oidcAllowed)
        {
            _oidcProviders = [];
            return;
        }

        _oidcProviders = (await IdpSvc.GetAllAsync())
            .Where(p => p.IsEnabled)
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.Name)
            .ToList();
    }

    private async Task LoginAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            _errorMessage = "Invalid email or password.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user, Input.Password, isPersistent: true, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {Email} signed in.", Input.Email);
            Navigation.NavigateTo(GetSafeReturnUrl());
        }
        else if (result.IsLockedOut)
        {
            _errorMessage = "Account is locked due to too many failed sign-in attempts. Try again later.";
        }
        else
        {
            _errorMessage = "Invalid email or password.";
        }
    }

    private string GetSafeReturnUrl()
    {
        // Defeats open-redirect: rejects absolute and protocol-relative
        // ("//evil.com", "/\evil.com") return urls, collapsing them to "/".
        return KrakenDeploy.Server.Web.LocalRedirect.MakeSafe(ReturnUrl);
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
