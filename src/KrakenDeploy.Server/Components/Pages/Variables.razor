@code {
    private enum VarMode { Edit, Preview }
    private VarMode _mode = VarMode.Edit;

    private RadzenDataGrid<Variable> _grid = default!;
    private bool _loaded;
    private string? _loadError;

    private List<Project> _projects = [];
    private List<DeploymentEnvironment> _environments = [];
    private List<Tenant> _tenants = [];
    private List<DeploymentTarget> _targets = [];
    private Dictionary<Guid, HashSet<Guid>> _targetTenantMap = [];
    private List<Channel> _channels = [];
    private List<string> _availableRoles = [];
    private sealed record StepOption(Guid Id, string Name);
    private List<StepOption> _projectStepNames = [];
    private Dictionary<Guid, string> _envNames = [];
    private Dictionary<Guid, string> _tenantNames = [];
    private Dictionary<Guid, string> _targetNames = [];

    private sealed record TagOption(Guid Id, string Label);
    private List<TagOption> _projectTagOptions = [];
    private List<TagOption> _envTagOptions = [];
    private List<TagOption> _tenantTagSetOptions = [];
    private Dictionary<Guid, HashSet<Guid>> _tenantTagSetTagIds = [];

    // ── Filter state ────────────────────────────────────────────────────
    private Guid? _filterProjectId;
    private Guid? _filterEnvId;
    private Guid? _filterTenantId;
    private string _filterRole = "";
    private Guid? _filterStepId;
    private string _filterName = "";
    private Guid? _filterTargetId;
    private Guid? _filterProjectTagId;
    private Guid? _filterEnvTagId;
    private Guid? _filterTenantTagSetId;
    private bool _showMoreFilters;
    private bool _autoApply = true;
    private bool _hasFetched;
    private bool _fetching;
    private System.Threading.CancellationTokenSource? _debounceCts;

    private bool HasAnyFilter =>
        _filterProjectId.HasValue || _filterEnvId.HasValue || _filterTenantId.HasValue
        || _filterRole.Length > 0 || _filterStepId.HasValue || _filterName.Length > 0
        || _filterTargetId.HasValue || _filterProjectTagId.HasValue
        || _filterEnvTagId.HasValue || _filterTenantTagSetId.HasValue;

    // ── Data ────────────────────────────────────────────────────────────
    private List<Variable> _variables = [];
    private List<VariableSet> _includedSets = [];
    private Dictionary<Guid, string> _sourceNames = [];
    private HashSet<Guid> _lockedIds = [];

    // Grouping is driven by the explicit "Group by" control, not (only) drag-to-
    // group. Radzen re-applies grouping when the Groups REFERENCE changes, so each
    // change assigns a fresh ObservableCollection. Source groups by SetId (a real
    // property) and the header maps the id to a friendly label via _setSourceNames.
    private string _groupBy = "name";
    private Dictionary<Guid, string> _setSourceNames = [];
    private bool? _allExpanded = true;
    private void SetAllExpanded(bool v) => _allExpanded = v;

    private static GroupDescriptor? GroupDescriptorFor(string key) => key switch
    {
        "name"   => new GroupDescriptor { Property = nameof(Variable.Name), Title = "Name", SortOrder = SortOrder.Ascending },
        "type"   => new GroupDescriptor { Property = nameof(Variable.Type), Title = "Type", SortOrder = SortOrder.Ascending },
        "source" => new GroupDescriptor { Property = nameof(Variable.SetId), Title = "Source" },
        _        => null,
    };

    private static string GroupKeyFromProperty(string? property) => property switch
    {
        nameof(Variable.Name)  => "name",
        nameof(Variable.Type)  => "type",
        nameof(Variable.SetId) => "source",
        null => "none",
        _ => "none",
    };

    // Default grouping for a first-time visitor (no persisted grid settings).
    // Passed to KrakenGrid.DefaultGroups so the grid seeds it WITHOUT the page
    // mutating Groups — a page-side seed trips Radzen's auto-persist (every
    // Groups mutation calls SaveSettings) and clobbered the user's stored
    // grouping with the default on every load. Matches GroupDescriptorFor("name").
    private static readonly GroupDescriptor[] _defaultGroups =
        [new GroupDescriptor { Property = nameof(Variable.Name), Title = "Name", SortOrder = SortOrder.Ascending }];

    // Keeps the "Group by" SelectBar honest with whatever the grid actually
    // groups by — persisted-settings restore, drag-to-group, chip-remove, or the
    // KrakenGrid default. Deliberately does NOT seed: seeding here (grid.Groups
    // .Add) would auto-persist and overwrite the stored grouping every load.
    private void OnGridRender(DataGridRenderEventArgs<Variable> args)
    {
        if (args.Grid is not { } grid) return;

        var actual = GroupKeyFromProperty(grid.Groups.FirstOrDefault()?.Property);
        if (actual != _groupBy)
        {
            _groupBy = actual;
            StateHasChanged();
        }
    }

    private async Task OnGroupByChanged(string value)
    {
        _groupBy = string.IsNullOrEmpty(value) ? "none" : value;
        if (_grid is null) return;
        _grid.Groups.Clear();
        if (GroupDescriptorFor(_groupBy) is { } desc)
        {
            _grid.Groups.Add(desc);
        }
        // Public view invalidation — the internal grouped view caches until
        // something nulls it (drag does this internally; we go through Reload).
        await _grid.Reload();
    }

    // Group-header label: SetId (Source grouping) is a Guid — map it to the
    // same friendly source name the Source column shows; other dimensions
    // display their raw key (variable name, variable type).
    private string GroupKeyLabel(Radzen.Group group)
    {
        var key = group.Data.Key;
        if (group.GroupDescriptor?.Property == nameof(Variable.SetId))
        {
            return key is Guid sid && _setSourceNames.TryGetValue(sid, out var n) ? n : "Unknown source";
        }
        return key?.ToString() ?? "(none)";
    }

    // ── Preview mode ────────────────────────────────────────────────────
    private Guid? _previewProjectId;
    private Guid? _previewEnvId;
    private Guid? _previewTargetId;
    private Guid? _previewTenantId;
    // Channel is release-level: the real deploy path resolves with the
    // release's ChannelId, so previewing without it would silently hide every
    // channel-scoped override. "(any channel)" = null = the base resolution.
    private Guid? _previewChannelId;
    private List<Channel> _previewChannels = [];

    // Carry the edit-mode filter context into the preview so "filter project,
    // switch to Preview" starts pre-seeded instead of blank.
    private async Task SwitchToPreview()
    {
        _previewProjectId ??= _filterProjectId;
        _previewEnvId ??= _filterEnvId;
        _previewTenantId ??= _filterTenantId;
        _previewTargetId ??= _filterTargetId;
        await LoadPreviewChannelsAsync(_previewProjectId);
        _mode = VarMode.Preview;
    }

    private async Task OnPreviewProjectChangedAsync(Guid? projectId)
    {
        _previewProjectId = projectId;
        _previewChannelId = null;   // channels are project-specific
        await LoadPreviewChannelsAsync(projectId);
    }

    private async Task LoadPreviewChannelsAsync(Guid? projectId)
    {
        if (projectId is { } pid)
        {
            _previewChannels = await ChannelSvc.GetForProjectAsync(pid);
            _previewChannelNames = _previewChannels.ToDictionary(c => c.Id, c => c.Name);
        }
        else
        {
            _previewChannels = [];
            _previewChannelNames = [];
        }
    }

    private bool _previewLoading;
    private bool _previewRan;
    private List<VariablePreviewRow> _previewRows = [];
    // Channel/step display names for the PREVIEW project's scope badges — the
    // edit-mode _channels/_projectStepNames belong to the filtered project,
    // which can differ from the previewed one.
    private Dictionary<Guid, string> _previewChannelNames = [];
    private Dictionary<Guid, string> _previewStepNames = [];

    // ── New variable row ────────────────────────────────────────────────
    private string _newName = "";
    private string _newValue = "";
    private VariableType _newType = VariableType.Text;
    private VariableScope _newScope = new();
    private record TypeOption(VariableType Value, string Label);
    private readonly TypeOption[] _typeOptions =
    [
        new(VariableType.Text, "Text"),
        new(VariableType.Sensitive, "Sensitive"),
        new(VariableType.StringArray, "Array"),
    ];

    // ── Scope popup ─────────────────────────────────────────────────────
    private bool _popupOpen;
    private double _popupTop;
    private double _popupLeft;
    private Variable? _popupEditingVar;
    private IEnumerable<Guid> _popEnvIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTenantIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTargetIds = Array.Empty<Guid>();
    private Guid? _popChannelId;
    private Guid? _popProcessStepId;
    private IEnumerable<string> _popRoles = [];

    // ── Array editor ────────────────────────────────────────────────────
    private bool _arrayPopupOpen;
    private double _arrayPopupTop;
    private double _arrayPopupLeft;
    private Variable? _arrayEditingVar;
    private string _arrayLines = "";

    // ── Lifecycle ───────────────────────────────────────────────────────

    private string? _appliedQuery;
    private bool _disposed;

    protected override void OnInitialized()
    {
        // Query-only, same-route navigations reuse THIS component instance
        // (the project page's Edit button → ?project=…, or a filter link →
        // ?env=…). Under global interactivity + enhanced navigation the page's
        // parameters/lifecycle are NOT reliably re-run for a query-only change,
        // so OnParametersSetAsync alone misses them — the URL updates but no
        // filter chip appears and no fetch runs. LocationChanged is the
        // documented hook that always fires on a location change; we re-read the
        // query there. Same pattern as SpaceSwitcher. Unsubscribed in Dispose.
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded)
        {
            try
            {
                _projects = await ProjectSvc.GetAllAsync();
                _environments = await EnvironmentSvc.GetAllOrderedAsync(includeArchived: true);
                _envNames = _environments.ToDictionary(e => e.Id, e => e.Name);
                _tenants = await TenantSvc.GetAllAsync();
                _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);
                _targets = await TargetSvc.GetAllAsync();
                _targetNames = _targets.ToDictionary(t => t.Id, t => t.Name);
                _targetTenantMap = await TargetSvc.GetTenantAssociationMapAsync();
                _availableRoles = _targets.SelectMany(t => t.Roles)
                    .Where(r => !string.IsNullOrWhiteSpace(r))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(r => r, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                await LoadTagOptionsAsync();
            }
            catch (Exception ex)
            {
                _loadError = ex.Message;
            }
            finally
            {
                _loaded = true;
            }
        }

        // First mount applies here; same-route query-only navigations are
        // additionally covered by OnLocationChanged. The _appliedQuery guard in
        // ApplyQueryFromCurrentUrlAsync keeps the two paths idempotent so the
        // same navigation is never applied (or fetched) twice.
        await ApplyQueryFromCurrentUrlAsync();
    }

    // Re-reads the current URL's query string and applies it to the filters,
    // fetching when at least one filter is present. Guarded by _appliedQuery so
    // SyncFiltersToUrl's history-replace navigation (which sets _appliedQuery
    // BEFORE navigating) can't trigger a re-apply loop, and so the
    // OnParametersSet and LocationChanged paths never double-fetch one nav.
    private async Task ApplyQueryFromCurrentUrlAsync()
    {
        if (!_loaded || _loadError is not null) return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (uri.Query == _appliedQuery) return;

        _appliedQuery = uri.Query;
        var applied = ApplyQueryFilters(uri.Query);
        if (applied && HasAnyFilter)
        {
            await FetchAsync();
        }
        else
        {
            // Query changed but carried no actionable filter (e.g. an empty
            // query) — reflect the current state without a fetch.
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Marshal onto the Dispatcher and swallow faults: this is a void-returning
        // event handler, so an unguarded async continuation would surface as an
        // unobserved async-void exception that tears down the circuit.
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;

                // A navigation AWAY from this page fires this too, just before the
                // component is disposed — ignore anything not targeting this page
                // so we don't start a pointless fetch during teardown.
                var uri = Nav.ToAbsoluteUri(Nav.Uri);
                if (!string.Equals(uri.AbsolutePath, Sp("/variables"), StringComparison.OrdinalIgnoreCase))
                {
                    return;
                }

                await ApplyQueryFromCurrentUrlAsync();
            }
            catch (Exception ex)
            {
                Notifications.Notify(NotificationSeverity.Error, "Filter failed", ex.Message, 5000);
            }
        });
    }

    public void Dispose()
    {
        // Kill any pending debounce and invalidate in-flight fetches so their
        // continuations can't touch services after the circuit tears down.
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        _fetchSeq++;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }

    // Returns true when the query string carried at least one filter key.
    private bool ApplyQueryFilters(string queryString)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryString);
        var applied = false;
        if (query.TryGetValue("project", out var projSlug))
        {
            _filterProjectId = _projects
                .FirstOrDefault(p => string.Equals(p.Slug, projSlug.ToString(), StringComparison.OrdinalIgnoreCase))?.Id;
            _filterStepId = null;
            applied = true;
        }
        if (query.TryGetValue("env", out var envVal) && Guid.TryParse(envVal, out var envId)) { _filterEnvId = envId; applied = true; }
        if (query.TryGetValue("tenant", out var tenantVal) && Guid.TryParse(tenantVal, out var tenantId)) { _filterTenantId = tenantId; applied = true; }
        if (query.TryGetValue("role", out var roleVal) && roleVal.ToString() is { Length: > 0 } r) { _filterRole = r; applied = true; }
        if (query.TryGetValue("name", out var nameVal) && nameVal.ToString() is { Length: > 0 } n) { _filterName = n; applied = true; }
        // After the project block — it resets the step filter.
        if (query.TryGetValue("step", out var stepVal) && Guid.TryParse(stepVal, out var stepId)) { _filterStepId = stepId; applied = true; }
        if (query.TryGetValue("target", out var targetVal) && Guid.TryParse(targetVal, out var targetId)) { _filterTargetId = targetId; applied = true; }
        return applied;
    }

    // Mirrors the current filters into the URL (history-replace) so the view is
    // shareable and F5-stable. Runs when a fetch commits and when filters are
    // cleared; _appliedQuery is set FIRST so the navigation-triggered
    // OnParametersSetAsync pass doesn't re-apply what we just wrote. Advanced
    // tag filters are intentionally not persisted.
    private void SyncFiltersToUrl()
    {
        if (!RendererInfo.IsInteractive) return;

        var parts = new List<string>();
        if (_filterProjectId is { } pid
            && _projects.FirstOrDefault(p => p.Id == pid)?.Slug is { } slug)
        {
            parts.Add($"project={Uri.EscapeDataString(slug)}");
        }
        if (_filterEnvId is { } envId) parts.Add($"env={envId}");
        if (_filterTenantId is { } tenantId) parts.Add($"tenant={tenantId}");
        if (_filterRole.Length > 0) parts.Add($"role={Uri.EscapeDataString(_filterRole)}");
        if (_filterName.Length > 0) parts.Add($"name={Uri.EscapeDataString(_filterName)}");
        if (_filterStepId is { } stepId) parts.Add($"step={stepId}");
        if (_filterTargetId is { } targetId) parts.Add($"target={targetId}");

        var query = parts.Count > 0 ? "?" + string.Join("&", parts) : "";
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (uri.Query == query)
        {
            _appliedQuery = query;
            return;
        }

        _appliedQuery = query;
        Nav.NavigateTo(uri.AbsolutePath + query, replace: true);
    }

    private async Task LoadTagOptionsAsync()
    {
        var projSets = await TagSvc.GetSetsForKindAsync(TaggableEntityKind.Project);
        _projectTagOptions = projSets
            .Where(s => s.Type != TagSetType.FreeText)
            .SelectMany(s => s.Tags.Select(t => new TagOption(t.Id, $"{s.Name}/{t.Name}")))
            .ToList();

        var envSets = await TagSvc.GetSetsForKindAsync(TaggableEntityKind.Environment);
        _envTagOptions = envSets
            .Where(s => s.Type != TagSetType.FreeText)
            .SelectMany(s => s.Tags.Select(t => new TagOption(t.Id, $"{s.Name}/{t.Name}")))
            .ToList();

        var tenantSets = await TagSvc.GetSetsForKindAsync(TaggableEntityKind.Tenant);
        _tenantTagSetOptions = tenantSets
            .Select(s => new TagOption(s.Id, s.Name))
            .ToList();
        _tenantTagSetTagIds = tenantSets
            .ToDictionary(s => s.Id, s => s.Tags.Select(t => t.Id).ToHashSet());
    }

    // ── Filter change + debounce ────────────────────────────────────────

    private async Task OnFilterChangedAsync(Action setter)
    {
        setter();
        await MaybeAutoFetchAsync();
    }

    private async Task OnProjectFilterChangedAsync(Guid? projectId)
    {
        _filterProjectId = projectId;
        // Steps, channels and the pending new-variable scope belong to the
        // previously selected project — carrying them over would silently
        // filter/scope against ids from another project.
        _filterStepId = null;
        _newScope = new VariableScope();
        await MaybeAutoFetchAsync();
    }

    private async Task OnNameKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_autoApply && HasAnyFilter)
        {
            await FetchAsync();
        }
        else if (_autoApply)
        {
            await MaybeAutoFetchAsync();
        }
    }

    private async Task MaybeAutoFetchAsync()
    {
        if (!_autoApply || !HasAnyFilter) return;
        _debounceCts?.Cancel();
        _debounceCts = new System.Threading.CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(400, token);
            if (!token.IsCancellationRequested)
            {
                await FetchAsync();
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearFilterAsync(Action setter)
    {
        setter();
        if (_autoApply && HasAnyFilter)
        {
            await FetchAsync();
        }
        else if (!HasAnyFilter)
        {
            ResetResults();
        }
    }

    private Task ClearAllFiltersAsync()
    {
        _filterProjectId = null;
        _filterEnvId = null;
        _filterTenantId = null;
        _filterRole = "";
        _filterStepId = null;
        _filterName = "";
        _filterTargetId = null;
        _filterProjectTagId = null;
        _filterEnvTagId = null;
        _filterTenantTagSetId = null;
        ResetResults();
        return Task.CompletedTask;
    }

    // Clears the result state AND invalidates any in-flight fetch so a slow
    // fetch that started before the clear cannot commit stale rows afterwards.
    private void ResetResults()
    {
        _fetchSeq++;
        _debounceCts?.Cancel();
        _variables = [];
        _includedSets = [];
        _sourceNames.Clear();
        _lockedIds.Clear();
        _hasFetched = false;
        _fetching = false;
        SyncFiltersToUrl();
    }

    // ── Fetch ───────────────────────────────────────────────────────────
    //
    // Latest-wins design: every fetch gets a sequence number; all data is
    // loaded into locals and committed to component state at a single point,
    // only when the fetch is still the newest. The finally block ALWAYS
    // re-renders via InvokeAsync — FetchAsync is reachable from contexts
    // Blazor does not re-render automatically (context-menu callbacks,
    // debounced continuations), which is how the UI used to strand on
    // "Fetching variables..." with the data already written.

    private int _fetchSeq;

    private sealed record FilterSnapshot(
        Guid? ProjectId, Guid? EnvId, Guid? TenantId, string Role, Guid? StepId,
        string Name, Guid? TargetId, Guid? ProjectTagId, Guid? EnvTagId, Guid? TenantTagSetId);

    private sealed record FetchResult(
        List<Variable> Variables,
        List<VariableSet> IncludedSets,
        Dictionary<Guid, string> SourceNames,
        HashSet<Guid> LockedIds,
        List<Channel> Channels,
        List<StepOption> Steps,
        List<string> Roles);

    private async Task FetchAsync()
    {
        if (!HasAnyFilter) return;
        var seq = ++_fetchSeq;
        _fetching = true;
        StateHasChanged();

        try
        {
            var snapshot = new FilterSnapshot(
                _filterProjectId, _filterEnvId, _filterTenantId, _filterRole, _filterStepId,
                _filterName, _filterTargetId, _filterProjectTagId, _filterEnvTagId, _filterTenantTagSetId);

            var result = await BuildFetchResultAsync(snapshot);

            if (seq != _fetchSeq) return;

            _variables = result.Variables;
            _includedSets = result.IncludedSets;
            _sourceNames = result.SourceNames;
            _lockedIds = result.LockedIds;
            _channels = result.Channels;
            _projectStepNames = result.Steps;
            _availableRoles = result.Roles;
            // SetId → friendly source label, for the "group by Source" header.
            _setSourceNames = _variables
                .GroupBy(v => v.SetId)
                .ToDictionary(g => g.Key, g => SourceLabel(g.First()));
            _hasFetched = true;
            SyncFiltersToUrl();
        }
        catch (Exception ex)
        {
            if (seq == _fetchSeq)
            {
                Notifications.Notify(NotificationSeverity.Error, "Fetch failed", ex.Message, 5000);
            }
        }
        finally
        {
            if (seq == _fetchSeq)
            {
                _fetching = false;
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    // Pure load: reads everything the grid needs into a result object without
    // touching component state, so a superseded fetch can be discarded whole.
    private async Task<FetchResult> BuildFetchResultAsync(FilterSnapshot f)
    {
        IReadOnlyCollection<Guid>? projectIds = null;
        if (f.ProjectTagId.HasValue)
        {
            projectIds = await TagSvc.GetEntityIdsWithAnyTagAsync(TaggableEntityKind.Project, [f.ProjectTagId.Value]);
        }

        HashSet<Guid>? envIds = null;
        if (f.EnvTagId.HasValue)
        {
            envIds = await TagSvc.GetEntityIdsWithAnyTagAsync(TaggableEntityKind.Environment, [f.EnvTagId.Value]);
        }

        HashSet<Guid>? tenantSetTagIds = null;
        if (f.TenantTagSetId.HasValue)
        {
            tenantSetTagIds = _tenantTagSetTagIds.TryGetValue(f.TenantTagSetId.Value, out var ids) ? ids : [];
        }

        var results = await VariableSvc.SearchVariablesAsync(
            projectId: f.ProjectId,
            nameContains: f.Name.Length > 0 ? f.Name : null,
            projectIds: projectIds);

        bool MatchesScopeFilters(Variable v)
        {
            if (f.EnvId.HasValue && v.Scope.EnvironmentId.HasValue
                && v.Scope.EnvironmentId != f.EnvId.Value) return false;
            if (envIds is not null && v.Scope.EnvironmentId.HasValue
                && !envIds.Contains(v.Scope.EnvironmentId.Value)) return false;
            if (f.TenantId.HasValue && v.Scope.TenantId.HasValue
                && v.Scope.TenantId != f.TenantId.Value) return false;
            if (f.Role.Length > 0 && v.Scope.Roles is { Count: > 0 }
                && !v.Scope.Roles.Contains(f.Role, StringComparer.OrdinalIgnoreCase)) return false;
            if (f.StepId.HasValue && v.Scope.ProcessStepId.HasValue
                && v.Scope.ProcessStepId != f.StepId.Value) return false;
            if (f.TargetId.HasValue && v.Scope.TargetId.HasValue
                && v.Scope.TargetId != f.TargetId.Value) return false;
            if (tenantSetTagIds is not null && v.Scope.TenantTagIds is { Count: > 0 }
                && !v.Scope.TenantTagIds.Any(tenantSetTagIds.Contains)) return false;
            return true;
        }

        var variables = results.Where(MatchesScopeFilters).ToList();

        var includedSets = new List<VariableSet>();
        var sourceNames = new Dictionary<Guid, string>();
        var lockedIds = new HashSet<Guid>();
        var channels = _channels;
        var steps = new List<StepOption>();
        var roles = _availableRoles;

        if (f.ProjectId.HasValue && _projects.Any(p => p.Id == f.ProjectId.Value))
        {
            channels = await ChannelSvc.GetForProjectAsync(f.ProjectId.Value);
            var process = await ProcessSvc.GetAsync(f.ProjectId.Value);
            steps = process?.Steps.Select(s => new StepOption(s.Id, s.Name)).ToList() ?? [];

            var stepRoles = process?.Steps.SelectMany(s => s.TargetRoles) ?? [];
            roles = _targets.SelectMany(t => t.Roles)
                .Concat(stepRoles)
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(r => r, StringComparer.OrdinalIgnoreCase)
                .ToList();

            includedSets = await VariableSvc.GetIncludedSetsAsync(f.ProjectId.Value);
            foreach (var set in includedSets)
            {
                foreach (var v in set.Variables)
                {
                    sourceNames[v.Id] = set.Name ?? "Library";
                    lockedIds.Add(v.Id);
                }
            }

            // Overlay the included library variables, subject to the SAME
            // name + scope filters as the project's own rows.
            var existing = variables.Select(v => v.Id).ToHashSet();
            foreach (var lv in includedSets.SelectMany(s => s.Variables))
            {
                if (existing.Contains(lv.Id)) continue;
                if (f.Name.Length > 0
                    && !lv.Name.Contains(f.Name, StringComparison.OrdinalIgnoreCase)) continue;
                if (!MatchesScopeFilters(lv)) continue;
                variables.Add(lv);
            }

            variables = variables
                .OrderBy(v => v.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(v => v.Id)
                .ToList();
        }

        return new FetchResult(variables, includedSets, sourceNames, lockedIds, channels, steps, roles);
    }

    // ── Helpers ─────────────────────────────────────────────────────────

    private bool IsLocked(Variable v) => _lockedIds.Contains(v.Id);

    private string SourceLabel(Variable v)
    {
        if (_sourceNames.TryGetValue(v.Id, out var s)) return s;
        return v.Set?.Kind switch
        {
            VariableSetKind.Library => v.Set.Name ?? "Library",
            VariableSetKind.TenantCommon => "Tenant",
            _ => v.Set?.ProjectId is { } pid ? ProjectName(pid) : "Project",
        };
    }
    private string ProjectName(Guid id) => _projects.FirstOrDefault(p => p.Id == id)?.Name ?? "?";
    private string EnvName(Guid id) => _envNames.TryGetValue(id, out var n) ? n : "?";
    private string TenantName(Guid id) => _tenantNames.TryGetValue(id, out var n) ? n : "?";
    private string TargetName(Guid id) => _targetNames.TryGetValue(id, out var n) ? n : "?";
    private string ChannelName(Guid id) => _channels.FirstOrDefault(c => c.Id == id)?.Name ?? "?";
    private string StepName(Guid id) => _projectStepNames.FirstOrDefault(s => s.Id == id)?.Name ?? "?";
    private string TagLabel(List<TagOption> options, Guid id) => options.FirstOrDefault(t => t.Id == id)?.Label ?? "?";
    private static int CountOf(IEnumerable<Guid>? e) => e?.Count() ?? 0;

    private IEnumerable<DeploymentTarget> PopTargetOptions
    {
        get
        {
            var tenantIds = _popTenantIds.ToHashSet();
            if (tenantIds.Count == 0) return _targets;
            return _targets.Where(t => _targetTenantMap.TryGetValue(t.Id, out var serves) && serves.Overlaps(tenantIds));
        }
    }

    private void OnPopTenantsChanged(IEnumerable<Guid> tenantIds)
    {
        _popTenantIds = tenantIds;
        var allowed = PopTargetOptions.Select(t => t.Id).ToHashSet();
        _popTargetIds = _popTargetIds.Where(allowed.Contains).ToList();
    }

    // ── Grid edit ───────────────────────────────────────────────────────

    private static bool IsEditableProperty(string? prop) =>
        prop is nameof(Variable.Name) or nameof(Variable.Value) or nameof(Variable.Type);

    private void OnCellRender(DataGridCellRenderEventArgs<Variable> args)
    {
        if (args.Column is { } col && IsEditableProperty(col.Property))
        {
            args.Attributes.Add("style", "cursor: pointer;");
        }
    }

    private async Task OnCellClickAsync(DataGridCellMouseEventArgs<Variable> args)
    {
        if (args.Column is { } col && IsEditableProperty(col.Property)
            && args.Data is { } data && !IsLocked(data))
        {
            if (data.Type == VariableType.Sensitive)
            {
                // The entity's Value holds ciphertext. Blank it for the edit
                // session so (a) the ciphertext never reaches the browser and
                // (b) saving without retyping doesn't re-encrypt the
                // ciphertext into garbage. Empty on save = keep stored value.
                data.Value = "";
            }
            await _grid.EditRow(data);
        }
    }

    private async Task OnRowUpdateAsync(Variable v)
    {
        if (!await Guard.AllowAsync(EditPermissionFor(v))) return;
        try
        {
            var valueToSend = v.Type == VariableType.Sensitive && string.IsNullOrEmpty(v.Value)
                ? null   // sensitive left blank -> keep the stored ciphertext
                : v.Value;
            await VariableSvc.UpdateVariableAsync(v.Id, v.Name, valueToSend, v.Type, v.Scope, await Guard.CurrentCallerAsync());
            await FetchAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Save failed", ex.Message, 5000);
            await FetchAsync();
        }
    }

    private async Task CancelEditAsync(Variable v)
    {
        _grid.CancelEditRow(v);
        await FetchAsync();
    }

    private async Task AddNewVariableAsync()
    {
        if (!_filterProjectId.HasValue || string.IsNullOrWhiteSpace(_newName)) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        try
        {
            await VariableSvc.CreateVariableAsync(
                _filterProjectId.Value, _newName, _newValue ?? "", _newType, _newScope, await Guard.CurrentCallerAsync());
            _newName = "";
            _newValue = "";
            _newType = VariableType.Text;
            _newScope = new VariableScope();
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Added", "Variable was added.", 3000);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Add failed", ex.Message, 5000);
        }
    }

    private string ScopeLabelForNew()
    {
        if (_newScope.IsUnscoped) return "Define scope";
        var parts = new List<string>();
        if (_newScope.EnvironmentId is { } e) parts.Add($"env: {EnvName(e)}");
        if (_newScope.TenantId is { } t) parts.Add($"tenant: {TenantName(t)}");
        if (_newScope.TargetId is { } tg) parts.Add($"target: {TargetName(tg)}");
        if (_newScope.ChannelId is { } c) parts.Add($"channel: {ChannelName(c)}");
        if (_newScope.ProcessStepId is { } st) parts.Add($"step: {StepName(st)}");
        if (_newScope.Roles is { Count: > 0 } r) parts.Add($"roles: {string.Join(",", r)}");
        return string.Join(" | ", parts);
    }

    // ── Context menu ────────────────────────────────────────────────────

    private void ShowRowMenu(MouseEventArgs args, Variable v)
    {
        ContextMenu.Open(args, new List<ContextMenuItem>
        {
            new() { Text = "Add Value", Value = "add", Icon = "add" },
            new() { Text = "Duplicate Variable", Value = "duplicate", Icon = "content_copy" },
            new() { Text = "Delete Variable", Value = "delete", Icon = "delete" },
        }, e =>
        {
            ContextMenu.Close();
            // The service callback is a plain Action — an async lambda here
            // would be async void: exceptions would kill the circuit and the
            // page would never re-render after the awaited work finishes.
            _ = RunRowActionAsync(e.Value?.ToString(), v);
        });
    }

    private async Task RunRowActionAsync(string? action, Variable v)
    {
        try
        {
            switch (action)
            {
                case "add": await AddValueAsync(v); break;
                case "duplicate": await DuplicateAsync(v); break;
                case "delete": await DeleteAsync(v); break;
            }
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Action failed", ex.Message, 5000);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    // The permission the pre-check should use for a row: library-set rows are
    // guarded by LibraryVariableSetEdit, everything else by VariableEdit. The
    // service re-checks authoritatively either way.
    private static Permission EditPermissionFor(Variable v) =>
        v.Set?.Kind == VariableSetKind.Library ? Permission.LibraryVariableSetEdit : Permission.VariableEdit;

    private async Task AddValueAsync(Variable v)
    {
        if (!await Guard.AllowAsync(EditPermissionFor(v))) return;
        // Create in the variable's own set — works for project rows, library
        // rows and rows found without a project filter alike.
        await VariableSvc.CreateVariableInSetAsync(
            v.SetId, v.Name, "", VariableType.Text, new VariableScope(), await Guard.CurrentCallerAsync());
        await FetchAsync();
    }

    private async Task DuplicateAsync(Variable v)
    {
        if (!await Guard.AllowAsync(EditPermissionFor(v))) return;
        var rawValue = v.Type == VariableType.Sensitive ? "" : v.Value;
        await VariableSvc.CreateVariableInSetAsync(
            v.SetId, v.Name + " (copy)", rawValue, v.Type,
            CloneScope(v.Scope), await Guard.CurrentCallerAsync());
        await FetchAsync();
    }

    private static VariableScope CloneScope(VariableScope s) => new()
    {
        EnvironmentId = s.EnvironmentId,
        TenantId = s.TenantId,
        TargetId = s.TargetId,
        ChannelId = s.ChannelId,
        ProcessStepId = s.ProcessStepId,
        Roles = s.Roles is { Count: > 0 } r ? [..r] : null,
        TenantTagIds = s.TenantTagIds is { Count: > 0 } tt ? [..tt] : null,
    };

    private async Task DeleteAsync(Variable v)
    {
        if (!await Guard.AllowAsync(EditPermissionFor(v))) return;
        var confirmed = await Dialog.Confirm(
            $"Delete variable '{v.Name}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed == true)
        {
            await VariableSvc.DeleteVariableAsync(v.Id, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Deleted", $"Variable '{v.Name}' was removed.", 3000);
        }
    }

    // ── Included sets ───────────────────────────────────────────────────

    private async Task OpenIncludeSetDialog()
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var available = await VariableSvc.GetAvailableLibrarySetsAsync(_filterProjectId.Value);
        if (available.Count == 0)
        {
            Notifications.Notify(NotificationSeverity.Info, "No sets available", "All library variable sets are already included.", 3000);
            return;
        }
        var result = await Dialog.OpenAsync<IncludeVariableSetDialog>(
            "Include Library Variable Set",
            new Dictionary<string, object?> { [nameof(IncludeVariableSetDialog.Sets)] = available },
            new DialogOptions { Width = "420px" });
        if (result is Guid setId)
        {
            await VariableSvc.IncludeSetAsync(_filterProjectId.Value, setId, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Included", "Library variable set was added.", 3000);
        }
    }

    private async Task RemoveIncludedSetAsync(Guid setId)
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var confirmed = await Dialog.Confirm(
            "Remove this library variable set from the project?",
            "Confirm Remove",
            new ConfirmOptions { OkButtonText = "Remove", CancelButtonText = "Cancel" });
        if (confirmed == true)
        {
            await VariableSvc.ExcludeSetAsync(_filterProjectId.Value, setId, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Removed", "Library variable set was excluded.", 3000);
        }
    }

    // ── Scope popup ─────────────────────────────────────────────────────

    private void OpenScopePopup(MouseEventArgs args, Variable v)
    {
        if (IsLocked(v))
        {
            // Included library rows are shown for context only — their scope
            // is owned by the library set page.
            Notifications.Notify(NotificationSeverity.Info, "Library variable",
                "Edit this variable in its library variable set.", 4000);
            return;
        }
        _popupEditingVar = v;
        SeedPopupFromScope(v.Scope);
        SetPopupPosition(args);
        _popupOpen = true;
    }

    private void OpenNewScopePopup(MouseEventArgs args)
    {
        _popupEditingVar = null;
        SeedPopupFromScope(_newScope);
        SetPopupPosition(args);
        _popupOpen = true;
    }

    private void SetPopupPosition(MouseEventArgs args)
    {
        const double popupWidth = 420;
        const double margin = 8;
        _popupTop = args.ClientY + margin;
        _popupLeft = args.ClientX - popupWidth / 2;
        if (_popupLeft < margin) _popupLeft = margin;
    }

    private void ClosePopup() => _popupOpen = false;

    private void SeedPopupFromScope(VariableScope s)
    {
        _popEnvIds = s.EnvironmentId.HasValue ? new[] { s.EnvironmentId.Value } : [];
        _popTenantIds = s.TenantId.HasValue ? new[] { s.TenantId.Value } : [];
        _popTargetIds = s.TargetId.HasValue ? new[] { s.TargetId.Value } : [];
        _popRoles = s.Roles is { Count: > 0 } r ? r.ToList() : [];
        foreach (var role in _popRoles.Where(r => !_availableRoles.Contains(r, StringComparer.OrdinalIgnoreCase)))
        {
            _availableRoles.Add(role);
        }
        _popChannelId = s.ChannelId;
        _popProcessStepId = s.ProcessStepId;
    }

    private async Task SaveScopeAsync()
    {
        var roles = _popRoles.Where(r => !string.IsNullOrWhiteSpace(r)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var envIds = _popEnvIds.ToList();
        var tenantIds = _popTenantIds.ToList();
        var targetIds = _popTargetIds.ToList();

        VariableScope ScopeFor(Guid? env, Guid? tenant, Guid? target, List<Guid>? tenantTags) => new()
        {
            EnvironmentId = env,
            TenantId = tenant,
            TargetId = target,
            ChannelId = _popChannelId,
            ProcessStepId = _popProcessStepId,
            Roles = roles.Count > 0 ? [..roles] : null,
            // The popup has no tenant-tag picker; preserve whatever the
            // variable already carries instead of silently wiping it.
            TenantTagIds = tenantTags is { Count: > 0 } ? [..tenantTags] : null,
        };

        if (_popupEditingVar is null)
        {
            if (!_filterProjectId.HasValue) return;
            if (!await Guard.AllowAsync(Permission.VariableEdit)) return;

            if (envIds.Count <= 1 && tenantIds.Count <= 1 && targetIds.Count <= 1)
            {
                _newScope = ScopeFor(
                    envIds.Count > 0 ? envIds[0] : null,
                    tenantIds.Count > 0 ? tenantIds[0] : null,
                    targetIds.Count > 0 ? targetIds[0] : null,
                    _newScope.TenantTagIds);
                ClosePopup();
                return;
            }

            if (string.IsNullOrWhiteSpace(_newName))
            {
                Notifications.Notify(NotificationSeverity.Warning, "Missing name",
                    "Type a variable name before saving a multi-scope.", 5000);
                return;
            }

            var envSetN = envIds.Count > 0 ? envIds.Cast<Guid?>().ToList() : [null];
            var tenantSetN = tenantIds.Count > 0 ? tenantIds.Cast<Guid?>().ToList() : [null];
            var targetSetN = targetIds.Count > 0 ? targetIds.Cast<Guid?>().ToList() : [null];

            try
            {
                foreach (var e in envSetN)
                    foreach (var t in tenantSetN)
                        foreach (var tg in targetSetN)
                        {
                            await VariableSvc.CreateVariableAsync(
                                _filterProjectId.Value, _newName, _newValue ?? "", _newType,
                                ScopeFor(e, t, tg, null), await Guard.CurrentCallerAsync());
                        }
            }
            catch (Exception ex)
            {
                Notifications.Notify(NotificationSeverity.Error, "Add failed", ex.Message, 5000);
                await FetchAsync();
                return;
            }

            _newName = ""; _newValue = ""; _newType = VariableType.Text; _newScope = new VariableScope();
            ClosePopup();
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Added", "Variable was added (multi-scope).", 3000);
            return;
        }

        if (!await Guard.AllowAsync(EditPermissionFor(_popupEditingVar))) return;

        var existingTenantTags = _popupEditingVar.Scope.TenantTagIds;
        // Sensitive vars never multi-expand (the popup already warns) — the
        // stored ciphertext can't be copied through the create path without
        // double-encrypting it.
        var singleTarget = (envIds.Count <= 1 && tenantIds.Count <= 1 && targetIds.Count <= 1)
                           || _popupEditingVar.Type == VariableType.Sensitive;

        try
        {
            if (singleTarget)
            {
                // Plain scope change — update in place (value: null keeps the
                // stored value untouched, including Sensitive ciphertext).
                await VariableSvc.UpdateVariableAsync(
                    _popupEditingVar.Id, _popupEditingVar.Name, null, _popupEditingVar.Type,
                    ScopeFor(
                        envIds.Count > 0 ? envIds[0] : null,
                        tenantIds.Count > 0 ? tenantIds[0] : null,
                        targetIds.Count > 0 ? targetIds[0] : null,
                        existingTenantTags), await Guard.CurrentCallerAsync());
            }
            else
            {
                // Multi-scope expansion — one clone per combination, applied
                // atomically by the service (all-or-nothing).
                var envSet = envIds.Count > 0 ? envIds.Cast<Guid?>().ToList() : [null];
                var tenantSet = tenantIds.Count > 0 ? tenantIds.Cast<Guid?>().ToList() : [null];
                var targetSet = targetIds.Count > 0 ? targetIds.Cast<Guid?>().ToList() : [null];

                var scopes = new List<VariableScope>();
                foreach (var e in envSet)
                    foreach (var t in tenantSet)
                        foreach (var tg in targetSet)
                        {
                            scopes.Add(ScopeFor(e, t, tg, existingTenantTags));
                        }

                await VariableSvc.ReplaceVariableScopesAsync(
                    _popupEditingVar.Id, scopes, await Guard.CurrentCallerAsync());
            }
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Scope save failed", ex.Message, 5000);
            await FetchAsync();
            return;
        }

        ClosePopup();
        await FetchAsync();
        Notifications.Notify(NotificationSeverity.Success, "Scope saved", "Variable scope was updated.", 3000);
    }

    private async Task OpenAdvancedEditorAsync()
    {
        ClosePopup();
        if (_popupEditingVar is not null)
        {
            await Dialog.OpenAsync<VariableFormDialog>(
                "Edit Variable",
                new Dictionary<string, object?>
                {
                    [nameof(VariableFormDialog.Variable)] = _popupEditingVar,
                    // The variable's OWN project drives the channel/step pickers —
                    // it can differ from the page filter (tag search, no project).
                    [nameof(VariableFormDialog.ProjectId)] = _popupEditingVar.Set?.ProjectId ?? _filterProjectId,
                },
                new DialogOptions { Width = "640px" });
            await FetchAsync();
        }
    }

    // ── Array editor ────────────────────────────────────────────────────

    private static string FormatArrayPreview(string? json)
    {
        var items = ParseArrayJson(json);
        return items.Count switch
        {
            0 => "[]",
            1 => $"[{items[0]}]",
            _ => $"[{items[0]}, ... ({items.Count} items)]",
        };
    }

    private static List<string> ParseArrayJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try { return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? []; }
        catch { return json.Split(',', StringSplitOptions.None).Select(s => s.Trim()).ToList(); }
    }

    private void OpenArrayEditor(MouseEventArgs args, Variable v)
    {
        _arrayEditingVar = v;
        _arrayLines = string.Join("\n", ParseArrayJson(v.Value));
        SetArrayPopupPosition(args);
        _arrayPopupOpen = true;
    }

    private void OpenArrayEditorForNew(MouseEventArgs args)
    {
        _arrayEditingVar = null;
        _arrayLines = string.Join("\n", ParseArrayJson(_newValue));
        SetArrayPopupPosition(args);
        _arrayPopupOpen = true;
    }

    private void SetArrayPopupPosition(MouseEventArgs args)
    {
        const double popupWidth = 460;
        const double margin = 8;
        _arrayPopupTop = args.ClientY + margin;
        _arrayPopupLeft = args.ClientX - popupWidth / 2;
        if (_arrayPopupLeft < margin) _arrayPopupLeft = margin;
    }

    private void CloseArrayEditor() => _arrayPopupOpen = false;

    private async Task SaveArrayAsync()
    {
        var lines = (_arrayLines ?? "").Split('\n', StringSplitOptions.None).Select(l => l.TrimEnd('\r')).ToList();
        var json = System.Text.Json.JsonSerializer.Serialize(lines);
        if (_arrayEditingVar is null)
        {
            _newValue = json;
        }
        else
        {
            if (!await Guard.AllowAsync(EditPermissionFor(_arrayEditingVar))) return;
            try
            {
                await VariableSvc.UpdateVariableAsync(
                    _arrayEditingVar.Id, _arrayEditingVar.Name, json,
                    _arrayEditingVar.Type, _arrayEditingVar.Scope, await Guard.CurrentCallerAsync());
                await FetchAsync();
                Notifications.Notify(NotificationSeverity.Success, "Saved", "Array value updated.", 3000);
            }
            catch (Exception ex)
            {
                Notifications.Notify(NotificationSeverity.Error, "Save failed", ex.Message, 5000);
                return;
            }
        }
        CloseArrayEditor();
    }

    // ── Preview ─────────────────────────────────────────────────────────

    private async Task RunPreviewAsync()
    {
        if (!_previewProjectId.HasValue || !_previewEnvId.HasValue) return;
        _previewLoading = true;
        _previewRan = false;
        _previewRows = [];
        StateHasChanged();

        try
        {
            var targetRoles = _previewTargetId.HasValue
                ? _targets.FirstOrDefault(t => t.Id == _previewTargetId)?.Roles ?? []
                : [];

            IReadOnlyList<Guid>? tenantTagIds = null;
            if (_previewTenantId.HasValue)
            {
                tenantTagIds = await VariableSvc.GetTenantTagIdsAsync(_previewTenantId.Value);
            }

            // Provenance-aware resolution: winner value + source set + winning
            // scope + specificity per name. channelId is passed so channel-scoped
            // overrides resolve exactly as they would at deploy time (the deploy
            // path resolves with the release's ChannelId). Sensitive winners
            // arrive masked — the plaintext is never decrypted for previews.
            _previewRows = await VariableSvc.PreviewResolveAsync(
                _previewProjectId.Value, _previewEnvId.Value, _previewTargetId,
                targetRoles, tenantId: _previewTenantId, channelId: _previewChannelId,
                tenantTagIds: tenantTagIds);

            // Channel names are already loaded for the picker; a step-scoped
            // winner can't surface here (preview has no step dimension) but
            // resolve its name defensively if one ever does.
            if (_previewStepNames.Count == 0 && _previewRows.Any(r => r.Scope.ProcessStepId.HasValue))
            {
                var process = await ProcessSvc.GetAsync(_previewProjectId.Value);
                _previewStepNames = process?.Steps.ToDictionary(s => s.Id, s => s.Name) ?? [];
            }

            _previewRan = true;
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Preview failed", ex.Message, 5000);
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private string PreviewChannelName(Guid id) => _previewChannelNames.TryGetValue(id, out var n) ? n : "?";
    private string PreviewStepName(Guid id) => _previewStepNames.TryGetValue(id, out var n) ? n : "?";
}
