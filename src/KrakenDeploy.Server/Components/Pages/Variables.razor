@page "/s/{SpaceSlug}/variables"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

@using KrakenDeploy.Server.Core.Domain.Variables
@using KrakenDeploy.Server.Core.Domain.Environments
@using KrakenDeploy.Server.Core.Domain.Tenants
@using KrakenDeploy.Server.Core.Domain.Targets
@using KrakenDeploy.Server.Core.Domain.Channels
@using KrakenDeploy.Server.Core.Domain.Projects
@using KrakenDeploy.Server.Core.Domain.Tags
@inject ProjectService ProjectSvc
@inject VariableService VariableSvc
@inject EnvironmentService EnvironmentSvc
@inject TenantService TenantSvc
@inject TargetService TargetSvc
@inject ChannelService ChannelSvc
@inject ProcessService ProcessSvc
@inject TagService TagSvc
@inject DialogService Dialog
@inject ContextMenuService ContextMenu
@inject NotificationService Notifications
@inject UiActionGuard Guard
@inject NavigationManager Nav

<PageTitle>Variables - KrakenDeploy</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0">
            Variables
        </RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
            <RadzenButton Text="Edit" Size="ButtonSize.Small"
                          ButtonStyle="@(_mode == VarMode.Edit ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Click="@(() => _mode = VarMode.Edit)" />
            <RadzenButton Text="Preview" Size="ButtonSize.Small"
                          ButtonStyle="@(_mode == VarMode.Preview ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Click="@SwitchToPreview" />
        </RadzenStack>
        @if (_hasFetched)
        {
            <RadzenBadge Text="@($"{_variables.Count} variables")" BadgeStyle="BadgeStyle.Light" IsPill="true" />
        }
    </RadzenStack>
    @if (_mode == VarMode.Edit && _hasFetched)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem">
            @* Explicit grouping control — drag-to-group still works, but it's a
               finicky drop target (worse without the new-variable bar), and once
               a group is dragged off it can't be re-added. This is the reliable,
               project-independent path. *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">Group by</RadzenText>
                <RadzenSelectBar TValue="string" Value="@_groupBy" ValueChanged="OnGroupByChanged"
                                 Size="ButtonSize.ExtraSmall">
                    <Items>
                        <RadzenSelectBarItem Text="None" Value="@("none")" />
                        <RadzenSelectBarItem Text="Name" Value="@("name")" />
                        <RadzenSelectBarItem Text="Type" Value="@("type")" />
                        <RadzenSelectBarItem Text="Source" Value="@("source")" />
                    </Items>
                </RadzenSelectBar>
            </RadzenStack>
            @if (_groupBy != "none")
            {
                <RadzenButton Icon="unfold_less" Text="Collapse all"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => SetAllExpanded(false))" />
                <RadzenButton Icon="unfold_more" Text="Expand all"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => SetAllExpanded(true))" />
            }
        </RadzenStack>
    }
</RadzenStack>

@if (!_loaded)
{
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Loading...</RadzenText>
    return;
}

@if (_loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
        Failed to load: @_loadError
    </RadzenAlert>
    return;
}

@if (_mode == VarMode.Edit)
{
    @* ── Primary selector: the project anchors editing (new-variable bar,
          included sets, steps/channels) — everything below it is a filter. *@
    <div class="kraken-var-primary-bar rz-mb-2">
        <RadzenLabel Text="Project" class="kraken-var-primary-label" />
        <RadzenDropDown TValue="Guid?" Value="@_filterProjectId"
                        ValueChanged="@(async (Guid? v) => await OnProjectFilterChangedAsync(v))"
                        Data="@_projects" TextProperty="Name" ValueProperty="Id"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="Select a project..." Style="width: 280px;" />
        @if (!_filterProjectId.HasValue)
        {
            <span class="rz-color-secondary" style="font-size: 12px;">
                Pick a project to edit its variables — or search across projects with the filters below.
            </span>
        }
    </div>

    @* ── Filter row ──────────────────────────────────────────────────── *@
    <div class="kraken-var-filter-bar rz-mb-2">
        <RadzenDropDown TValue="Guid?" Value="@_filterEnvId"
                        ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterEnvId = v))"
                        Data="@_environments" TextProperty="Name" ValueProperty="Id"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="Environment" Style="width: 160px;" />
        <RadzenDropDown TValue="Guid?" Value="@_filterTenantId"
                        ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterTenantId = v))"
                        Data="@_tenants" TextProperty="Name" ValueProperty="Id"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="Tenant" Style="width: 150px;" />
        @* Value must be null (not "") when empty, else Radzen suppresses the
           placeholder and the field renders blank. AllowClear is deliberately
           off here — it threw ArgumentException on these filter dropdowns. *@
        <RadzenDropDown TValue="string" Value="@(_filterRole.Length > 0 ? _filterRole : null)"
                        ValueChanged="@(async (string v) => await OnFilterChangedAsync(() => _filterRole = v ?? ""))"
                        Data="@_availableRoles"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="Roles" Style="width: 130px;" />
        <RadzenDropDown TValue="Guid?" Value="@_filterStepId"
                        ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterStepId = v))"
                        Data="@_projectStepNames" TextProperty="Name" ValueProperty="Id"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="Step" Style="width: 150px;"
                        Disabled="@(!_filterProjectId.HasValue)" />
        @* Native input: RadzenTextBox commits @bind-Value only on blur/change,
           so the debounced keyup fetch would always see the PREVIOUS value.
           oninput keeps _filterName current on every keystroke. *@
        <input class="rz-textbox" placeholder="Name search..."
               style="width: 160px;"
               value="@_filterName"
               @oninput="@(e => _filterName = e.Value?.ToString() ?? "")"
               @onkeyup="OnNameKeyUp" />
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenCheckBox TValue="bool" @bind-Value="_autoApply" Name="autoApply" />
            <RadzenLabel Text="Auto" Component="autoApply" Style="cursor:pointer; font-size:13px;" />
        </RadzenStack>
        @if (!_autoApply)
        {
            <RadzenButton Text="Apply" Icon="search" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small" Click="FetchAsync"
                          Disabled="@(!HasAnyFilter)" />
        }
        <button type="button" class="kraken-vargrid-link" style="font-size:12px;"
                @onclick="@(() => _showMoreFilters = !_showMoreFilters)">
            @(_showMoreFilters ? "Less filters" : "More filters")
        </button>
    </div>

    @* ── Optional filters row (collapsible) ──────────────────────────── *@
    @if (_showMoreFilters)
    {
        <div class="kraken-var-filter-bar rz-mb-2" style="border-style: dashed;">
            <RadzenDropDown TValue="Guid?" Value="@_filterTargetId"
                            ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterTargetId = v))"
                            Data="@_targets" TextProperty="Name" ValueProperty="Id"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Target" Style="width: 160px;" />
            <RadzenDropDown TValue="Guid?" Value="@_filterProjectTagId"
                            ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterProjectTagId = v))"
                            Data="@_projectTagOptions" TextProperty="Label" ValueProperty="Id"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Project Tag" Style="width: 160px;" />
            <RadzenDropDown TValue="Guid?" Value="@_filterEnvTagId"
                            ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterEnvTagId = v))"
                            Data="@_envTagOptions" TextProperty="Label" ValueProperty="Id"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Environment Tag" Style="width: 170px;" />
            <RadzenDropDown TValue="Guid?" Value="@_filterTenantTagSetId"
                            ValueChanged="@(async (Guid? v) => await OnFilterChangedAsync(() => _filterTenantTagSetId = v))"
                            Data="@_tenantTagSetOptions" TextProperty="Label" ValueProperty="Id"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Tenant Tag Set" Style="width: 170px;" />
        </div>
    }

    @* ── Active filter chips ─────────────────────────────────────────── *@
    @if (HasAnyFilter)
    {
        <div class="rz-mb-2" style="display:flex; flex-wrap:wrap; gap:4px; align-items:center;">
            @if (_filterProjectId.HasValue)
            {
                <FilterChip Label="@($"Project: {ProjectName(_filterProjectId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterProjectId = null))" />
            }
            @if (_filterEnvId.HasValue)
            {
                <FilterChip Label="@($"Env: {EnvName(_filterEnvId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterEnvId = null))" />
            }
            @if (_filterTenantId.HasValue)
            {
                <FilterChip Label="@($"Tenant: {TenantName(_filterTenantId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterTenantId = null))" />
            }
            @if (_filterRole.Length > 0)
            {
                <FilterChip Label="@($"Role: {_filterRole}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterRole = ""))" />
            }
            @if (_filterStepId.HasValue)
            {
                <FilterChip Label="@($"Step: {StepName(_filterStepId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterStepId = null))" />
            }
            @if (_filterName.Length > 0)
            {
                <FilterChip Label="@($"Name: {_filterName}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterName = ""))" />
            }
            @if (_filterTargetId.HasValue)
            {
                <FilterChip Label="@($"Target: {TargetName(_filterTargetId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterTargetId = null))" />
            }
            @if (_filterProjectTagId.HasValue)
            {
                <FilterChip Label="@($"ProjTag: {TagLabel(_projectTagOptions, _filterProjectTagId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterProjectTagId = null))" />
            }
            @if (_filterEnvTagId.HasValue)
            {
                <FilterChip Label="@($"EnvTag: {TagLabel(_envTagOptions, _filterEnvTagId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterEnvTagId = null))" />
            }
            @if (_filterTenantTagSetId.HasValue)
            {
                <FilterChip Label="@($"TenantTag: {TagLabel(_tenantTagSetOptions, _filterTenantTagSetId.Value)}")"
                            OnRemove="@(() => ClearFilterAsync(() => _filterTenantTagSetId = null))" />
            }
            <button type="button" class="kraken-vargrid-link" style="font-size:12px;"
                    @onclick="ClearAllFiltersAsync">Clear all</button>
        </div>
    }

    @* ── Content area ────────────────────────────────────────────────── *@
    @if (!_hasFetched)
    {
        @if (_fetching)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Fetching variables...</RadzenText>
        }
        else if (!HasAnyFilter)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                Select a project above to edit its variables, or set any filter for a cross-project
                search@(_autoApply ? "." : ", then click Apply.")
            </RadzenText>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                @(_autoApply ? "Fetching variables..." : "Filters changed. Click Apply to fetch.")
            </RadzenText>
        }
    }
    else
    {
        @* Grid stays mounted across refetches (IsLoading shows the overlay);
           unmounting it on every fetch lost edit/paging state and flickered. *@
        @* ── New variable row (only when a project is selected) ──────── *@
        @if (_filterProjectId.HasValue)
        {
            <RequirePermission Permission="Permission.VariableEdit">
                <div class="kraken-newvar-bar">
                    <div class="kraken-newvar-name">
                        <RadzenLabel Text="Name" />
                        <RadzenTextBox @bind-Value="_newName" Placeholder="Enter new variable" Style="width: 100%;" />
                    </div>
                    <div class="kraken-newvar-value">
                        <RadzenLabel Text="Value" />
                        @if (_newType == VariableType.Sensitive)
                        {
                            <RadzenPassword @bind-Value="_newValue" Placeholder="Enter value" Style="width: 100%;" />
                        }
                        else if (_newType == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenTextBox @bind-Value="_newValue" Placeholder='["a","b"] or a, b' Style="flex: 1;" />
                                <RadzenButton Icon="format_list_bulleted" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small" Click="@(args => OpenArrayEditorForNew(args))" title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenTextBox @bind-Value="_newValue" Placeholder="Enter value" Style="width: 100%;" />
                        }
                    </div>
                    <div class="kraken-newvar-type">
                        <RadzenLabel Text="Type" />
                        <RadzenDropDown TValue="VariableType" @bind-Value="_newType"
                                        Data="@_typeOptions" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" />
                    </div>
                    <div class="kraken-newvar-scope">
                        <RadzenLabel Text="Scope" />
                        <button type="button" class="kraken-newvar-scope-btn" @onclick="@(args => OpenNewScopePopup(args))">
                            @ScopeLabelForNew()
                        </button>
                    </div>
                    <div class="kraken-newvar-actions">
                        <RadzenButton Text="Add" Icon="add_circle_outline" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small" Disabled="@(string.IsNullOrWhiteSpace(_newName))"
                                      Click="AddNewVariableAsync" />
                    </div>
                </div>
            </RequirePermission>
        }

        @* NOTE: RadzenDataGrid.Groups is NOT a [Parameter] — a Groups="..."
           attribute is silently swallowed by CaptureUnmatchedValues. Grouping
           is driven programmatically via _grid.Groups (see OnGridRender /
           ApplyGroupByAsync), which is the officially supported pattern. *@
        <KrakenGrid SettingsKey="all-variables" @key="@("all-variables-grid")" @ref="_grid" Data="@_variables" TItem="Variable"
                    IsLoading="@_fetching"
                    AllowFiltering="true" FilterMode="FilterMode.Simple"
                    AllowSorting="true" AllowPaging="true" PageSize="50"
                    AllowGrouping="true"
                    DefaultGroups="@_defaultGroups"
                    Render="@OnGridRender"
                    AllGroupsExpanded="@_allExpanded"
                    AllGroupsExpandedChanged="@(v => _allExpanded = v)"
                    AllowColumnResize="true"
                    EditMode="DataGridEditMode.Single"
                    CellRender="@OnCellRender"
                    CellClick="@OnCellClickAsync"
                    RowUpdate="@OnRowUpdateAsync"
                    EmptyText="No variables match the current filters.">
            <GroupHeaderTemplate Context="group">
                <strong>@GroupKeyLabel(group)</strong>
                <span class="rz-color-secondary rz-ml-2">
                    (@group.Data.Count value@(group.Data.Count == 1 ? "" : "s"))
                </span>
            </GroupHeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="Variable" Property="Name" Title="Name" Width="220px">
                    <Template Context="v">
                        @if (IsLocked(v))
                        {
                            <RadzenIcon Icon="lock" Style="font-size:0.8rem; opacity:0.5; margin-right:4px;" />
                        }
                        @v.Name
                    </Template>
                    <EditTemplate Context="v">
                        <RadzenTextBox @bind-Value="v.Name" Style="width: 100%;" Placeholder="Variable name" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Property="Value" Title="Value" Sortable="false" Groupable="false">
                    <Template Context="v">
                        @if (v.Type == VariableType.Sensitive)
                        {
                            <RadzenBadge Text="*** sensitive ***" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                        }
                        else if (v.Type == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                <code class="kraken-var-value">@FormatArrayPreview(v.Value)</code>
                                <RadzenButton Icon="format_list_bulleted" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall" Click="@(args => OpenArrayEditor(args, v))"
                                              @onclick:stopPropagation="true" title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <code class="kraken-var-value">@v.Value</code>
                        }
                    </Template>
                    <EditTemplate Context="v">
                        @if (v.Type == VariableType.Sensitive)
                        {
                            <RadzenPassword @bind-Value="v.Value" Style="width: 100%;" Placeholder="(retype to change)" />
                        }
                        else if (v.Type == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenTextBox @bind-Value="v.Value" Style="flex: 1;" Placeholder='["a","b"] or a, b' />
                                <RadzenButton Icon="format_list_bulleted" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall" Click="@(args => OpenArrayEditor(args, v))"
                                              @onclick:stopPropagation="true" title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenTextBox @bind-Value="v.Value" Style="width: 100%;" Placeholder="Enter value" />
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Property="Type" Title="Type" Width="110px">
                    <Template Context="v">@v.Type</Template>
                    <EditTemplate Context="v">
                        <RadzenDropDown TValue="VariableType" @bind-Value="v.Type"
                                        Data="@_typeOptions" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* UniqueID + GroupProperty make this template column drag-groupable —
                   Radzen's drop handler skips columns with neither a Property nor a
                   UniqueID, so without these Source could never be dragged to the
                   group panel. Groups by SetId; the header maps id → friendly name. *@
                <RadzenDataGridColumn TItem="Variable" Title="Source" Width="140px" Sortable="false" Filterable="false"
                                      UniqueID="source" GroupProperty="@nameof(Variable.SetId)">
                    <Template Context="v">
                        <span class="@(IsLocked(v) ? "rz-color-secondary" : "")">@SourceLabel(v)</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="Scope" Sortable="false" Filterable="false" Groupable="false">
                    <Template Context="v">
                        @if (IsLocked(v))
                        {
                            @* Library rows are read-only here — scope chips without the edit affordance. *@
                            <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.3rem" AlignItems="AlignItems.Center">
                                @if (v.Scope.IsUnscoped)
                                {
                                    <span class="rz-color-secondary" style="font-size:12px;">unscoped</span>
                                }
                                @if (v.Scope.EnvironmentId is { } lEnvId)
                                {
                                    <RadzenBadge Text="@($"env: {EnvName(lEnvId)}")" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                                }
                                @if (v.Scope.TenantId is { } lTenantId)
                                {
                                    <RadzenBadge Text="@($"tenant: {TenantName(lTenantId)}")" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                }
                                @if (v.Scope.TargetId is { } lTargetId)
                                {
                                    <RadzenBadge Text="@($"target: {TargetName(lTargetId)}")" BadgeStyle="BadgeStyle.Secondary" IsPill="true" />
                                }
                                @if (v.Scope.Roles is { Count: > 0 })
                                {
                                    @foreach (var r in v.Scope.Roles)
                                    {
                                        <RadzenBadge Text="@($"role: {r}")" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                    }
                                }
                            </RadzenStack>
                        }
                        else
                        {
                        <button type="button"
                                class="@(v.Scope.IsUnscoped ? "kraken-vargrid-link kraken-scope-unbound-btn" : "kraken-scope-chip-btn")"
                                @onclick="@(args => OpenScopePopup(args, v))"
                                @onclick:stopPropagation="true">
                            @if (v.Scope.IsUnscoped)
                            {
                                <text>Define scope</text>
                            }
                            else
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.3rem" AlignItems="AlignItems.Center">
                                    @if (v.Scope.EnvironmentId is { } envId)
                                    {
                                        <RadzenBadge Text="@($"env: {EnvName(envId)}")" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                                    }
                                    @if (v.Scope.TenantId is { } tenantId)
                                    {
                                        <RadzenBadge Text="@($"tenant: {TenantName(tenantId)}")" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                    }
                                    @if (v.Scope.TargetId is { } targetId)
                                    {
                                        <RadzenBadge Text="@($"target: {TargetName(targetId)}")" BadgeStyle="BadgeStyle.Secondary" IsPill="true" />
                                    }
                                    @if (v.Scope.ChannelId is { } channelId)
                                    {
                                        <RadzenBadge Text="@($"channel: {ChannelName(channelId)}")" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                                    }
                                    @if (v.Scope.ProcessStepId is { } stepId)
                                    {
                                        <RadzenBadge Text="@($"step: {StepName(stepId)}")" BadgeStyle="BadgeStyle.Primary" IsPill="true" />
                                    }
                                    @if (v.Scope.Roles is { Count: > 0 })
                                    {
                                        @foreach (var r in v.Scope.Roles)
                                        {
                                            <RadzenBadge Text="@($"role: {r}")" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                        }
                                    }
                                    <RadzenIcon Icon="edit" Style="font-size: 0.95rem; opacity: 0.55;" />
                                </RadzenStack>
                            }
                        </button>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="" Width="140px" Sortable="false" Filterable="false" Groupable="false" TextAlign="TextAlign.Right">
                    <Template Context="v">
                        @if (!IsLocked(v))
                        {
                            <RequirePermission Permission="Permission.VariableEdit">
                                <RadzenButton Icon="more_vert" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                              Click="@(args => ShowRowMenu(args, v))" @onclick:stopPropagation="true" />
                            </RequirePermission>
                        }
                    </Template>
                    <EditTemplate Context="v">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => _grid.UpdateRow(v))" @onclick:stopPropagation="true" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" class="rz-ml-1"
                                      Click="@(() => CancelEditAsync(v))" @onclick:stopPropagation="true" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </KrakenGrid>

        @* ── Included library sets (only when project selected) ──────── *@
        @if (_filterProjectId.HasValue && _includedSets.Count > 0)
        {
            <RadzenCard class="rz-mt-4">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Included Library Variable Sets</RadzenText>
                    <RequirePermission Permission="Permission.VariableEdit">
                        <RadzenButton Icon="add" Text="Include set" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small" Click="OpenIncludeSetDialog" />
                    </RequirePermission>
                </RadzenStack>
                <RadzenStack Gap="0.5rem">
                    @foreach (var set in _includedSets)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" class="kraken-included-set-row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="library_books" Style="font-size:1.1rem; opacity:0.6;" />
