}

@* ── Scope popup ─────────────────────────────────────────────────────────── *@
@if (_popupOpen)
{
    <div class="kraken-scope-popup-backdrop" @onclick="ClosePopup"></div>
    <div class="kraken-scope-popup" style="@($"top: {_popupTop}px; left: {_popupLeft}px;")" @onclick:stopPropagation="true">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                @(_popupEditingVar is null ? "Define scope" : "Edit scope")
            </RadzenText>
            <div>
                <RadzenLabel Text="Environments" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popEnvIds"
                                Data="@_environments" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any environment)" Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Tenants" />
                <RadzenDropDown TValue="IEnumerable<Guid>" Value="@_popTenantIds"
                                ValueChanged="@OnPopTenantsChanged"
                                Data="@_tenants" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any tenant)" Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Targets" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popTargetIds"
                                Data="@PopTargetOptions" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any target)" Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Channel" />
                <RadzenDropDown TValue="Guid?" @bind-Value="_popChannelId"
                                Data="@_channels" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="(any channel)" Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Step" />
                <RadzenDropDown TValue="Guid?" @bind-Value="_popProcessStepId"
                                Data="@_projectStepNames" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="(any step)" Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Target Roles" />
                <RadzenDropDown TValue="IEnumerable<string>" @bind-Value="_popRoles"
                                Data="@_availableRoles" Multiple="true" AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any role)" Style="width: 100%;" />
            </div>
            @if (_popupEditingVar?.Type == VariableType.Sensitive
                 && (CountOf(_popEnvIds) > 1 || CountOf(_popTenantIds) > 1 || CountOf(_popTargetIds) > 1))
            {
                <div class="kraken-scope-popup-warning">
                    Multi-scope expansion is disabled for sensitive variables -
                    only the first selection of each dimension will be applied.
                </div>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <button type="button" class="kraken-vargrid-link" @onclick="OpenAdvancedEditorAsync">Open editor</button>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ClosePopup" />
                    <RadzenButton Text="Done" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="SaveScopeAsync" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </div>
}

@code {
    private enum VarMode { Edit, Preview }
    private VarMode _mode = VarMode.Edit;

    private RadzenDataGrid<Variable> _grid = default!;
    private bool _loaded;
    private string? _loadError;

    private List<Project> _projects = [];
    private List<DeploymentEnvironment> _environments = [];
    private List<Tenant> _tenants = [];
    private List<DeploymentTarget> _targets = [];
    private Dictionary<Guid, HashSet<Guid>> _targetTenantMap = [];
    private List<Channel> _channels = [];
    private List<string> _availableRoles = [];
    private sealed record StepOption(Guid Id, string Name);
    private List<StepOption> _projectStepNames = [];
    private Dictionary<Guid, string> _envNames = [];
    private Dictionary<Guid, string> _tenantNames = [];
    private Dictionary<Guid, string> _targetNames = [];

    private sealed record TagOption(Guid Id, string Label);
    private List<TagOption> _projectTagOptions = [];
    private List<TagOption> _envTagOptions = [];
    private List<TagOption> _tenantTagSetOptions = [];

    // ── Filter state ────────────────────────────────────────────────────
    private Guid? _filterProjectId;
    private Guid? _filterEnvId;
    private Guid? _filterTenantId;
    private string _filterRole = "";
    private Guid? _filterStepId;
    private string _filterName = "";
    private Guid? _filterTargetId;
    private Guid? _filterProjectTagId;
    private Guid? _filterEnvTagId;
    private Guid? _filterTenantTagSetId;
    private bool _showMoreFilters;
    private bool _autoApply = true;
    private bool _hasFetched;
    private bool _fetching;
    private System.Threading.CancellationTokenSource? _debounceCts;

    private bool HasAnyFilter =>
        _filterProjectId.HasValue || _filterEnvId.HasValue || _filterTenantId.HasValue
        || _filterRole.Length > 0 || _filterStepId.HasValue || _filterName.Length > 0
        || _filterTargetId.HasValue || _filterProjectTagId.HasValue
        || _filterEnvTagId.HasValue || _filterTenantTagSetId.HasValue;

    // ── Data ────────────────────────────────────────────────────────────
    private List<Variable> _variables = [];
    private List<VariableSet> _includedSets = [];
    private Dictionary<Guid, string> _sourceNames = [];
    private HashSet<Guid> _lockedIds = [];

    private readonly List<GroupDescriptor> _groups = [new() { Property = nameof(Variable.Name) }];
    private bool? _allExpanded = true;
    private void SetAllExpanded(bool v) => _allExpanded = v;

    // ── Preview mode ────────────────────────────────────────────────────
    private Guid? _previewProjectId;
    private Guid? _previewEnvId;
    private Guid? _previewTargetId;
    private Guid? _previewTenantId;
    private bool _previewLoading;
    private Dictionary<string, string>? _previewResult;
    private List<PreviewRow> _previewRows = [];
    private sealed record PreviewRow(string Name, string Value, bool Sensitive);

    // ── New variable row ────────────────────────────────────────────────
    private string _newName = "";
    private string _newValue = "";
    private VariableType _newType = VariableType.Text;
    private VariableScope _newScope = new();
    private record TypeOption(VariableType Value, string Label);
    private readonly TypeOption[] _typeOptions =
    [
        new(VariableType.Text, "Text"),
        new(VariableType.Sensitive, "Sensitive"),
        new(VariableType.StringArray, "Array"),
    ];

    // ── Scope popup ─────────────────────────────────────────────────────
    private bool _popupOpen;
    private double _popupTop;
    private double _popupLeft;
    private Variable? _popupEditingVar;
    private IEnumerable<Guid> _popEnvIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTenantIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTargetIds = Array.Empty<Guid>();
    private Guid? _popChannelId;
    private Guid? _popProcessStepId;
    private IEnumerable<string> _popRoles = [];

    // ── Array editor ────────────────────────────────────────────────────
    private bool _arrayPopupOpen;
    private double _arrayPopupTop;
    private double _arrayPopupLeft;
    private Variable? _arrayEditingVar;
    private string _arrayLines = "";

    // ── Lifecycle ───────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _projects = await ProjectSvc.GetAllAsync();
            _environments = await EnvironmentSvc.GetAllOrderedAsync(includeArchived: true);
            _envNames = _environments.ToDictionary(e => e.Id, e => e.Name);
            _tenants = await TenantSvc.GetAllAsync();
            _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);
            _targets = await TargetSvc.GetAllAsync();
            _targetNames = _targets.ToDictionary(t => t.Id, t => t.Name);
            _targetTenantMap = await TargetSvc.GetTenantAssociationMapAsync();
            _availableRoles = _targets.SelectMany(t => t.Roles)
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(r => r, StringComparer.OrdinalIgnoreCase)
                .ToList();

            await LoadTagOptionsAsync();

            if (!_loaded)
            {
                var uri = Nav.ToAbsoluteUri(Nav.Uri);
                var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                if (query.TryGetValue("project", out var projSlug))
                {
                    _filterProjectId = _projects
                        .FirstOrDefault(p => string.Equals(p.Slug, projSlug.ToString(), StringComparison.OrdinalIgnoreCase))?.Id;
                }
                if (query.TryGetValue("env", out var envVal) && Guid.TryParse(envVal, out var envId)) _filterEnvId = envId;
                if (query.TryGetValue("tenant", out var tenantVal) && Guid.TryParse(tenantVal, out var tenantId)) _filterTenantId = tenantId;
                if (query.TryGetValue("role", out var roleVal) && roleVal.ToString() is { Length: > 0 } r) _filterRole = r;
                if (query.TryGetValue("name", out var nameVal) && nameVal.ToString() is { Length: > 0 } n) _filterName = n;

                if (HasAnyFilter)
                {
                    await FetchAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task LoadTagOptionsAsync()
    {
        var projSets = await TagSvc.GetSetsForKindAsync(TaggableEntityKind.Project);
        _projectTagOptions = projSets
            .Where(s => s.Type != TagSetType.FreeText)
            .SelectMany(s => s.Tags.Select(t => new TagOption(t.Id, $"{s.Name}/{t.Name}")))
            .ToList();

        var envSets = await TagSvc.GetSetsForKindAsync(TaggableEntityKind.Environment);
        _envTagOptions = envSets
            .Where(s => s.Type != TagSetType.FreeText)
            .SelectMany(s => s.Tags.Select(t => new TagOption(t.Id, $"{s.Name}/{t.Name}")))
            .ToList();

        var tenantSets = await TagSvc.GetSetsForKindAsync(TaggableEntityKind.Tenant);
        _tenantTagSetOptions = tenantSets
            .Select(s => new TagOption(s.Id, s.Name))
            .ToList();
    }

    // ── Filter change + debounce ────────────────────────────────────────

    private async Task OnFilterChangedAsync(Action setter)
    {
        setter();
        await MaybeAutoFetchAsync();
    }

    private void OnNameKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_autoApply && HasAnyFilter)
        {
            _ = FetchAsync();
        }
        else if (_autoApply)
        {
            _ = MaybeAutoFetchAsync();
        }
    }

    private async Task MaybeAutoFetchAsync()
    {
        if (!_autoApply || !HasAnyFilter) return;
        _debounceCts?.Cancel();
        _debounceCts = new System.Threading.CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(400, token);
            if (!token.IsCancellationRequested)
            {
                await FetchAsync();
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearFilterAsync(Action setter)
    {
        setter();
        if (_autoApply && HasAnyFilter)
        {
            await FetchAsync();
        }
        else if (!HasAnyFilter)
        {
            _variables = [];
            _hasFetched = false;
        }
    }

    private async Task ClearAllFiltersAsync()
    {
        _filterProjectId = null;
        _filterEnvId = null;
        _filterTenantId = null;
        _filterRole = "";
        _filterStepId = null;
        _filterName = "";
        _filterTargetId = null;
        _filterProjectTagId = null;
        _filterEnvTagId = null;
        _filterTenantTagSetId = null;
        _variables = [];
        _includedSets = [];
        _sourceNames.Clear();
        _lockedIds.Clear();
        _hasFetched = false;
        await Task.CompletedTask;
    }

    // ── Fetch ───────────────────────────────────────────────────────────

    private async Task FetchAsync()
    {
        if (!HasAnyFilter) return;
        _fetching = true;
        StateHasChanged();

        try
        {
            IReadOnlyCollection<Guid>? projectIds = null;
            IReadOnlyCollection<Guid>? environmentIds = null;

            if (_filterProjectTagId.HasValue)
            {
                projectIds = await TagSvc.GetEntityIdsWithAnyTagAsync(TaggableEntityKind.Project, [_filterProjectTagId.Value]);
            }
            if (_filterEnvTagId.HasValue)
            {
                environmentIds = await TagSvc.GetEntityIdsWithAnyTagAsync(TaggableEntityKind.Environment, [_filterEnvTagId.Value]);
            }

            _variables = await VariableSvc.SearchVariablesAsync(
                projectId: _filterProjectId,
                environmentId: _filterEnvId,
                tenantId: _filterTenantId,
                role: _filterRole.Length > 0 ? _filterRole : null,
                stepId: _filterStepId,
                targetId: _filterTargetId,
                nameContains: _filterName.Length > 0 ? _filterName : null,
                projectIds: projectIds,
                environmentIds: environmentIds);

            _sourceNames.Clear();
            _lockedIds.Clear();
            _includedSets = [];

            if (_filterProjectId.HasValue)
            {
                await LoadProjectContextAsync(_filterProjectId.Value);
            }

            _hasFetched = true;
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Fetch failed", ex.Message, 5000);
        }
        finally
        {
            _fetching = false;
        }
    }

    private async Task LoadProjectContextAsync(Guid projectId)
    {
        var project = _projects.FirstOrDefault(p => p.Id == projectId);
        if (project is null) return;

        _channels = await ChannelSvc.GetForProjectAsync(project.Id);
        var process = await ProcessSvc.GetAsync(project.Id);
        _projectStepNames = process?.Steps.Select(s => new StepOption(s.Id, s.Name)).ToList() ?? [];

        var stepRoles = process?.Steps.SelectMany(s => s.TargetRoles) ?? [];
        _availableRoles = _targets.SelectMany(t => t.Roles)
            .Concat(stepRoles)
            .Where(r => !string.IsNullOrWhiteSpace(r))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(r => r, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _includedSets = await VariableSvc.GetIncludedSetsAsync(project.Id);
        foreach (var set in _includedSets)
        {
            foreach (var v in set.Variables)
            {
                _sourceNames[v.Id] = set.Name ?? "Library";
                _lockedIds.Add(v.Id);
            }
        }

        var libVars = _includedSets.SelectMany(s => s.Variables).ToList();
        var existing = _variables.Select(v => v.Id).ToHashSet();
        foreach (var lv in libVars)
        {
            if (!existing.Contains(lv.Id))
            {
                _variables.Add(lv);
            }
        }
    }

    // ── Helpers ─────────────────────────────────────────────────────────

    private bool IsLocked(Variable v) => _lockedIds.Contains(v.Id);
    private string SourceLabel(Variable v) => _sourceNames.TryGetValue(v.Id, out var s) ? s : "Project";
    private string ProjectName(Guid id) => _projects.FirstOrDefault(p => p.Id == id)?.Name ?? "?";
    private string EnvName(Guid id) => _envNames.TryGetValue(id, out var n) ? n : "?";
    private string TenantName(Guid id) => _tenantNames.TryGetValue(id, out var n) ? n : "?";
    private string TargetName(Guid id) => _targetNames.TryGetValue(id, out var n) ? n : "?";
    private string ChannelName(Guid id) => _channels.FirstOrDefault(c => c.Id == id)?.Name ?? "?";
    private string StepName(Guid id) => _projectStepNames.FirstOrDefault(s => s.Id == id)?.Name ?? "?";
    private string TagLabel(List<TagOption> options, Guid id) => options.FirstOrDefault(t => t.Id == id)?.Label ?? "?";
    private static int CountOf(IEnumerable<Guid>? e) => e?.Count() ?? 0;

    private IEnumerable<DeploymentTarget> PopTargetOptions
    {
        get
        {
            var tenantIds = _popTenantIds.ToHashSet();
            if (tenantIds.Count == 0) return _targets;
            return _targets.Where(t => _targetTenantMap.TryGetValue(t.Id, out var serves) && serves.Overlaps(tenantIds));
        }
    }

    private void OnPopTenantsChanged(IEnumerable<Guid> tenantIds)
    {
        _popTenantIds = tenantIds;
        var allowed = PopTargetOptions.Select(t => t.Id).ToHashSet();
        _popTargetIds = _popTargetIds.Where(allowed.Contains).ToList();
    }

    // ── Grid edit ───────────────────────────────────────────────────────

    private static bool IsEditableProperty(string? prop) =>
        prop is nameof(Variable.Name) or nameof(Variable.Value) or nameof(Variable.Type);

    private void OnCellRender(DataGridCellRenderEventArgs<Variable> args)
    {
        if (args.Column is { } col && IsEditableProperty(col.Property))
        {
            args.Attributes.Add("style", "cursor: pointer;");
        }
    }

    private async Task OnCellClickAsync(DataGridCellMouseEventArgs<Variable> args)
    {
        if (args.Column is { } col && IsEditableProperty(col.Property)
            && args.Data is { } data && !IsLocked(data))
        {
            await _grid.EditRow(data);
        }
    }

    private async Task OnRowUpdateAsync(Variable v)
    {
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        try
        {
            await VariableSvc.UpdateVariableAsync(v.Id, v.Name, v.Value, v.Type, v.Scope, await Guard.CurrentCallerAsync());
            await FetchAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Save failed", ex.Message, 5000);
        }
    }

    private async Task CancelEditAsync(Variable v)
    {
        _grid.CancelEditRow(v);
        await FetchAsync();
    }

    private async Task AddNewVariableAsync()
    {
        if (!_filterProjectId.HasValue || string.IsNullOrWhiteSpace(_newName)) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        try
        {
            await VariableSvc.CreateVariableAsync(
                _filterProjectId.Value, _newName, _newValue ?? "", _newType, _newScope, await Guard.CurrentCallerAsync());
            _newName = "";
            _newValue = "";
            _newType = VariableType.Text;
            _newScope = new VariableScope();
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Added", "Variable was added.", 3000);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Add failed", ex.Message, 5000);
        }
    }

    private string ScopeLabelForNew()
    {
        if (_newScope.IsUnscoped) return "Define scope";
        var parts = new List<string>();
        if (_newScope.EnvironmentId is { } e) parts.Add($"env: {EnvName(e)}");
        if (_newScope.TenantId is { } t) parts.Add($"tenant: {TenantName(t)}");
        if (_newScope.TargetId is { } tg) parts.Add($"target: {TargetName(tg)}");
        if (_newScope.ChannelId is { } c) parts.Add($"channel: {ChannelName(c)}");
        if (_newScope.ProcessStepId is { } st) parts.Add($"step: {StepName(st)}");
        if (_newScope.Roles is { Count: > 0 } r) parts.Add($"roles: {string.Join(",", r)}");
        return string.Join(" | ", parts);
    }

    // ── Context menu ────────────────────────────────────────────────────

    private void ShowRowMenu(MouseEventArgs args, Variable v)
    {
        ContextMenu.Open(args, new List<ContextMenuItem>
        {
            new() { Text = "Add Value", Value = "add", Icon = "add" },
            new() { Text = "Duplicate Variable", Value = "duplicate", Icon = "content_copy" },
            new() { Text = "Delete Variable", Value = "delete", Icon = "delete" },
        }, async e =>
        {
            ContextMenu.Close();
            switch (e.Value)
            {
                case "add": await AddValueAsync(v); break;
                case "duplicate": await DuplicateAsync(v); break;
                case "delete": await DeleteAsync(v); break;
            }
        });
    }

    private async Task AddValueAsync(Variable v)
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        await VariableSvc.CreateVariableAsync(
            _filterProjectId.Value, v.Name, "", VariableType.Text, new VariableScope(), await Guard.CurrentCallerAsync());
        await FetchAsync();
    }

    private async Task DuplicateAsync(Variable v)
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var rawValue = v.Type == VariableType.Sensitive ? "" : v.Value;
        await VariableSvc.CreateVariableAsync(
            _filterProjectId.Value, v.Name + " (copy)", rawValue, v.Type,
            new VariableScope
            {
                EnvironmentId = v.Scope.EnvironmentId,
                TenantId = v.Scope.TenantId,
                TargetId = v.Scope.TargetId,
                Roles = v.Scope.Roles is { Count: > 0 } r ? [..r] : null,
            }, await Guard.CurrentCallerAsync());
        await FetchAsync();
    }

    private async Task DeleteAsync(Variable v)
    {
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var confirmed = await Dialog.Confirm(
            $"Delete variable '{v.Name}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed == true)
        {
            await VariableSvc.DeleteVariableAsync(v.Id, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Deleted", $"Variable '{v.Name}' was removed.", 3000);
        }
    }

    // ── Included sets ───────────────────────────────────────────────────

    private async Task OpenIncludeSetDialog()
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var available = await VariableSvc.GetAvailableLibrarySetsAsync(_filterProjectId.Value);
        if (available.Count == 0)
        {
            Notifications.Notify(NotificationSeverity.Info, "No sets available", "All library variable sets are already included.", 3000);
            return;
        }
        var result = await Dialog.OpenAsync<IncludeVariableSetDialog>(
            "Include Library Variable Set",
            new Dictionary<string, object?> { [nameof(IncludeVariableSetDialog.Sets)] = available },
            new DialogOptions { Width = "420px" });
        if (result is Guid setId)
        {
            await VariableSvc.IncludeSetAsync(_filterProjectId.Value, setId, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Included", "Library variable set was added.", 3000);
        }
    }

    private async Task RemoveIncludedSetAsync(Guid setId)
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var confirmed = await Dialog.Confirm(
            "Remove this library variable set from the project?",
            "Confirm Remove",
            new ConfirmOptions { OkButtonText = "Remove", CancelButtonText = "Cancel" });
        if (confirmed == true)
        {
            await VariableSvc.ExcludeSetAsync(_filterProjectId.Value, setId, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Removed", "Library variable set was excluded.", 3000);
        }
    }

    // ── Scope popup ─────────────────────────────────────────────────────

    private void OpenScopePopup(MouseEventArgs args, Variable v)
    {
        _popupEditingVar = v;
        SeedPopupFromScope(v.Scope);
        SetPopupPosition(args);
        _popupOpen = true;
    }

    private void OpenNewScopePopup(MouseEventArgs args)
    {
        _popupEditingVar = null;
        SeedPopupFromScope(_newScope);
        SetPopupPosition(args);
        _popupOpen = true;
    }

    private void SetPopupPosition(MouseEventArgs args)
    {
        const double popupWidth = 420;
        const double margin = 8;
        _popupTop = args.ClientY + margin;
        _popupLeft = args.ClientX - popupWidth / 2;
        if (_popupLeft < margin) _popupLeft = margin;
    }

    private void ClosePopup() => _popupOpen = false;

    private void SeedPopupFromScope(VariableScope s)
    {
        _popEnvIds = s.EnvironmentId.HasValue ? new[] { s.EnvironmentId.Value } : [];
        _popTenantIds = s.TenantId.HasValue ? new[] { s.TenantId.Value } : [];
        _popTargetIds = s.TargetId.HasValue ? new[] { s.TargetId.Value } : [];
        _popRoles = s.Roles is { Count: > 0 } r ? r.ToList() : [];
        foreach (var role in _popRoles.Where(r => !_availableRoles.Contains(r, StringComparer.OrdinalIgnoreCase)))
        {
            _availableRoles.Add(role);
        }
        _popChannelId = s.ChannelId;
        _popProcessStepId = s.ProcessStepId;
    }

    private async Task SaveScopeAsync()
    {
        if (!_filterProjectId.HasValue) return;
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;

        var roles = _popRoles.Where(r => !string.IsNullOrWhiteSpace(r)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var envIds = _popEnvIds.ToList();
        var tenantIds = _popTenantIds.ToList();
        var targetIds = _popTargetIds.ToList();

        if (_popupEditingVar is null)
        {
            if (envIds.Count <= 1 && tenantIds.Count <= 1 && targetIds.Count <= 1)
            {
                _newScope = new VariableScope
                {
                    EnvironmentId = envIds.Count > 0 ? envIds[0] : null,
                    TenantId = tenantIds.Count > 0 ? tenantIds[0] : null,
                    TargetId = targetIds.Count > 0 ? targetIds[0] : null,
                    ChannelId = _popChannelId,
                    ProcessStepId = _popProcessStepId,
                    Roles = roles.Count > 0 ? roles : null,
                };
                ClosePopup();
                return;
            }

            if (string.IsNullOrWhiteSpace(_newName))
            {
                Notifications.Notify(NotificationSeverity.Warning, "Missing name",
                    "Type a variable name before saving a multi-scope.", 5000);
                return;
            }

            var envSetN = envIds.Count > 0 ? envIds.Cast<Guid?>().ToList() : [null];
            var tenantSetN = tenantIds.Count > 0 ? tenantIds.Cast<Guid?>().ToList() : [null];
            var targetSetN = targetIds.Count > 0 ? targetIds.Cast<Guid?>().ToList() : [null];

            foreach (var e in envSetN)
                foreach (var t in tenantSetN)
                    foreach (var tg in targetSetN)
                    {
                        await VariableSvc.CreateVariableAsync(
                            _filterProjectId.Value, _newName, _newValue ?? "", _newType,
                            new VariableScope
                            {
                                EnvironmentId = e, TenantId = t, TargetId = tg,
                                ChannelId = _popChannelId, ProcessStepId = _popProcessStepId,
                                Roles = roles.Count > 0 ? [..roles] : null,
                            }, await Guard.CurrentCallerAsync());
                    }

            _newName = ""; _newValue = ""; _newType = VariableType.Text; _newScope = new VariableScope();
            ClosePopup();
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Added", "Variable was added (multi-scope).", 3000);
            return;
        }

        var sensitiveEdit = _popupEditingVar.Type == VariableType.Sensitive;
        if (sensitiveEdit)
        {
            await VariableSvc.UpdateVariableAsync(
                _popupEditingVar.Id, _popupEditingVar.Name, null, _popupEditingVar.Type,
                new VariableScope
                {
                    EnvironmentId = envIds.Count > 0 ? envIds[0] : null,
                    TenantId = tenantIds.Count > 0 ? tenantIds[0] : null,
                    TargetId = targetIds.Count > 0 ? targetIds[0] : null,
                    ChannelId = _popChannelId, ProcessStepId = _popProcessStepId,
                    Roles = roles.Count > 0 ? roles : null,
                }, await Guard.CurrentCallerAsync());
        }
        else
        {
            var envSet = envIds.Count > 0 ? envIds.Cast<Guid?>().ToList() : [null];
            var tenantSet = tenantIds.Count > 0 ? tenantIds.Cast<Guid?>().ToList() : [null];
            var targetSet = targetIds.Count > 0 ? targetIds.Cast<Guid?>().ToList() : [null];
            var name = _popupEditingVar.Name;
            var value = _popupEditingVar.Value;
            var type = _popupEditingVar.Type;

            await VariableSvc.DeleteVariableAsync(_popupEditingVar.Id, await Guard.CurrentCallerAsync());
            foreach (var e in envSet)
                foreach (var t in tenantSet)
                    foreach (var tg in targetSet)
                    {
                        await VariableSvc.CreateVariableAsync(
                            _filterProjectId.Value, name, value, type,
                            new VariableScope
                            {
                                EnvironmentId = e, TenantId = t, TargetId = tg,
                                ChannelId = _popChannelId, ProcessStepId = _popProcessStepId,
                                Roles = roles.Count > 0 ? [..roles] : null,
                            }, await Guard.CurrentCallerAsync());
                    }
        }

        ClosePopup();
        await FetchAsync();
        Notifications.Notify(NotificationSeverity.Success, "Scope saved", "Variable scope was updated.", 3000);
    }

    private async Task OpenAdvancedEditorAsync()
    {
        ClosePopup();
        if (_popupEditingVar is not null)
        {
            await Dialog.OpenAsync<VariableFormDialog>(
                "Edit Variable",
                new Dictionary<string, object?>
                {
                    [nameof(VariableFormDialog.Variable)] = _popupEditingVar,
                    [nameof(VariableFormDialog.ProjectId)] = _filterProjectId,
                },
                new DialogOptions { Width = "640px" });
            await FetchAsync();
        }
    }

    // ── Array editor ────────────────────────────────────────────────────

    private static string FormatArrayPreview(string? json)
    {
        var items = ParseArrayJson(json);
        return items.Count switch
        {
            0 => "[]",
            1 => $"[{items[0]}]",
            _ => $"[{items[0]}, ... ({items.Count} items)]",
        };
    }

    private static List<string> ParseArrayJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try { return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? []; }
        catch { return json.Split(',', StringSplitOptions.None).Select(s => s.Trim()).ToList(); }
    }

    private void OpenArrayEditor(MouseEventArgs args, Variable v)
    {
        _arrayEditingVar = v;
        _arrayLines = string.Join("\n", ParseArrayJson(v.Value));
        SetArrayPopupPosition(args);
        _arrayPopupOpen = true;
    }

    private void OpenArrayEditorForNew(MouseEventArgs args)
    {
        _arrayEditingVar = null;
        _arrayLines = string.Join("\n", ParseArrayJson(_newValue));
        SetArrayPopupPosition(args);
        _arrayPopupOpen = true;
    }

    private void SetArrayPopupPosition(MouseEventArgs args)
    {
        const double popupWidth = 460;
        const double margin = 8;
        _arrayPopupTop = args.ClientY + margin;
        _arrayPopupLeft = args.ClientX - popupWidth / 2;
        if (_arrayPopupLeft < margin) _arrayPopupLeft = margin;
    }

    private void CloseArrayEditor() => _arrayPopupOpen = false;

    private async Task SaveArrayAsync()
    {
        if (!await Guard.AllowAsync(Permission.VariableEdit)) return;
        var lines = (_arrayLines ?? "").Split('\n', StringSplitOptions.None).Select(l => l.TrimEnd('\r')).ToList();
        var json = System.Text.Json.JsonSerializer.Serialize(lines);
        if (_arrayEditingVar is null)
        {
            _newValue = json;
        }
        else
        {
            await VariableSvc.UpdateVariableAsync(
                _arrayEditingVar.Id, _arrayEditingVar.Name, json,
                _arrayEditingVar.Type, _arrayEditingVar.Scope, await Guard.CurrentCallerAsync());
            await FetchAsync();
            Notifications.Notify(NotificationSeverity.Success, "Saved", "Array value updated.", 3000);
        }
        CloseArrayEditor();
    }

    // ── Preview ─────────────────────────────────────────────────────────

    private async Task RunPreviewAsync()
    {
        if (!_previewProjectId.HasValue || !_previewEnvId.HasValue) return;
        _previewLoading = true;
        _previewResult = null;
        _previewRows = [];
        StateHasChanged();

        try
        {
            var targetRoles = _previewTargetId.HasValue
                ? _targets.FirstOrDefault(t => t.Id == _previewTargetId)?.Roles ?? []
                : [];

            IReadOnlyList<Guid>? tenantTagIds = null;
            if (_previewTenantId.HasValue)
            {
                tenantTagIds = await VariableSvc.GetTenantTagIdsAsync(_previewTenantId.Value);
            }

            var resolved = await VariableSvc.ResolveAsync(
                _previewProjectId.Value, _previewEnvId.Value, _previewTargetId,
                targetRoles, tenantId: _previewTenantId, tenantTagIds: tenantTagIds);

            var sensitive = await VariableSvc.GetSensitiveNamesAsync(_previewProjectId.Value);

            _previewResult = resolved;
            _previewRows = resolved
                .OrderBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase)
                .Select(kv => new PreviewRow(kv.Key, kv.Value, sensitive.Contains(kv.Key)))
                .ToList();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Preview failed", ex.Message, 5000);
        }
        finally
        {
            _previewLoading = false;
        }
    }
}
