@page "/variable-sets"
@attribute [Authorize]
@using KrakenDeploy.Server.Core.Domain.Variables
@using KrakenDeploy.Server.Data.Services
@inject VariableService VariableSvc
@inject NavigationManager Nav
@inject NotificationService Notify
@inject UiActionGuard Guard

<PageTitle>Variable Sets - KrakenDeploy</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-0">Variable Sets</RadzenText>
    <RequirePermission Permission="Permission.LibraryVariableSetCreate">
        <RadzenButton Text="New Variable Set" Icon="add_circle_outline" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => { _createOpen = true; _name = ""; _description = null; })" />
    </RequirePermission>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-4">
    Reusable library variable sets. Include a set in a project's
    <strong>Variable Sets</strong> tab to overlay its variables onto that project's
    own variables (project variables win on conflicts).
</RadzenText>

@if (_createOpen)
{
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">New Variable Set</RadzenText>
        <RadzenFormField Text="Name" class="rz-mb-3" style="width:100%">
            <RadzenTextBox @bind-Value="_name" Placeholder="e.g. Shared Database Settings" style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="Description (optional)" class="rz-mb-3" style="width:100%">
            <RadzenTextBox @bind-Value="_description" style="width:100%" />
        </RadzenFormField>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Create" ButtonStyle="ButtonStyle.Primary" Click="@CreateAsync" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => _createOpen = false)" />
        </RadzenStack>
    </RadzenCard>
}

<KrakenGrid SettingsKey="variable-sets" Data="@_sets" TItem="VariableSet"
                AllowPaging="true" PageSize="20"
                AllowSorting="true" AllowColumnResize="true"
                RowClick="@(args => { if (args.Data is { } s) Nav.NavigateTo($"/variable-sets/{s.Id}"); })"
                EmptyText="No library variable sets yet — create one to share variables across projects.">
    <Columns>
        <RadzenDataGridColumn TItem="VariableSet" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="VariableSet" Property="Description" Title="Description" />
        <RadzenDataGridColumn TItem="VariableSet" Title="Variables" Width="100px" Sortable="false">
            <Template Context="s">
                <RadzenBadge Text="@s.Variables.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="VariableSet" Property="CreatedUtc" Title="Created"
                              Width="140px" FormatString="{0:yyyy-MM-dd}" />
        <RadzenDataGridColumn TItem="VariableSet" Title="" Width="70px" TextAlign="TextAlign.Center" Sortable="false">
            <Template Context="s">
                <RequirePermission Permission="Permission.LibraryVariableSetDelete">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Variant="Variant.Text"
                                  Click="@(async _ => await DeleteAsync(s))"
                                  @onclick:stopPropagation="true"
                                  title="Delete" />
                </RequirePermission>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</KrakenGrid>

@code {
    private List<VariableSet> _sets = [];
    private bool _createOpen;
    private string _name = "";
    private string? _description;

    protected override async Task OnInitializedAsync()
        => _sets = await VariableSvc.GetLibrarySetsAsync();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            return;
        }

        if (!await Guard.AllowAsync(Permission.LibraryVariableSetCreate)) return;

        try
        {
            var set = await VariableSvc.CreateLibrarySetAsync(_name.Trim(), _description?.Trim());
            _sets = [.. _sets.Append(set).OrderBy(s => s.Name)];
            _createOpen = false;
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Variable set created",
                Detail = set.Name ?? "",
                Duration = 3000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 5000,
            });
        }
    }

    private async Task DeleteAsync(VariableSet set)
    {
        if (!await Guard.AllowAsync(Permission.LibraryVariableSetDelete)) return;

        var deleted = await VariableSvc.DeleteLibrarySetAsync(set.Id);
        if (deleted)
        {
            _sets = _sets.Where(x => x.Id != set.Id).ToList();
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Deleted",
                Detail = set.Name ?? "",
                Duration = 3000,
            });
        }
    }
}
