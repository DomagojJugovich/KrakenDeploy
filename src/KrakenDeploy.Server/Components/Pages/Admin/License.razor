@page "/s/{SpaceSlug}/settings/license"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using KrakenDeploy.Server.Core.Domain.Audit
@using KrakenDeploy.Server.Core.Domain.Licensing

@inject LicenseService LicenseSvc
@inject LicenseUsageCounter UsageCounter
@inject IAuditLog Audit
@inject NotificationService Notify
@inject ILogger<License> Log
@inject UiActionGuard Guard

<PageTitle>License - KrakenDeploy</PageTitle>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-4">License</RadzenText>

<RequirePermission Permission="Permission.ConfigureServer">
    <RadzenCard class="rz-mb-4" Style="max-width: 700px;">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-0">
                Enter License Key
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                Paste the license key you received from KrakenDeploy. The key is
                validated locally — no internet connection required. On
                successful activation the key is persisted to
                <code>data/license.key</code> so it survives server restart.
            </RadzenText>
            <div>
                <RadzenTextArea @bind-Value="_licenseText"
                                Rows="6"
                                Style="width: 100%; font-family: monospace;"
                                Placeholder="Paste your license key here..."
                                aria-label="License key" />
            </div>
            <div>
                <RadzenButton Text="Validate &amp; Activate"
                              ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@_saving"
                              Click="ActivateAsync"
                              Disabled="@string.IsNullOrWhiteSpace(_licenseText)" />
            </div>
        </RadzenStack>
    </RadzenCard>
</RequirePermission>

@if (_result is not null)
{
    <RadzenCard Style="max-width: 700px;">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-0">
                    Current License
                </RadzenText>
                @if (_result.IsValid)
                {
                    <RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" />
                }
                else
                {
                    <RadzenBadge Text="Invalid" BadgeStyle="BadgeStyle.Danger" />
                }
            </RadzenStack>

            @if (_result.IsValid && _result.Claims is not null)
            {
                var c = _result.Claims;
                <RadzenStack Gap="0.5rem">
                    <div>
                        <strong>Licensed to:</strong> @c.CustomerName
                    </div>
                    <div>
                        <strong>Type:</strong> @c.LicenseType
                    </div>
                    <div>
                        <strong>Expires:</strong> @c.ExpiresUtc.ToString("yyyy-MM-dd")
                        <span class="rz-color-secondary">
                            (@DaysRemaining(c.ExpiresUtc))
                        </span>
                    </div>
                    <div>
                        <strong>Target limit:</strong> @(c.MaxTargets == 0 ? "Unlimited" : c.MaxTargets.ToString())
                    </div>
                    <div>
                        <strong>User limit:</strong> @(c.MaxUsers == 0 ? "Unlimited" : c.MaxUsers.ToString())
                    </div>
                    <div>
                        <strong>Issued:</strong> @c.IssuedUtc.ToString("yyyy-MM-dd")
                    </div>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="View usage"
                                  Icon="speed"
                                  Variant="Variant.Outlined"
                                  Size="ButtonSize.Small"
                                  Click="@(() => Navigation.NavigateTo(Sp("/configuration/license-usage")))" />
                </RadzenStack>
            }
            else if (_result.ErrorMessage is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             Text="@_result.ErrorMessage" />
            }
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string _licenseText = "";
    private LicenseValidationResult? _result;
    private bool _saving;

    protected override void OnInitialized()
    {
        _result = LicenseSvc.LoadAndValidate();
    }

    private async Task ActivateAsync()
    {
        if (string.IsNullOrWhiteSpace(_licenseText)) { return; }
        if (!await Guard.AllowAsync(Permission.ConfigureServer)) { return; }
        _saving = true;
        try
        {
            // Persist + validate together so a bad paste can't overwrite a
            // good license file. The cache is also cleared inside the call.
            _result = await LicenseSvc.SaveAndActivateAsync(_licenseText);

            if (_result.IsValid)
            {
                // Drop the cached counter snapshot so the banner reflects
                // the new caps immediately instead of waiting up to 60 s.
                UsageCounter.Invalidate();

                var summary = LicenseService.FormatAuditSummary(_result.Claims!);
                await Audit.RecordAsync(
                    AuditEventType.LicenseUploaded,
                    subjectType: "License",
                    subjectName: _result.Claims!.CustomerName,
                    details:     summary);

                Notify.Notify(NotificationSeverity.Success, "Activated",
                    $"License for {_result.Claims.CustomerName} is active.");
                _licenseText = "";
            }
            else
            {
                // Record the failed attempt — forensic trail for license-key
                // brute-force or replay scenarios. ErrorMessage is the
                // validation-layer reason ("signature mismatch", "expired",
                // etc.) — safe to surface, not the raw JWT.
                await Audit.RecordAsync(
                    AuditEventType.LicenseUploadRejected,
                    subjectType: "License",
                    details:     _result.ErrorMessage ?? "Unknown validation failure.");

                Notify.Notify(NotificationSeverity.Error, "Invalid",
                    _result.ErrorMessage ?? "Unknown error.");
            }
        }
        catch (InvalidOperationException ex)
        {
            // Config-override case — not a validation failure, no point
            // auditing as such.
            Notify.Notify(NotificationSeverity.Warning,
                "Cannot persist license", ex.Message, 8000);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "License activation failed unexpectedly.");
            Notify.Notify(NotificationSeverity.Error,
                "Activation failed", ex.Message, 6000);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string DaysRemaining(DateTimeOffset expiresUtc)
    {
        var days = (int)(expiresUtc - DateTimeOffset.UtcNow).TotalDays;
        return days switch
        {
            < 0 => "expired",
            0   => "today",
            1   => "1 day remaining",
            _   => $"{days} days remaining",
        };
    }
}
