@page "/projects"
@rendermode InteractiveServer
@attribute [Authorize]

@inject ProjectService ProjectSvc
@inject DialogService Dialog
@inject NotificationService Notifications

<PageTitle>Projects - KrakenDeploy</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             Gap="1rem" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-0">
        Projects
    </RadzenText>
    <RequirePermission Permission="Permission.ProjectCreate">
        <RadzenButton Icon="add" Text="New Project"
                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="OpenCreateDialogAsync" />
    </RequirePermission>
</RadzenStack>

<RadzenDataGrid Data="@_projects" TItem="Project"
                AllowPaging="true" PageSize="25"
                AllowSorting="true"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                AllowColumnResize="true"
                EmptyText="No projects yet. Click 'New Project' to get started.">
    <Columns>
        <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Width="220px">
            <Template Context="p">
                <RadzenLink Path="@($"/projects/{p.Slug}")" Text="@p.Name" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Project" Property="Slug" Title="Slug" Width="180px" />
        <RadzenDataGridColumn TItem="Project" Property="Description" Title="Description"
                              Filterable="false" />
        <RadzenDataGridColumn TItem="Project" Property="CreatedUtc" Title="Created"
                              Width="130px" FormatString="{0:yyyy-MM-dd}"
                              Filterable="false" />
        <RadzenDataGridColumn TItem="Project" Title="" Width="88px"
                              Filterable="false" Sortable="false" TextAlign="TextAlign.Right">
            <Template Context="p">
                <RequirePermission Permission="Permission.ProjectEdit">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.ExtraSmall" class="rz-mr-1"
                                  Click="@(() => OpenEditDialogAsync(p))"
                                  title="Edit" />
                </RequirePermission>
                <RequirePermission Permission="Permission.ProjectDelete">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.ExtraSmall"
                                  Click="@(() => DeleteAsync(p))"
                                  title="Delete" />
                </RequirePermission>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private IReadOnlyList<Project> _projects = [];

    protected override async Task OnInitializedAsync()
        => _projects = await ProjectSvc.GetAllAsync();

    private async Task OpenCreateDialogAsync()
    {
        var result = await Dialog.OpenAsync<ProjectFormDialog>(
            "New Project",
            new Dictionary<string, object>(),
            new DialogOptions { Width = "520px" });

        if (result is true)
        {
            _projects = await ProjectSvc.GetAllAsync();
        }
    }

    private async Task OpenEditDialogAsync(Project project)
    {
        var result = await Dialog.OpenAsync<ProjectFormDialog>(
            "Edit Project",
            new Dictionary<string, object> { [nameof(ProjectFormDialog.Project)] = project },
            new DialogOptions { Width = "520px" });

        if (result is true)
        {
            _projects = await ProjectSvc.GetAllAsync();
        }
    }

    private async Task DeleteAsync(Project project)
    {
        var confirmed = await Dialog.Confirm(
            $"Delete project '{project.Name}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await ProjectSvc.DeleteAsync(project.Id);
            _projects = await ProjectSvc.GetAllAsync();
            Notifications.Notify(NotificationSeverity.Success, "Deleted",
                $"'{project.Name}' was deleted.", 4000);
        }
    }
}
