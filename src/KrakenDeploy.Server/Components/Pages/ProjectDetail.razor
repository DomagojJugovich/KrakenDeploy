@page "/s/{SpaceSlug}/projects/{Slug}"
@inherits SpaceScopedComponentBase
@attribute [Authorize]
@inject NavigationManager Nav

@* Landing for /projects/{Slug} — redirects to the dashboard sub-page so the
   active sub-page is reflected in the URL bar. *@

@code {
    [Parameter] public string Slug { get; set; } = "";

    protected override void OnInitialized()
        => Nav.NavigateTo(Sp($"/projects/{Slug}/dashboard"), replace: true);
}
