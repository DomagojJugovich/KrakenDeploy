@page "/s/{SpaceSlug}/deployments/{Id:guid}"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Text.Json
@using KrakenDeploy.Server.Core.Domain.Ai
@using KrakenDeploy.Server.Core.Domain.Deployments
@using KrakenDeploy.Server.Data.Services
@inject DeploymentService DeploymentSvc
@inject ArtifactService ArtifactSvc
@inject OfflineResultService OfflineResultSvc
@inject OfflineDropBundleBuilder BundleBuilder
@inject NavigationManager Nav
@inject NotificationService Notify
@inject DialogService DialogService
@inject UiActionGuard Guard
@inject IAuditLog Audit
@inject IServiceProvider Services
@inject MaintenanceModeService MaintenanceSvc

<PageTitle>Deployment @(Deployment?.Id.ToString()[..8]) - KrakenDeploy</PageTitle>

@if (Deployment is null)
{
    <RadzenText>Loading…</RadzenText>
}
else
{
    <div class="breadcrumb">
        <a href="@Sp("/deployments")">Deployments</a>
        <RadzenIcon Icon="chevron_right" />
        <span>@Deployment.Id.ToString()[..8]</span>
    </div>

    <div class="page-head">
        <div>
            <h1 class="page-title">
                @(Deployment.Release?.Project?.Name ?? "Deployment")
                @if (Deployment.Release?.Version is { Length: > 0 } ver)
                {
                    <span class="mono" style="font-weight:600; color:var(--text-2); font-size:18px; margin-left:8px;">@ver</span>
                }
            </h1>
            <p class="page-sub">@(Deployment.Environment?.Name ?? "—") · @TargetSummary</p>
        </div>
        <div class="page-head-actions">
            @if (CanCancel)
            {
                <RequirePermission Permission="Permission.TaskCancel">
                    <RadzenButton Text="Cancel" Icon="cancel"
                                  ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                  Click="@CancelDeploymentAsync" Disabled="@_cancelling"
                                  title="@CancelTooltip" />
                </RequirePermission>
            }
            @if (CanRedeploy)
            {
                <RequirePermission Permission="Permission.DeploymentCreate">
                    <RadzenButton Text="Redeploy" Icon="replay"
                                  ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                                  Click="@RedeployAsync"
                                  title="Deploy this release again, prefilled with the same environment, target(s) and tenant." />
                </RequirePermission>
            }
        </div>
    </div>

    @* ── Bold status banner (shared task component — D1 Phase 2) ── *@
    <TaskStatusBanner Status="Deployment.Status"
                      RunningMessage="@RunningStepLabel()"
                      FailedMessage="@(_diagnosis?.ProbableCause ?? _lastErrorLine)"
                      DefaultFailedMessage="Deployment failed."
                      FinishedDuration="@FormatDuration()"
                      QueuedMessage="@QueuedMessage()"
                      HasRun="@(Deployment.StartedUtc is not null)" />

    @* ── Summary grid ── *@
    <div class="kr-card kr-card-pad rz-mb-4">
        <dl class="kv">
            <dt>Project</dt><dd>@(Deployment.Release?.Project?.Name ?? "—")</dd>
            <dt>Release</dt><dd class="mono">@(Deployment.Release?.Version ?? "—")</dd>
            <dt>Environment</dt><dd>@(Deployment.Environment?.Name ?? "—")</dd>
            <dt>Target@(MultiTargetCount > 1 ? "s" : "")</dt><dd>@TargetSummary</dd>
            <dt>Started</dt><dd class="mono">@(Deployment.StartedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
            <dt>Completed</dt><dd class="mono">@(Deployment.CompletedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
            <dt>Duration</dt><dd class="mono">@FormatDuration()</dd>
            <dt>Initiated by</dt><dd>@Deployment.CreatedByDisplay</dd>
            <dt>Cause</dt>
            <dd>
                @Deployment.Cause
                @if (!string.IsNullOrEmpty(Deployment.CauseDetail))
                {
                    <span class="cell-muted mono">(@Deployment.CauseDetail)</span>
                }
            </dd>
            <dt>Deployment</dt><dd class="mono">@Deployment.Id.ToString()[..8]</dd>
        </dl>
    </div>

    @* ── Offline drop bundle actions ─────────────────────────────────────── *@
    @if (Deployment.Status == DeploymentStatus.PendingOfflineResult)
    {
        <RadzenCard class="rz-mb-4" style="border-left:4px solid var(--rz-warning)">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Offline Drop</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-3">
                This deployment is waiting for an offline result. Download the drop bundle,
                execute it on the target, then upload the result bundle.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" class="rz-mb-3">
                @if (!string.IsNullOrEmpty(Deployment.DropBundlePath))
                {
                    <RadzenButton Text="Download Drop Bundle" Icon="download"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/api/deployments/{Id}/drop-bundle", forceLoad: true))" />
                }
                <RequirePermission Permission="Permission.DeploymentCreate">
                    <RadzenButton Text="Re-generate Bundle" Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@RegenerateAsync" IsBusy="@_regenerating"
                                  Disabled="@_regenerating" BusyText="Re-generating…" />
                </RequirePermission>
            </RadzenStack>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Upload Result Bundle</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-2">
                Upload the result bundle zip (containing <code>deployment-result.json</code>,
                <code>deployment-log.txt</code>, and optional <code>artifacts/</code>).
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RequirePermission Permission="Permission.OfflineResultUpload">
                    <InputFile OnChange="@OnResultFileSelected" accept=".zip" />
                    <RadzenButton Text="Upload Result" Icon="upload_file"
                                  ButtonStyle="ButtonStyle.Success"
                                  Click="@UploadResultAsync"
                                  Disabled="@(_resultFile is null || _uploading)" />
                </RequirePermission>
                @if (_uploading)
                {
                    <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small"
                                               Mode="ProgressBarMode.Indeterminate" />
                }
            </RadzenStack>
        </RadzenCard>
    }
    @if (!string.IsNullOrEmpty(Deployment.DropBundlePath) &&
         Deployment.Status != DeploymentStatus.PendingOfflineResult)
    {
        <RadzenCard class="rz-mb-4">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenIcon Icon="cloud_download" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    This was an offline-drop deployment.
                </RadzenText>
                <RadzenButton Text="Download Bundle" Icon="download"
                              Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo($"/api/deployments/{Id}/drop-bundle", forceLoad: true))" />
            </RadzenStack>
        </RadzenCard>
    }

    @* M11.C — AI Analysis card. Renders above the tabs only when a
       diagnosis row exists (a started deployment that failed + AI was
       enabled). Low-confidence diagnoses carry a "verify yourself" footer. *@
    @if (_diagnosis is not null)
    {
        <RadzenCard class="rz-mb-4" style="border-left:4px solid var(--rz-info);">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="neurology" />
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">AI Analysis</RadzenText>
                    <RadzenBadge Text="@($"Confidence: {_diagnosis.Confidence}")"
                                 BadgeStyle="@ConfidenceStyle(_diagnosis.Confidence)" />
                </RadzenStack>

                <div>
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Probable cause</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1">@_diagnosis.ProbableCause</RadzenText>
                </div>

                @if (!string.IsNullOrWhiteSpace(_diagnosis.SuggestedFix))
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Suggested fix</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1">@_diagnosis.SuggestedFix</RadzenText>
                    </div>
                }

                @if (_relevantLogLines.Count > 0)
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Relevant log lines</RadzenText>
                        <ul style="margin:0; padding-left:1.2rem;">
                            @foreach (var line in _relevantLogLines)
                            {
                                <li>
                                    <span class="rz-color-secondary">#@line.Sequence</span>
                                    <span style="font-family: var(--rz-mono-font, monospace); font-size:0.85rem;">
                                        @line.Text
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (_diagnosis.Confidence == DiagnosisConfidence.Low)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat"
                                 Shade="Shade.Lighter" AllowClose="false" class="rz-mb-0">
                        Low-confidence AI guess — verify against the log before acting on it.
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text=@($"Steps ({_stepOutcomes.Count})") Icon="checklist">
                <TaskStepOutcomesGrid Outcomes="_stepOutcomes"
                                      TargetName="TargetNameOf"
                                      SettingsKey="deployment-steps" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Log" Icon="terminal">
                <TaskLogView Lines="_log" IsRunning="@(Deployment.Status == DeploymentStatus.Running)" />
            </RadzenTabsItem>

            <RadzenTabsItem Text=@($"Artifacts ({_artifacts.Count})") Icon="attach_file">
                <TaskArtifactsGrid Artifacts="_artifacts"
                                   DownloadUrl="DownloadUrl"
                                   EmptyText="No artifacts collected for this deployment."
                                   SettingsKey="deployment-artifacts" />
            </RadzenTabsItem>

            <RadzenTabsItem Text=@($"Output variables ({_outputVariables.Count})") Icon="data_object">
                <TaskOutputVariablesView Variables="_outputVariables"
                                         SettingsKey="deployment-output-vars" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Deployment? Deployment { get; set; }
    private List<TaskArtifact> _artifacts = [];
    private List<TaskOutputVariable> _outputVariables = [];
    private List<TaskStepOutcome> _stepOutcomes = [];
    private List<TaskLogLine> _log = [];
    // Computed ONCE when _log loads (not per render): the banner's FailedMessage
    // parameter is evaluated on every parent render, so scanning _log there would
    // re-run Where+OrderByDescending over the whole log on each interaction.
    private string? _lastErrorLine;

    // M11.C — AI diagnosis + its parsed relevant-log-lines.
    private DeploymentDiagnosis? _diagnosis;
    private List<DiagnosisLogLineView> _relevantLogLines = [];

    // Offline result upload
    private IBrowserFile? _resultFile;
    private bool _uploading;

    // Lifecycle action busy flags
    private bool _cancelling;
    private bool _regenerating;

    // F1 — set when this Queued deployment is held by the (project,env,tenant)
    // serialization rule (a same-key deployment is in-flight: Running or a parked
    // offline-drop PendingOfflineResult). Consulted only by the banner's Queued
    // branch, so it is harmlessly ignored once the row leaves Queued. Computed on
    // load (below).
    private bool _blockedByInFlightPeer;

    // Non-null while this Queued task is held by the instance-wide maintenance gate
    // (the claim is refused, so it cannot start until maintenance is disabled). Held
    // as the state rather than a bool so the banner can quote the operator's reason.
    private MaintenanceState? _maintenanceHold;

    // Cancel is meaningful only before a deployment reaches a terminal state.
    private bool CanCancel =>
        Deployment?.Status is DeploymentStatus.Queued or DeploymentStatus.Running;

    // Redeploy re-runs a finished deployment.
    private bool CanRedeploy =>
        Deployment?.Status is DeploymentStatus.Succeeded
            or DeploymentStatus.SucceededWithWarnings
            or DeploymentStatus.Failed
            or DeploymentStatus.Cancelled;

    private string CancelTooltip => Deployment?.Status == DeploymentStatus.Running
        ? "Cancel this deployment. The abort is pushed to the agent (the running " +
          "step's process is stopped); no further steps start."
        : "Cancel this deployment before it starts.";

    protected override async Task OnInitializedAsync()
    {
        Deployment = await DeploymentSvc.GetAsync(Id);
        if (Deployment is not null)
        {
            _artifacts = await ArtifactSvc.GetByTaskAsync(Id);
            _outputVariables = await DeploymentSvc.GetOutputVariablesAsync(Id);
            _stepOutcomes = await DeploymentSvc.GetStepOutcomesAsync(Id);
            _log = await DeploymentSvc.GetLogAsync(Id);
            _lastErrorLine = ComputeLastErrorLine();
            await LoadDiagnosisAsync();
            await RefreshQueueReasonAsync();
        }
    }

    private async Task LoadDiagnosisAsync()
    {
        _diagnosis = await DeploymentSvc.GetDiagnosisAsync(Id);
        _relevantLogLines = [];
        if (_diagnosis is not null && !string.IsNullOrWhiteSpace(_diagnosis.RelevantLogLinesJson))
        {
            try
            {
                _relevantLogLines = JsonSerializer.Deserialize<List<DiagnosisLogLineView>>(
                    _diagnosis.RelevantLogLinesJson,
                    new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? [];
            }
            catch (JsonException)
            {
                // Malformed blob — show the rest of the card without the lines.
                _relevantLogLines = [];
            }
        }
    }

    private sealed record DiagnosisLogLineView(int Sequence, string Text);

    private static BadgeStyle ConfidenceStyle(DiagnosisConfidence c) => c switch
    {
        DiagnosisConfidence.High   => BadgeStyle.Success,
        DiagnosisConfidence.Medium => BadgeStyle.Info,
        _                          => BadgeStyle.Warning,
    };

    private void OnResultFileSelected(InputFileChangeEventArgs e)
    {
        _resultFile = e.File;
    }

    private async Task UploadResultAsync()
    {
        if (_resultFile is null || Deployment is null)
        {
            return;
        }

        if (!await Guard.AllowAsync(Permission.OfflineResultUpload)) return;

        _uploading = true;
        try
        {
            // Stream the file to the ingestion service
            await using var stream = _resultFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            var updated = await OfflineResultSvc.IngestAsync(Deployment.Id, stream);

            Deployment = await DeploymentSvc.GetAsync(Id);
            if (Deployment is not null)
            {
                _artifacts = await ArtifactSvc.GetByTaskAsync(Id);
                _outputVariables = await DeploymentSvc.GetOutputVariablesAsync(Id);
                _stepOutcomes = await DeploymentSvc.GetStepOutcomesAsync(Id);
                _log = await DeploymentSvc.GetLogAsync(Id);
                _lastErrorLine = ComputeLastErrorLine();
                await RefreshQueueReasonAsync();
            }
            _resultFile = null;

            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Result ingested",
                Detail = $"Status: {updated.Status}",
                Duration = 4000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 5000,
            });
        }
        finally
        {
            _uploading = false;
        }
    }

    // ── Cancel ───────────────────────────────────────────────────────────────
    private async Task CancelDeploymentAsync()
    {
        if (Deployment is null)
        {
            return;
        }

        // Server-authoritative re-check (the button's visibility is cosmetic).
        if (!await Guard.AllowAsync(Permission.TaskCancel)) return;

        var running = Deployment.Status == DeploymentStatus.Running;
        var confirmed = await DialogService.Confirm(
            running
                ? "Cancel this running deployment? The abort is pushed to the agent, which " +
                  "stops the running step; no further steps will start."
                : "Cancel this queued deployment before it starts?",
            "Cancel deployment",
            new ConfirmOptions { OkButtonText = "Cancel deployment", CancelButtonText = "Keep running" });
        if (confirmed != true)
        {
            return;
        }

        _cancelling = true;
        try
        {
            // The service records the semantic Deployment.Cancelled audit itself.
            var updated = await DeploymentSvc.CancelAsync(Deployment.Id, await Guard.CurrentCallerAsync());
            if (updated is not null)
            {
                Deployment = await DeploymentSvc.GetAsync(Id);
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary  = "Cancelled",
                    Detail   = running
                        ? "The abort was pushed to the agent."
                        : "The queued deployment was cancelled.",
                    Duration = 4000,
                });
            }
        }
        catch (AuthorizationException)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Not allowed",
                Detail   = "You don't have permission to cancel this deployment.",
                Duration = 5000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary  = "Could not cancel",
                Detail   = ex.Message,
                Duration = 5000,
            });
        }
        finally
        {
            _cancelling = false;
        }
    }

    // ── Redeploy ───────────────────────────────────────────────────────────────
    private async Task RedeployAsync()
    {
        if (Deployment is null)
        {
            return;
        }

        if (!await Guard.AllowAsync(Permission.DeploymentCreate)) return;

        // Reproduce the source deployment's target set from the assignments
        // join (first-assigned first, so the redeploy keeps the same primary).
        var targetIds = Deployment.ResolvedTargets().Select(t => t.Id).ToList();

        // The dialog navigates to the new deployment on success; nothing to do here.
        await DialogService.OpenAsync<DeployReleaseDialog>(
            $"Redeploy {Deployment.Release?.Version}",
            new Dictionary<string, object?>
            {
                [nameof(DeployReleaseDialog.ReleaseId)]           = Deployment.ReleaseId,
                [nameof(DeployReleaseDialog.PresetEnvironmentId)] = Deployment.EnvironmentId,
                [nameof(DeployReleaseDialog.PresetTargetIds)]     = targetIds,
                [nameof(DeployReleaseDialog.PresetTenantId)]      = Deployment.TenantId,
                [nameof(DeployReleaseDialog.PresetFailureMode)]   = Deployment.FailureMode,
            },
            DeployReleaseDialog.BuildOptions());
    }

    // ── Regenerate offline drop bundle ───────────────────────────────────────
    private async Task RegenerateAsync()
    {
        if (Deployment is null)
        {
            return;
        }

        // Regeneration re-materialises a secret-bearing deployable — gate it at
        // the deploy tier, not the read-only DeploymentView.
        if (!await Guard.AllowAsync(Permission.DeploymentCreate)) return;

        _regenerating = true;
        try
        {
            await BundleBuilder.RegenerateForDeploymentAsync(
                Deployment.Id, Services, await Guard.CurrentCallerAsync());
            Deployment = await DeploymentSvc.GetAsync(Id);
            await RefreshQueueReasonAsync();
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary  = "Bundle re-generated",
                Detail   = "A fresh drop bundle is ready to download.",
                Duration = 4000,
            });
        }
        catch (AuthorizationException)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Not allowed",
                Detail   = "You don't have permission to regenerate this bundle.",
                Duration = 6000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Could not re-generate",
                Detail   = ex.Message,
                Duration = 6000,
            });
        }
        finally
        {
            _regenerating = false;
        }
    }

    private string? ScheduledMessage()
        => Deployment?.ScheduledFor is { } s
            ? $"Scheduled for {s.ToLocalTime():yyyy-MM-dd HH:mm}."
            : null;

    // F1 — recompute whether this (still-Queued) deployment is held by the
    // (project,env,tenant) serialization rule (a same-key peer is in-flight).
    // Called on every Deployment (re)load so the banner tracks the latest fetch.
    // The page is load-time static (no live poll), so this is as fresh as the
    // rest of the page; it is never consulted once the row leaves Queued.
    private async Task RefreshQueueReasonAsync()
    {
        if (Deployment is not { Status: DeploymentStatus.Queued })
        {
            _blockedByInFlightPeer = false;
            _maintenanceHold = null;
            return;
        }

        // The maintenance gate in ServerTaskLease.TryClaimAsync refuses the claim
        // outright, so it outranks the serialization rule as the reason this task
        // hasn't started. Read it first and skip the peer probe when it applies.
        var maintenance = await MaintenanceSvc.GetStateAsync();
        _maintenanceHold = maintenance.Enabled ? maintenance : null;
        _blockedByInFlightPeer = _maintenanceHold is null
            && await DeploymentSvc.HasInFlightPeerAsync(
                Deployment.Id, Deployment.ProjectId, Deployment.EnvironmentId, Deployment.TenantId);
    }

    // F1 — the reason a Queued deployment is waiting. Maintenance mode wins (the
    // claim is refused for every task, so nothing else it might be waiting on
    // matters); then a future schedule (the task is intentionally held); then the
    // (project,env,tenant) serialization rule. Null → the banner falls back to its
    // generic "Waiting to start." text.
    private string? QueuedMessage()
    {
        if (_maintenanceHold is { } hold)
        {
            return QueueWaitMessage.MaintenanceHold(hold.Reason);
        }
        if (ScheduledMessage() is { } scheduled)
        {
            return scheduled;
        }
        return _blockedByInFlightPeer
            ? QueueWaitMessage.RunningPeer(
                Deployment?.Release?.Project?.Name, Deployment?.Environment?.Name)
            : null;
    }

    private string FormatDuration()
        => TaskFormatting.Elapsed(Deployment?.StartedUtc, Deployment?.CompletedUtc);

    private string DownloadUrl(Guid artifactId)
        => $"/api/deployments/{Id}/artifacts/{artifactId}/download";

    // ── Multi-target rendering helpers ────────────────────────────────────
    //
    // The assignments join (Deployment.Targets) is the single authority for
    // the target set. Single-target deployments render the target's name;
    // multi-target deployments get a "N targets" summary in the header +
    // per-row target names in the Steps tab.

    private int MultiTargetCount => Deployment?.Targets?.Count ?? 0;

    private string TargetSummary
    {
        get
        {
            if (Deployment is null) { return "—"; }
            var names = Deployment.TargetNames();
            if (names.Count <= 1)
            {
                return names.Count == 0 ? "—" : names[0];
            }
            // Multi-target: short list with "N targets" prefix for at-a-
            // glance scan, full names follow so operators can read which
            // machines are in scope without expanding anything.
            return $"{names.Count} targets: {string.Join(", ", names)}";
        }
    }

    private string TargetNameOf(Guid targetId)
    {
        var name = Deployment?.Targets
            .FirstOrDefault(a => a.TargetId == targetId)
            ?.Target?.Name;
        return string.IsNullOrEmpty(name) ? targetId.ToString()[..8] : name;
    }

    // Best-effort "current step" label for a running deployment, derived from the
    // outcomes recorded so far (no fabricated total — the process step count isn't
    // loaded here).
    private string RunningStepLabel()
    {
        var last = _stepOutcomes.LastOrDefault();
        return last is not null ? $"Step {_stepOutcomes.Count} · {last.StepName}" : "In progress…";
    }

    private string? ComputeLastErrorLine()
        => _log
            .Where(l => l.Level == "error")
            .OrderByDescending(l => l.Sequence)
            .FirstOrDefault()?.Message;
}
