@page "/s/{SpaceSlug}/deployments/{Id:guid}"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Text.Json
@using KrakenDeploy.Server.Core.Domain.Ai
@using KrakenDeploy.Server.Core.Domain.Deployments
@using KrakenDeploy.Server.Data.Services
@inject DeploymentService DeploymentSvc
@inject ArtifactService ArtifactSvc
@inject OfflineResultService OfflineResultSvc
@inject NavigationManager Nav
@inject NotificationService Notify
@inject UiActionGuard Guard

<PageTitle>Deployment @(Deployment?.Id.ToString()[..8]) - KrakenDeploy</PageTitle>

@if (Deployment is null)
{
    <RadzenText>Loading…</RadzenText>
}
else
{
    <div class="breadcrumb">
        <a href="@Sp("/deployments")">Deployments</a>
        <RadzenIcon Icon="chevron_right" />
        <span>@Deployment.Id.ToString()[..8]</span>
    </div>

    <div class="page-head">
        <div>
            <h1 class="page-title">
                @(Deployment.Release?.Project?.Name ?? "Deployment")
                @if (Deployment.Release?.Version is { Length: > 0 } ver)
                {
                    <span class="mono" style="font-weight:600; color:var(--text-2); font-size:18px; margin-left:8px;">@ver</span>
                }
            </h1>
            <p class="page-sub">@(Deployment.Environment?.Name ?? "—") · @TargetSummary</p>
        </div>
    </div>

    @* ── Bold status banner ── *@
    <div class="kr-card st--@BannerClass(Deployment.Status) rz-mb-4">
        <div class="kr-card-pad status-banner">
            <StatusPill Deployment="Deployment.Status" Variant="StatusPill.PillVariant.Bold" />
            @if (Deployment.Status == DeploymentStatus.Running)
            {
                <span class="banner-msg">@RunningStepLabel()</span>
                <span class="grow">
                    <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate"
                                       ShowValue="false" Style="height:6px;" />
                </span>
            }
            else if (Deployment.Status == DeploymentStatus.Failed)
            {
                <span class="banner-msg">@(_diagnosis?.ProbableCause ?? LastErrorLine() ?? "Deployment failed.")</span>
            }
            else if (Deployment.Status == DeploymentStatus.PendingOfflineResult)
            {
                <span class="banner-msg">Awaiting offline result from an air-gapped target.</span>
            }
            else
            {
                <span class="banner-msg muted">Finished in @FormatDuration()</span>
            }
        </div>
    </div>

    @* ── Summary grid ── *@
    <div class="kr-card kr-card-pad rz-mb-4">
        <dl class="kv">
            <dt>Project</dt><dd>@(Deployment.Release?.Project?.Name ?? "—")</dd>
            <dt>Release</dt><dd class="mono">@(Deployment.Release?.Version ?? "—")</dd>
            <dt>Environment</dt><dd>@(Deployment.Environment?.Name ?? "—")</dd>
            <dt>Target@(MultiTargetCount > 1 ? "s" : "")</dt><dd>@TargetSummary</dd>
            <dt>Started</dt><dd class="mono">@(Deployment.StartedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
            <dt>Completed</dt><dd class="mono">@(Deployment.CompletedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
            <dt>Duration</dt><dd class="mono">@FormatDuration()</dd>
            <dt>Deployment</dt><dd class="mono">@Deployment.Id.ToString()[..8]</dd>
        </dl>
    </div>

    @* ── Offline drop bundle actions ─────────────────────────────────────── *@
    @if (Deployment.Status == DeploymentStatus.PendingOfflineResult)
    {
        <RadzenCard class="rz-mb-4" style="border-left:4px solid var(--rz-warning)">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Offline Drop</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-3">
                This deployment is waiting for an offline result. Download the drop bundle,
                execute it on the target, then upload the result bundle.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" class="rz-mb-3">
                @if (!string.IsNullOrEmpty(Deployment.DropBundlePath))
                {
                    <RadzenButton Text="Download Drop Bundle" Icon="download"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/api/deployments/{Id}/drop-bundle", forceLoad: true))" />
                }
                <RadzenButton Text="Re-generate Bundle" Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@RegenerateAsync" />
            </RadzenStack>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Upload Result Bundle</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-2">
                Upload the result bundle zip (containing <code>deployment-result.json</code>,
                <code>deployment-log.txt</code>, and optional <code>artifacts/</code>).
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RequirePermission Permission="Permission.OfflineResultUpload">
                    <InputFile OnChange="@OnResultFileSelected" accept=".zip" />
                    <RadzenButton Text="Upload Result" Icon="upload_file"
                                  ButtonStyle="ButtonStyle.Success"
                                  Click="@UploadResultAsync"
                                  Disabled="@(_resultFile is null || _uploading)" />
                </RequirePermission>
                @if (_uploading)
                {
                    <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small"
                                               Mode="ProgressBarMode.Indeterminate" />
                }
            </RadzenStack>
        </RadzenCard>
    }
    @if (!string.IsNullOrEmpty(Deployment.DropBundlePath) &&
         Deployment.Status != DeploymentStatus.PendingOfflineResult)
    {
        <RadzenCard class="rz-mb-4">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenIcon Icon="cloud_download" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    This was an offline-drop deployment.
                </RadzenText>
                <RadzenButton Text="Download Bundle" Icon="download"
                              Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo($"/api/deployments/{Id}/drop-bundle", forceLoad: true))" />
            </RadzenStack>
        </RadzenCard>
    }

    @* M11.C — AI Analysis card. Renders above the tabs only when a
       diagnosis row exists (a started deployment that failed + AI was
       enabled). Low-confidence diagnoses carry a "verify yourself" footer. *@
    @if (_diagnosis is not null)
    {
        <RadzenCard class="rz-mb-4" style="border-left:4px solid var(--rz-info);">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="neurology" />
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">AI Analysis</RadzenText>
                    <RadzenBadge Text="@($"Confidence: {_diagnosis.Confidence}")"
                                 BadgeStyle="@ConfidenceStyle(_diagnosis.Confidence)" />
                </RadzenStack>

                <div>
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Probable cause</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1">@_diagnosis.ProbableCause</RadzenText>
                </div>

                @if (!string.IsNullOrWhiteSpace(_diagnosis.SuggestedFix))
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Suggested fix</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1">@_diagnosis.SuggestedFix</RadzenText>
                    </div>
                }

                @if (_relevantLogLines.Count > 0)
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Relevant log lines</RadzenText>
                        <ul style="margin:0; padding-left:1.2rem;">
                            @foreach (var line in _relevantLogLines)
                            {
                                <li>
                                    <span class="rz-color-secondary">#@line.Sequence</span>
                                    <span style="font-family: var(--rz-mono-font, monospace); font-size:0.85rem;">
                                        @line.Text
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (_diagnosis.Confidence == DiagnosisConfidence.Low)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat"
                                 Shade="Shade.Lighter" AllowClose="false" class="rz-mb-0">
                        Low-confidence AI guess — verify against the log before acting on it.
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text=@($"Steps ({_stepOutcomes.Count})") Icon="checklist">
                @if (_stepOutcomes.Count == 0)
                {
                    <RadzenText class="rz-color-secondary rz-mt-4">
                        No step outcomes recorded yet. The Steps tab populates as the
                        orchestrator finishes each step's terminal attempt.
                    </RadzenText>
                }
                else
                {
                    <KrakenGrid SettingsKey="deployment-steps" Data="@_stepOutcomes" TItem="DeploymentStepOutcome"
                                    AllowSorting="false" AllowColumnResize="true"
                                    class="rz-mt-3">
                        <Columns>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  Property="StepIndex" Title="#" Width="60px">
                                <Template Context="o">@(o.StepIndex + 1)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  Property="StepName" Title="Step" Width="240px">
                                <Template Context="o">
                                    <strong>@o.StepName</strong>
                                    @if (o.AttemptCount > 1)
                                    {
                                        <span class="rz-color-secondary rz-text-body2 rz-ml-2">
                                            (retried @(o.AttemptCount - 1)×)
                                        </span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  Property="Outcome" Title="Outcome" Width="140px">
                                <Template Context="o">
                                    <StatusPill Step="o.Outcome" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  UniqueID="side" Title="Side" Width="80px">
                                <Template Context="o">
                                    @(o.IsServerSide ? "Server" : "Target")
                                </Template>
                            </RadzenDataGridColumn>
                            @* M-RollingDeployments Phase 3 — Target column.
                               Shows the per-(step, target) attribution from
                               the widened DeploymentStepOutcome key. Server-
                               side steps + pre-Phase-1a outcomes have a null
                               TargetId and render "—". *@
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  UniqueID="target" Title="Target" Width="140px">
                                <Template Context="o">
                                    @if (o.TargetId is { } tid)
                                    {
                                        <span class="rz-text-body2">@(TargetNameOf(tid))</span>
                                    }
                                    else
                                    {
                                        <span class="rz-color-secondary">—</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  Property="Required" Title="Required" Width="100px">
                                <Template Context="o">
                                    @if (o.Required)
                                    {
                                        <RadzenBadge Text="Required" BadgeStyle="BadgeStyle.Light" />
                                    }
                                    else
                                    {
                                        <span class="rz-color-secondary">optional</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  UniqueID="duration" Title="Duration" Width="100px">
                                <Template Context="o">@FormatStepDuration(o)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentStepOutcome"
                                                  Property="ErrorMessage" Title="Detail">
                                <Template Context="o">
                                    <span class="rz-color-secondary">
                                        @(o.ErrorMessage ?? "—")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </KrakenGrid>
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="Log" Icon="terminal">
                <div class="kraken-log rz-mt-3">
                    @foreach (var entry in Deployment.LogEntries.OrderBy(l => l.Sequence))
                    {
                        <div class="ln @LevelClass(entry.Level)">
                            <span class="lt">@entry.Timestamp.ToString("HH:mm:ss")</span>
                            <span class="lm">@entry.Message</span>
                        </div>
                    }
                    @if (Deployment.LogEntries.Any() && Deployment.Status == DeploymentStatus.Running)
                    {
                        <div class="ln"><span class="lt"></span><span class="lm"><span class="kraken-caret"></span></span></div>
                    }
                    @if (!Deployment.LogEntries.Any())
                    {
                        <span class="kraken-log-empty">No log entries yet.</span>
                    }
                </div>
            </RadzenTabsItem>

            <RadzenTabsItem Text=@($"Artifacts ({_artifacts.Count})") Icon="attach_file">
                @if (_artifacts.Count == 0)
                {
                    <RadzenText class="rz-color-secondary rz-mt-4">
                        No artifacts collected for this deployment.
                    </RadzenText>
                }
                else
                {
                    <KrakenGrid SettingsKey="deployment-artifacts" Data="@_artifacts" TItem="DeploymentArtifact"
                                    AllowSorting="true" AllowColumnResize="true"
                                    class="rz-mt-3">
                        <Columns>
                            <RadzenDataGridColumn TItem="DeploymentArtifact"
                                                  Property="StepName" Title="Step" Width="200px" />
                            <RadzenDataGridColumn TItem="DeploymentArtifact"
                                                  Property="FileName" Title="File">
                                <Template Context="a">
                                    @if (IsImage(a.ContentType))
                                    {
                                        <img src="@DownloadUrl(a.Id)" alt="@a.FileName"
                                             style="max-height:48px; max-width:80px; object-fit:contain;
                                                    vertical-align:middle; margin-right:8px;" />
                                    }
                                    <a href="@DownloadUrl(a.Id)" target="_blank"
                                       rel="noopener noreferrer">@a.FileName</a>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentArtifact"
                                                  Property="ContentType" Title="Type" Width="180px" />
                            <RadzenDataGridColumn TItem="DeploymentArtifact"
                                                  Property="SizeBytes" Title="Size" Width="100px">
                                <Template Context="a">@FormatBytes(a.SizeBytes)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentArtifact"
                                                  Property="CollectedUtc" Title="Collected"
                                                  Width="160px">
                                <Template Context="a">
                                    @a.CollectedUtc.ToString("yyyy-MM-dd HH:mm")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DeploymentArtifact" UniqueID="download" Title="Download"
                                                  Width="100px" Sortable="false">
                                <Template Context="a">
                                    <RadzenButton Icon="download" ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => Nav.NavigateTo(DownloadUrl(a.Id)))"
                                                  title="@($"Download {a.FileName}")" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </KrakenGrid>
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text=@($"Output variables ({_outputVariables.Count})") Icon="data_object">
                @if (_outputVariables.Count == 0)
                {
                    <RadzenText class="rz-color-secondary rz-mt-4">
                        No output variables captured.
                        Steps emit them with <code>Set-OctopusVariable -name X -value Y</code> in
                        PowerShell or <code>##octopus[setVariable name='base64' value='base64']</code>
                        on stdout from any language. They're then available to later steps as
                        <code>#{Octopus.Action[StepName].Output.X}</code> or
                        <code>$OctopusParameters["Octopus.Action[StepName].Output.X"]</code>.
                    </RadzenText>
                }
                else
                {
                    @foreach (var group in _outputVariables.GroupBy(o => o.StepName)
                                                            .OrderBy(g => g.Min(o => o.CapturedUtc)))
                    {
                        <RadzenCard class="rz-mt-3">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">
                                <RadzenIcon Icon="play_arrow" Style="vertical-align:middle;margin-right:4px;" />
                                @group.Key
                                <span class="rz-color-secondary rz-text-body2 rz-ml-2">
                                    (@group.Count() variable@(group.Count() == 1 ? "" : "s"))
                                </span>
                            </RadzenText>
                            <KrakenGrid SettingsKey="deployment-output-vars" Data="@group.OrderBy(o => o.Name)"
                                            TItem="DeploymentOutputVariable"
                                            AllowSorting="false" AllowColumnResize="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="DeploymentOutputVariable"
                                                          Property="Name" Title="Name" Width="280px">
                                        <Template Context="o">
                                            <code>@o.Name</code>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="DeploymentOutputVariable"
                                                          Property="Value" Title="Value">
                                        <Template Context="o">
                                            @if (o.Value.Contains('\n'))
                                            {
                                                <pre style="margin:0; white-space: pre-wrap; word-break: break-word;
                                                            font-family: var(--rz-mono-font, monospace);
                                                            font-size: 0.85rem;">@o.Value</pre>
                                            }
                                            else
                                            {
                                                <span style="font-family: var(--rz-mono-font, monospace);
                                                             font-size: 0.85rem;
                                                             word-break: break-word;">@o.Value</span>
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="DeploymentOutputVariable"
                                                          Title="Reference"
                                                          Width="320px" Sortable="false">
                                        <Template Context="o">
                                            <code>#{Octopus.Action[@(group.Key)].Output.@(o.Name)}</code>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="DeploymentOutputVariable"
                                                          Property="CapturedUtc" Title="Captured"
                                                          Width="160px">
                                        <Template Context="o">
                                            @o.CapturedUtc.ToString("yyyy-MM-dd HH:mm:ss")
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </KrakenGrid>
                        </RadzenCard>
                    }
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Deployment? Deployment { get; set; }
    private List<DeploymentArtifact> _artifacts = [];
    private List<DeploymentOutputVariable> _outputVariables = [];
    private List<DeploymentStepOutcome> _stepOutcomes = [];

    // M11.C — AI diagnosis + its parsed relevant-log-lines.
    private DeploymentDiagnosis? _diagnosis;
    private List<DiagnosisLogLineView> _relevantLogLines = [];

    // Offline result upload
    private IBrowserFile? _resultFile;
    private bool _uploading;

    protected override async Task OnInitializedAsync()
    {
        Deployment = await DeploymentSvc.GetAsync(Id);
        if (Deployment is not null)
        {
            _artifacts = await ArtifactSvc.GetByDeploymentAsync(Id);
            _outputVariables = await DeploymentSvc.GetOutputVariablesAsync(Id);
            _stepOutcomes = await DeploymentSvc.GetStepOutcomesAsync(Id);
            await LoadDiagnosisAsync();
        }
    }

    private async Task LoadDiagnosisAsync()
    {
        _diagnosis = await DeploymentSvc.GetDiagnosisAsync(Id);
        _relevantLogLines = [];
        if (_diagnosis is not null && !string.IsNullOrWhiteSpace(_diagnosis.RelevantLogLinesJson))
        {
            try
            {
                _relevantLogLines = JsonSerializer.Deserialize<List<DiagnosisLogLineView>>(
                    _diagnosis.RelevantLogLinesJson,
                    new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? [];
            }
            catch (JsonException)
            {
                // Malformed blob — show the rest of the card without the lines.
                _relevantLogLines = [];
            }
        }
    }

    private sealed record DiagnosisLogLineView(int Sequence, string Text);

    private static BadgeStyle ConfidenceStyle(DiagnosisConfidence c) => c switch
    {
        DiagnosisConfidence.High   => BadgeStyle.Success,
        DiagnosisConfidence.Medium => BadgeStyle.Info,
        _                          => BadgeStyle.Warning,
    };

    private void OnResultFileSelected(InputFileChangeEventArgs e)
    {
        _resultFile = e.File;
    }

    private async Task UploadResultAsync()
    {
        if (_resultFile is null || Deployment is null)
        {
            return;
        }

        if (!await Guard.AllowAsync(Permission.OfflineResultUpload)) return;

        _uploading = true;
        try
        {
            // Stream the file to the ingestion service
            await using var stream = _resultFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            var updated = await OfflineResultSvc.IngestAsync(Deployment.Id, stream);

            Deployment = await DeploymentSvc.GetAsync(Id);
            if (Deployment is not null)
            {
                _artifacts = await ArtifactSvc.GetByDeploymentAsync(Id);
                _outputVariables = await DeploymentSvc.GetOutputVariablesAsync(Id);
                _stepOutcomes = await DeploymentSvc.GetStepOutcomesAsync(Id);
            }
            _resultFile = null;

            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Result ingested",
                Detail = $"Status: {updated.Status}",
                Duration = 4000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 5000,
            });
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task RegenerateAsync()
    {
        Notify.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Re-generating",
            Detail = "Triggering a new drop bundle generation...",
            Duration = 3000,
        });

        // Re-deploy triggers regeneration through the normal pipeline.
        // For now, inform the user to create a new deployment.
        await Task.CompletedTask;
    }

    private string FormatDuration()
    {
        if (Deployment?.StartedUtc is null)    { return "—"; }
        var end = Deployment.CompletedUtc ?? DateTimeOffset.UtcNow;
        var dur = end - Deployment.StartedUtc.Value;
        return dur.TotalHours >= 1
            ? $"{(int)dur.TotalHours}h {dur.Minutes}m {dur.Seconds}s"
            : $"{dur.Minutes}m {dur.Seconds}s";
    }

    private static string LevelClass(string level) => level switch
    {
        "error"             => "lv-error",
        "warn" or "warning" => "lv-warn",
        "ok" or "success"   => "lv-ok",
        "cmd" or "command"  => "lv-cmd",
        _                   => "lv-info",
    };

    private string DownloadUrl(Guid artifactId)
        => $"/api/deployments/{Id}/artifacts/{artifactId}/download";

    // ── M-RollingDeployments Phase 3 — multi-target rendering helpers ────
    //
    // The deployment-detail page now has to surface BOTH the legacy single-
    // target field (Deployment.Target — kept by the orchestrator for back-
    // compat) AND the multi-target join (Deployment.Targets — populated
    // by Phase 1a's migration + Phase 1b's CreateAsync extension). The
    // helpers below reconcile the two so single-target deployments render
    // identically to pre-Phase-1a and multi-target deployments get a clean
    // "N targets" summary in the header + per-row target names in the
    // Steps tab.

    private int MultiTargetCount => Deployment?.Targets?.Count ?? 0;

    private string TargetSummary
    {
        get
        {
            if (Deployment is null) { return "—"; }
            var fromJoin = Deployment.Targets
                ?.Where(a => a.Target is not null)
                .Select(a => a.Target!.Name)
                .ToList() ?? [];
            if (fromJoin.Count == 0)
            {
                return Deployment.Target?.Name ?? "—";
            }
            if (fromJoin.Count == 1)
            {
                return fromJoin[0];
            }
            // Multi-target: short list with "N targets" prefix for at-a-
            // glance scan, full names follow so operators can read which
            // machines are in scope without expanding anything.
            return $"{fromJoin.Count} targets: {string.Join(", ", fromJoin)}";
        }
    }

    private string TargetNameOf(Guid targetId)
    {
        if (Deployment is null) { return targetId.ToString()[..8]; }
        var fromJoin = Deployment.Targets
            ?.FirstOrDefault(a => a.TargetId == targetId)
            ?.Target?.Name;
        if (!string.IsNullOrEmpty(fromJoin)) { return fromJoin; }
        // Fallback to legacy Deployment.Target when the row's TargetId
        // matches it (single-target deployment whose Targets join row was
        // somehow stripped post-migration — defensive).
        if (Deployment.Target is not null && Deployment.Target.Id == targetId)
        {
            return Deployment.Target.Name;
        }
        return targetId.ToString()[..8];
    }

    // Maps a deployment status to the StatusPill colour family (.st--*) for the
    // bold header banner's left border + soft tint.
    private static string BannerClass(DeploymentStatus s) => s switch
    {
        DeploymentStatus.Succeeded             => "ok",
        DeploymentStatus.SucceededWithWarnings => "warn",
        DeploymentStatus.Failed                => "fail",
        DeploymentStatus.Running               => "run",
        DeploymentStatus.Queued                => "queue",
        DeploymentStatus.PendingOfflineResult  => "offline",
        DeploymentStatus.Cancelled             => "idle",
        _                                      => "idle",
    };

    // Best-effort "current step" label for a running deployment, derived from the
    // outcomes recorded so far (no fabricated total — the process step count isn't
    // loaded here).
    private string RunningStepLabel()
    {
        var last = _stepOutcomes.LastOrDefault();
        return last is not null ? $"Step {_stepOutcomes.Count} · {last.StepName}" : "In progress…";
    }

    private string? LastErrorLine()
        => Deployment?.LogEntries?
            .Where(l => l.Level == "error")
            .OrderByDescending(l => l.Sequence)
            .FirstOrDefault()?.Message;

    private static string FormatStepDuration(DeploymentStepOutcome o)
    {
        if (o.StartedUtc is null) { return "—"; }
        var dur = o.CompletedUtc - o.StartedUtc.Value;
        if (dur.TotalSeconds < 1) { return "<1s"; }
        return dur.TotalHours >= 1
            ? $"{(int)dur.TotalHours}h {dur.Minutes}m {dur.Seconds}s"
            : dur.TotalMinutes >= 1
                ? $"{dur.Minutes}m {dur.Seconds}s"
                : $"{dur.Seconds}s";
    }

    private static bool IsImage(string contentType) =>
        contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static string FormatBytes(long bytes)
    {
        const long KB = 1024;
        const long MB = 1024 * 1024;
        const long GB = 1024 * 1024 * 1024;
        if (bytes < KB) { return $"{bytes} B"; }
        if (bytes < MB) { return $"{bytes / (double)KB:F1} KB"; }
        if (bytes < GB) { return $"{bytes / (double)MB:F1} MB"; }
        return $"{bytes / (double)GB:F2} GB";
    }
}
