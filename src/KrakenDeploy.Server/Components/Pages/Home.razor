@page "/s/{SpaceSlug}"
@inherits SpaceScopedComponentBase
@attribute [Authorize]
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Security.Claims
@using KrakenDeploy.Server.Core.Domain.Analytics
@inject DashboardService DashboardSvc
@inject PivotViewService PivotViewSvc
@inject DashboardLayoutService DashboardLayoutSvc
@inject DialogService Dialog
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Dashboard - KrakenDeploy</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-sub">@(_summary?.SpaceName ?? "…") · all projects</p>
    </div>
    <div class="page-head-actions">
        @if (_summary is not null)
        {
            @if (_editMode)
            {
                <RadzenButton Text="Reset" Icon="restart_alt" ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Filled" Click="@ResetLayoutAsync" />
                <RadzenButton Text="Done" Icon="check" ButtonStyle="ButtonStyle.Success"
                              Variant="Variant.Filled" Click="@ToggleEditMode" />
            }
            else
            {
                <RadzenButton Text="Customize" Icon="dashboard_customize" ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Filled" Click="@ToggleEditMode" />
            }
        }
        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Variant="Variant.Filled" Click="@RefreshAsync" />
        <RadzenButton Text="Deploy" Icon="rocket_launch" ButtonStyle="ButtonStyle.Primary"
                      Variant="Variant.Filled" Click="@(() => Nav.NavigateTo(Sp("/projects")))" />
    </div>
</div>

@if (_summary is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
}
else
{
    var s = _summary;

    @* ── Rearrangeable tiles — per-user layout persisted via DashboardLayoutService.
       Read-only until "Customize" toggles EditMode; each move/resize commit fires
       Change → save. The tile item is a transparent positioning shell so our
       existing .stat / .kr-card visuals show through (see .dash-tiles in app.css). ── *@
    <div class="dash-tiles">
    <RadzenTileLayout @key="_layoutEpoch" Columns="12" RowHeight="92" Gap="10"
                      EditMode="_editMode" Change="@(_ => OnLayoutChangedAsync())">

        <RadzenTileLayoutItem @bind-Col="_tiles[TileTargetsOnline].Col" @bind-Row="_tiles[TileTargetsOnline].Row"
                              @bind-ColSpan="_tiles[TileTargetsOnline].ColSpan" @bind-RowSpan="_tiles[TileTargetsOnline].RowSpan">
            <div class="stat st--ok">
                <span class="stat-strip"></span>
                <div class="stat-row">
                    <div class="stat-ic"><RadzenIcon Icon="dns" /></div>
                    <div>
                        <div class="stat-val">@($"{s.TargetsOnline}/{s.TargetsTotal}")</div>
                        <div class="stat-label">Targets online</div>
                    </div>
                </div>
            </div>
        </RadzenTileLayoutItem>

        <RadzenTileLayoutItem @bind-Col="_tiles[TileDeploymentsToday].Col" @bind-Row="_tiles[TileDeploymentsToday].Row"
                              @bind-ColSpan="_tiles[TileDeploymentsToday].ColSpan" @bind-RowSpan="_tiles[TileDeploymentsToday].RowSpan">
            <div class="stat st--run">
                <span class="stat-strip"></span>
                <div class="stat-row">
                    <div class="stat-ic"><RadzenIcon Icon="rocket_launch" /></div>
                    <div>
                        <div class="stat-val">@s.DeploymentsToday</div>
                        <div class="stat-label">Deployments today</div>
                    </div>
                </div>
            </div>
        </RadzenTileLayoutItem>

        <RadzenTileLayoutItem @bind-Col="_tiles[TileFailed24h].Col" @bind-Row="_tiles[TileFailed24h].Row"
                              @bind-ColSpan="_tiles[TileFailed24h].ColSpan" @bind-RowSpan="_tiles[TileFailed24h].RowSpan">
            <div class="stat st--fail">
                <span class="stat-strip"></span>
                <div class="stat-row">
                    <div class="stat-ic"><RadzenIcon Icon="error" /></div>
                    <div>
                        <div class="stat-val">@s.Failed24h</div>
                        <div class="stat-label">Failed (24h)</div>
                    </div>
                </div>
            </div>
        </RadzenTileLayoutItem>

        <RadzenTileLayoutItem @bind-Col="_tiles[TilePendingOffline].Col" @bind-Row="_tiles[TilePendingOffline].Row"
                              @bind-ColSpan="_tiles[TilePendingOffline].ColSpan" @bind-RowSpan="_tiles[TilePendingOffline].RowSpan">
            <div class="stat st--offline">
                <span class="stat-strip"></span>
                <div class="stat-row">
                    <div class="stat-ic"><RadzenIcon Icon="cloud_off" /></div>
                    <div>
                        <div class="stat-val">@s.PendingOffline</div>
                        <div class="stat-label">Pending offline</div>
                    </div>
                </div>
            </div>
        </RadzenTileLayoutItem>

        <RadzenTileLayoutItem @bind-Col="_tiles[TileRecent].Col" @bind-Row="_tiles[TileRecent].Row"
                              @bind-ColSpan="_tiles[TileRecent].ColSpan" @bind-RowSpan="_tiles[TileRecent].RowSpan">
            <div class="kr-card">
                <div class="kr-card-head">
                    <h3>Recent deployments</h3>
                    <a class="primary-link" href="@Sp("/deployments")">View all</a>
                </div>
                @if (s.Recent.Count == 0)
                {
                    <div class="kr-empty">No deployments yet.</div>
                }
                else
                {
                    <table class="dg">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Project / Release</th>
                                <th>Environment</th>
                                <th>Target</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in s.Recent)
                            {
                                <tr class="clickable" @onclick="@(() => Nav.NavigateTo(Sp($"/deployments/{d.Id}")))">
                                    <td><StatusPill Deployment="d.Status" /></td>
                                    <td>
                                        <span class="cell-strong">@(d.Release?.Project?.Name ?? "—")</span>
                                        <span class="mono cell-muted">&nbsp;@(d.Release?.Version)</span>
                                    </td>
                                    <td>
                                        <span class="env-cell @EnvColor(d.Environment?.Name)">
                                            <span class="dot"></span>@(d.Environment?.Name ?? "—")
                                        </span>
                                    </td>
                                    <td>@TargetLabel(d)</td>
                                    <td class="mono cell-muted">@TimeLabel(d)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </RadzenTileLayoutItem>

        <RadzenTileLayoutItem @bind-Col="_tiles[TileAttention].Col" @bind-Row="_tiles[TileAttention].Row"
                              @bind-ColSpan="_tiles[TileAttention].ColSpan" @bind-RowSpan="_tiles[TileAttention].RowSpan">
            <div class="kr-card">
                <div class="kr-card-head"><h3>Needs attention</h3></div>
                @if (s.Attention.Count == 0)
                {
                    <div class="kr-empty">Nothing needs attention.</div>
                }
                else
                {
                    @foreach (var d in s.Attention)
                    {
                        <a class="attn-row" href="@Sp($"/deployments/{d.Id}")">
                            <StatusPill Deployment="d.Status" />
                            <div class="attn-body">
                                <div class="attn-title">
                                    @(d.Release?.Project?.Name ?? "—")
                                    <span class="mono muted-3">@(d.Release?.Version)</span>
                                </div>
                                <div class="attn-meta">@(d.Environment?.Name) · @TargetLabel(d) · @TimeLabel(d)</div>
                            </div>
                            <RadzenIcon Icon="chevron_right" Style="color: var(--text-3);" />
                        </a>
                    }
                }
            </div>
        </RadzenTileLayoutItem>

        <RadzenTileLayoutItem @bind-Col="_tiles[TileEnvironmentHealth].Col" @bind-Row="_tiles[TileEnvironmentHealth].Row"
                              @bind-ColSpan="_tiles[TileEnvironmentHealth].ColSpan" @bind-RowSpan="_tiles[TileEnvironmentHealth].RowSpan">
            <div class="kr-card">
                <div class="kr-card-head"><h3>Environment health</h3></div>
                @if (s.Environments.Count == 0)
                {
                    <div class="kr-empty">No environments configured.</div>
                }
                else
                {
                    @for (var i = 0; i < s.Environments.Count; i++)
                    {
                        var e = s.Environments[i];
                        <div class="envh-row @($"env-c{i % 6}")">
                            <span class="envh-dot"></span>
                            <span class="envh-name">@e.Name</span>
                            <span class="envh-spacer"></span>
                            <span class="envh-deploys">@e.DeploysThisWeek deploys/wk</span>
                            <span class="envh-gauge">@e.TargetsOnline / @e.TargetsTotal up</span>
                        </div>
                    }
                }
            </div>
        </RadzenTileLayoutItem>

    </RadzenTileLayout>
    </div>

    @* ── Analytics — OLAP-style pivot over deployment facts ── *@
    <div class="kr-card" style="margin-top: var(--section-gap);">
        <div class="kr-card-head kraken-analytics-head" @onclick="ToggleAnalyticsAsync">
            <h3><RadzenIcon Icon="pivot_table_chart" Style="vertical-align: -4px; margin-right: 7px; color: var(--coral);" />Analytics</h3>
            <RadzenIcon Icon="@(_analyticsOpen ? "expand_less" : "expand_more")" Style="color: var(--text-3);" />
        </div>

        @if (_analyticsOpen)
        {
            <div class="kr-card-pad">
                <div class="toolbar">
                    <div class="seg">
                        @foreach (var days in (int[])[7, 30, 90])
                        {
                            var d = days;
                            <button class="@(_rangeDays == d ? "on" : "")" @onclick="@(() => SetRangeAsync(d))">@d days</button>
                        }
                    </div>

                    <RadzenDropDown TValue="Guid?" Data="@_views" ValueProperty="Id" TextProperty="Name"
                                    Value="@_selectedViewId" Change="@(v => ApplyViewAsync((Guid?)v))"
                                    AllowClear="true" Placeholder="Saved views…" Style="min-width: 190px;" />
                    <RadzenButton Icon="save" Text="Save view" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@SaveViewAsync" />
                    @if (_selectedViewId is not null)
                    {
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      title="Delete selected view" Click="@DeleteViewAsync" />
                    }

                    <span class="muted-3" style="margin-left: auto; font-size: 12.5px;">
                        @_facts.Count deployment@(_facts.Count == 1 ? "" : "s")@(_factsTruncated ? " (capped — narrow the range)" : "") ·
                        click a row total to open the deployments behind it
                    </span>
                </div>

                @* Layout controls — our own (Radzen's field picker is off): the
                   layout is the single source of truth, edits rebuild the pivot. *@
                <div class="kraken-pivot-controls">
                    <div class="kpc-field">
                        <label>Rows</label>
                        <RadzenDropDown TValue="IEnumerable<string>" Multiple="true" Chips="true" AllowClear="true"
                                        Data="@PivotFields.Dimensions" TextProperty="Title" ValueProperty="Property"
                                        Value="@_layout.Rows" Change="@(v => SetAxis(isRows: true, (IEnumerable<string>?)v))"
                                        Placeholder="(none)" Style="width: 100%;" />
                    </div>
                    <div class="kpc-field">
                        <label>Columns</label>
                        <RadzenDropDown TValue="IEnumerable<string>" Multiple="true" Chips="true" AllowClear="true"
                                        Data="@PivotFields.Dimensions" TextProperty="Title" ValueProperty="Property"
                                        Value="@_layout.Columns" Change="@(v => SetAxis(isRows: false, (IEnumerable<string>?)v))"
                                        Placeholder="(none)" Style="width: 100%;" />
                    </div>
                    <div class="kpc-field">
                        <label>Values</label>
                        <RadzenDropDown TValue="IEnumerable<string>" Multiple="true" Chips="true" AllowClear="true"
                                        Data="@PivotFields.Catalog" TextProperty="Title" ValueProperty="Property"
                                        Value="@_layout.Values.Select(v => v.Property)" Change="@(v => SetValues((IEnumerable<string>?)v))"
                                        Placeholder="(none)" Style="width: 100%;" />
                        <div class="kpc-fns">
                            @foreach (var v in _layout.Values)
                            {
                                var prop = v.Property;
                                <div class="kpc-fn">
                                    <span class="kpc-fn-name">@PivotFields.Title(prop)</span>
                                    <RadzenDropDown TValue="AggregateFunction" Data="@PivotFields.FunctionsFor(prop)"
                                                    Value="@v.Function" Change="@(f => SetValueFunction(prop, (AggregateFunction)f))"
                                                    Disabled="@(PivotFields.FunctionsFor(prop).Count == 1)" />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (_factsLoading)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
                else if (_layout.Values.Count == 0)
                {
                    <div class="kr-empty">Add at least one value to see the pivot.</div>
                }
                else
                {
                    <AnalyticsPivot @ref="_pivot" Facts="@_facts" Layout="@_layout"
                                    RenderToken="@_pivotKey" OnDrill="@OpenDrillAsync" />
                }
            </div>
        }
    </div>
}

@code {
    private DashboardSummary? _summary;
    private Dictionary<string, int> _envColor = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadLayoutAsync();
    }

    // ── Tile layout (RadzenTileLayout) — per-user, DB-persisted ──────────────

    private const string DashboardKey = "space-home";

    // Bump when the tile set changes incompatibly: a saved layout with a different
    // version is ignored and the default is used (safe re-flow).
    private const int LayoutVersion = 1;

    // Stable tile ids — persisted, never rename.
    private const string TileTargetsOnline = "targets-online";
    private const string TileDeploymentsToday = "deployments-today";
    private const string TileFailed24h = "failed-24h";
    private const string TilePendingOffline = "pending-offline";
    private const string TileRecent = "recent-deployments";
    private const string TileAttention = "needs-attention";
    private const string TileEnvironmentHealth = "environment-health";

    private bool _editMode;
    private int _layoutEpoch;
    private Task? _pendingSave; // in-flight layout save, so Reset can await it first
    private Dictionary<string, TilePos> _tiles = DefaultTilePositions();

    // Default arrangement on the 12-column grid.
    private static Dictionary<string, TilePos> DefaultTilePositions() => new()
    {
        [TileTargetsOnline]     = new TilePos { Col = 1,  Row = 1, ColSpan = 3, RowSpan = 1 },
        [TileDeploymentsToday]  = new TilePos { Col = 4,  Row = 1, ColSpan = 3, RowSpan = 1 },
        [TileFailed24h]         = new TilePos { Col = 7,  Row = 1, ColSpan = 3, RowSpan = 1 },
        [TilePendingOffline]    = new TilePos { Col = 10, Row = 1, ColSpan = 3, RowSpan = 1 },
        [TileRecent]            = new TilePos { Col = 1,  Row = 2, ColSpan = 8, RowSpan = 5 },
        [TileAttention]         = new TilePos { Col = 9,  Row = 2, ColSpan = 4, RowSpan = 3 },
        [TileEnvironmentHealth] = new TilePos { Col = 9,  Row = 5, ColSpan = 4, RowSpan = 2 },
    };

    private void ToggleEditMode() => _editMode = !_editMode;

    private async Task LoadLayoutAsync()
    {
        await EnsureUserAsync();
        if (_userId is not { } userId)
        {
            return;
        }

        var saved = await DashboardLayoutSvc.GetForUserAsync(userId, DashboardKey);
        if (saved is null)
        {
            return; // no saved layout → keep defaults
        }

        try
        {
            var state = JsonSerializer.Deserialize<TileLayoutState>(saved.Definition, LayoutJson);
            if (state is null || state.Version != LayoutVersion)
            {
                return; // stale/incompatible → keep defaults (safe re-flow)
            }

            // Overlay saved positions onto the current default set: known tiles take
            // their saved place; tiles added since keep their default; tiles no longer
            // defined are dropped.
            var positions = DefaultTilePositions();
            foreach (var t in state.Tiles)
            {
                if (positions.ContainsKey(t.TileId))
                {
                    positions[t.TileId] = new TilePos
                    {
                        Col = t.Col, Row = t.Row, ColSpan = t.ColSpan, RowSpan = t.RowSpan,
                    };
                }
            }
            _tiles = positions;
        }
        catch (JsonException)
        {
            // Corrupt definition → keep defaults.
        }
    }

    private async Task OnLayoutChangedAsync()
    {
        // Persist only deliberate edits. Change fires once per move/resize commit
        // (on pointer-up), so it's one write per gesture — no per-pointer chatter.
        if (!_editMode || _userId is not { } userId)
        {
            return;
        }

        var state = new TileLayoutState(
            LayoutVersion,
            _tiles.Select(kv => new TileState(
                kv.Key, kv.Value.Col, kv.Value.Row, kv.Value.ColSpan, kv.Value.RowSpan)).ToList());

        // Track the in-flight write so a concurrent Reset can await it before
        // clearing — otherwise this save could land after the clear and silently
        // undo the reset (Change fires on pointer-up; Reset can be clicked mid-save).
        var save = DashboardLayoutSvc.UpsertAsync(userId, DashboardKey, JsonSerializer.Serialize(state, LayoutJson));
        _pendingSave = save;
        await save;
    }

    private async Task ResetLayoutAsync()
    {
        // Let any in-flight save finish first so it can't re-persist the old layout
        // after we clear it.
        if (_pendingSave is { } pending)
        {
            try { await pending; }
            catch { /* a faulted save is moot — we're discarding the layout anyway */ }
        }

        _tiles = DefaultTilePositions();
        _layoutEpoch++; // remount the layout so items re-seed from the defaults
        if (_userId is { } userId)
        {
            await DashboardLayoutSvc.ClearAsync(userId, DashboardKey);
        }
    }

    private async Task EnsureUserAsync()
    {
        if (_userId is not null)
        {
            return;
        }
        var authState = await AuthState.GetAuthenticationStateAsync();
        if (Guid.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
        {
            _userId = id;
        }
    }

    private sealed class TilePos
    {
        public int Col { get; set; }
        public int Row { get; set; }
        public int ColSpan { get; set; }
        public int RowSpan { get; set; }
    }

    private sealed record TileLayoutState(int Version, List<TileState> Tiles);

    private sealed record TileState(string TileId, int Col, int Row, int ColSpan, int RowSpan);

    private async Task LoadAsync()
    {
        _summary = await DashboardSvc.GetSummaryAsync();
        _envColor = _summary.Environments
            .Select((e, i) => (e.Name, i))
            .ToDictionary(x => x.Name, x => x.i, StringComparer.OrdinalIgnoreCase);
    }

    private async Task RefreshAsync()
    {
        _summary = null;
        await LoadAsync();
    }

    private string EnvColor(string? name)
        => name is not null && _envColor.TryGetValue(name, out var i) ? $"env-c{i % 6}" : "env-c0";

    private static string TargetLabel(Deployment d)
    {
        if (d.Target is not null)
        {
            return d.Target.Name;
        }
        var count = d.Targets?.Count ?? 0;
        return count > 0 ? $"{count} targets" : "—";
    }

    private static string TimeLabel(Deployment d)
    {
        var ts = (d.StartedUtc ?? d.CreatedUtc).ToLocalTime();
        return ts.Date == DateTimeOffset.Now.Date
            ? ts.ToString("HH:mm")
            : ts.ToString("MMM d");
    }

    // ── Analytics pivot ──────────────────────────────────────────────────

    private const int FactRowCap = 10_000;

    private static readonly JsonSerializerOptions LayoutJson = new(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() },
    };

    private AnalyticsPivot? _pivot;
    private bool _analyticsOpen;
    private bool _factsLoading;
    private bool _factsTruncated;
    private int _rangeDays = 90;
    private int _rebuilds;
    private IReadOnlyList<DeploymentFact> _facts = [];
    private PivotLayout _layout = PivotFields.Default();
    private string _pivotKey = "default";
    private List<PivotView> _views = [];
    private bool _viewsLoaded;
    private Guid? _selectedViewId;
    private Guid? _userId;

    /// <summary>Forces the child pivot to rebuild (remount + render). Used after
    /// a range change or applied view so a fresh layout takes; incidental Home
    /// re-renders keep the token stable, leaving the user's picker state intact.</summary>
    private void BumpPivot() => _pivotKey = $"r{++_rebuilds}";

    private async Task ToggleAnalyticsAsync()
    {
        _analyticsOpen = !_analyticsOpen;
        if (_analyticsOpen && _facts.Count == 0)
        {
            await LoadAnalyticsAsync();
        }
    }

    private async Task LoadAnalyticsAsync()
    {
        _factsLoading = true;
        try
        {
            await EnsureUserAsync();
            if (_userId is { } uid && !_viewsLoaded)
            {
                _views = await PivotViewSvc.GetForUserAsync(uid);
                _viewsLoaded = true;
            }

            _facts = await DashboardSvc.GetDeploymentFactsAsync(
                DateTimeOffset.UtcNow.AddDays(-_rangeDays), FactRowCap);
            _factsTruncated = _facts.Count >= FactRowCap;
            BumpPivot(); // new fact set → rebuild the pivot
        }
        finally
        {
            _factsLoading = false;
        }
    }

    private async Task SetRangeAsync(int days)
    {
        if (days == _rangeDays)
        {
            return;
        }
        _rangeDays = days;
        await LoadAnalyticsAsync();
    }

    // ── Layout controls (our own — Radzen field picker is off) ───────────

    private void SetAxis(bool isRows, IEnumerable<string>? props)
    {
        var list = props?.ToList() ?? [];
        _layout = isRows ? _layout with { Rows = list } : _layout with { Columns = list };
        BumpPivot();
    }

    private void SetValues(IEnumerable<string>? props)
    {
        var selected = props?.ToList() ?? [];
        // Keep the function of values that stay; default-init newly added ones;
        // preserve the user's ordering of the multiselect.
        var values = selected.Select(p =>
            _layout.Values.FirstOrDefault(v => v.Property == p)
            ?? new PivotMeasure(p, PivotFields.DefaultFunction(p))).ToList();
        _layout = _layout with { Values = values };
        BumpPivot();
    }

    private void SetValueFunction(string property, AggregateFunction fn)
    {
        _layout = _layout with
        {
            Values = _layout.Values
                .Select(v => v.Property == property ? v with { Function = fn } : v)
                .ToList(),
        };
        BumpPivot();
    }

    private async Task SaveViewAsync()
    {
        if (_userId is not { } userId)
        {
            return;
        }

        var initial = _views.FirstOrDefault(v => v.Id == _selectedViewId)?.Name;
        var result = await Dialog.OpenAsync<SavePivotViewDialog>(
            "Save pivot view",
            new Dictionary<string, object?> { [nameof(SavePivotViewDialog.InitialName)] = initial },
            new DialogOptions { Width = "420px" });

        if (result is not string name || string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        if (_layout.Values.Count == 0)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Nothing to save",
                "Add at least one value to the pivot first.", 4000);
            return;
        }

        var saved = await PivotViewSvc.UpsertAsync(userId, name, JsonSerializer.Serialize(_layout, LayoutJson));
        _views = await PivotViewSvc.GetForUserAsync(userId);
        _selectedViewId = saved.Id;
        Notifications.Notify(NotificationSeverity.Success, "View saved", $"'{name}' was saved.", 3000);
    }

    private Task ApplyViewAsync(Guid? viewId)
    {
        _selectedViewId = viewId;

        if (viewId is null)
        {
            _layout = PivotFields.Default();
            BumpPivot();
            return Task.CompletedTask;
        }

        var view = _views.FirstOrDefault(v => v.Id == viewId);
        if (view is null)
        {
            return Task.CompletedTask;
        }

        try
        {
            var layout = JsonSerializer.Deserialize<PivotLayout>(view.Definition, LayoutJson);
            if (layout is { Values.Count: > 0 })
            {
                // Drop properties that no longer exist on the fact shape so a
                // stale view can't wedge the pivot.
                var known = PivotFields.Catalog.Select(f => f.Property).ToHashSet();
                _layout = new PivotLayout(
                    layout.Rows.Where(known.Contains).ToList(),
                    layout.Columns.Where(known.Contains).ToList(),
                    layout.Values.Where(v => known.Contains(v.Property)).ToList());
                BumpPivot(); // rebuild with the applied layout
            }
        }
        catch (JsonException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Corrupt view",
                "This saved view could not be read.", 4000);
        }

        return Task.CompletedTask;
    }

    private async Task DeleteViewAsync()
    {
        if (_userId is not { } userId || _selectedViewId is not { } viewId)
        {
            return;
        }

        var view = _views.FirstOrDefault(v => v.Id == viewId);
        var confirmed = await Dialog.Confirm(
            $"Delete view '{view?.Name}'?", "Delete pivot view",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await PivotViewSvc.DeleteAsync(userId, viewId);
            _views = await PivotViewSvc.GetForUserAsync(userId);
            await ApplyViewAsync(null);
        }
    }

    private async Task OpenDrillAsync(IQueryable<DeploymentFact>? view)
    {
        var facts = view?.ToList() ?? [];
        await Dialog.OpenAsync<PivotDrillDialog>(
            $"Deployments ({facts.Count})",
            new Dictionary<string, object?> { [nameof(PivotDrillDialog.Facts)] = facts },
            new DialogOptions { Width = "880px" });
    }
}
