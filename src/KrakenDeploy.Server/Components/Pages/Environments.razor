@page "/environments"
@rendermode InteractiveServer
@attribute [Authorize]

@inject EnvironmentService EnvironmentSvc
@inject DashboardService DashboardSvc
@inject DialogService Dialog
@inject NotificationService Notifications
@inject UiActionGuard Guard

<PageTitle>Environments - KrakenDeploy</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Environments</h1>
        <p class="page-sub">Promotion path · @_envs.Count environments</p>
    </div>
    <div class="page-head-actions">
        <RequirePermission Permission="Permission.EnvironmentCreate">
            <RadzenButton Icon="add_circle_outline" Text="New environment"
                          ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled"
                          Click="OpenCreateDialogAsync" />
        </RequirePermission>
    </div>
</div>

@if (_envs.Count == 0)
{
    <div class="kr-card kr-card-pad kr-empty">No environments yet. Click "New environment" to get started.</div>
}
else
{
    <div class="env-flow">
        @for (var i = 0; i < _envs.Count; i++)
        {
            var e = _envs[i];
            var h = _health.GetValueOrDefault(e.Id);
            var idx = i;
            <div class="env-card @($"env-c{i % 6}")">
                <div class="env-card-bar"></div>
                <div class="env-card-body">
                    <div class="env-card-head">
                        <span class="env-card-name">@e.Name</span>
                        <span class="env-card-order">#@(i + 1)</span>
                    </div>
                    <div class="env-card-gauge">
                        @(h?.TargetsOnline ?? 0)<small> / @(h?.TargetsTotal ?? 0) targets up</small>
                    </div>
                    <div class="env-card-deploys">@(h?.DeploysThisWeek ?? 0) deploys this week</div>
                    <div class="env-card-actions">
                        <RequirePermission Permission="Permission.EnvironmentEdit">
                            <RadzenButton Icon="arrow_upward" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                          Disabled="@(idx == 0)" Click="@(() => MoveUpAsync(e))" title="Move up" />
                        </RequirePermission>
                        <RequirePermission Permission="Permission.EnvironmentEdit">
                            <RadzenButton Icon="arrow_downward" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                          Disabled="@(idx == _envs.Count - 1)" Click="@(() => MoveDownAsync(e))" title="Move down" />
                        </RequirePermission>
                        <RequirePermission Permission="Permission.EnvironmentEdit">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                          Click="@(() => OpenEditDialogAsync(e))" title="Edit" />
                        </RequirePermission>
                        <RequirePermission Permission="Permission.EnvironmentDelete">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                          Click="@(() => DeleteAsync(e))" title="Delete" />
                        </RequirePermission>
                    </div>
                </div>
            </div>
            @if (i < _envs.Count - 1)
            {
                <div class="env-arrow"><RadzenIcon Icon="east" /></div>
            }
        }
    </div>

    <p class="page-sub" style="margin-top:-8px;">
        Target counts reflect distinct machines that have deployed to each environment
        (targets carry roles, not a fixed environment).
    </p>
}

@code {
    private List<DeploymentEnvironment> _envs = [];
    private Dictionary<Guid, EnvironmentHealth> _health = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _envs = await EnvironmentSvc.GetAllOrderedAsync();
        _health = (await DashboardSvc.GetEnvironmentHealthAsync())
            .ToDictionary(h => h.EnvironmentId);
    }

    private async Task OpenCreateDialogAsync()
    {
        var result = await Dialog.OpenAsync<EnvironmentFormDialog>(
            "New Environment",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "480px" });

        if (result is true)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialogAsync(DeploymentEnvironment env)
    {
        var result = await Dialog.OpenAsync<EnvironmentFormDialog>(
            "Edit Environment",
            new Dictionary<string, object?> { [nameof(EnvironmentFormDialog.Environment)] = env },
            new DialogOptions { Width = "480px" });

        if (result is true)
        {
            await LoadAsync();
        }
    }

    private async Task MoveUpAsync(DeploymentEnvironment env)
    {
        if (!await Guard.AllowAsync(Permission.EnvironmentEdit)) return;
        await EnvironmentSvc.MoveUpAsync(env.Id);
        await LoadAsync();
    }

    private async Task MoveDownAsync(DeploymentEnvironment env)
    {
        if (!await Guard.AllowAsync(Permission.EnvironmentEdit)) return;
        await EnvironmentSvc.MoveDownAsync(env.Id);
        await LoadAsync();
    }

    private async Task DeleteAsync(DeploymentEnvironment env)
    {
        if (!await Guard.AllowAsync(Permission.EnvironmentDelete)) return;

        var confirmed = await Dialog.Confirm(
            $"Delete environment '{env.Name}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await EnvironmentSvc.DeleteAsync(env.Id);
            await LoadAsync();
            Notifications.Notify(NotificationSeverity.Success, "Deleted",
                $"'{env.Name}' was deleted.", 4000);
        }
    }
}
