@page "/targets"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable

@inject TargetService TargetSvc
@inject ITargetStatusNotifier StatusNotifier
@inject DialogService Dialog
@inject NotificationService Notification

<PageTitle>Deployment Targets - KrakenDeploy</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center"
             class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" style="margin:0;">
        Deployment Targets
    </RadzenText>
    <RequirePermission Permission="Permission.MachineCreate">
        <RadzenButton Text="Add Deployment Target"
                      Icon="add_circle_outline"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="OpenAddWizardAsync" />
    </RequirePermission>
</RadzenStack>

<RadzenDataGrid Data="@_targets" TItem="DeploymentTarget"
                AllowPaging="true" PageSize="25"
                AllowSorting="true"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                AllowColumnResize="true"
                EmptyText="No targets registered yet. Click 'Add Deployment Target' to get started.">
    <Columns>
        <RadzenDataGridColumn TItem="DeploymentTarget" Property="Name" Title="Name" Width="180px">
            <Template Context="t">
                <a href="/targets/@t.Id">@t.Name</a>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="DeploymentTarget" Property="Status" Title="Status"
                              Width="120px" Filterable="false">
            <Template Context="t">
                <span title="@LastSeenTitle(t.LastSeenUtc)">
                    <RadzenBadge Text="@t.Status.ToString()" BadgeStyle="@StatusBadgeStyle(t.Status)" />
                </span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="DeploymentTarget" Property="MachineName" Title="Hostname"
                              Width="160px" />
        <RadzenDataGridColumn TItem="DeploymentTarget" Property="OperatingSystem" Title="OS"
                              Width="130px" />
        <RadzenDataGridColumn TItem="DeploymentTarget" Property="AgentVersion" Title="Agent"
                              Width="100px" />
        <RadzenDataGridColumn TItem="DeploymentTarget" Property="TransportMode" Title="Transport"
                              Width="110px">
            <Template Context="t">
                @t.TransportMode.ToString()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="DeploymentTarget" Title="Roles" Filterable="false"
                              Sortable="false">
            <Template Context="t">
                @string.Join(", ", t.Roles)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="DeploymentTarget" Title="Last Seen" Width="130px"
                              Filterable="false" Sortable="false">
            <Template Context="t">
                <span title="@(t.LastSeenUtc.HasValue ? t.LastSeenUtc.Value.ToString("u") : "never")">
                    @RelativeTime(t.LastSeenUtc)
                </span>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<DeploymentTarget> _targets = [];

    // ── Lifecycle ───────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
        => _targets = await TargetSvc.GetAllAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        StatusNotifier.TargetStatusChanged += OnTargetStatusChanged;
    }

    public ValueTask DisposeAsync()
    {
        StatusNotifier.TargetStatusChanged -= OnTargetStatusChanged;
        return ValueTask.CompletedTask;
    }

    // ── Live status update ──────────────────────────────────────────────────

    private void OnTargetStatusChanged(Guid targetId, TargetStatus status, DateTimeOffset? lastSeenUtc)
    {
        var target = _targets.FirstOrDefault(t => t.Id == targetId);
        if (target is null)
        {
            return;
        }

        target.Status = status;
        target.LastSeenUtc = lastSeenUtc;

        // Schedule a UI re-render on the correct Blazor synchronisation context.
        _ = InvokeAsync(StateHasChanged);
    }

    // ── Wizard ─────────────────────────────────────────────────────────────

    private async Task OpenAddWizardAsync()
    {
        var result = await Dialog.OpenAsync<AddTargetWizardDialog>(
            "Add Deployment Target",
            options: new DialogOptions
            {
                Width = "600px",
                CloseDialogOnOverlayClick = false,
            });

        if (result is true)
        {
            _targets = await TargetSvc.GetAllAsync();
            Notification.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Target created",
                Detail = "The deployment target has been created. Install the agent using the provided token.",
                Duration = 6000,
            });
        }
    }

    // ── Helpers ─────────────────────────────────────────────────────────────

    private static BadgeStyle StatusBadgeStyle(TargetStatus status) => status switch
    {
        TargetStatus.Online       => BadgeStyle.Success,
        TargetStatus.Offline      => BadgeStyle.Danger,
        TargetStatus.Disabled     => BadgeStyle.Warning,
        TargetStatus.ShuttingDown => BadgeStyle.Warning,
        _                         => BadgeStyle.Light,
    };

    private static string LastSeenTitle(DateTimeOffset? dt)
        => dt.HasValue
            ? $"Last seen {dt.Value:u}"
            : "Never connected";

    private static string RelativeTime(DateTimeOffset? dt)
    {
        if (dt is null) return "never";
        var diff = DateTimeOffset.UtcNow - dt.Value;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
}
