@page "/step-packages"
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Security
@using KrakenDeploy.Server.Core.Domain.StepPackages
@using KrakenDeploy.Server.Data.Services
@inject StepPackageService Svc
@inject DialogService Dialog
@inject NotificationService Notifications

<PageTitle>Step Packages</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0">
        Step Packages
    </RadzenText>
    <RequirePermission Permission="Permission.StepPackageManage">
        <RadzenButton Text="Upload" Icon="cloud_upload" Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="OpenUploadAsync" />
    </RequirePermission>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-3">
    Installed <code>.kdeploy-step</code> packages. Each row is a single
    (name, version) install. Multiple versions of the same package coexist;
    each step in a deployment process pins to one exact version, locked
    further at release time so old releases continue to deploy with the
    package they were authored against.
</RadzenText>

@if (!_loaded)
{
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Loading…</RadzenText>
}
else if (_packages.Count == 0)
{
    <RadzenCard class="rz-p-5 rz-text-align-center">
        <RadzenIcon Icon="extension" Style="font-size: 3rem; opacity: 0.3;" />
        <RadzenText TextStyle="TextStyle.H6" class="rz-mt-3">No packages installed</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-4">
            Upload a <code>.kdeploy-step</code> archive to install a step package
            on this Kraken server.
        </RadzenText>
        <RequirePermission Permission="Permission.StepPackageManage">
            <RadzenButton Text="Upload" Icon="cloud_upload"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="OpenUploadAsync" />
        </RequirePermission>
    </RadzenCard>
}
else
{
    <RadzenDataGrid Data="@_packages" TItem="StepPackage"
                    AllowPaging="false" AllowSorting="true" AllowFiltering="false"
                    Density="Density.Compact">
        <Columns>
            <RadzenDataGridColumn TItem="StepPackage" Property="Name" Title="Package" />
            <RadzenDataGridColumn TItem="StepPackage" Property="Version" Title="Version" Width="120px" />
            <RadzenDataGridColumn TItem="StepPackage" Property="StepTypes" Title="Step types" />
            <RadzenDataGridColumn TItem="StepPackage" Property="Source" Title="Source" Width="120px">
                <Template Context="p">@p.Source</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="StepPackage" Property="CreatedUtc" Title="Installed" Width="180px">
                <Template Context="p">
                    @p.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="StepPackage" Property="Sha256" Title="SHA-256" Width="220px">
                <Template Context="p">
                    <code style="font-size: 0.75em;">@TruncSha(p.Sha256)</code>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="StepPackage" Title="" Width="60px"
                                  Sortable="false" Filterable="false">
                <Template Context="p">
                    <RequirePermission Permission="Permission.StepPackageManage">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      IsBusy="@(_uninstalling == p.Id)"
                                      Click="@(() => UninstallAsync(p))"
                                      title="Uninstall this version" />
                    </RequirePermission>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private bool _loaded;
    private List<StepPackage> _packages = [];
    private Guid? _uninstalling;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loaded = false;
        try
        {
            _packages = await Svc.GetAllAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error,
                "Failed to load step packages", ex.Message, 6000);
            _packages = [];
        }
        _loaded = true;
    }

    private async Task OpenUploadAsync()
    {
        var result = await Dialog.OpenAsync<UploadStepPackageDialog>(
            "Upload step package",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "640px", CloseDialogOnOverlayClick = false });

        if (result is StepPackage)
        {
            await ReloadAsync();
        }
    }

    private static string TruncSha(string sha)
        => string.IsNullOrEmpty(sha) ? "" : sha[..Math.Min(16, sha.Length)] + "…";

    /// <summary>
    /// Uninstall flow (Phase D-11). Two-stage so the admin sees what they're
    /// destroying before it's gone:
    ///   1. Plain confirm dialog up-front.
    ///   2. If the service reports conflicts, present the conflict report
    ///      (live steps + release snapshots) and abort.
    /// </summary>
    private async Task UninstallAsync(StepPackage pkg)
    {
        var confirmed = await Dialog.Confirm(
            $"Remove step package '{pkg.Name}' version '{pkg.Version}'? " +
            "Any deployment / runbook steps pinned to this version will block the uninstall.",
            "Uninstall step package",
            new ConfirmOptions { OkButtonText = "Uninstall", CancelButtonText = "Cancel" });

        if (confirmed != true) { return; }

        _uninstalling = pkg.Id;
        try
        {
            var result = await Svc.UninstallAsync(pkg.Name, pkg.Version);
            switch (result.Status)
            {
                case StepPackageService.UninstallStatus.Uninstalled:
                    Notifications.Notify(NotificationSeverity.Success,
                        "Uninstalled",
                        $"Removed {pkg.Name} {pkg.Version}.", 4000);
                    await ReloadAsync();
                    break;

                case StepPackageService.UninstallStatus.Blocked:
                    await ShowConflictAsync(result.Conflicts!);
                    break;

                case StepPackageService.UninstallStatus.NotFound:
                    // Stale UI — someone else removed it. Refresh quietly.
                    await ReloadAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error,
                "Uninstall failed", ex.Message, 6000);
        }
        finally
        {
            _uninstalling = null;
        }
    }

    /// <summary>
    /// Renders the conflict report into a Radzen Alert dialog. No bulk-upgrade
    /// affordances here — that's D-10. For now the admin's options are
    /// (a) cancel, (b) edit each live step's version pin in the UI, or
    /// (c) wait for releases that snapshotted the version to age out.
    /// </summary>
    private async Task ShowConflictAsync(StepPackageUsageReport report)
    {
        var liveByProject = report.LiveSteps
            .GroupBy(s => s.ProjectSlug)
            .Select(g => $"{g.First().ProjectName} ({g.Key}): " +
                         string.Join(", ", g.Select(s =>
                            $"{s.StepName}{(s.IsRunbook ? " (runbook)" : "")}")));
        var releasesByProject = report.ReleaseSnapshots
            .GroupBy(r => r.ProjectSlug)
            .Select(g => $"{g.First().ProjectName} ({g.Key}): " +
                         string.Join(", ", g.Select(r => r.ReleaseVersion)));

        var body =
            $"'{report.Name} {report.Version}' is still pinned by " +
            $"{report.LiveSteps.Count} live step(s) and " +
            $"{report.ReleaseSnapshots.Count} release snapshot(s).\n\n" +
            (report.LiveSteps.Count > 0
                ? "Live steps:\n  • " + string.Join("\n  • ", liveByProject) + "\n\n"
                : "") +
            (report.ReleaseSnapshots.Count > 0
                ? "Release snapshots:\n  • " + string.Join("\n  • ", releasesByProject) + "\n\n"
                : "") +
            "Edit each live step's version pin (or delete the affected releases) " +
            "before retrying the uninstall.";

        await Dialog.Alert(body, "Uninstall blocked", new AlertOptions
        {
            OkButtonText = "Close",
        });
    }
}
