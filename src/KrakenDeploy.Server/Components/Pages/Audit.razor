@page "/s/{SpaceSlug}/audit"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using KrakenDeploy.Server.Core.Domain.Audit
@using Microsoft.EntityFrameworkCore

@inject KrakenDeploy.Server.Data.KrakenDbContext Db
@inject ISpaceContext SpaceCtx
@inject IPermissionEvaluator Perms
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject DialogService DialogService

<PageTitle>Audit Log - KrakenDeploy</PageTitle>

<RequirePermission Permission="Permission.EventView" Fallback="@_unauthorized">

<RadzenStack Gap="1rem">

    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 class="rz-mb-2">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-0">
            Audit Log
        </RadzenText>
    </RadzenStack>

    @if (HasNonDefaultFilters)
    {
        @* Filter-state callout — pattern from Step Packages + Users +
           Teams. Audit's filter card is right above the grid so the
           operator can see WHAT they typed, but the callout makes it
           obvious WHY the grid might be empty + provides a one-click
           reset path. *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat"
                     Shade="Shade.Lighter" AllowClose="false" class="rz-mb-2">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                         AlignItems="AlignItems.Center">
                <RadzenIcon Icon="filter_alt" />
                <span>
                    Filters active: <strong>@ActiveFiltersSummary</strong>.
                    Showing <strong>@_totalCount</strong> matching @(_totalCount == 1 ? "entry" : "entries").
                </span>
                <RadzenButton Text="Reset filters"
                              Size="ButtonSize.ExtraSmall"
                              Variant="Variant.Text"
                              Click="ResetFilters" />
            </RadzenStack>
        </RadzenAlert>
    }

    @* ── Filters ──────────────────────────────────────────────────────── *@
    <RadzenCard Variant="Variant.Outlined" class="rz-p-4">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem"
                     AlignItems="AlignItems.End" Style="flex-wrap:wrap">

            <RadzenFormField Text="From" style="min-width:160px">
                <RadzenDatePicker @bind-Value="_from" DateFormat="yyyy-MM-dd"
                                  ShowCalendarWeek="false" />
            </RadzenFormField>

            <RadzenFormField Text="To" style="min-width:160px">
                <RadzenDatePicker @bind-Value="_to" DateFormat="yyyy-MM-dd"
                                  ShowCalendarWeek="false" />
            </RadzenFormField>

            <RadzenFormField Text="Event type" style="min-width:200px">
                <RadzenTextBox @bind-Value="_eventTypeFilter"
                               Placeholder="e.g. Project.Created" />
            </RadzenFormField>

            <RadzenFormField Text="User" style="min-width:180px">
                <RadzenTextBox @bind-Value="_userFilter"
                               Placeholder="email or display name" />
            </RadzenFormField>

            <RadzenFormField Text="Subject type" style="min-width:150px">
                <RadzenTextBox @bind-Value="_subjectTypeFilter"
                               Placeholder="e.g. Project" />
            </RadzenFormField>

            @if (_canIncludeSystem)
            {
                @* Sysadmin-only: audit rows with no Space (license uploads,
                   KEK rotations, sign-ins). The flag is re-validated
                   server-side in LoadDataAsync and by the export endpoint —
                   this rendering gate is UI convenience, not authorization. *@
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             AlignItems="AlignItems.Center" class="rz-pb-2">
                    <RadzenSwitch @bind-Value="_includeSystemEvents"
                                  Change="@((bool _) => ApplyFiltersAsync())" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                        Include system events
                    </RadzenText>
                </RadzenStack>
            }

            <RadzenButton Icon="search" Text="Search"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="ApplyFiltersAsync" />

            <RadzenButton Icon="clear" Text="Reset"
                          ButtonStyle="ButtonStyle.Light"
                          Click="ResetFilters" />

            @* Export takes the current filter values via query string so the
               download mirrors exactly what's on screen. Anchor download
               attribute hints the filename; the server's
               Content-Disposition header wins, so the stamped name shows. *@
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                         Style="margin-left:auto">
                <RadzenButton Icon="download" Text="CSV"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo(BuildExportUrl(".csv"), forceLoad: true))" />
                <RadzenButton Icon="data_object" Text="JSON"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo(BuildExportUrl(".json"), forceLoad: true))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @* ── Grid ─────────────────────────────────────────────────────────── *@
    <KrakenGrid SettingsKey="audit" @ref="_grid"
                    Data="@_entries"
                    TItem="AuditEntry"
                    Count="@_totalCount"
                    LoadData="@LoadDataAsync"
                    AllowPaging="true"
                    PageSize="50"
                    AllowSorting="true"
                    AllowColumnResize="true"
                    IsLoading="@_loading"
                    EmptyText="No audit entries match the current filters.">
        <Columns>
            <RadzenDataGridColumn TItem="AuditEntry" Property="OccurredUtc"
                                  Title="Occurred" Width="180px" Sortable="true">
                <Template Context="e">
                    <span title="@e.OccurredUtc.ToString("O")">
                        @e.OccurredUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                    </span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="AuditEntry" Property="EventType"
                                  Title="Event" Width="200px" Sortable="true" />

            <RadzenDataGridColumn TItem="AuditEntry" Property="UserDisplay"
                                  Title="User" Width="220px">
                <Template Context="e">
                    <span>@e.UserDisplay</span>
                    @if (!string.IsNullOrEmpty(e.IpAddress))
                    {
                        <span class="rz-text-caption rz-color-secondary"
                              style="margin-left:0.4rem;">
                            (@e.IpAddress)
                        </span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="AuditEntry" Title="Subject">
                <Template Context="e">
                    @if (e.SubjectType is not null)
                    {
                        <span class="rz-text-caption rz-color-secondary">@e.SubjectType</span>
                        <span> </span>
                    }
                    @if (!string.IsNullOrEmpty(e.SubjectName))
                    {
                        <strong>@e.SubjectName</strong>
                    }
                    else if (!string.IsNullOrEmpty(e.SubjectId))
                    {
                        <span class="rz-text-caption">@e.SubjectId</span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="AuditEntry" Property="Details"
                                  Title="Details">
                <Template Context="e">
                    @if (!string.IsNullOrEmpty(e.Details))
                    {
                        <span>@e.Details</span>
                    }
                    else if (e.BeforeJson is not null || e.AfterJson is not null)
                    {
                        <RadzenButton Icon="data_object" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall"
                                      Text="View snapshot"
                                      Click="@(() => ShowSnapshot(e))" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </KrakenGrid>

</RadzenStack>

</RequirePermission>

@code {
    private RadzenDataGrid<AuditEntry>? _grid;
    private List<AuditEntry> _entries = [];
    private int  _totalCount;
    private bool _loading;

    // Filters
    private DateTime? _from;
    private DateTime? _to;
    private string _eventTypeFilter  = "";
    private string _userFilter       = "";
    private string _subjectTypeFilter = "";

    // System-event visibility (rows with SpaceId == null). The toggle is
    // rendered only for AdministerSystem holders and re-validated at query
    // time — see BuildQueryAsync.
    private bool _canIncludeSystem;
    private bool _includeSystemEvents;

    private RenderFragment _unauthorized =>
        @<div class="rz-p-4">
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                You do not have permission to view the audit log.
            </RadzenAlert>
        </div>;

    protected override async Task OnInitializedAsync()
    {
        // Default date range: last 30 days
        _to   = DateTime.Today;
        _from = DateTime.Today.AddDays(-30);

        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _canIncludeSystem = await Perms.HasPermissionAsync(user, Permission.AdministerSystem);
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _loading = true;
        try
        {
            var query = await BuildQueryAsync();

            _totalCount = await query.CountAsync();

            // Sorting
            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = args.OrderBy switch
                {
                    "OccurredUtc"      => args.Sorts?.FirstOrDefault()?.SortOrder == SortOrder.Descending
                        ? query.OrderByDescending(e => e.OccurredUtc)
                        : query.OrderBy(e => e.OccurredUtc),
                    "EventType"        => args.Sorts?.FirstOrDefault()?.SortOrder == SortOrder.Descending
                        ? query.OrderByDescending(e => e.EventType)
                        : query.OrderBy(e => e.EventType),
                    _                  => query.OrderByDescending(e => e.OccurredUtc),
                };
            }
            else
            {
                query = query.OrderByDescending(e => e.OccurredUtc);
            }

            _entries = await query
                .Skip(args.Skip ?? 0)
                .Take(args.Top ?? 50)
                .ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Builds the grid query through the audit choke point
    /// (<see cref="AuditExportService.ApplyScopedFilter"/>): active Space only,
    /// plus system rows (SpaceId == null) when the sysadmin toggle is on.
    /// The toggle is re-validated server-side here (UiActionGuard pattern) —
    /// the rendering gate alone must never authorize the wider query, because
    /// a long-lived circuit can outlive an AdministerSystem revocation.
    /// </summary>
    private async Task<IQueryable<AuditEntry>> BuildQueryAsync()
    {
        var includeSystem = false;
        if (_includeSystemEvents)
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            includeSystem = await Perms.HasPermissionAsync(user, Permission.AdministerSystem);
        }

        return AuditExportService.ApplyScopedFilter(
            Db.AuditEntries.AsNoTracking(), BuildFilter(includeSystem));
    }

    /// <summary>
    /// The page's filter state as the shared <see cref="AuditExportService.Filter"/>
    /// shape. The "to" boundary is pushed to the next day so the exclusive
    /// comparison includes everything from the chosen day. SpaceIds carries the
    /// active Space, already validated by <c>SpaceScopedComponentBase</c>.
    /// </summary>
    private AuditExportService.Filter BuildFilter(bool includeSystemRows)
    {
        DateTimeOffset? fromUtc = _from.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(_from.Value.Date, DateTimeKind.Utc))
            : null;
        DateTimeOffset? toUtc = _to.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(_to.Value.Date.AddDays(1), DateTimeKind.Utc))
            : null;

        return new AuditExportService.Filter(
            SpaceIds:            [SpaceCtx.CurrentSpaceId],
            IncludeSystemRows:   includeSystemRows,
            FromUtc:             fromUtc,
            ToUtcExclusive:      toUtc,
            EventTypeContains:   string.IsNullOrWhiteSpace(_eventTypeFilter)   ? null : _eventTypeFilter.Trim(),
            UserDisplayContains: string.IsNullOrWhiteSpace(_userFilter)        ? null : _userFilter.Trim(),
            SubjectTypeContains: string.IsNullOrWhiteSpace(_subjectTypeFilter) ? null : _subjectTypeFilter.Trim());
    }

    private async Task ApplyFiltersAsync()
    {
        if (_grid is not null)
        {
            await _grid.Reload();
        }
    }

    private void ResetFilters()
    {
        _eventTypeFilter   = "";
        _userFilter        = "";
        _subjectTypeFilter = "";
        _includeSystemEvents = false;
        _to   = DateTime.Today;
        _from = DateTime.Today.AddDays(-30);
        _ = ApplyFiltersAsync();
    }

    /// <summary>
    /// True when any free-text filter has a value. The date range is NOT
    /// counted as "non-default" because the page initialises it to last
    /// 30 days — calling that out on every visit would be noise.
    /// </summary>
    private bool HasNonDefaultFilters =>
        !string.IsNullOrWhiteSpace(_eventTypeFilter)
        || !string.IsNullOrWhiteSpace(_userFilter)
        || !string.IsNullOrWhiteSpace(_subjectTypeFilter);

    /// <summary>
    /// Comma-separated list of which filters are set, for the callout text.
    /// Specific values are still visible in the input boxes above; this is
    /// just a quick scan of what's narrowing the result set.
    /// </summary>
    private string ActiveFiltersSummary
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(_eventTypeFilter))   { parts.Add($"event=\"{_eventTypeFilter}\""); }
            if (!string.IsNullOrWhiteSpace(_userFilter))        { parts.Add($"user=\"{_userFilter}\""); }
            if (!string.IsNullOrWhiteSpace(_subjectTypeFilter)) { parts.Add($"subject=\"{_subjectTypeFilter}\""); }
            return string.Join(", ", parts);
        }
    }

    /// <summary>
    /// Builds an export URL with the current filter values as query
    /// parameters. <paramref name="suffix"/> selects the format (".csv" or
    /// ".json"). The "to" boundary mirrors the page's BuildFilter() — it's
    /// pushed to the next day so the endpoint's exclusive comparison
    /// includes everything from the chosen day.
    /// The active Space rides along explicitly ("space=") because the /api
    /// surface has no ambient Space; the endpoint re-validates it against the
    /// caller's accessible Spaces, and "includeSystem" against AdministerSystem.
    /// </summary>
    private string BuildExportUrl(string suffix)
    {
        var qs = new List<string>
        {
            $"space={SpaceCtx.CurrentSpaceId}",
        };

        if (_includeSystemEvents && _canIncludeSystem)
        {
            qs.Add("includeSystem=true");
        }

        if (_from.HasValue)
        {
            var fromUtc = new DateTimeOffset(DateTime.SpecifyKind(_from.Value.Date, DateTimeKind.Utc));
            qs.Add($"from={Uri.EscapeDataString(fromUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture))}");
        }
        if (_to.HasValue)
        {
            // Match BuildQuery: exclusive day boundary = chosen day + 1.
            var toUtc = new DateTimeOffset(DateTime.SpecifyKind(_to.Value.Date.AddDays(1), DateTimeKind.Utc));
            qs.Add($"to={Uri.EscapeDataString(toUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture))}");
        }
        if (!string.IsNullOrWhiteSpace(_eventTypeFilter))
        {
            qs.Add($"eventType={Uri.EscapeDataString(_eventTypeFilter.Trim())}");
        }
        if (!string.IsNullOrWhiteSpace(_userFilter))
        {
            qs.Add($"user={Uri.EscapeDataString(_userFilter.Trim())}");
        }
        if (!string.IsNullOrWhiteSpace(_subjectTypeFilter))
        {
            qs.Add($"subjectType={Uri.EscapeDataString(_subjectTypeFilter.Trim())}");
        }

        var query = qs.Count == 0 ? "" : "?" + string.Join('&', qs);
        return $"/api/audit/export{suffix}{query}";
    }

    private async Task ShowSnapshot(AuditEntry e)
    {
        await DialogService.OpenAsync<AuditSnapshotDialog>(
            $"Snapshot — {e.EventType}",
            new Dictionary<string, object?>
            {
                [nameof(AuditSnapshotDialog.BeforeJson)] = e.BeforeJson,
                [nameof(AuditSnapshotDialog.AfterJson)]  = e.AfterJson,
            },
            new DialogOptions
            {
                Width    = "95vw",
                Height   = "90vh",
                Resizable = true,
                Draggable = false,
                CloseDialogOnOverlayClick = true,
            });
    }
}
