@page "/s/{SpaceSlug}/runbooks/{Id:guid}"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using KrakenDeploy.Contracts.Steps
@using KrakenDeploy.Server.Components.Dialogs
@using KrakenDeploy.Server.Core.Domain.Deployments
@using KrakenDeploy.Server.Core.Domain.Environments
@using KrakenDeploy.Server.Core.Domain.Processes
@using KrakenDeploy.Server.Core.Domain.Runbooks
@using KrakenDeploy.Server.Core.Domain.Targets
@using KrakenDeploy.Server.Core.Domain.Audit
@using KrakenDeploy.Server.Data.Services
@using KrakenDeploy.Server.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState
@inject IAuditLog Audit
@inject RunbookService RunbookSvc
@inject EnvironmentService EnvSvc
@inject TargetService TargetSvc
@inject NavigationManager Nav
@inject NotificationService Notify
@inject DialogService Dialog
@inject UiActionGuard Guard

<PageTitle>@(_runbook?.Name ?? "Runbook") - KrakenDeploy</PageTitle>

@if (_runbook is null)
{
    <RadzenText>Loading…</RadzenText>
    return;
}

<div class="rz-display-flex rz-align-items-center rz-mb-4" style="gap:1rem">
    <RadzenButton Icon="arrow_back" Variant="Variant.Text"
                  Click="@(() => Nav.NavigateTo(Sp("/runbooks")))" />
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">@_runbook.Name</RadzenText>
    <RadzenBadge Text="@(_runbook.Project?.Name ?? "?")" BadgeStyle="BadgeStyle.Light" />
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" style="margin-left:auto">
        <RequirePermission Permission="Permission.RunbookRunCreate">
            <RadzenButton Text="Run Now" Icon="play_arrow" ButtonStyle="ButtonStyle.Success"
                          Click="@(() => _triggerOpen = !_triggerOpen)" />
        </RequirePermission>
    </RadzenStack>
</div>

@if (!string.IsNullOrEmpty(_runbook.Description))
{
    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4 rz-color-secondary">@_runbook.Description</RadzenText>
}

@* ── Trigger panel ────────────────────────────────────────────────────────── *@
@if (_triggerOpen)
{
    <RadzenCard class="rz-mb-4" style="border-left:4px solid var(--rz-success)">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Trigger Run</RadzenText>
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="4">
                <RadzenFormField Text="Environment" style="width:100%">
                    <RadzenDropDown TValue="Guid?"
                                    Data="@_environments"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    @bind-Value="_triggerEnvId"
                                    Placeholder="Select environment…"
                                    style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Target" style="width:100%">
                    <RadzenDropDown TValue="Guid?"
                                    Data="@_targets"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    @bind-Value="_triggerTargetId"
                                    Placeholder="Select target…"
                                    style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RequirePermission Permission="Permission.RunbookRunCreate">
                <RadzenButton Text="Trigger" Icon="play_arrow" ButtonStyle="ButtonStyle.Success"
                              Click="@TriggerRunAsync"
                              Disabled="@(!_triggerEnvId.HasValue || !_triggerTargetId.HasValue)" />
            </RequirePermission>
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => _triggerOpen = false)" />
        </RadzenStack>
    </RadzenCard>
}

<RadzenTabs @bind-SelectedIndex="_tabIndex">
    <Tabs>

        @* ── Steps tab ────────────────────────────────────────────────────────── *@
        <RadzenTabsItem Text="Steps" Icon="list">
            <div class="rz-mt-3">
                <div class="rz-display-flex rz-justify-content-end rz-mb-3" style="gap:0.5rem">
                    @* M15 follow-up — unified StepFormDialog flow (was an
                       inline form pre-migration). Add Step opens the same
                       picker the process editor uses; the picker's
                       result drives which dialog opens (blank script,
                       Step Group, or template-backed step). *@
                    <RequirePermission Permission="Permission.RunbookEdit">
                        <RadzenButton Text="Add Step" Icon="add_circle_outline" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@OpenAddStepAsync" />
                    </RequirePermission>
                </div>

                @if (_steps.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                        No steps yet — click <strong>Add Step</strong>.
                    </RadzenText>
                }
                else
                {
                    @foreach (var step in _steps)
                    {
                        var depth = DepthOf(step);
                        var numbering = NumberingOf(step);
                        var childCount = ChildCountOf(step);
                        var isGroup = IsStepGroup(step);
                        <div draggable="true"
                             class="@DragRowCssClass(step)"
                             style="@($"margin-left:{(depth * 24).ToString(System.Globalization.CultureInfo.InvariantCulture)}px;")"
                             @ondragstart="@(() => OnDragStart(step))"
                             @ondragover="@(() => OnDragOver(step))"
                             @ondragover:preventDefault="true"
                             @ondrop="@(() => OnDropOnStepAsync(step))"
                             @ondragend="@(_ => OnDragEnd())">
                        <RadzenCard class="rz-mb-2">
                            <div class="rz-display-flex rz-align-items-center" style="gap:0.75rem">
                                <RadzenBadge Text="@numbering" BadgeStyle="BadgeStyle.Light"
                                             style="min-width:2rem;text-align:center" />
                                <RadzenIcon Icon="@(isGroup ? "folder" : "list_alt")"
                                            Style="opacity:0.7;" />
                                <div style="flex:1">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" style="margin:0">
                                        @if (isGroup)
                                        {
                                            <RadzenIcon Icon="expand_more"
                                                        Style="font-size:1rem;vertical-align:middle;opacity:0.6;" />
                                        }
                                        @step.Name
                                        @if (isGroup)
                                        {
                                            <span class="rz-color-secondary rz-text-body2 rz-ml-2">
                                                (@childCount child@(childCount == 1 ? "" : "ren"))
                                            </span>
                                        }
                                    </RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary" style="margin:0">
                                        @step.StepType
                                        @if (!string.IsNullOrEmpty(step.PackageId))
                                        {
                                            <span> · @step.PackageId</span>
                                        }
                                    </RadzenText>
                                </div>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                    @if (isGroup)
                                    {
                                        <RadzenButton Icon="add_circle_outline"
                                                      Size="ButtonSize.Small" Variant="Variant.Text"
                                                      title="Add child step"
                                                      Click="@(() => OpenAddChildStepAsync(step))" />
                                    }
                                    <RadzenButton Icon="edit" Size="ButtonSize.Small" Variant="Variant.Text"
                                                  title="Edit"
                                                  Click="@(() => OpenEditStepAsync(step))" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  title="@(isGroup && childCount > 0
                                                          ? $"Delete (removes {childCount} child step(s) too)"
                                                          : "Delete")"
                                                  Click="@(async () => await DeleteStepAsync(step))" />
                                </RadzenStack>
                            </div>
                        </RadzenCard>
                        </div>
                    }

                    @* M15 follow-up — top-level drop zone. Drag any child
                       step here to reparent it back to top-level. *@
                    <div class="@TopLevelDropZoneCss"
                         @ondragover="OnDragOverTopLevel"
                         @ondragover:preventDefault="true"
                         @ondrop="OnDropOnTopLevelAsync"
                         @ondragend="@(_ => OnDragEnd())">
                        @if (_draggingStepId is not null)
                        {
                            <RadzenIcon Icon="output" Style="vertical-align:middle;margin-right:6px;" />
                            <text>Drop here to move to top-level</text>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Caption"
                                        class="rz-color-secondary">
                                Drag a step row to reparent. Drop on a Step
                                Group to make it a child; drop on this strip
                                to send it back to top-level.
                            </RadzenText>
                        }
                    </div>
                }
            </div>
        </RadzenTabsItem>

        @* ── Runs tab ─────────────────────────────────────────────────────────── *@
        <RadzenTabsItem Text="@($"Runs ({_runs.Count})")" Icon="history">
            <div class="rz-mt-3 rz-mb-3 rz-display-flex rz-justify-content-end">
                <RadzenButton Text="Refresh" Icon="refresh" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light" Click="@RefreshRunsAsync" />
            </div>
            <KrakenGrid SettingsKey="runbook-detail" AllowColumnResize="true" Data="@_runs" TItem="RunbookRun"
                            AllowPaging="true" PageSize="10"
                            AllowSorting="true"
                            RowClick="@(async args => { if (args.Data is { } r) await ToggleRunLog(r); })"
                            EmptyText="No runs yet — click 'Run Now' to trigger the runbook.">
                <Columns>
                    <RadzenDataGridColumn TItem="RunbookRun" Property="Status" Title="Status" Width="120px">
                        <Template Context="r">
                            <RadzenBadge Text="@r.Status.ToString()" BadgeStyle="@RunStatusStyle(r.Status)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunbookRun" Title="Environment" Width="160px">
                        <Template Context="r">@(r.Environment?.Name ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunbookRun" Title="Target" Width="160px">
                        <Template Context="r">@(r.TargetLabel())</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunbookRun" Title="Started" Width="160px">
                        <Template Context="r">
                            @(r.StartedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunbookRun" Title="Duration" Width="110px">
                        <Template Context="r">@FormatDuration(r)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunbookRun" Title="Initiated by" Width="150px">
                        <Template Context="r">
                            <span title="@(r.Cause.ToString() + (string.IsNullOrEmpty(r.CauseDetail) ? "" : " (" + r.CauseDetail + ")"))">@r.CreatedByDisplay</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RunbookRun" Title="" Width="52px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="r">
                            @if (r.Status is DeploymentStatus.Queued or DeploymentStatus.Running)
                            {
                                @* B6 — cancel a queued/running run. stopPropagation: the
                                   row's RowClick toggles the log viewer (Deployments.razor
                                   pattern). *@
                                <RequirePermission Permission="Permission.TaskCancel">
                                    <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                  Variant="Variant.Text"
                                                  Click="@(async () => await CancelRunAsync(r))"
                                                  @onclick:stopPropagation="true"
                                                  title="Cancel run" />
                                </RequirePermission>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </KrakenGrid>

            @* Inline log viewer for the selected run *@
            @if (_selectedRun is not null)
            {
                <RadzenCard class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">
                        Log — @_selectedRun.Environment?.Name / @(_selectedRun.TargetLabel())
                    </RadzenText>
                    <div style="font-family:monospace;font-size:0.82rem;background:var(--surface-2);color:var(--text);border:1px solid var(--surface-3);
                                 padding:1rem;border-radius:4px;max-height:400px;overflow-y:auto">
                        @if (_selectedRunLogs.Count == 0)
                        {
                            <span style="color:#888">No log entries.</span>
                        }
                        else
                        {
                            @foreach (var entry in _selectedRunLogs)
                            {
                                <div class="@LevelClass(entry.Level)">
                                    <span style="color:#888;user-select:none">
                                        @entry.Timestamp.ToString("HH:mm:ss")
                                    </span>
                                    <span> @entry.Message</span>
                                </div>
                            }
                        }
                    </div>
                </RadzenCard>
            }
        </RadzenTabsItem>

        @* ── Tags tab (extended tag sets, runbook-scoped) ─────────────────── *@
        <RadzenTabsItem Text="Tags" Icon="sell">
            <RadzenCard class="rz-mt-3" style="max-width: 720px;">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-3">
                    Tags from Space-level tag sets scoped to runbooks
                    (managed under Library → Tag Sets).
                </RadzenText>
                <EntityTagEditor Kind="TaggableEntityKind.Runbook" EntityId="@Id"
                                 EditPermission="Permission.RunbookEdit" />
            </RadzenCard>
        </RadzenTabsItem>

    </Tabs>
</RadzenTabs>

@code {
    [Parameter] public Guid Id { get; set; }

    private Runbook? _runbook;
    private List<ProcessStep> _steps = [];
    // M15 follow-up — tree sidecar maps (same shape as Process.razor).
    private Dictionary<Guid, int> _depthByStepId = [];
    private Dictionary<Guid, string> _numberingByStepId = [];
    private Dictionary<Guid, int> _childCountByStepId = [];
    private Dictionary<Guid, HashSet<Guid>> _descendantsByStepId = [];
    // Drag state.
    private Guid? _draggingStepId;
    private Guid? _dropTargetStepId;
    private bool _dropTargetIsTopLevel;

    private List<RunbookRun> _runs = [];
    private List<DeploymentEnvironment> _environments = [];
    private List<DeploymentTarget> _targets = [];

    // tabs
    private int _tabIndex;

    // trigger panel
    private bool _triggerOpen;
    private Guid? _triggerEnvId;
    private Guid? _triggerTargetId;

    // M15 follow-up — step editing migrated to the shared StepFormDialog
    // flow. The inline form / _stepName / _stepType / _stepPackageId /
    // _stepScript / _stepTypes fields are gone; the dialog handles all
    // step authoring through the same code path the process editor uses
    // (schema-driven body, Step Group editor with ForEach panel, parent
    // dropdown, step-package version pin, validator catch).

    // run log viewer
    private RunbookRun? _selectedRun;
    private List<TaskLogLine> _selectedRunLogs = [];

    protected override async Task OnInitializedAsync()
    {
        var rbTask  = RunbookSvc.GetAsync(Id);
        var runsTask = RunbookSvc.GetRunsAsync(Id);
        var envTask = EnvSvc.GetAllOrderedAsync();
        var tgtTask = TargetSvc.GetAllAsync();
        await Task.WhenAll(rbTask, runsTask, envTask, tgtTask);

        _runbook      = rbTask.Result;
        _runs         = runsTask.Result;
        _environments = envTask.Result;
        _targets      = tgtTask.Result;

        if (_runbook is not null)
        {
            BuildStepTree(await RunbookSvc.GetProcessStepsAsync(Id));
        }
    }

    /// <summary>
    /// M15 follow-up — DFS over the flat step list via shared
    /// <see cref="StepTreeBuilder"/>. Same logic Process.razor uses.
    /// </summary>
    private void BuildStepTree(IEnumerable<ProcessStep> rawSteps)
    {
        var view = StepTreeBuilder.Build(rawSteps.OrderBy(s => s.SortOrder));
        _steps = [.. view.OrderedSteps];
        _depthByStepId = view.DepthByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
        _numberingByStepId = view.NumberingByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
        _childCountByStepId = view.ChildCountByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
        _descendantsByStepId = view.DescendantsByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
    }

    /// <summary>
    /// Re-loads + re-builds the tree from the database. Use after any
    /// mutation (add / delete / reparent) so the UI reflects the new
    /// shape — including server-side SortOrder reassignment on reparent.
    /// </summary>
    private async Task ReloadStepsAsync()
    {
        _runbook = await RunbookSvc.GetAsync(Id);
        if (_runbook is not null)
        {
            BuildStepTree(await RunbookSvc.GetProcessStepsAsync(Id));
        }
    }

    private int DepthOf(ProcessStep step)
        => _depthByStepId.TryGetValue(step.Id, out var d) ? d : 0;

    private string NumberingOf(ProcessStep step)
        => _numberingByStepId.TryGetValue(step.Id, out var n)
            ? n
            : (_steps.IndexOf(step) + 1).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private int ChildCountOf(ProcessStep step)
        => _childCountByStepId.TryGetValue(step.Id, out var c) ? c : 0;

    private bool IsStepGroup(ProcessStep step)
        => string.Equals(step.StepType, "Kraken.StepGroup", StringComparison.OrdinalIgnoreCase);

    // ── Step management (M15 follow-up — unified StepFormDialog flow) ─

    private Task OpenAddStepAsync() => OpenAddStepCoreAsync(parentStepId: null);

    private Task OpenAddChildStepAsync(ProcessStep groupStep)
        => OpenAddStepCoreAsync(parentStepId: groupStep.Id);

    /// <summary>
    /// Opens the ChooseStepTemplateDialog picker + the appropriate
    /// StepFormDialog flow. Mirrors Process.razor's OpenAddStepCoreAsync
    /// pattern; the host is the runbook service so the dialog persists
    /// against runbook steps.
    /// </summary>
    private async Task OpenAddStepCoreAsync(Guid? parentStepId)
    {
        var choice = await Dialog.OpenAsync<ChooseStepTemplateDialog>(
            "Choose Step Template",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "1000px", CloseDialogOnOverlayClick = false });

        if (choice is not ChooseStepTemplateResult result) { return; }

        if (result.IsStepGroup)
        {
            var groupResult = await Dialog.OpenAsync<StepFormDialog>(
                "Add Step Group",
                new Dictionary<string, object?>
                {
                    [nameof(StepFormDialog.Host)]         = (IStepEditingHost)RunbookSvc,
                    [nameof(StepFormDialog.EditPermission)] = Permission.RunbookEdit,
                    [nameof(StepFormDialog.ProjectId)]    = Id, // runbook id, host resolves project id from it
                    [nameof(StepFormDialog.ActionType)]   = "Kraken.StepGroup",
                    [nameof(StepFormDialog.ParentStepId)] = parentStepId,
                },
                new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

            if (groupResult is true) { await ReloadStepsAsync(); }
            return;
        }

        if (result.IsBlankScriptStep)
        {
            var formResult = await Dialog.OpenAsync<StepFormDialog>(
                "Add Step",
                new Dictionary<string, object?>
                {
                    [nameof(StepFormDialog.Host)]         = (IStepEditingHost)RunbookSvc,
                    [nameof(StepFormDialog.EditPermission)] = Permission.RunbookEdit,
                    [nameof(StepFormDialog.ProjectId)]    = Id,
                    [nameof(StepFormDialog.ActionType)]   = "Kraken.Script",
                    [nameof(StepFormDialog.ParentStepId)] = parentStepId,
                },
                new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

            if (formResult is true) { await ReloadStepsAsync(); }
            return;
        }

        var template = result.Template;
        if (template is null) { return; }

        var templatedResult = await Dialog.OpenAsync<StepFormDialog>(
            $"Add Step — {template.Name}",
            new Dictionary<string, object?>
            {
                [nameof(StepFormDialog.Host)]         = (IStepEditingHost)RunbookSvc,
                [nameof(StepFormDialog.ProjectId)]    = Id,
                [nameof(StepFormDialog.Template)]     = template,
                [nameof(StepFormDialog.ParentStepId)] = parentStepId,
            },
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

        if (templatedResult is true) { await ReloadStepsAsync(); }
    }

    private async Task OpenEditStepAsync(ProcessStep step)
    {
        var result = await Dialog.OpenAsync<StepFormDialog>(
            $"Edit Step — {step.Name}",
            new Dictionary<string, object?>
            {
                [nameof(StepFormDialog.Host)] = (IStepEditingHost)RunbookSvc,
                [nameof(StepFormDialog.EditPermission)] = Permission.RunbookEdit,
                [nameof(StepFormDialog.Step)] = step,
            },
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

        if (result is true) { await ReloadStepsAsync(); }
    }

    private async Task DeleteStepAsync(ProcessStep step)
    {
        if (!await Guard.AllowAsync(Permission.RunbookEdit)) return;
        var deleted = await RunbookSvc.DeleteStepAsync(step.Id, await Guard.CurrentCallerAsync());
        if (deleted)
        {
            await ReloadStepsAsync();
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary  = "Step deleted",
                Detail   = step.Name,
                Duration = 3000,
            });
        }
    }

    // ── Trigger ────────────────────────────────────────────────────────────────

    private async Task TriggerRunAsync()
    {
        if (!_triggerEnvId.HasValue || !_triggerTargetId.HasValue)
        {
            return;
        }

        if (!await Guard.AllowAsync(Permission.RunbookRunCreate)) return;

        try
        {
            var actingUser = (await AuthState.GetAuthenticationStateAsync()).User;
            var run = await RunbookSvc.TriggerAsync(
                Id,
                _triggerEnvId.Value,
                _triggerTargetId.Value,
                initiator: TaskInitiator.Manual(actingUser.GetUserId(), actingUser.GetDisplayName()),
                caller: CallerAuthorization.ForUser(actingUser));

            _runs = [run, .. _runs];
            _triggerOpen   = false;
            _triggerEnvId  = null;
            _triggerTargetId = null;

            // Switch to Runs tab
            _tabIndex = 1;

            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary  = "Run triggered",
                Detail   = $"Run {run.Id.ToString()[..8]} queued",
                Duration = 4000,
            });
        }
        catch (Exception ex) when (ex is InvalidOperationException or AuthorizationException)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Error",
                Detail   = ex.Message,
                Duration = 5000,
            });
        }
    }

    // ── Runs ───────────────────────────────────────────────────────────────────

    private async Task RefreshRunsAsync()
    {
        _runs = await RunbookSvc.GetRunsAsync(Id);
        _selectedRun = null;
        _selectedRunLogs = [];
    }

    // B6 — cancel a queued/running run: guarded server-side re-check, confirm,
    // service flip (B5 guarded write) + agent abort push, semantic audit.
    // Mirrors Deployments.razor's CancelDeploymentAsync.
    private async Task CancelRunAsync(RunbookRun run)
    {
        // Server-authoritative re-check (the button's visibility is cosmetic).
        if (!await Guard.AllowAsync(Permission.TaskCancel)) return;

        var running = run.Status == DeploymentStatus.Running;
        var confirmed = await Dialog.Confirm(
            running
                ? "Cancel this running runbook run? The abort is pushed to the agent, " +
                  "which stops the running step."
                : "Cancel this queued run before it starts?",
            "Cancel runbook run",
            new ConfirmOptions { OkButtonText = "Cancel run", CancelButtonText = "Keep running" });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            var updated = await RunbookSvc.CancelRunAsync(run.Id, await Guard.CurrentCallerAsync());
            if (updated is not null)
            {
                await Audit.RecordAsync(
                    AuditEventType.RunbookRunCancelled,
                    subjectType: "RunbookRun",
                    subjectId:   run.Id.ToString(),
                    details:     "Runbook run cancelled from the runbook detail page.");

                run.Status       = updated.Status;
                run.CompletedUtc = updated.CompletedUtc;
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary  = "Cancelled",
                    Detail   = running
                        ? "The abort was pushed to the agent."
                        : "The queued run was cancelled.",
                    Duration = 4000,
                });
            }
        }
        catch (AuthorizationException)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Not allowed",
                Detail   = "You don't have permission to cancel this runbook run.",
                Duration = 5000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary  = "Could not cancel",
                Detail   = ex.Message,
                Duration = 5000,
            });
        }
    }

    private async Task ToggleRunLog(RunbookRun run)
    {
        if (_selectedRun?.Id == run.Id)
        {
            _selectedRun     = null;
            _selectedRunLogs = [];
            return;
        }

        var full = await RunbookSvc.GetRunAsync(run.Id);
        if (full is not null)
        {
            _selectedRun     = full;
            _selectedRunLogs = await RunbookSvc.GetRunLogAsync(run.Id);
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static BadgeStyle RunStatusStyle(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Succeeded             => BadgeStyle.Success,
        DeploymentStatus.SucceededWithWarnings => BadgeStyle.Warning,
        DeploymentStatus.Failed                => BadgeStyle.Danger,
        DeploymentStatus.Running               => BadgeStyle.Info,
        DeploymentStatus.Queued                => BadgeStyle.Warning,
        _                                      => BadgeStyle.Light,
    };

    private static string LevelClass(string level) => level switch
    {
        "error"   => "rz-color-danger",
        "warning" => "rz-color-warning",
        _         => "",
    };

    private static string FormatDuration(RunbookRun r)
    {
        if (r.StartedUtc is null)
        {
            return "—";
        }

        var end = r.CompletedUtc ?? DateTimeOffset.UtcNow;
        var dur = end - r.StartedUtc.Value;
        return dur.TotalHours >= 1
            ? $"{(int)dur.TotalHours}h {dur.Minutes}m {dur.Seconds}s"
            : $"{dur.Minutes}m {dur.Seconds}s";
    }

    // ── M15 follow-up: drag-into-row reparenting ───────────────────────
    //
    // Step Group creation moved to the unified StepFormDialog flow
    // (OpenAddStepCoreAsync → ChooseStepTemplateDialog → "Step Group"
    // sentinel → StepFormDialog). The standalone AddStepGroupAsync
    // helper that used to live here is gone.

    private void OnDragStart(ProcessStep step)
    {
        _draggingStepId = step.Id;
        _dropTargetStepId = null;
        _dropTargetIsTopLevel = false;
    }

    private void OnDragOver(ProcessStep step)
    {
        if (_draggingStepId is null) { return; }
        _dropTargetIsTopLevel = false;
        _dropTargetStepId = IsValidDropTarget(_draggingStepId.Value, step.Id, step)
            ? step.Id
            : null;
    }

    private void OnDragOverTopLevel()
    {
        if (_draggingStepId is null) { return; }
        _dropTargetStepId = null;
        _dropTargetIsTopLevel = true;
    }

    private async Task OnDropOnStepAsync(ProcessStep target)
    {
        var sourceId = _draggingStepId;
        ClearDragState();
        if (sourceId is null) { return; }

        if (!IsValidDropTarget(sourceId.Value, target.Id, target))
        {
            return;
        }

        var source = _steps.FirstOrDefault(s => s.Id == sourceId.Value);
        if (source is null) { return; }

        await ReparentAsync(source, newParentId: target.Id);
    }

    private async Task OnDropOnTopLevelAsync()
    {
        var sourceId = _draggingStepId;
        ClearDragState();
        if (sourceId is null) { return; }
        var source = _steps.FirstOrDefault(s => s.Id == sourceId.Value);
        if (source is null) { return; }
        if (source.ParentStepId is null) { return; }

        await ReparentAsync(source, newParentId: null);
    }

    private void OnDragEnd() => ClearDragState();

    private void ClearDragState()
    {
        _draggingStepId = null;
        _dropTargetStepId = null;
        _dropTargetIsTopLevel = false;
    }

    private bool IsValidDropTarget(Guid sourceId, Guid targetId, ProcessStep target)
    {
        if (sourceId == targetId) { return false; }
        if (!IsStepGroup(target)) { return false; }
        if (_descendantsByStepId.TryGetValue(sourceId, out var kids)
            && kids.Contains(targetId))
        {
            return false;
        }
        var source = _steps.FirstOrDefault(s => s.Id == sourceId);
        if (source?.ParentStepId == targetId) { return false; }
        return true;
    }

    private async Task ReparentAsync(ProcessStep source, Guid? newParentId)
    {
        if (!await Guard.AllowAsync(Permission.RunbookEdit)) return;
        try
        {
            await RunbookSvc.UpdateStepAsync(
                source.Id, source.Name, source.PackageId,
                source.TargetRoles, source.Config,
                await Guard.CurrentCallerAsync(),
                stepPackageName:    source.StepPackageName,
                stepPackageVersion: source.StepPackageVersion,
                updateParent:       UpdateParent.To(newParentId));
            await ReloadStepsAsync();
            Notify.Notify(NotificationSeverity.Success, "Moved",
                newParentId is null
                    ? $"Step '{source.Name}' moved to top-level."
                    : $"Step '{source.Name}' moved into its new parent.",
                3000);
        }
        catch (ProcessValidationException ex)
        {
            Notify.Notify(NotificationSeverity.Error,
                "Move refused", ex.Message, 6000);
        }
        catch (Exception ex)
        {
            Notify.Notify(NotificationSeverity.Error,
                "Move failed", ex.Message, 6000);
        }
    }

    private string DragRowCssClass(ProcessStep step)
    {
        var cls = "kraken-step-card-wrap";
        if (_draggingStepId == step.Id)
        {
            cls += " kraken-step-card-wrap--dragging";
        }
        else if (_dropTargetStepId == step.Id)
        {
            cls += " kraken-step-card-wrap--drop-target";
        }
        return cls;
    }

    private string TopLevelDropZoneCss => _dropTargetIsTopLevel
        ? "kraken-step-droptarget kraken-step-droptarget--active"
        : "kraken-step-droptarget";
}
