@page "/s/{SpaceSlug}/tenants/{Id:guid}"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using KrakenDeploy.Server.Core.Domain.Tenants
@using KrakenDeploy.Server.Core.Domain.Variables
@using KrakenDeploy.Server.Data.Services
@inject TenantService TenantSvc
@inject VariableService VariableSvc
@inject NavigationManager Nav
@inject NotificationService Notify
@inject UiActionGuard Guard

<PageTitle>@(_tenant?.Name ?? "Tenant") - KrakenDeploy</PageTitle>

@if (_tenant is null)
{
    <RadzenText>Loading…</RadzenText>
    return;
}

<div class="rz-display-flex rz-align-items-center rz-mb-4" style="gap:1rem">
    <RadzenButton Icon="arrow_back" Variant="Variant.Text" Click="@(() => Nav.NavigateTo(Sp("/tenants")))" />
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">@_tenant.Name</RadzenText>
    <RadzenBadge Text="@_tenant.Slug" BadgeStyle="BadgeStyle.Light" />
    <RequirePermission Permission="Permission.TenantEdit">
        <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small"
                      title="Edit tenant" Click="@OpenEdit" />
    </RequirePermission>
</div>

@if (_editOpen)
{
    <RadzenCard class="rz-mb-4" style="max-width: 720px;">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Edit Tenant</RadzenText>
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="6">
                <RadzenFormField Text="Name" style="width:100%">
                    <RadzenTextBox @bind-Value="_editName" style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Slug" style="width:100%">
                    <RadzenTextBox @bind-Value="_editSlug" style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenFormField Text="Description (optional)" class="rz-mb-3" style="width:100%">
            <RadzenTextBox @bind-Value="_editDescription" style="width:100%" />
        </RadzenFormField>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Click="@SaveEditAsync" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => _editOpen = false)" />
        </RadzenStack>
    </RadzenCard>
}

@if (!string.IsNullOrEmpty(_tenant.Description))
{
    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4 rz-color-secondary">@_tenant.Description</RadzenText>
}

@* ── Applied tags (extended tag sets — tenant-scoped sets) ────────────────── *@
<RadzenCard class="rz-mb-4" style="max-width: 720px;">
    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Tags</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-3">
        Tags from Space-level tag sets scoped to tenants (managed under Library → Tag Sets).
    </RadzenText>
    <EntityTagEditor Kind="TaggableEntityKind.Tenant" EntityId="@Id"
                     EditPermission="Permission.TenantEdit" />
</RadzenCard>

@* ── Tenant common variables (read-only) ─────────────────────────────────── *@
<RadzenCard style="max-width: 900px;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenText TextStyle="TextStyle.H6">Variables</RadzenText>
        @if (_tenant.VariableSetId is { } vsId)
        {
            <RadzenLink Path="@Sp($"/variable-sets/{vsId}")" Text="Edit in Library"
                        style="margin-left:auto; font-size:13px;" />
        }
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-3">
        Common variables applied to every deployment of this tenant. Project variables
        scoped to this tenant are visible in each project's Variables page.
    </RadzenText>
    @if (_tenantVars.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            No tenant common variables defined.
        </RadzenText>
    }
    else
    {
        <KrakenGrid SettingsKey="tenant-vars" Data="@_tenantVars" TItem="VariableDto"
                    AllowPaging="false" AllowSorting="true" AllowColumnResize="true"
                    GridLines="DataGridGridLines.Horizontal">
            <Columns>
                <RadzenDataGridColumn TItem="VariableDto" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="VariableDto" Title="Value" Width="280px">
                    <Template Context="v">
                        @if (v.Type == "Sensitive")
                        {
                            <span class="rz-color-secondary">••••••••</span>
                        }
                        else if (v.Value.Length > 60)
                        {
                            <span title="@v.Value">@v.Value[..60]…</span>
                        }
                        else
                        {
                            @v.Value
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VariableDto" Title="Type" Width="110px">
                    <Template Context="v">@v.Type</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VariableDto" Title="Scope" Width="200px">
                    <Template Context="v">
                        @if (v.Scope.IsUnscoped)
                        {
                            <span class="rz-color-secondary">all deployments</span>
                        }
                        else
                        {
                            @(v.Scope.EnvironmentId.HasValue ? "env-scoped" : "")
                            @(v.Scope.Roles is { Count: > 0 } ? $"roles: {string.Join(",", v.Scope.Roles)}" : "")
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </KrakenGrid>
    }
</RadzenCard>

@code {
    [Parameter] public Guid Id { get; set; }

    private Tenant? _tenant;
    private List<VariableDto> _tenantVars = [];

    private bool _editOpen;
    private string _editName = "";
    private string _editSlug = "";
    private string? _editDescription;

    protected override async Task OnInitializedAsync()
    {
        _tenant = await TenantSvc.GetAsync(Id);
        if (_tenant?.VariableSetId is { } setId)
        {
            _tenantVars = await VariableSvc.GetVariablesInSetAsync(setId);
        }
    }

    private void OpenEdit()
    {
        if (_tenant is null) return;
        _editName = _tenant.Name;
        _editSlug = _tenant.Slug;
        _editDescription = _tenant.Description;
        _editOpen = true;
    }

    private async Task SaveEditAsync()
    {
        if (!await Guard.AllowAsync(Permission.TenantEdit)) return;
        if (string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editSlug)) return;

        try
        {
            var updated = await TenantSvc.UpdateAsync(
                Id, _editName.Trim(), _editSlug.Trim(), _editDescription?.Trim(),
                await Guard.CurrentCallerAsync());
            if (updated is not null)
            {
                _tenant = updated;
                _editOpen = false;
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Tenant updated",
                    Detail = updated.Name,
                    Duration = 3000,
                });
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or AuthorizationException)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 5000,
            });
        }
    }
}
