@page "/s/{SpaceSlug}/configuration/users"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@using KrakenDeploy.Server.Core.Domain.Security
@using KrakenDeploy.Server.Data.Identity

@inject UserService UserSvc
@inject DialogService Dialog
@inject NotificationService Notify
@inject UiActionGuard Guard

<PageTitle>Users - KrakenDeploy</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             Gap="1rem" class="rz-mb-4" Style="flex-wrap:wrap">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-0">Users</RadzenText>

    <RequirePermission Permission="Permission.UserInvite">
        <RadzenButton Icon="person_add" Text="Invite User"
                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="InviteAsync" />
        <RadzenButton Icon="precision_manufacturing" Text="New Service Account"
                      ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                      Click="NewServiceAccountAsync" />
    </RequirePermission>

    @* ── Filter toggle (Octopus-style segmented control) ────────────────── *@
    <RadzenSelectBar @bind-Value="_kindFilter"
                     TValue="UserKindFilter"
                     Size="ButtonSize.Small"
                     Style="margin-left:auto"
                     Change="@((UserKindFilter _) => StateHasChanged())">
        <Items>
            <RadzenSelectBarItem Text="All"             Value="UserKindFilter.All" />
            <RadzenSelectBarItem Text="Humans"          Value="UserKindFilter.Humans" />
            <RadzenSelectBarItem Text="Service accounts" Value="UserKindFilter.ServiceAccounts" />
        </Items>
    </RadzenSelectBar>
</RadzenStack>

@if (_kindFilter != UserKindFilter.All)
{
    @* Filter-state callout — pattern from Step Packages, prevents the
       "where did my users go?" support ticket when an admin leaves the
       toggle in a non-default position. *@
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat"
                 Shade="Shade.Lighter" AllowClose="false" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                     AlignItems="AlignItems.Center">
            <RadzenIcon Icon="filter_alt" />
            <span>
                Showing <strong>@FilterLabel(_kindFilter).ToLower()</strong> only —
                @VisibleCount of @_users.Count user@(_users.Count == 1 ? "" : "s").
            </span>
            <RadzenButton Text="Clear filter"
                          Size="ButtonSize.ExtraSmall"
                          Variant="Variant.Text"
                          Click="@(() => _kindFilter = UserKindFilter.All)" />
        </RadzenStack>
    </RadzenAlert>
}

<KrakenGrid SettingsKey="users" Data="@VisibleUsers" TItem="ApplicationUser"
                AllowPaging="true" PageSize="25"
                AllowSorting="true"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                AllowColumnResize="true"
                EmptyText="@EmptyText">
    <Columns>
        <RadzenDataGridColumn TItem="ApplicationUser" Property="Kind" Title="Kind"
                              Width="160px" Sortable="true" Filterable="false">
            <Template Context="u">
                @if (u.Kind == UserKind.ServiceAccount)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" IsPill="true"
                                 Text="Service" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true"
                                 Text="Human" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ApplicationUser" Property="Email" Title="Email" />
        <RadzenDataGridColumn TItem="ApplicationUser" Property="UserName" Title="Username"
                              Width="220px" />
        <RadzenDataGridColumn TItem="ApplicationUser" Title="Email status" Width="130px"
                              Filterable="false" Sortable="false">
            <Template Context="u">
                @if (u.Kind == UserKind.ServiceAccount)
                {
                    @* Synthetic email — confirmation isn't a meaningful
                       signal for non-deliverable @kraken.local addresses. *@
                    <span class="rz-color-secondary" style="font-size:0.85em">—</span>
                }
                else if (u.EmailConfirmed)
                {
                    <RadzenBadge Text="Confirmed" BadgeStyle="BadgeStyle.Success" />
                }
                else
                {
                    <RadzenBadge Text="Pending" BadgeStyle="BadgeStyle.Warning" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ApplicationUser" Property="IsDisabled" Title="Status"
                              Width="110px" Sortable="true" Filterable="false">
            <Template Context="u">
                @if (u.IsDisabled)
                {
                    <RadzenBadge Text="Disabled" BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                }
                else
                {
                    <RadzenBadge Text="Enabled" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ApplicationUser" Title="" Width="170px"
                              Filterable="false" Sortable="false"
                              TextAlign="TextAlign.Right">
            <Template Context="u">
                @if (u.Kind != UserKind.ServiceAccount)
                {
                    <RequirePermission Permission="Permission.UserChangePassword">
                        <RadzenButton Icon="password" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => ResetPasswordAsync(u))" title="Reset password" />
                    </RequirePermission>
                }
                <RequirePermission Permission="Permission.UserEdit">
                    @if (u.IsDisabled)
                    {
                        <RadzenButton Icon="lock_open" ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => ToggleDisabledAsync(u))" title="Enable user" />
                    }
                    else
                    {
                        <RadzenButton Icon="block" ButtonStyle="ButtonStyle.Warning"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => ToggleDisabledAsync(u))" title="Disable user" />
                    }
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.ExtraSmall"
                                  Click="@(() => DeleteAsync(u))" title="Delete user" />
                </RequirePermission>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</KrakenGrid>

@code {
    private enum UserKindFilter { All, Humans, ServiceAccounts }

    private List<ApplicationUser> _users = [];
    private UserKindFilter        _kindFilter = UserKindFilter.All;

    private IEnumerable<ApplicationUser> VisibleUsers => _kindFilter switch
    {
        UserKindFilter.Humans          => _users.Where(u => u.Kind == UserKind.Human),
        UserKindFilter.ServiceAccounts => _users.Where(u => u.Kind == UserKind.ServiceAccount),
        _                              => _users,
    };

    private int VisibleCount => VisibleUsers.Count();

    private string EmptyText => _kindFilter switch
    {
        UserKindFilter.Humans          => "No human users. Use 'Invite User' to add one.",
        UserKindFilter.ServiceAccounts => "No service accounts yet. Use 'New Service Account' to add one.",
        _                              => "No users yet. Use 'Invite User' to add the first one.",
    };

    private static string FilterLabel(UserKindFilter f) => f switch
    {
        UserKindFilter.Humans          => "Humans",
        UserKindFilter.ServiceAccounts => "Service accounts",
        _                              => "All",
    };

    protected override async Task OnInitializedAsync()
        => _users = await UserSvc.GetAllAsync();

    private async Task InviteAsync()
    {
        var result = await Dialog.OpenAsync<InviteUserDialog>(
            "Invite User",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "460px" });

        if (result is true)
        {
            _users = await UserSvc.GetAllAsync();
        }
    }

    private async Task NewServiceAccountAsync()
    {
        var result = await Dialog.OpenAsync<NewServiceAccountDialog>(
            "New Service Account",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "520px" });

        if (result is true)
        {
            _users = await UserSvc.GetAllAsync();
            // Surface the new row by switching the filter to service
            // accounts if the operator was previously filtering them out —
            // otherwise the just-created row would be invisible.
            if (_kindFilter == UserKindFilter.Humans)
            {
                _kindFilter = UserKindFilter.ServiceAccounts;
            }
        }
    }

    private async Task DeleteAsync(ApplicationUser user)
    {
        if (!await Guard.AllowAsync(Permission.UserEdit)) return;

        var verbiage = user.Kind == UserKind.ServiceAccount
            ? $"Delete service account '{user.UserName}'? Any API keys issued to it stop working immediately."
            : $"Delete user '{user.Email}'? This removes them from all teams and cannot be undone.";

        var confirmed = await Dialog.Confirm(
            verbiage,
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        await UserSvc.DeleteAsync(user.Id);
        _users = await UserSvc.GetAllAsync();
        Notify.Notify(NotificationSeverity.Success, "Deleted",
            user.UserName ?? user.Email ?? "", 4000);
    }

    private async Task ToggleDisabledAsync(ApplicationUser user)
    {
        if (!await Guard.AllowAsync(Permission.UserEdit)) return;

        var disabling = !user.IsDisabled;
        if (disabling)
        {
            var confirmed = await Dialog.Confirm(
                $"Disable '{user.Email ?? user.UserName}'? They are signed out within the " +
                "revalidation window and cannot sign in until re-enabled.",
                "Confirm Disable",
                new ConfirmOptions { OkButtonText = "Disable", CancelButtonText = "Cancel" });
            if (confirmed != true) return;
        }

        await UserSvc.SetDisabledAsync(user.Id, disabling);
        _users = await UserSvc.GetAllAsync();
        Notify.Notify(NotificationSeverity.Success, disabling ? "Disabled" : "Enabled",
            user.Email ?? user.UserName ?? "", 4000);
    }

    private async Task ResetPasswordAsync(ApplicationUser user)
    {
        if (!await Guard.AllowAsync(Permission.UserChangePassword)) return;

        var confirmed = await Dialog.Confirm(
            $"Reset the password for '{user.Email}'? A new temporary password is generated " +
            "and their other active sessions are signed out.",
            "Confirm Password Reset",
            new ConfirmOptions { OkButtonText = "Reset", CancelButtonText = "Cancel" });
        if (confirmed != true) return;

        var temp = await UserSvc.ResetPasswordAsync(user.Id);
        if (temp is null)
        {
            Notify.Notify(NotificationSeverity.Error, "Not found", "User no longer exists.", 4000);
            return;
        }

        await Dialog.Alert(
            $"Temporary password for {user.Email}:\n\n{temp}\n\n" +
            "Share it securely. The user should change it after signing in.",
            "Password Reset");
    }
}
