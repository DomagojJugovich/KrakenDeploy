@page "/configuration/features"
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Audit
@using KrakenDeploy.Server.Core.Domain.Features

@inject FeatureFlagService FeatureSvc
@inject IFeatureCatalog Catalog
@inject IAuditLog Audit
@inject NotificationService Notify

<PageTitle>Features — KrakenDeploy</PageTitle>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-1">
    Features
</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-4">
    Per-instance toggles for behaviour that doesn't fit a Space-scoped
    setting. Each toggle has a sensible default — changing one writes an
    override row, switching back to default removes the row so the audit
    log shows a clean "back to default" state.
</RadzenText>

<RequirePermission Permission="Permission.ConfigureServer">

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Style="margin: 2rem auto; display: block;" />
    }
    else
    {
        var byGroup = _states
            .GroupBy(s => s.Descriptor.Group)
            .ToDictionary(g => g.Key, g => g.ToList());

        @foreach (var group in FeatureGroups.DisplayOrder)
        {
            if (!byGroup.TryGetValue(group, out var items)) { continue; }

            <RadzenCard class="rz-mb-3" Style="max-width: 1000px;">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
                    @group
                </RadzenText>

                <RadzenStack Gap="1rem">
                    @foreach (var state in items)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem"
                                     AlignItems="AlignItems.Start"
                                     Style="padding-bottom:0.75rem;border-bottom:1px solid var(--rz-border-color)">
                            <RadzenSwitch Value="@state.Enabled"
                                          TValue="bool"
                                          Disabled="@_saving"
                                          Change="@((bool v) => ToggleAsync(state.Descriptor.Key, v))"
                                          Style="margin-top:0.25rem" />
                            <div style="flex:1">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                                             AlignItems="AlignItems.Center" class="rz-mb-1">
                                    <strong>@state.Descriptor.Title</strong>
                                    @if (!state.IsOverride)
                                    {
                                        <span class="rz-color-secondary"
                                              style="font-size:0.75em;font-style:italic">
                                            (default)
                                        </span>
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="@(state.Enabled == state.Descriptor.DefaultEnabled
                                                                    ? BadgeStyle.Light
                                                                    : BadgeStyle.Info)"
                                                     IsPill="true"
                                                     Text="@(state.Enabled == state.Descriptor.DefaultEnabled
                                                              ? "default"
                                                              : "override")" />
                                    }
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Body2"
                                            class="rz-color-secondary rz-mb-0">
                                    @state.Descriptor.Description
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption"
                                            class="rz-color-secondary rz-mb-0"
                                            Style="font-family:monospace">
                                    @state.Descriptor.Key
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenCard>
        }
    }

</RequirePermission>

@code {
    private bool _loading = true;
    private bool _saving;
    private List<FeatureState> _states = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _states = await FeatureSvc.GetAllAsync();
        }
        catch (Exception ex)
        {
            Notify.Notify(NotificationSeverity.Error,
                "Failed to load features", ex.Message, 6000);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleAsync(string key, bool enabled)
    {
        _saving = true;
        try
        {
            await FeatureSvc.SetAsync(key, enabled);

            // Re-fetch so the IsOverride / (default) badge state reflects
            // the new persisted reality (toggling back to default removes
            // the override row).
            _states = await FeatureSvc.GetAllAsync();

            var descriptor = Catalog.Find(key);
            var isDefault = descriptor is not null && enabled == descriptor.DefaultEnabled;
            await Audit.RecordAsync(
                AuditEventType.FeatureFlagUpdated,
                subjectType: "FeatureFlag",
                subjectName: key,
                details:     $"Enabled={enabled}, IsDefault={isDefault}");

            Notify.Notify(NotificationSeverity.Success,
                enabled ? "Enabled" : "Disabled",
                $"{descriptor?.Title ?? key} {(enabled ? "on" : "off")}.",
                3000);
        }
        catch (Exception ex)
        {
            Notify.Notify(NotificationSeverity.Error,
                "Failed to update feature", ex.Message, 6000);
            // Re-fetch to roll the UI back to the persisted state on failure.
            _states = await FeatureSvc.GetAllAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
