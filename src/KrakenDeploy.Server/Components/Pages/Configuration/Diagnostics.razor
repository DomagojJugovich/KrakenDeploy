@page "/s/{SpaceSlug}/configuration/diagnostics"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]

@inject DiagnosticsService DiagSvc
@inject NavigationManager Nav
@inject NotificationService Notify

<PageTitle>Diagnostics — KrakenDeploy</PageTitle>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-1">
    Diagnostics
</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-4">
    Server self-inspection — runtime info, integrity checks, downloadable
    report for support tickets. Everything on this page is read-only;
    nothing here mutates state.
</RadzenText>

<RequirePermission Permission="Permission.ConfigureServer">
    @if (_info is null)
    {
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Style="margin: 2rem auto; display: block;" />
    }
    else
    {
        @* ── Server info card ──────────────────────────────────────────── *@
        <RadzenCard class="rz-mb-3" Style="max-width: 1100px;">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
                Server info
            </RadzenText>
            <RadzenRow Gap="2rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <KeyValueRow Label="Version">
                        <code>@_info.ServerVersion</code>
                        @if (!string.IsNullOrEmpty(_info.CommitHash))
                        {
                            <span class="rz-color-secondary" style="font-family:monospace;font-size:0.85em">
                                +@(_info.CommitHash.Length > 12 ? _info.CommitHash[..12] : _info.CommitHash)
                            </span>
                        }
                    </KeyValueRow>
                    <KeyValueRow Label=".NET runtime">@_info.DotNetRuntime</KeyValueRow>
                    <KeyValueRow Label="OS">@_info.OperatingSystem</KeyValueRow>
                    <KeyValueRow Label="Architecture">@_info.ProcessArchitecture</KeyValueRow>
                    <KeyValueRow Label="Environment">@_info.EnvironmentName</KeyValueRow>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <KeyValueRow Label="Uptime">@FormatUptime(_info.Uptime)</KeyValueRow>
                    <KeyValueRow Label="Started">
                        <span title="@_info.StartedUtc.ToString("O")">
                            @_info.StartedUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                        </span>
                    </KeyValueRow>
                    <KeyValueRow Label="Working set">@FormatBytes(_info.WorkingSetBytes)</KeyValueRow>
                    <KeyValueRow Label="Threads">@_info.ThreadCount</KeyValueRow>
                    <KeyValueRow Label="Connected agents">
                        <strong>@_info.ConnectedAgents</strong> of @_info.RowCounts.DeploymentTargets target(s)
                    </KeyValueRow>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        @* ── Database card ─────────────────────────────────────────────── *@
        <RadzenCard class="rz-mb-3" Style="max-width: 1100px;">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                         AlignItems="AlignItems.Center" class="rz-mb-3">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-0">
                    Database
                </RadzenText>
                @if (_info.DatabaseReachable)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="reachable" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" IsPill="true" Text="unreachable" />
                }
                <span class="rz-color-secondary">PostgreSQL @_info.DatabaseVersion</span>
            </RadzenStack>

            <RadzenRow Gap="2rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <KeyValueRow Label="Spaces">       @_info.RowCounts.Spaces </KeyValueRow>
                    <KeyValueRow Label="Projects">     @_info.RowCounts.Projects </KeyValueRow>
                    <KeyValueRow Label="Environments"> @_info.RowCounts.Environments </KeyValueRow>
                    <KeyValueRow Label="Targets">      @_info.RowCounts.DeploymentTargets </KeyValueRow>
                    <KeyValueRow Label="Tenants">      @_info.RowCounts.Tenants </KeyValueRow>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <KeyValueRow Label="Releases">      @_info.RowCounts.Releases </KeyValueRow>
                    <KeyValueRow Label="Deployments">   @_info.RowCounts.Deployments </KeyValueRow>
                    <KeyValueRow Label="Users">         @_info.RowCounts.Users </KeyValueRow>
                    <KeyValueRow Label="Teams">         @_info.RowCounts.Teams </KeyValueRow>
                    <KeyValueRow Label="Audit entries"> @_info.RowCounts.AuditEntries </KeyValueRow>
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0" Style="margin-top:0.75rem">
                Data path: <code>@_info.DataPath</code> &mdash; @FormatBytes(_info.DataPathSizeBytes) on disk.
            </RadzenText>
        </RadzenCard>

        @* ── Actions card ──────────────────────────────────────────────── *@
        <RadzenCard class="rz-mb-3" Style="max-width: 1100px;">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-3">
                Actions
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="flex-wrap:wrap">
                <RadzenButton Text="Refresh server info"
                              Icon="refresh" ButtonStyle="ButtonStyle.Light"
                              IsBusy="@_refreshing"
                              Click="RefreshAsync" />
                <RadzenButton Text="Run integrity check"
                              Icon="rule" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@_running"
                              Click="RunIntegrityAsync" />
                <RadzenButton Text="Download diagnostics report"
                              Icon="download" ButtonStyle="ButtonStyle.Secondary"
                              Click="@(() => Nav.NavigateTo("/api/diagnostics/report.zip", forceLoad: true))" />
                <RadzenButton Text="Open Hangfire dashboard"
                              Icon="open_in_new" Variant="Variant.Outlined"
                              Click="@(() => Nav.NavigateTo("/hangfire", forceLoad: true))" />
            </RadzenStack>
        </RadzenCard>

        @* ── Integrity result ─────────────────────────────────────────── *@
        @if (_integrity is not null)
        {
            <RadzenCard Style="max-width: 1100px;">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             AlignItems="AlignItems.Center" class="rz-mb-3">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mb-0">
                        Integrity check
                    </RadzenText>
                    @if (_integrity.Healthy)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="healthy" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" IsPill="true" Text="attention" />
                    }
                    <span class="rz-color-secondary">
                        @_integrity.Elapsed.TotalMilliseconds.ToString("F0") ms
                    </span>
                </RadzenStack>

                <RadzenStack Gap="0.5rem">
                    @foreach (var f in _integrity.Findings)
                    {
                        <RadzenAlert AlertStyle="@SeverityToStyle(f.Severity)"
                                     Variant="Variant.Flat" Shade="Shade.Lighter"
                                     AllowClose="false" ShowIcon="true">
                            <strong>@f.Check</strong>
                            <span style="margin-left:0.4em">@f.Message</span>
                        </RadzenAlert>
                    }
                </RadzenStack>
            </RadzenCard>
        }
    }
</RequirePermission>

@code {
    private ServerInfoReport?     _info;
    private IntegrityCheckResult? _integrity;
    private bool _refreshing;
    private bool _running;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            _info = await DiagSvc.GetServerInfoAsync();
        }
        catch (Exception ex)
        {
            Notify.Notify(NotificationSeverity.Error,
                "Failed to load diagnostics", ex.Message, 6000);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task RunIntegrityAsync()
    {
        _running = true;
        try
        {
            _integrity = await DiagSvc.RunIntegrityCheckAsync();
            Notify.Notify(
                _integrity.Healthy ? NotificationSeverity.Success : NotificationSeverity.Warning,
                _integrity.Healthy ? "Integrity OK" : "Integrity issues found",
                $"Completed in {_integrity.Elapsed.TotalMilliseconds:F0} ms.",
                4000);
        }
        catch (Exception ex)
        {
            Notify.Notify(NotificationSeverity.Error,
                "Integrity check failed", ex.Message, 6000);
        }
        finally
        {
            _running = false;
        }
    }

    private static AlertStyle SeverityToStyle(IntegritySeverity s) => s switch
    {
        IntegritySeverity.Error   => AlertStyle.Danger,
        IntegritySeverity.Warning => AlertStyle.Warning,
        _                         => AlertStyle.Info,
    };

    private static string FormatUptime(TimeSpan span)
    {
        if (span.TotalDays >= 1) { return $"{(int)span.TotalDays}d {span.Hours}h {span.Minutes}m"; }
        if (span.TotalHours >= 1){ return $"{(int)span.TotalHours}h {span.Minutes}m {span.Seconds}s"; }
        return $"{span.Minutes}m {span.Seconds}s";
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024              => $"{bytes} B",
        < 1024L * 1024      => $"{bytes / 1024.0:F1} KiB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MiB",
        _                   => $"{bytes / (1024.0 * 1024 * 1024):F1} GiB",
    };
}
