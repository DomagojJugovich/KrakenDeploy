@page "/releases"
@rendermode InteractiveServer
@attribute [Authorize]

@inject ReleaseService ReleaseSvc

<PageTitle>Releases - KrakenDeploy</PageTitle>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-4">Releases</RadzenText>

<KrakenGrid SettingsKey="releases" Data="@_releases" TItem="Release"
                AllowPaging="true" PageSize="25"
                AllowSorting="true"
                AllowColumnResize="true"
                EmptyText="No releases yet. Create a project and define a release process in M2.">
    <Columns>
        <RadzenDataGridColumn TItem="Release" Property="Version" Title="Version" Width="160px" />
        <RadzenDataGridColumn TItem="Release" Title="Project" Width="220px"
                              Sortable="false" Filterable="false">
            <Template Context="r">
                @(r.Project?.Name ?? r.ProjectId.ToString())
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Release" Property="CreatedUtc" Title="Created"
                              FormatString="{0:yyyy-MM-dd HH:mm}" />
    </Columns>
</KrakenGrid>

@code {
    private List<Release> _releases = [];

    protected override async Task OnInitializedAsync()
    {
        _releases = await ReleaseSvc.GetAllAsync();
    }
}
