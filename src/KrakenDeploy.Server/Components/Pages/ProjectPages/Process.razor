@page "/s/{SpaceSlug}/projects/{Slug}/process"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Lifecycles
@using KrakenDeploy.Server.Core.Domain.Processes
@using KrakenDeploy.Server.Data.Services
@inject ProjectService ProjectSvc
@inject ProcessService ProcessSvc
@inject LifecycleService LifecycleSvc
@inject StepTemplateService TemplateSvc
@inject StepPackageService StepPackageSvc
@inject DialogService Dialog
@inject NotificationService Notifications
@inject UiActionGuard Guard
@inject NavigationManager Nav
@inject KrakenDeploy.Server.Data.Services.Ai.SpaceAiSettingsService AiSettingsSvc

<ProjectShell Slug="@Slug">
    <div class="kraken-process-page">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenButton class="kraken-aside-toggle"
                          Icon="@(_asideOpen ? "menu_open" : "view_sidebar")"
                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => _asideOpen = !_asideOpen)"
                          title="Show or hide the Lifecycle panel" />
            <h2 class="section-title" style="margin: 0; align-self: center;">
                Deployment process · @_steps.Count step@(_steps.Count == 1 ? "" : "s")
            </h2>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RequirePermission Permission="Permission.ReleaseCreate">
                <RadzenButton Text="Create Release" Icon="add_circle_outline"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="OpenCreateReleaseAsync" />
            </RequirePermission>
            <RequirePermission Permission="Permission.ProcessEdit">
                <RadzenButton Text="Import from Octopus" Icon="cloud_download"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="OpenImportDeploymentProcessAsync" />
            </RequirePermission>
            <RequirePermission Permission="Permission.ProcessEdit">
                @if (_assistantEnabled)
                {
                    <RadzenButton Text="Suggest from package" Icon="auto_awesome"
                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="OpenSuggestProcessAsync" />
                }
                <RadzenButton Text="Add Step" Icon="add_circle_outline"
                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="OpenAddStepAsync" />
            </RequirePermission>
        </RadzenStack>
    </RadzenStack>

    @if (!_loaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            Loading process...
        </RadzenText>
    }
    else if (_loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
            Failed to load process: @_loadError
        </RadzenAlert>
    }
    else if (_project is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Project '@Slug' was not found.
        </RadzenAlert>
    }
    else
    {
    @* WP3-c (a) — the aggregate validation panel. Structural ERRORS (the process
       will not deploy / flatten as authored) and non-blocking WARNINGS (WP3-b's
       gated-child advisory) previously had no surface at all: ValidateAsync had
       no caller and the advisory only flashed in the step editor's post-save
       notification. Refreshed on load and after every step mutation. *@
    @if (_validation is { } validation && validation.Errors.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false"
                     class="rz-mb-3">
            <strong>This process has @validation.Errors.Count structural
                error@(validation.Errors.Count == 1 ? "" : "s"):</strong>
            <ul class="rz-mt-1 rz-mb-0" style="padding-left: 1.25rem;">
                @foreach (var error in validation.Errors)
                {
                    <li>@error.Message</li>
                }
            </ul>
        </RadzenAlert>
    }
    @if (_validation is { } v && v.WarningsOrEmpty.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false"
                     class="rz-mb-3">
            <ul class="rz-mt-0 rz-mb-0" style="padding-left: 1.25rem;">
                @foreach (var warning in v.WarningsOrEmpty)
                {
                    <li>@warning</li>
                }
            </ul>
        </RadzenAlert>
    }
    <div class="kraken-process-layout @(_asideOpen ? "kraken-process-layout--aside-open" : null)">
        @* ── Left: step list ───────────────────────────────────────────── *@
        <div class="kraken-process-steps">
            @if (_steps.Count == 0)
            {
                <RadzenCard class="rz-p-5 rz-text-align-center">
                    <RadzenIcon Icon="extension" Style="font-size: 3rem; opacity: 0.3;" />
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mt-3">
                        No steps yet
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-4">
                        A deployment process is an ordered list of steps the agent runs
                        when a release is deployed.
                    </RadzenText>
                    <RequirePermission Permission="Permission.ProcessEdit">
                        <RadzenButton Text="Add the first step" Icon="add_circle_outline"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="OpenAddStepAsync" />
                    </RequirePermission>
                </RadzenCard>
            }
            else
            {
                @for (var i = 0; i < _steps.Count; i++)
                {
                    var step = _steps[i];
                    var index = i;
                    var depth = DepthOf(step);
                    var numbering = NumberingOf(step);
                    var childCount = ChildCountOf(step);
                    var isGroup = IsStepGroup(step);
                    @* M15 follow-up: wrap row in a draggable div. RadzenCard
                       doesn't reliably forward the draggable attribute
                       through its render tree, so the wrapping div carries
                       the drag handlers + the visual highlight class. *@
                    <div draggable="true"
                         class="@DragRowCssClass(step)"
                         style="@($"margin-left:{(depth * 24).ToString(System.Globalization.CultureInfo.InvariantCulture)}px;")"
                         @ondragstart="@(() => OnDragStart(step))"
                         @ondragover="@(() => OnDragOver(step))"
                         @ondragover:preventDefault="true"
                         @ondrop="@(() => OnDropOnStepAsync(step))"
                         @ondragend="@(_ => OnDragEnd())">
                    <RadzenCard class="kraken-step-card-inner">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Start" Gap="1rem">
                            <div class="kraken-step-number"
                                 title="@(depth > 0 ? "Child of a Step Group" : "Top-level step")">
                                @numbering
                            </div>
                            <div class="kraken-step-icon">
                                <RadzenIcon Icon="@(isGroup ? "folder" : "inventory_2")" />
                            </div>
                            <div class="kraken-step-body">
                                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3"
                                            class="rz-mb-1">
                                    @if (isGroup)
                                    {
                                        <RadzenIcon Icon="expand_more"
                                                    Style="font-size:1rem;vertical-align:middle;opacity:0.6;" />
                                    }
                                    @step.Name
                                    @if (isGroup)
                                    {
                                        <span class="rz-color-secondary rz-text-body2 rz-ml-2">
                                            (@childCount child@(childCount == 1 ? "" : "ren"))
                                        </span>
                                    }
                                </RadzenText>
                                @if (isGroup)
                                {
                                    @* Step Group body — show ForEach properties if set.
                                       D3: read the typed columns, not Config keys. *@
                                    @if (!string.IsNullOrWhiteSpace(step.ForEachCollection))
                                    {
                                        <RadzenText TextStyle="TextStyle.Body2"
                                                    class="rz-color-secondary rz-mb-2">
                                            ForEach over <code>#{@step.ForEachCollection}</code>
                                            @if (step.ForEachParallel)
                                            {
                                                <text> — iterations run in parallel</text>
                                            }
                                        </RadzenText>
                                    }
                                    else
                                    {
                                        <RadzenText TextStyle="TextStyle.Body2"
                                                    class="rz-color-secondary rz-mb-2">
                                            Step Group — children run sequentially
                                        </RadzenText>
                                    }
                                }
                                else
                                {
                                <RadzenText TextStyle="TextStyle.Body2"
                                            class="rz-color-secondary rz-mb-2">
                                    Deploy package
                                    <strong>@step.PackageId</strong>
                                    to deployment targets
                                    @if (step.TargetRoles.Count == 0)
                                    {
                                        <text>(any role)</text>
                                    }
                                    else
                                    {
                                        <text>with the tags</text>
                                    }
                                </RadzenText>
                                }
                                @if (step.TargetRoles.Count > 0)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 Wrap="FlexWrap.Wrap" Gap="0.4rem"
                                                 class="rz-mb-2">
                                        @foreach (var role in step.TargetRoles)
                                        {
                                            <RadzenBadge Text="@role"
                                                         BadgeStyle="BadgeStyle.Secondary" />
                                        }
                                    </RadzenStack>
                                }
                                @* Phase D-7: step-package pin + "update available" indicator. *@
                                @if (step.StepPackageName is { } pkgName
                                     && step.StepPackageVersion is { } pkgVer)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center" Gap="0.4rem"
                                                 class="rz-mb-2">
                                        <RadzenBadge IsPill="true"
                                                     BadgeStyle="BadgeStyle.Light"
                                                     Text="@($"{pkgName} {pkgVer}")"
                                                     title="Step package pinned for this step." />
                                        @if (LatestInstalled(pkgName) is { } latest && latest != pkgVer)
                                        {
                                            <RadzenBadge IsPill="true"
                                                         BadgeStyle="BadgeStyle.Warning"
                                                         Text="@($"Update available: {latest}")"
                                                         title="A newer version of this step package is installed. Edit the step to bump." />
                                        }
                                    </RadzenStack>
                                }
                                <RadzenText TextStyle="TextStyle.Caption"
                                            class="rz-color-secondary">
                                    <RadzenIcon Icon="public"
                                                Style="font-size: 0.9rem; vertical-align: middle;" />
                                    Runs for any environment
                                </RadzenText>
                            </div>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <RequirePermission Permission="Permission.ProcessEdit">
                                    @* M15 — Move buttons disable per sibling-group edges
                                       (not the global step list edges). *@
                                    <RadzenButton Icon="arrow_upward"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Disabled="@(IsFirstSibling(step))"
                                                  Click="@(() => MoveAsync(step.Id, -1))"
                                                  title="Move up" />
                                    <RadzenButton Icon="arrow_downward"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Disabled="@(IsLastSibling(step))"
                                                  Click="@(() => MoveAsync(step.Id, 1))"
                                                  title="Move down" />
                                    @if (isGroup)
                                    {
                                        <RadzenButton Icon="add_circle_outline"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => OpenAddChildStepAsync(step))"
                                                      title="Add child step" />
                                    }
                                    <RadzenButton Icon="edit"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Click="@(() => OpenEditStepAsync(step))"
                                                  title="Edit" />
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Click="@(() => DeleteAsync(step))"
                                                  title="@(isGroup && childCount > 0
                                                          ? $"Delete (removes {childCount} child step(s) too)"
                                                          : "Delete")" />
                                </RequirePermission>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                    </div>
                }

                @* M15 follow-up — top-level drop zone: drag any child here
                   to make it a top-level step. Visible-but-subtle when no
                   drag is in progress; highlights when the cursor hovers. *@
                <RequirePermission Permission="Permission.ProcessEdit">
                    <div class="@TopLevelDropZoneCss"
                         @ondragover="OnDragOverTopLevel"
                         @ondragover:preventDefault="true"
                         @ondrop="OnDropOnTopLevelAsync"
                         @ondragend="@(_ => OnDragEnd())">
                        @if (_draggingStepId is not null)
                        {
                            <RadzenIcon Icon="output" Style="vertical-align:middle;margin-right:6px;" />
                            <text>Drop here to move to top-level</text>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Caption"
                                        class="rz-color-secondary">
                                Drag a step row to reparent. Drop on a Step
                                Group to make it a child; drop on this strip
                                to send it back to top-level.
                            </RadzenText>
                        }
                    </div>
                </RequirePermission>
            }
        </div>

        @* ── Right: lifecycle sidebar ─────────────────────────────────── *@
        <aside class="kraken-process-sidebar">
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal"
                             JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3"
                                class="rz-mb-0">
                        Lifecycle
                    </RadzenText>
                    <RadzenButton Text="Change" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.ExtraSmall"
                                  Click="@(() => Nav.NavigateTo(Sp("/lifecycles")))" />
                </RadzenStack>
                @if (_lifecycle is not null)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3">
                        <strong>@_lifecycle.Name</strong>
                    </RadzenText>
                    var phaseIndex = 0;
                    @foreach (var phase in _lifecycle.Phases.OrderBy(p => p.SortOrder))
                    {
                        <div class="kraken-lc-item @($"env-c{phaseIndex % 6}")">
                            <span class="kraken-lc-dot"></span>
                            <div>
                                <div class="kraken-lc-name">@phase.Name</div>
                                <div class="kraken-lc-meta">
                                    @(phase.IsOptional ? "optional" : "required")@(phase.EnvironmentIds.Count > 0 ? $" · {phase.EnvironmentIds.Count} env(s)" : null)
                                </div>
                            </div>
                        </div>
                        phaseIndex++;
                    }
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                        No lifecycle configured.
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Lifecycles can be defined
                        <RadzenLink Path="@Sp("/lifecycles")" Text="here" />.
                    </RadzenText>
                }
            </RadzenCard>
        </aside>
    </div>
    }
    </div>
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Project? _project;
    // M15 — _steps is the DFS-ordered list of every step in the process
    // (parent immediately followed by its children, then back to the next
    // top-level step). Sidecar maps carry depth + dotted numbering +
    // child counts so the template doesn't recompute them per render.
    private List<ProcessStep> _steps = [];
    private Dictionary<Guid, int> _depthByStepId = [];
    private Dictionary<Guid, string> _numberingByStepId = [];
    private Dictionary<Guid, int> _childCountByStepId = [];
    /// <summary>M15 follow-up — per-step descendant ids, used by the
    /// drag UX to forbid drops on the source's own children (cycle
    /// prevention). Populated from <see cref="StepTreeBuilder"/>.</summary>
    private Dictionary<Guid, HashSet<Guid>> _descendantsByStepId = [];

    /// <summary>M15 follow-up drag state — the step currently being
    /// dragged. Null when no drag is in progress.</summary>
    private Guid? _draggingStepId;
    /// <summary>M15 follow-up drag state — the step the cursor is
    /// currently hovering over for the drop highlight.</summary>
    private Guid? _dropTargetStepId;
    /// <summary>M15 follow-up drag state — true while the cursor is
    /// over the top-level drop zone (sets the same highlight class on
    /// that strip).</summary>
    private bool _dropTargetIsTopLevel;

    private Lifecycle? _lifecycle;
    private bool _loaded;
    private string? _loadError;
    private bool _assistantEnabled;

    /// <summary>
    /// WP3-c (a) — aggregate process validation (structural errors + non-blocking
    /// warnings such as WP3-b's gated-child advisory), refreshed on load and after
    /// every step mutation via <see cref="ReloadStepsAsync"/>. Null until loaded;
    /// a failed refresh leaves the panel hidden rather than failing the page.
    /// </summary>
    private ProcessValidator.Result? _validation;

    /// <summary>
    /// Forces the Lifecycle aside visible on narrow viewports
    /// where it auto-collapses (see .kraken-process-layout--aside-open in
    /// app.css). No effect on wide viewports — the aside is always shown there.
    /// </summary>
    private bool _asideOpen;

    /// <summary>
    /// Cache of (package name → highest installed semver) used to render the
    /// "Update available" badge per step (Phase D-7). Loaded once on page
    /// init and re-loaded after Add / Edit / Move / Delete so the badges
    /// reflect the live catalog without per-step DB round-trips.
    /// </summary>
    private Dictionary<string, string> _latestInstalledByPackage =
        new(StringComparer.OrdinalIgnoreCase);

    private string? LatestInstalled(string packageName)
        => _latestInstalledByPackage.TryGetValue(packageName, out var v) ? v : null;

    protected override async Task OnParametersSetAsync()
    {
        // Load Project via Slug rather than cascading from ProjectShell — the
        // cascade does not reliably cross the rendermode boundary
        // (ProjectShell is SSR, Process is InteractiveServer).
        try
        {
            _project = await ProjectSvc.GetBySlugAsync(Slug);
            if (_project is null)
            {
                return;
            }

            var process = await ProcessSvc.GetAsync(_project.Id);
            BuildStepTree(process?.Steps ?? []);
            await ReloadLatestInstalledMapAsync();
            await ReloadValidationAsync();

            if (_project.LifecycleId is { } lifecycleId)
            {
                _lifecycle = await LifecycleSvc.GetAsync(lifecycleId);
            }

            // M11.D — show the "Suggest from package" button only when the
            // per-Space process assistant is enabled.
            try
            {
                var aiSettings = await AiSettingsSvc.GetAsync();
                _assistantEnabled = aiSettings.AssistantEnabled;
            }
            catch
            {
                _assistantEnabled = false;
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task ReloadStepsAsync()
    {
        if (_project is null) return;
        var process = await ProcessSvc.GetAsync(_project.Id);
        BuildStepTree(process?.Steps ?? []);
        await ReloadLatestInstalledMapAsync();
        await ReloadValidationAsync();
    }

    private async Task ReloadValidationAsync()
    {
        if (_project is null) return;
        try
        {
            _validation = await ProcessSvc.ValidateAsync(_project.Id);
        }
        catch
        {
            // Advisory surface only — a refresh failure must not take the
            // process editor down with it.
            _validation = null;
        }
    }

    /// <summary>
    /// M15 — delegates to the shared <see cref="StepTreeBuilder"/>
    /// (extracted in the drag-into-row follow-up so the runbook editor
    /// can use the same tree-flattening logic). Caller passes a list
    /// pre-sorted by SortOrder; builder returns the DFS-ordered list +
    /// sidecar maps including descendants (used by the drag UX to
    /// forbid drops on the source's own children).
    /// </summary>
    private void BuildStepTree(IEnumerable<ProcessStep> rawSteps)
    {
        var view = StepTreeBuilder.Build(rawSteps.OrderBy(s => s.SortOrder));
        _steps = [.. view.OrderedSteps];
        _depthByStepId = view.DepthByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
        _numberingByStepId = view.NumberingByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
        _childCountByStepId = view.ChildCountByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
        _descendantsByStepId = view.DescendantsByStepId.ToDictionary(kv => kv.Key, kv => kv.Value);
    }

    private int DepthOf(ProcessStep step)
        => _depthByStepId.TryGetValue(step.Id, out var d) ? d : 0;

    private string NumberingOf(ProcessStep step)
        => _numberingByStepId.TryGetValue(step.Id, out var n)
            ? n
            : (_steps.IndexOf(step) + 1).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private int ChildCountOf(ProcessStep step)
        => _childCountByStepId.TryGetValue(step.Id, out var c) ? c : 0;

    private bool IsStepGroup(ProcessStep step)
        => string.Equals(step.StepType, "Kraken.StepGroup", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// M15 — true when <paramref name="step"/> has no sibling above it
    /// (lowest SortOrder among steps with the same <see cref="ProcessStep.ParentStepId"/>).
    /// Drives the "Move up" button's Disabled state — siblings are scoped
    /// to the same parent so top-level steps can't move past each other's
    /// boundary into a Step Group's children list.
    /// </summary>
    private bool IsFirstSibling(ProcessStep step)
    {
        var siblings = _steps
            .Where(s => s.ParentStepId == step.ParentStepId)
            .OrderBy(s => s.SortOrder)
            .ToList();
        return siblings.Count > 0 && siblings[0].Id == step.Id;
    }

    private bool IsLastSibling(ProcessStep step)
    {
        var siblings = _steps
            .Where(s => s.ParentStepId == step.ParentStepId)
            .OrderBy(s => s.SortOrder)
            .ToList();
        return siblings.Count > 0 && siblings[^1].Id == step.Id;
    }

    /// <summary>
    /// Re-builds <see cref="_latestInstalledByPackage"/> for every distinct
    /// package referenced by the loaded steps. Done after any step mutation
    /// so the "Update available" badge picks up newly-installed versions
    /// without a hard page refresh. Single DB call per distinct package —
    /// noisy on huge processes but harmless for normal deployment process
    /// step counts (rarely more than ~20).
    /// </summary>
    private async Task ReloadLatestInstalledMapAsync()
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var distinctPackages = _steps
            .Select(s => s.StepPackageName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Cast<string>()
            .ToList();

        foreach (var name in distinctPackages)
        {
            var versions = await StepPackageSvc.GetVersionsAsync(name);
            var latest   = StepPackageResolver.OrderByHighestSemver(versions.Select(v => v.Version))
                .FirstOrDefault();
            if (latest is not null) { map[name] = latest; }
        }
        _latestInstalledByPackage = map;
    }

    private async Task OpenCreateReleaseAsync()
    {
        if (_project is null) return;

        var result = await Dialog.OpenAsync<CreateReleaseDialog>(
            "Create release",
            new Dictionary<string, object?>
            {
                [nameof(CreateReleaseDialog.ProjectId)] = _project.Id,
            },
            new DialogOptions { Width = "560px" });

        if (result is true)
        {
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Created",
                Detail = "Release was created.",
                Duration = 3000,
            });
        }
    }

    private async Task OpenImportDeploymentProcessAsync()
    {
        if (_project is null) return;

        var result = await Dialog.OpenAsync<ImportDeploymentProcessDialog>(
            "Import Octopus deployment process",
            new Dictionary<string, object?>
            {
                [nameof(ImportDeploymentProcessDialog.ProjectId)] = _project.Id,
            },
            new DialogOptions { Width = "780px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            await ReloadStepsAsync();
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Imported",
                Detail = "Deployment process imported successfully.",
                Duration = 4000,
            });
        }
    }

    private async Task OpenSuggestProcessAsync()
    {
        if (_project is null) return;

        var result = await Dialog.OpenAsync<SuggestProcessDialog>(
            "Suggest process from package",
            new Dictionary<string, object?>
            {
                [nameof(SuggestProcessDialog.ProjectId)] = _project.Id,
            },
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            await ReloadStepsAsync();
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Steps added",
                Detail = "Suggested steps were created. Edit each step's config to finish.",
                Duration = 5000,
            });
        }
    }

    private Task OpenAddStepAsync() => OpenAddStepCoreAsync(parentStepId: null);

    /// <summary>
    /// M15 — opens the "Add Step" picker pre-filled with a parent step
    /// id, so the new step lands as a child of the given Step Group.
    /// Used by the per-row "+Add child step" button on group rows.
    /// </summary>
    private Task OpenAddChildStepAsync(ProcessStep groupStep)
        => OpenAddStepCoreAsync(parentStepId: groupStep.Id);

    private async Task OpenAddStepCoreAsync(Guid? parentStepId)
    {
        if (_project is null) return;

        // ── Phase 5 picker — Choose Step Template ────────────────────────────
        var choice = await Dialog.OpenAsync<ChooseStepTemplateDialog>(
            "Choose Step Template",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "1000px", CloseDialogOnOverlayClick = false });

        if (choice is not ChooseStepTemplateResult result)
        {
            return; // user cancelled
        }

        // ── M15 — "Step Group" picker choice ─────────────────────────────────
        if (result.IsStepGroup)
        {
            var groupResult = await Dialog.OpenAsync<StepFormDialog>(
                "Add Step Group",
                new Dictionary<string, object?>
                {
                    [nameof(StepFormDialog.Host)]         = (IStepEditingHost)ProcessSvc,
                    [nameof(StepFormDialog.ProjectId)]    = _project.Id,
                    [nameof(StepFormDialog.ActionType)]   = "Kraken.StepGroup",
                    [nameof(StepFormDialog.ParentStepId)] = parentStepId,
                },
                new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

            if (groupResult is true)
            {
                await ReloadStepsAsync();
            }
            return;
        }

        // SC5 — installed step TYPE card (registry-sourced) or the legacy
        // blank-script sentinel → unified dialog with the type's schema
        // (StepSchemaResolver: serving package's schema).
        if (result.StepTypeId is not null || result.IsBlankScriptStep)
        {
            var actionType = result.StepTypeId ?? "Kraken.Script";
            var formResult = await Dialog.OpenAsync<StepFormDialog>(
                result.StepTypeDisplayName is null
                    ? "Add Step"
                    : $"Add Step — {result.StepTypeDisplayName}",
                new Dictionary<string, object?>
                {
                    [nameof(StepFormDialog.Host)]         = (IStepEditingHost)ProcessSvc,
                    [nameof(StepFormDialog.ProjectId)]    = _project.Id,
                    [nameof(StepFormDialog.ActionType)]   = actionType,
                    [nameof(StepFormDialog.ParentStepId)] = parentStepId,
                },
                new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

            if (formResult is true)
            {
                await ReloadStepsAsync();
            }
            return;
        }

        var template = result.Template;
        if (template is null) return;

        // Template-backed step (script-flavoured or otherwise) → unified dialog
        // with the template's parameter schema (via StepTemplateSchemaAdapter).
        var templatedResult = await Dialog.OpenAsync<StepFormDialog>(
            $"Add Step — {template.Name}",
            new Dictionary<string, object?>
            {
                [nameof(StepFormDialog.Host)]         = (IStepEditingHost)ProcessSvc,
                [nameof(StepFormDialog.ProjectId)]    = _project.Id,
                [nameof(StepFormDialog.Template)]     = template,
                [nameof(StepFormDialog.ParentStepId)] = parentStepId,
            },
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

        if (templatedResult is true)
        {
            await ReloadStepsAsync();
        }
    }

    private async Task OpenEditStepAsync(ProcessStep step)
    {
        // Unified dialog resolves the schema for any step type — built-in
        // first (Kraken.IIS / Octopus.IIS / Octopus.TentaclePackage / script /
        // …), then falls back to the matching community-library template by
        // ActionType. If neither matches, the dialog itself shows a clear
        // "no schema available" notice with a Close button.
        var result = await Dialog.OpenAsync<StepFormDialog>(
            $"Edit Step — {step.Name}",
            new Dictionary<string, object?>
            {
                [nameof(StepFormDialog.Host)] = (IStepEditingHost)ProcessSvc,
                [nameof(StepFormDialog.Step)] = step,
            },
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            await ReloadStepsAsync();
        }
    }

    private async Task MoveAsync(Guid stepId, int direction)
    {
        if (!await Guard.AllowAsync(Permission.ProcessEdit)) return;
        await ProcessSvc.MoveStepAsync(stepId, direction, await Guard.CurrentCallerAsync());
        await ReloadStepsAsync();
    }

    // ── M15 follow-up: drag-into-row reparenting ───────────────────────

    /// <summary>
    /// Begins a drag for <paramref name="step"/>. Records the source step
    /// id so subsequent dragover / drop can validate the drop target.
    /// Called on the row's <c>@ondragstart</c>.
    /// </summary>
    private void OnDragStart(ProcessStep step)
    {
        _draggingStepId = step.Id;
        _dropTargetStepId = null;
        _dropTargetIsTopLevel = false;
    }

    /// <summary>
    /// Highlights <paramref name="step"/> as the current drop target if it
    /// is a valid destination (a Kraken.StepGroup, not the dragged step
    /// itself, not a descendant of the dragged step). Otherwise clears
    /// the highlight. Called on the row's <c>@ondragover</c>.
    /// </summary>
    private void OnDragOver(ProcessStep step)
    {
        if (_draggingStepId is null) { return; }
        _dropTargetIsTopLevel = false;
        _dropTargetStepId = IsValidDropTarget(_draggingStepId.Value, step.Id, step)
            ? step.Id
            : null;
    }

    /// <summary>
    /// Highlights the top-level drop zone so the operator can drag a
    /// child step back to the root of the process.
    /// </summary>
    private void OnDragOverTopLevel()
    {
        if (_draggingStepId is null) { return; }
        _dropTargetStepId = null;
        _dropTargetIsTopLevel = true;
    }

    /// <summary>
    /// Commits the drop: reparents the dragged step to
    /// <paramref name="target"/> via <see cref="ProcessService.UpdateStepAsync"/>
    /// with an <see cref="UpdateParent"/>. Re-loads the step list so the
    /// tree view reflects the new structure.
    /// </summary>
    private async Task OnDropOnStepAsync(ProcessStep target)
    {
        var sourceId = _draggingStepId;
        ClearDragState();
        if (sourceId is null) { return; }

        if (!IsValidDropTarget(sourceId.Value, target.Id, target))
        {
            return; // silent no-op; the highlight already told the user
        }

        var source = _steps.FirstOrDefault(s => s.Id == sourceId.Value);
        if (source is null) { return; }

        await ReparentAsync(source, newParentId: target.Id);
    }

    /// <summary>
    /// Commits a drop onto the top-level drop zone: clears the dragged
    /// step's parent (makes it a top-level step).
    /// </summary>
    private async Task OnDropOnTopLevelAsync()
    {
        var sourceId = _draggingStepId;
        ClearDragState();
        if (sourceId is null) { return; }

        var source = _steps.FirstOrDefault(s => s.Id == sourceId.Value);
        if (source is null) { return; }
        if (source.ParentStepId is null) { return; } // already top-level

        await ReparentAsync(source, newParentId: null);
    }

    private void OnDragEnd()
    {
        ClearDragState();
    }

    private void ClearDragState()
    {
        _draggingStepId = null;
        _dropTargetStepId = null;
        _dropTargetIsTopLevel = false;
    }

    /// <summary>
    /// True iff <paramref name="targetId"/> is a valid drop destination
    /// for the step identified by <paramref name="sourceId"/>: a
    /// Kraken.StepGroup, not the dragged step itself, not a descendant
    /// of the dragged step (cycle prevention), and not already the
    /// dragged step's current parent (no-op).
    /// </summary>
    private bool IsValidDropTarget(Guid sourceId, Guid targetId, ProcessStep target)
    {
        if (sourceId == targetId) { return false; }
        if (!IsStepGroup(target)) { return false; }
        if (_descendantsByStepId.TryGetValue(sourceId, out var kids)
            && kids.Contains(targetId))
        {
            return false;
        }
        var source = _steps.FirstOrDefault(s => s.Id == sourceId);
        if (source?.ParentStepId == targetId) { return false; }
        return true;
    }

    private async Task ReparentAsync(ProcessStep source, Guid? newParentId)
    {
        if (!await Guard.AllowAsync(Permission.ProcessEdit)) return;
        try
        {
            await ProcessSvc.UpdateStepAsync(
                source.Id, source.Name, source.PackageId,
                source.TargetRoles, source.Config,
                await Guard.CurrentCallerAsync(),
                stepPackageName:    source.StepPackageName,
                stepPackageVersion: source.StepPackageVersion,
                knobs:              null,
                updateParent:       UpdateParent.To(newParentId));
            await ReloadStepsAsync();
            Notifications.Notify(NotificationSeverity.Success, "Moved",
                newParentId is null
                    ? $"Step '{source.Name}' moved to top-level."
                    : $"Step '{source.Name}' moved into its new parent.",
                3000);
        }
        catch (ProcessValidationException ex)
        {
            Notifications.Notify(NotificationSeverity.Error,
                "Move refused", ex.Message, 6000);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error,
                "Move failed", ex.Message, 6000);
        }
    }

    private string DragRowCssClass(ProcessStep step)
    {
        var cls = "kraken-step-card-wrap rz-mb-2";
        if (_draggingStepId == step.Id)
        {
            cls += " kraken-step-card-wrap--dragging";
        }
        else if (_dropTargetStepId == step.Id)
        {
            cls += " kraken-step-card-wrap--drop-target";
        }
        return cls;
    }

    private string TopLevelDropZoneCss => _dropTargetIsTopLevel
        ? "kraken-step-droptarget kraken-step-droptarget--active"
        : "kraken-step-droptarget";

    private async Task DeleteAsync(ProcessStep step)
    {
        if (!await Guard.AllowAsync(Permission.ProcessEdit)) return;

        // M15 — Step Group deletion cascades through the parent_step_id FK,
        // so we warn explicitly when removing a parent that has children.
        var kids = ChildCountOf(step);
        var message = kids > 0
            ? $"Delete '{step.Name}' AND its {kids} child step(s)? " +
              "Children are removed via cascade — this cannot be undone."
            : $"Delete step '{step.Name}'? This cannot be undone.";

        var confirmed = await Dialog.Confirm(
            message,
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await ProcessSvc.RemoveStepAsync(step.Id, await Guard.CurrentCallerAsync());
            await ReloadStepsAsync();
            Notifications.Notify(NotificationSeverity.Success, "Deleted",
                $"Step '{step.Name}' was removed.", 4000);
        }
    }
}
