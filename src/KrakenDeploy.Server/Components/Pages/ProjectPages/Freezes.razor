@page "/projects/{Slug}/freezes"
@attribute [Authorize]

<ProjectShell Slug="@Slug">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-3">
        Freezes
    </RadzenText>
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
        Deployment freezes (block deploys to selected environments during a window) — pending.
    </RadzenAlert>
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
}
