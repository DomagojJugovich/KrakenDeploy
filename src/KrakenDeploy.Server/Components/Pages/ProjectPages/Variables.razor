@page "/projects/{Slug}/variables"
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Variables
@using KrakenDeploy.Server.Core.Domain.Environments
@using KrakenDeploy.Server.Core.Domain.Tenants
@using KrakenDeploy.Server.Core.Domain.Targets
@inject ProjectService ProjectSvc
@inject VariableService VariableSvc
@inject EnvironmentService EnvironmentSvc
@inject TenantService TenantSvc
@inject TargetService TargetSvc
@inject DialogService Dialog
@inject ContextMenuService ContextMenu
@inject NotificationService Notifications

<ProjectShell Slug="@Slug">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0">
            Project Variables
        </RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RequirePermission Permission="Permission.VariableEdit">
                <RadzenButton Icon="unfold_less" Text="Collapse all"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => SetAllExpanded(false))" />
                <RadzenButton Icon="unfold_more" Text="Expand all"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => SetAllExpanded(true))" />
            </RequirePermission>
        </RadzenStack>
    </RadzenStack>

    @if (!_loaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            Loading variables...
        </RadzenText>
    }
    else if (_loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
            Failed to load variables: @_loadError
        </RadzenAlert>
    }
    else if (_project is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Project '@Slug' was not found.
        </RadzenAlert>
    }
    else
    {
        @* ── Always-visible "new variable" row above the grid ─────────────── *@
        <RequirePermission Permission="Permission.VariableEdit">
            <div class="kraken-newvar-bar">
                <div class="kraken-newvar-name">
                    <RadzenLabel Text="Name" />
                    <RadzenTextBox @bind-Value="_newName"
                                   Placeholder="Enter new variable"
                                   Style="width: 100%;" />
                </div>
                <div class="kraken-newvar-value">
                    <RadzenLabel Text="Value" />
                    @if (_newType == VariableType.Sensitive)
                    {
                        <RadzenPassword @bind-Value="_newValue"
                                        Placeholder="Enter value"
                                        Style="width: 100%;" />
                    }
                    else if (_newType == VariableType.StringArray)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center" Gap="0.4rem">
                            <RadzenTextBox @bind-Value="_newValue"
                                           Placeholder='["a","b"] or a, b'
                                           Style="flex: 1;" />
                            <RadzenButton Icon="format_list_bulleted"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@(args => OpenArrayEditorForNewAsync(args))"
                                          title="Edit as list" />
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenTextBox @bind-Value="_newValue"
                                       Placeholder="Enter value"
                                       Style="width: 100%;" />
                    }
                </div>
                <div class="kraken-newvar-type">
                    <RadzenLabel Text="Type" />
                    <RadzenDropDown TValue="VariableType" @bind-Value="_newType"
                                    Data="@_typeOptions" TextProperty="Label"
                                    ValueProperty="Value" Style="width: 100%;" />
                </div>
                <div class="kraken-newvar-scope">
                    <RadzenLabel Text="Scope" />
                    <button type="button" class="kraken-newvar-scope-btn"
                            @onclick="@(args => OpenNewScopePopupAsync(args))">
                        @ScopeLabelForNew()
                    </button>
                </div>
                <div class="kraken-newvar-actions">
                    <RadzenButton Text="Add" Icon="add"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Disabled="@(string.IsNullOrWhiteSpace(_newName))"
                                  Click="AddNewVariableAsync" />
                </div>
            </div>
        </RequirePermission>

        <RadzenDataGrid @ref="_grid" Data="@_variables" TItem="Variable"
                        AllowFiltering="true" FilterMode="FilterMode.Simple"
                        AllowSorting="true" AllowPaging="true" PageSize="50"
                        AllowGrouping="true" Groups="@_groups"
                        AllGroupsExpanded="@_allExpanded"
                        AllGroupsExpandedChanged="@(v => _allExpanded = v)"
                        AllowColumnResize="true"
                        EditMode="DataGridEditMode.Single"
                        CellRender="@OnCellRender"
                        CellClick="@OnCellClickAsync"
                        RowUpdate="@OnRowUpdateAsync"
                        EmptyText="No variables yet — use the row above to add one.">
            <GroupHeaderTemplate Context="group">
                <strong>@group.Data.Key</strong>
                <span class="rz-color-secondary rz-ml-2">
                    (@group.Data.Count value@(group.Data.Count == 1 ? "" : "s"))
                </span>
            </GroupHeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="Variable" Property="Name" Title="Name"
                                      Width="240px">
                    <Template Context="v">@v.Name</Template>
                    <EditTemplate Context="v">
                        <RadzenTextBox @bind-Value="v.Name" Style="width: 100%;"
                                       Placeholder="Enter new variable" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Property="Value" Title="Value"
                                      Sortable="false">
                    <Template Context="v">
                        @if (v.Type == VariableType.Sensitive)
                        {
                            <RadzenBadge Text="*** sensitive ***"
                                         BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                        }
                        else if (v.Type == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.4rem">
                                <code class="kraken-var-value">@FormatArrayPreview(v.Value)</code>
                                <RadzenButton Icon="format_list_bulleted"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(args => OpenArrayEditorAsync(args, v))"
                                              @onclick:stopPropagation="true"
                                              title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <code class="kraken-var-value">@v.Value</code>
                        }
                    </Template>
                    <EditTemplate Context="v">
                        @if (v.Type == VariableType.Sensitive)
                        {
                            <RadzenPassword @bind-Value="v.Value" Style="width: 100%;"
                                            Placeholder="(retype to change)" />
                        }
                        else if (v.Type == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenTextBox @bind-Value="v.Value" Style="flex: 1;"
                                               Placeholder='["a","b"] or a, b' />
                                <RadzenButton Icon="format_list_bulleted"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(args => OpenArrayEditorAsync(args, v))"
                                              @onclick:stopPropagation="true"
                                              title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenTextBox @bind-Value="v.Value" Style="width: 100%;"
                                           Placeholder="Enter value" />
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Property="Type" Title="Type"
                                      Width="120px">
                    <Template Context="v">@v.Type</Template>
                    <EditTemplate Context="v">
                        <RadzenDropDown TValue="VariableType" @bind-Value="v.Type"
                                        Data="@_typeOptions" TextProperty="Label"
                                        ValueProperty="Value" Style="width: 100%;" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="Scope" Sortable="false"
                                      Filterable="false">
                    @* No EditTemplate — scope is edited via the popup, never inline. *@
                    <Template Context="v">
                        <button type="button"
                                class="@(v.Scope.IsUnscoped
                                         ? "kraken-vargrid-link kraken-scope-unbound-btn"
                                         : "kraken-scope-chip-btn")"
                                @onclick="@(args => OpenScopePopupAsync(args, v))"
                                @onclick:stopPropagation="true">
                            @if (v.Scope.IsUnscoped)
                            {
                                <text>Define scope</text>
                            }
                            else
                            {
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             Wrap="FlexWrap.Wrap" Gap="0.3rem"
                                             AlignItems="AlignItems.Center">
                                    @if (v.Scope.EnvironmentId is { } envId)
                                    {
                                        <RadzenBadge Text="@($"env: {EnvName(envId)}")"
                                                     BadgeStyle="BadgeStyle.Info"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.TenantId is { } tenantId)
                                    {
                                        <RadzenBadge Text="@($"tenant: {TenantName(tenantId)}")"
                                                     BadgeStyle="BadgeStyle.Success"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.TargetId is { } targetId)
                                    {
                                        <RadzenBadge Text="@($"target: {TargetName(targetId)}")"
                                                     BadgeStyle="BadgeStyle.Secondary"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.Roles is { Count: > 0 })
                                    {
                                        @foreach (var r in v.Scope.Roles)
                                        {
                                            <RadzenBadge Text="@($"role: {r}")"
                                                         BadgeStyle="BadgeStyle.Light"
                                                         IsPill="true" />
                                        }
                                    }
                                    <RadzenIcon Icon="edit"
                                                Style="font-size: 0.95rem; opacity: 0.55;" />
                                </RadzenStack>
                            }
                        </button>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="" Width="140px"
                                      Sortable="false" Filterable="false"
                                      TextAlign="TextAlign.Right">
                    <Template Context="v">
                        <RequirePermission Permission="Permission.VariableEdit">
                            <RadzenButton Icon="more_vert"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.ExtraSmall"
                                          Click="@(args => ShowRowMenu(args, v))"
                                          @onclick:stopPropagation="true" />
                        </RequirePermission>
                    </Template>
                    <EditTemplate Context="v">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => _grid.UpdateRow(v))"
                                      @onclick:stopPropagation="true" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall" class="rz-ml-1"
                                      Click="@(() => CancelEditAsync(v))"
                                      @onclick:stopPropagation="true" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</ProjectShell>

@* ── Array-as-list editor popup ──────────────────────────────────────────── *@
@if (_arrayPopupOpen)
{
    <div class="kraken-scope-popup-backdrop" @onclick="CloseArrayEditor"></div>
    <div class="kraken-scope-popup kraken-array-popup"
         style="@($"top: {_arrayPopupTop}px; left: {_arrayPopupLeft}px;")"
         @onclick:stopPropagation="true">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                Edit array — one value per line
            </RadzenText>
            <RadzenTextArea @bind-Value="_arrayLines" Rows="14"
                            class="kraken-array-textarea"
                            Placeholder="line1&#10;line2&#10;line3" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                Stored as a JSON array. Empty lines are kept as empty entries.
                Drag the bottom-right corner to resize.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" Click="CloseArrayEditor" />
                <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Click="SaveArrayAsync" />
            </RadzenStack>
        </RadzenStack>
    </div>
}

@* ── Scope popup (custom div, positioned at click site) ──────────────────── *@
@if (_popupOpen)
{
    <div class="kraken-scope-popup-backdrop" @onclick="ClosePopup"></div>
    <div class="kraken-scope-popup"
         style="@($"top: {_popupTop}px; left: {_popupLeft}px;")"
         @onclick:stopPropagation="true">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                @(_popupEditingVar is null ? "Define scope" : "Edit scope")
            </RadzenText>

            <div>
                <RadzenLabel Text="Environments" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popEnvIds"
                                Data="@_environments" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true"
                                Chips="true" Placeholder="(any environment)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Tenants" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popTenantIds"
                                Data="@_tenants" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true"
                                Chips="true" Placeholder="(any tenant)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Targets" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popTargetIds"
                                Data="@_targets" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true"
                                Chips="true" Placeholder="(any target)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Target Roles (comma-separated)" />
                <RadzenTextBox @bind-Value="_popRolesCsv"
                               Placeholder="e.g. SERVER, TERMINAL"
                               Style="width: 100%;" />
            </div>

            @if (_popupEditingVar?.Type == VariableType.Sensitive
                 && (CountOf(_popEnvIds) > 1 || CountOf(_popTenantIds) > 1
                     || CountOf(_popTargetIds) > 1))
            {
                <div class="kraken-scope-popup-warning">
                    Multi-scope expansion is disabled for sensitive variables —
                    only the first selection of each dimension will be applied.
                </div>
            }

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <button type="button" class="kraken-vargrid-link"
                        @onclick="OpenAdvancedEditorAsync">Open editor</button>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="ClosePopup" />
                    <RadzenButton Text="Done" ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small" Click="SaveScopeAsync" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private RadzenDataGrid<Variable> _grid = default!;
    private Project? _project;
    private List<Variable> _variables = [];
    private List<DeploymentEnvironment> _environments = [];
    private List<Tenant> _tenants = [];
    private List<DeploymentTarget> _targets = [];
    private Dictionary<Guid, string> _envNames = [];
    private Dictionary<Guid, string> _tenantNames = [];
    private Dictionary<Guid, string> _targetNames = [];
    private bool _loaded;
    private string? _loadError;

    // Always group by Name. Single-value groups still render a header — the
    // count next to the name makes that obvious.
    private readonly List<GroupDescriptor> _groups =
    [
        new() { Property = nameof(Variable.Name) }
    ];
    private bool? _allExpanded = true;

    // ── Always-visible new-variable row state ─────────────────────────────
    private string _newName = "";
    private string _newValue = "";
    private VariableType _newType = VariableType.Text;
    private VariableScope _newScope = new();

    private record TypeOption(VariableType Value, string Label);
    private readonly TypeOption[] _typeOptions =
    [
        new(VariableType.Text,        "Text"),
        new(VariableType.Sensitive,   "Sensitive"),
        new(VariableType.StringArray, "Array"),
    ];

    // ── Scope popup state ──────────────────────────────────────────────────
    private bool _popupOpen;
    private double _popupTop;
    private double _popupLeft;
    private Variable? _popupEditingVar;
    private IEnumerable<Guid> _popEnvIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTenantIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTargetIds = Array.Empty<Guid>();
    private string _popRolesCsv = "";

    // ── Array-as-list editor state ─────────────────────────────────────────
    private bool _arrayPopupOpen;
    private double _arrayPopupTop;
    private double _arrayPopupLeft;
    private Variable? _arrayEditingVar;     // null = staged new-row value
    private string _arrayLines = "";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _project = await ProjectSvc.GetBySlugAsync(Slug);
            if (_project is null) return;

            _environments = await EnvironmentSvc.GetAllOrderedAsync();
            _envNames = _environments.ToDictionary(e => e.Id, e => e.Name);

            _tenants = await TenantSvc.GetAllAsync();
            _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);

            _targets = await TargetSvc.GetAllAsync();
            _targetNames = _targets.ToDictionary(t => t.Id, t => t.Name);

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task ReloadAsync()
    {
        if (_project is null) return;
        var dtos = await VariableSvc.GetVariablesAsync(_project.Id);
        var entities = new List<Variable>(dtos.Count);
        foreach (var d in dtos)
        {
            var entity = await VariableSvc.GetVariableAsync(d.Id);
            if (entity is not null) entities.Add(entity);
        }
        _variables = entities;
    }

    private string EnvName(Guid id) =>
        _envNames.TryGetValue(id, out var n) ? n : "?";
    private string TenantName(Guid id) =>
        _tenantNames.TryGetValue(id, out var n) ? n : "?";
    private string TargetName(Guid id) =>
        _targetNames.TryGetValue(id, out var n) ? n : "?";
    private static int CountOf(IEnumerable<Guid>? e) => e?.Count() ?? 0;

    // ── Grid edit lifecycle ────────────────────────────────────────────────

    private static bool IsEditableProperty(string? prop) =>
        prop is nameof(Variable.Name)
             or nameof(Variable.Value)
             or nameof(Variable.Type);

    private void OnCellRender(DataGridCellRenderEventArgs<Variable> args)
    {
        // Make non-action cells visually clickable to hint that the row will
        // enter edit mode on click.
        if (args.Column is { } col && IsEditableProperty(col.Property))
        {
            args.Attributes.Add("style", "cursor: pointer;");
        }
    }

    private async Task OnCellClickAsync(DataGridCellMouseEventArgs<Variable> args)
    {
        // Click on Name/Value/Type → enter row edit. Scope and Actions
        // columns have their own click handlers (popup, three-dots menu)
        // and stopPropagation so we never reach this branch for them.
        if (args.Column is { } col && IsEditableProperty(col.Property)
            && args.Data is { } data)
        {
            await _grid.EditRow(data);
        }
    }

    private async Task OnRowUpdateAsync(Variable v)
    {
        // RowUpdate fires after the user clicks the Save (✓) button or
        // _grid.UpdateRow(v) is called.
        if (_project is null) return;

        try
        {
            await VariableSvc.UpdateVariableAsync(
                v.Id, v.Name, v.Value, v.Type, v.Scope);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Save failed", ex.Message, 5000);
        }
    }

    private async Task CancelEditAsync(Variable v)
    {
        _grid.CancelEditRow(v);
        // The local entity may have been mutated by the form binding;
        // re-pull from DB so the grid shows the persisted state.
        await ReloadAsync();
    }

    /// <summary>
    /// Adds the staged new-row variable. Cartesian-expands the scope across
    /// any multi-selected env / tenant / target dimensions; an empty scope
    /// dimension collapses to a single null entry ("any").
    /// </summary>
    private async Task AddNewVariableAsync()
    {
        if (_project is null || string.IsNullOrWhiteSpace(_newName)) return;

        try
        {
            // Use the staged scope as-is. If the user opened the popup and
            // saved multi-select, those choices live in _newScope (single
            // dimension) and were applied for cartesian — see SaveScopeAsync.
            // For the simple inline-new case we just save one variable.
            await VariableSvc.CreateVariableAsync(
                _project.Id, _newName, _newValue ?? "", _newType, _newScope);

            _newName = "";
            _newValue = "";
            _newType = VariableType.Text;
            _newScope = new VariableScope();
            await ReloadAsync();
            Notifications.Notify(NotificationSeverity.Success, "Added",
                "Variable was added.", 3000);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Add failed", ex.Message, 5000);
        }
    }

    private string ScopeLabelForNew()
    {
        if (_newScope.IsUnscoped) return "Define scope";
        var parts = new List<string>();
        if (_newScope.EnvironmentId is { } e) parts.Add($"env: {EnvName(e)}");
        if (_newScope.TenantId is { } t) parts.Add($"tenant: {TenantName(t)}");
        if (_newScope.TargetId is { } tg) parts.Add($"target: {TargetName(tg)}");
        if (_newScope.Roles is { Count: > 0 } r) parts.Add($"roles: {string.Join(",", r)}");
        return string.Join(" • ", parts);
    }

    private void SetAllExpanded(bool expanded) => _allExpanded = expanded;

    // ── Three-dots menu ────────────────────────────────────────────────────

    private void ShowRowMenu(MouseEventArgs args, Variable v)
    {
        ContextMenu.Open(args, new List<ContextMenuItem>
        {
            new() { Text = "Add Value",          Value = "add",       Icon = "add" },
            new() { Text = "Duplicate Variable", Value = "duplicate", Icon = "content_copy" },
            new() { Text = "Delete Variable",    Value = "delete",    Icon = "delete" },
        }, async e =>
        {
            ContextMenu.Close();
            switch (e.Value)
            {
                case "add":       await AddValueAsync(v);   break;
                case "duplicate": await DuplicateAsync(v);  break;
                case "delete":    await DeleteAsync(v);     break;
            }
        });
    }

    private async Task AddValueAsync(Variable v)
    {
        if (_project is null) return;
        await VariableSvc.CreateVariableAsync(
            _project.Id, v.Name, "", VariableType.Text, new VariableScope());
        await ReloadAsync();
    }

    private async Task DuplicateAsync(Variable v)
    {
        if (_project is null) return;
        var rawValue = v.Type == VariableType.Sensitive ? "" : v.Value;
        await VariableSvc.CreateVariableAsync(
            _project.Id, v.Name + " (copy)", rawValue, v.Type,
            new VariableScope
            {
                EnvironmentId = v.Scope.EnvironmentId,
                TenantId      = v.Scope.TenantId,
                TargetId      = v.Scope.TargetId,
                Roles         = v.Scope.Roles is { Count: > 0 } r ? [..r] : null,
            });
        await ReloadAsync();
    }

    private async Task DeleteAsync(Variable v)
    {
        var confirmed = await Dialog.Confirm(
            $"Delete variable '{v.Name}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await VariableSvc.DeleteVariableAsync(v.Id);
            await ReloadAsync();
            Notifications.Notify(NotificationSeverity.Success, "Deleted",
                $"Variable '{v.Name}' was removed.", 3000);
        }
    }

    // ── Scope popup ────────────────────────────────────────────────────────

    private void OpenScopePopupAsync(MouseEventArgs args, Variable v)
    {
        _popupEditingVar = v;
        SeedPopupFromScope(v.Scope);
        SetPopupPosition(args);
        _popupOpen = true;
    }

    private void OpenNewScopePopupAsync(MouseEventArgs args)
    {
        // null _popupEditingVar signals "scope edit for the staged new-row"
        _popupEditingVar = null;
        SeedPopupFromScope(_newScope);
        SetPopupPosition(args);
        _popupOpen = true;
    }

    private void SetPopupPosition(MouseEventArgs args)
    {
        const double popupWidth = 420;
        const double margin = 8;
        _popupTop  = args.ClientY + margin;
        _popupLeft = args.ClientX - popupWidth / 2;
        if (_popupLeft < margin) _popupLeft = margin;
    }

    private void ClosePopup() => _popupOpen = false;

    private void SeedPopupFromScope(VariableScope s)
    {
        _popEnvIds    = s.EnvironmentId.HasValue ? new[] { s.EnvironmentId.Value } : [];
        _popTenantIds = s.TenantId.HasValue      ? new[] { s.TenantId.Value }      : [];
        _popTargetIds = s.TargetId.HasValue      ? new[] { s.TargetId.Value }      : [];
        _popRolesCsv  = s.Roles is { Count: > 0 } r ? string.Join(", ", r) : "";
    }

    private async Task SaveScopeAsync()
    {
        if (_project is null) return;

        var roles = ParseCsv(_popRolesCsv);
        var envIds    = _popEnvIds.ToList();
        var tenantIds = _popTenantIds.ToList();
        var targetIds = _popTargetIds.ToList();

        // ── Branch: new-row scope edit (no DB writes yet) ─────────────────
        if (_popupEditingVar is null)
        {
            // For the always-visible new row we just stage the scope locally;
            // multi-select cartesian only triggers if the user wants it AND
            // already typed a name. If they did, we expand right here.
            if (envIds.Count <= 1 && tenantIds.Count <= 1 && targetIds.Count <= 1)
            {
                _newScope = new VariableScope
                {
                    EnvironmentId = envIds.Count > 0 ? envIds[0] : null,
                    TenantId      = tenantIds.Count > 0 ? tenantIds[0] : null,
                    TargetId      = targetIds.Count > 0 ? targetIds[0] : null,
                    Roles         = roles.Count > 0 ? roles : null,
                };
                ClosePopup();
                return;
            }

            // Multi-select: requires a name; if missing, warn and keep popup
            // open so the user can fix it.
            if (string.IsNullOrWhiteSpace(_newName))
            {
                Notifications.Notify(NotificationSeverity.Warning, "Missing name",
                    "Type a variable name in the new-row inputs before saving "
                    + "a multi-scope (it expands into one variable per "
                    + "(env × tenant × target) combination).", 5000);
                return;
            }

            var envSetN    = envIds.Count    > 0 ? envIds   .Cast<Guid?>().ToList() : [null];
            var tenantSetN = tenantIds.Count > 0 ? tenantIds.Cast<Guid?>().ToList() : [null];
            var targetSetN = targetIds.Count > 0 ? targetIds.Cast<Guid?>().ToList() : [null];

            foreach (var e in envSetN)
                foreach (var t in tenantSetN)
                    foreach (var tg in targetSetN)
                    {
                        var scope = new VariableScope
                        {
                            EnvironmentId = e,
                            TenantId      = t,
                            TargetId      = tg,
                            Roles         = roles.Count > 0 ? [..roles] : null,
                        };
                        await VariableSvc.CreateVariableAsync(
                            _project.Id, _newName, _newValue ?? "",
                            _newType, scope);
                    }

            _newName = "";
            _newValue = "";
            _newType = VariableType.Text;
            _newScope = new VariableScope();
            ClosePopup();
            await ReloadAsync();
            Notifications.Notify(NotificationSeverity.Success, "Added",
                "Variable was added (multi-scope cartesian).", 3000);
            return;
        }

        var sensitiveEdit = _popupEditingVar.Type == VariableType.Sensitive;

        if (sensitiveEdit)
        {
            // Update in place; ciphertext untouched.
            var scope = new VariableScope
            {
                EnvironmentId = envIds.Count > 0 ? envIds[0] : null,
                TenantId      = tenantIds.Count > 0 ? tenantIds[0] : null,
                TargetId      = targetIds.Count > 0 ? targetIds[0] : null,
                Roles         = roles.Count > 0 ? roles : null,
            };
            await VariableSvc.UpdateVariableAsync(
                _popupEditingVar.Id, _popupEditingVar.Name, null,
                _popupEditingVar.Type, scope);
        }
        else
        {
            var envSet    = envIds.Count    > 0 ? envIds   .Cast<Guid?>().ToList() : [null];
            var tenantSet = tenantIds.Count > 0 ? tenantIds.Cast<Guid?>().ToList() : [null];
            var targetSet = targetIds.Count > 0 ? targetIds.Cast<Guid?>().ToList() : [null];

            var name  = _popupEditingVar.Name;
            var value = _popupEditingVar.Value;
            var type  = _popupEditingVar.Type;

            await VariableSvc.DeleteVariableAsync(_popupEditingVar.Id);

            foreach (var e in envSet)
                foreach (var t in tenantSet)
                    foreach (var tg in targetSet)
                    {
                        var scope = new VariableScope
                        {
                            EnvironmentId = e,
                            TenantId      = t,
                            TargetId      = tg,
                            Roles         = roles.Count > 0 ? [..roles] : null,
                        };
                        await VariableSvc.CreateVariableAsync(
                            _project.Id, name, value, type, scope);
                    }
        }

        ClosePopup();
        await ReloadAsync();
        Notifications.Notify(NotificationSeverity.Success, "Scope saved",
            "Variable scope was updated.", 3000);
    }

    private async Task OpenAdvancedEditorAsync()
    {
        ClosePopup();
        if (_popupEditingVar is not null)
        {
            await Dialog.OpenAsync<VariableFormDialog>(
                "Edit Variable",
                new Dictionary<string, object?>
                {
                    [nameof(VariableFormDialog.Variable)] = _popupEditingVar,
                },
                new DialogOptions { Width = "640px" });
            await ReloadAsync();
        }
    }

    private static List<string> ParseCsv(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return [];
        return raw.Split(',', StringSplitOptions.RemoveEmptyEntries
                            | StringSplitOptions.TrimEntries)
                  .ToList();
    }

    // ── Array-as-list editor ───────────────────────────────────────────────

    /// <summary>
    /// Renders a short preview for a stored StringArray value. The full JSON
    /// can be long; the user opens the popup to see/edit it as lines.
    /// </summary>
    private static string FormatArrayPreview(string? json)
    {
        var items = ParseArrayJson(json);
        return items.Count switch
        {
            0 => "[]",
            1 => $"[{items[0]}]",
            _ => $"[{items[0]}, ... ({items.Count} items)]",
        };
    }

    private static List<string> ParseArrayJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return [];
        }
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? [];
        }
        catch
        {
            // Fallback: treat as comma-separated.
            return json.Split(',', StringSplitOptions.None)
                       .Select(s => s.Trim())
                       .ToList();
        }
    }

    private void OpenArrayEditorAsync(MouseEventArgs args, Variable v)
    {
        _arrayEditingVar = v;
        _arrayLines = string.Join("\n", ParseArrayJson(v.Value));
        SetArrayPopupPosition(args);
        _arrayPopupOpen = true;
    }

    private void OpenArrayEditorForNewAsync(MouseEventArgs args)
    {
        _arrayEditingVar = null;
        _arrayLines = string.Join("\n", ParseArrayJson(_newValue));
        SetArrayPopupPosition(args);
        _arrayPopupOpen = true;
    }

    private void SetArrayPopupPosition(MouseEventArgs args)
    {
        const double popupWidth = 460;
        const double margin = 8;
        _arrayPopupTop  = args.ClientY + margin;
        _arrayPopupLeft = args.ClientX - popupWidth / 2;
        if (_arrayPopupLeft < margin) _arrayPopupLeft = margin;
    }

    private void CloseArrayEditor() => _arrayPopupOpen = false;

    private async Task SaveArrayAsync()
    {
        // Convert lines into a JSON array string. Newlines are split on \n
        // and \r\n alike; trailing \r is stripped. Empty lines are preserved
        // because empty array entries are sometimes meaningful.
        var lines = (_arrayLines ?? "")
            .Split('\n', StringSplitOptions.None)
            .Select(l => l.TrimEnd('\r'))
            .ToList();
        var json = System.Text.Json.JsonSerializer.Serialize(lines);

        if (_arrayEditingVar is null)
        {
            // New-row case: just stage the value, persist on Add.
            _newValue = json;
        }
        else
        {
            await VariableSvc.UpdateVariableAsync(
                _arrayEditingVar.Id, _arrayEditingVar.Name, json,
                _arrayEditingVar.Type, _arrayEditingVar.Scope);
            await ReloadAsync();
            Notifications.Notify(NotificationSeverity.Success, "Saved",
                "Array value updated.", 3000);
        }

        CloseArrayEditor();
    }
}
