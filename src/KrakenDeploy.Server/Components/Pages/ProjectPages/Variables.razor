    private void SetAllExpanded(bool expanded) => _allExpanded = expanded;

    // ── Three-dots menu ────────────────────────────────────────────────────

    private void ShowRowMenu(MouseEventArgs args, Variable v)
    {
        ContextMenu.Open(args, new List<ContextMenuItem>
        {
            new() { Text = "Add Value",          Value = "add",       Icon = "add" },
            new() { Text = "Duplicate Variable", Value = "duplicate", Icon = "content_copy" },
            new() { Text = "Delete Variable",    Value = "delete",    Icon = "delete" },
        }, async e =>
        {
            ContextMenu.Close();
            switch (e.Value)
            {
                case "add":       await AddValueAsync(v);   break;
                case "duplicate": await DuplicateAsync(v);  break;
                case "delete":    await DeleteAsync(v);     break;
            }
        });
