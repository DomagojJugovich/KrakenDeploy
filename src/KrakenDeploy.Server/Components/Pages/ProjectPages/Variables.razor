@page "/s/{SpaceSlug}/projects/{Slug}/variables"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Variables
@inject ProjectService ProjectSvc
@inject VariableService VariableSvc
@inject NavigationManager Nav

<ProjectShell Slug="@Slug">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0">
            Project Variables
        </RadzenText>
        <RadzenButton Text="Edit in Variables" Icon="open_in_new"
                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@(() => Nav.NavigateTo(Sp($"/variables?project={Slug}")))" />
    </RadzenStack>

    @if (!_loaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Loading…</RadzenText>
    }
    else if (_loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
            Failed to load: @_loadError
        </RadzenAlert>
    }
    else if (_project is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Project '@Slug' was not found.
        </RadzenAlert>
    }
    else if (_variables.Count == 0 && _includedSets.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            No variables defined for this project.
        </RadzenText>
    }
    else
    {
        <KrakenGrid SettingsKey="project-vars-ro" Data="@_variables" TItem="VariableDto"
                    AllowSorting="true" AllowPaging="true" PageSize="50"
                    AllowColumnResize="true" AllowFiltering="true"
                    FilterMode="FilterMode.Simple"
                    GridLines="DataGridGridLines.Horizontal">
            <Columns>
                <RadzenDataGridColumn TItem="VariableDto" Property="Name" Title="Name" Width="240px" />
                <RadzenDataGridColumn TItem="VariableDto" Title="Value">
                    <Template Context="v">
                        @if (v.Type == "Sensitive")
                        {
                            <RadzenBadge Text="*** sensitive ***" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                        }
                        else if (v.Value.Length > 80)
                        {
                            <span title="@v.Value">@v.Value[..80]…</span>
                        }
                        else
                        {
                            <code class="kraken-var-value">@v.Value</code>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VariableDto" Title="Type" Width="110px">
                    <Template Context="v">@v.Type</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VariableDto" Title="Scope" Width="220px">
                    <Template Context="v">
                        @if (v.Scope.IsUnscoped)
                        {
                            <span class="rz-color-secondary">all</span>
                        }
                        else
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.2rem">
                                @if (v.Scope.EnvironmentId.HasValue)
                                {
                                    <RadzenBadge Text="env" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                                }
                                @if (v.Scope.TenantId.HasValue)
                                {
                                    <RadzenBadge Text="tenant" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                }
                                @if (v.Scope.TargetId.HasValue)
                                {
                                    <RadzenBadge Text="target" BadgeStyle="BadgeStyle.Secondary" IsPill="true" />
                                }
                                @if (v.Scope.Roles is { Count: > 0 })
                                {
                                    <RadzenBadge Text="role" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                }
                                @if (v.Scope.ChannelId.HasValue)
                                {
                                    <RadzenBadge Text="channel" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                                }
                                @if (v.Scope.ProcessStepId.HasValue)
                                {
                                    <RadzenBadge Text="step" BadgeStyle="BadgeStyle.Primary" IsPill="true" />
                                }
                            </RadzenStack>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </KrakenGrid>

        @if (_includedSets.Count > 0)
        {
            <RadzenCard class="rz-mt-3">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Included Library Variable Sets</RadzenText>
                <RadzenStack Gap="0.4rem">
                    @foreach (var set in _includedSets)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="library_books" Style="font-size:1.1rem; opacity:0.6;" />
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">@set.Name</RadzenText>
                            <RadzenBadge Text="@($"{set.Variables.Count} vars")" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenCard>
        }
    }
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Project? _project;
    private List<VariableDto> _variables = [];
    private List<VariableSet> _includedSets = [];
    private bool _loaded;
    private string? _loadError;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _project = await ProjectSvc.GetBySlugAsync(Slug);
            if (_project is not null)
            {
                _variables = await VariableSvc.GetVariablesAsync(_project.Id);
                _includedSets = await VariableSvc.GetIncludedSetsAsync(_project.Id);
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }
}
