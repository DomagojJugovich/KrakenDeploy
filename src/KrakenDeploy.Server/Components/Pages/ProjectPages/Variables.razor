@page "/s/{SpaceSlug}/projects/{Slug}/variables"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Variables
@using KrakenDeploy.Server.Core.Domain.Environments
@using KrakenDeploy.Server.Core.Domain.Tenants
@using KrakenDeploy.Server.Core.Domain.Targets
@using KrakenDeploy.Server.Core.Domain.Channels
@using KrakenDeploy.Server.Data
@using KrakenDeploy.Server.Data.Services
@using Microsoft.EntityFrameworkCore
@inject ProjectService ProjectSvc
@inject VariableService VariableSvc
@inject EnvironmentService EnvironmentSvc
@inject TenantService TenantSvc
@inject TargetService TargetSvc
@inject ChannelService ChannelSvc
@inject ProcessService ProcessSvc
@inject DialogService Dialog
@inject ContextMenuService ContextMenu
@inject NotificationService Notifications
@inject UiActionGuard Guard
@inject NavigationManager Nav
@inject IDbContextFactory<KrakenDbContext> DbFactory

<ProjectShell Slug="@Slug">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0">
                Project Variables
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
                <RadzenButton Text="Edit" Size="ButtonSize.Small"
                              ButtonStyle="@(_mode == VarMode.Edit ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Click="@(() => _mode = VarMode.Edit)" />
                <RadzenButton Text="Preview" Size="ButtonSize.Small"
                              ButtonStyle="@(_mode == VarMode.Preview ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Click="@(() => _mode = VarMode.Preview)" />
            </RadzenStack>
        </RadzenStack>
        @if (_mode == VarMode.Edit)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RequirePermission Permission="Permission.VariableEdit">
                    <RadzenButton Icon="unfold_less" Text="Collapse all"
                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => SetAllExpanded(false))" />
                    <RadzenButton Icon="unfold_more" Text="Expand all"
                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => SetAllExpanded(true))" />
                </RequirePermission>
            </RadzenStack>
        }
    </RadzenStack>

    @if (_mode == VarMode.Edit)
    {
    @* ── Filter bar ─────────────────────────────────────────────────────── *@
    <div class="kraken-var-filter-bar rz-mb-3">
        <RadzenDropDown TValue="Guid?" @bind-Value="_filterEnvId"
                        Data="@_environments" TextProperty="Name" ValueProperty="Id"
                        AllowClear="true" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="All environments" Style="width: 180px;" />
        <RadzenDropDown TValue="Guid?" @bind-Value="_filterTenantId"
                        Data="@_tenants" TextProperty="Name" ValueProperty="Id"
                        AllowClear="true" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="All tenants" Style="width: 160px;" />
        <RadzenDropDown TValue="string" @bind-Value="_filterRole"
                        Data="@_availableRoles"
                        AllowClear="true" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="All roles" Style="width: 150px;" />
        <RadzenDropDown TValue="Guid?" @bind-Value="_filterStepId"
                        Data="@_projectStepNames" TextProperty="Name" ValueProperty="Id"
                        AllowClear="true" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="All steps" Style="width: 170px;" />
        @if (_filterEnvId.HasValue || _filterTenantId.HasValue
             || _filterRole?.Length > 0 || _filterStepId.HasValue)
        {
            <RadzenButton Icon="filter_alt_off" Text="Clear"
                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="ClearFilters" />
        }
    </div>
    }

    @if (!_loaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            Loading variables...
        </RadzenText>
    }
    else if (_loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
            Failed to load variables: @_loadError
        </RadzenAlert>
    }
    else if (_project is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Project '@Slug' was not found.
        </RadzenAlert>
    }
    else
    {
        @if (_mode == VarMode.Edit)
        {
        @* ── Always-visible "new variable" row above the grid ─────────────── *@
        <RequirePermission Permission="Permission.VariableEdit">
            <div class="kraken-newvar-bar">
                <div class="kraken-newvar-name">
                    <RadzenLabel Text="Name" />
                    <RadzenTextBox @bind-Value="_newName"
                                   Placeholder="Enter new variable"
                                   Style="width: 100%;" />
                </div>
                <div class="kraken-newvar-value">
                    <RadzenLabel Text="Value" />
                    @if (_newType == VariableType.Sensitive)
                    {
                        <RadzenPassword @bind-Value="_newValue"
                                        Placeholder="Enter value"
                                        Style="width: 100%;" />
                    }
                    else if (_newType == VariableType.StringArray)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center" Gap="0.4rem">
                            <RadzenTextBox @bind-Value="_newValue"
                                           Placeholder='["a","b"] or a, b'
                                           Style="flex: 1;" />
                            <RadzenButton Icon="format_list_bulleted"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@(args => OpenArrayEditorForNew(args))"
                                          title="Edit as list" />
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenTextBox @bind-Value="_newValue"
                                       Placeholder="Enter value"
                                       Style="width: 100%;" />
                    }
                </div>
                <div class="kraken-newvar-type">
                    <RadzenLabel Text="Type" />
                    <RadzenDropDown TValue="VariableType" @bind-Value="_newType"
                                    Data="@_typeOptions" TextProperty="Label"
                                    ValueProperty="Value" Style="width: 100%;" />
                </div>
                <div class="kraken-newvar-scope">
                    <RadzenLabel Text="Scope" />
                    <button type="button" class="kraken-newvar-scope-btn"
                            @onclick="@(args => OpenNewScopePopup(args))">
                        @ScopeLabelForNew()
                    </button>
                </div>
                <div class="kraken-newvar-actions">
                    <RadzenButton Text="Add" Icon="add_circle_outline"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Disabled="@(string.IsNullOrWhiteSpace(_newName))"
                                  Click="AddNewVariableAsync" />
                </div>
            </div>
        </RequirePermission>

        <KrakenGrid SettingsKey="project-variables" @ref="_grid" Data="@_filteredVariables" TItem="Variable"
                        AllowFiltering="true" FilterMode="FilterMode.Simple"
                        AllowSorting="true" AllowPaging="true" PageSize="50"
                        AllowGrouping="true" Groups="@_groups"
                        AllGroupsExpanded="@_allExpanded"
                        AllGroupsExpandedChanged="@(v => _allExpanded = v)"
                        AllowColumnResize="true"
                        EditMode="DataGridEditMode.Single"
                        CellRender="@OnCellRender"
                        CellClick="@OnCellClickAsync"
                        RowUpdate="@OnRowUpdateAsync"
                        EmptyText="No variables yet — use the row above to add one.">
            <GroupHeaderTemplate Context="group">
                <strong>@group.Data.Key</strong>
                <span class="rz-color-secondary rz-ml-2">
                    (@group.Data.Count value@(group.Data.Count == 1 ? "" : "s"))
                </span>
            </GroupHeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="Variable" Property="Name" Title="Name"
                                      Width="220px">
                    <Template Context="v">
                        @if (IsLocked(v))
                        {
                            <RadzenIcon Icon="lock" Style="font-size:0.8rem; opacity:0.5; margin-right:4px;" />
                        }
                        @v.Name
                    </Template>
                    <EditTemplate Context="v">
                        <RadzenTextBox @bind-Value="v.Name" Style="width: 100%;"
                                       Placeholder="Enter new variable" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Property="Value" Title="Value"
                                      Sortable="false">
                    <Template Context="v">
                        @if (v.Type == VariableType.Sensitive)
                        {
                            <RadzenBadge Text="*** sensitive ***"
                                         BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                        }
                        else if (v.Type == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.4rem">
                                <code class="kraken-var-value">@FormatArrayPreview(v.Value)</code>
                                <RadzenButton Icon="format_list_bulleted"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(args => OpenArrayEditor(args, v))"
                                              @onclick:stopPropagation="true"
                                              title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <code class="kraken-var-value">@v.Value</code>
                        }
                    </Template>
                    <EditTemplate Context="v">
                        @if (v.Type == VariableType.Sensitive)
                        {
                            <RadzenPassword @bind-Value="v.Value" Style="width: 100%;"
                                            Placeholder="(retype to change)" />
                        }
                        else if (v.Type == VariableType.StringArray)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenTextBox @bind-Value="v.Value" Style="flex: 1;"
                                               Placeholder='["a","b"] or a, b' />
                                <RadzenButton Icon="format_list_bulleted"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(args => OpenArrayEditor(args, v))"
                                              @onclick:stopPropagation="true"
                                              title="Edit as list" />
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenTextBox @bind-Value="v.Value" Style="width: 100%;"
                                           Placeholder="Enter value" />
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Property="Type" Title="Type"
                                      Width="120px">
                    <Template Context="v">@v.Type</Template>
                    <EditTemplate Context="v">
                        <RadzenDropDown TValue="VariableType" @bind-Value="v.Type"
                                        Data="@_typeOptions" TextProperty="Label"
                                        ValueProperty="Value" Style="width: 100%;" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="Source" Width="140px"
                                      Sortable="false" Filterable="false">
                    <Template Context="v">
                        <span class="@(IsLocked(v) ? "rz-color-secondary" : "")">
                            @SourceLabel(v)
                        </span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="Scope" Sortable="false"
                                      Filterable="false">
                    @* No EditTemplate — scope is edited via the popup, never inline. *@
                    <Template Context="v">
                        <button type="button"
                                class="@(v.Scope.IsUnscoped
                                         ? "kraken-vargrid-link kraken-scope-unbound-btn"
                                         : "kraken-scope-chip-btn")"
                                @onclick="@(args => OpenScopePopup(args, v))"
                                @onclick:stopPropagation="true">
                            @if (v.Scope.IsUnscoped)
                            {
                                <text>Define scope</text>
                            }
                            else
                            {
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             Wrap="FlexWrap.Wrap" Gap="0.3rem"
                                             AlignItems="AlignItems.Center">
                                    @if (v.Scope.EnvironmentId is { } envId)
                                    {
                                        <RadzenBadge Text="@($"env: {EnvName(envId)}")"
                                                     BadgeStyle="BadgeStyle.Info"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.TenantId is { } tenantId)
                                    {
                                        <RadzenBadge Text="@($"tenant: {TenantName(tenantId)}")"
                                                     BadgeStyle="BadgeStyle.Success"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.TargetId is { } targetId)
                                    {
                                        <RadzenBadge Text="@($"target: {TargetName(targetId)}")"
                                                     BadgeStyle="BadgeStyle.Secondary"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.ChannelId is { } channelId)
                                    {
                                        <RadzenBadge Text="@($"channel: {ChannelName(channelId)}")"
                                                     BadgeStyle="BadgeStyle.Warning"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.ProcessStepId is { } stepId)
                                    {
                                        <RadzenBadge Text="@($"step: {StepName(stepId)}")"
                                                     BadgeStyle="BadgeStyle.Primary"
                                                     IsPill="true" />
                                    }
                                    @if (v.Scope.Roles is { Count: > 0 })
                                    {
                                        @foreach (var r in v.Scope.Roles)
                                        {
                                            <RadzenBadge Text="@($"role: {r}")"
                                                         BadgeStyle="BadgeStyle.Light"
                                                         IsPill="true" />
                                        }
                                    }
                                    <RadzenIcon Icon="edit"
                                                Style="font-size: 0.95rem; opacity: 0.55;" />
                                </RadzenStack>
                            }
                        </button>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Variable" Title="" Width="140px"
                                      Sortable="false" Filterable="false"
                                      TextAlign="TextAlign.Right">
                    <Template Context="v">
                        @if (!IsLocked(v))
                        {
                            <RequirePermission Permission="Permission.VariableEdit">
                                <RadzenButton Icon="more_vert"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(args => ShowRowMenu(args, v))"
                                              @onclick:stopPropagation="true" />
                            </RequirePermission>
                        }
                    </Template>
                    <EditTemplate Context="v">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => _grid.UpdateRow(v))"
                                      @onclick:stopPropagation="true" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall" class="rz-ml-1"
                                      Click="@(() => CancelEditAsync(v))"
                                      @onclick:stopPropagation="true" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </KrakenGrid>

        @* ── Included library sets ───────────────────────────────────────── *@
        <RadzenCard class="rz-mt-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                    Included Library Variable Sets
                </RadzenText>
                <RequirePermission Permission="Permission.VariableEdit">
                    <RadzenButton Icon="add" Text="Include set"
                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="OpenIncludeSetDialog" />
                </RequirePermission>
            </RadzenStack>
            @if (_includedSets.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    No library variable sets included. Variables from included sets
                    appear above (read-only) and participate in deployment resolution.
                </RadzenText>
            }
            else
            {
                <RadzenStack Gap="0.5rem">
                    @foreach (var set in _includedSets)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     class="kraken-included-set-row">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="library_books"
                                            Style="font-size:1.1rem; opacity:0.6;" />
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                    @set.Name
                                </RadzenText>
                                <RadzenBadge Text="@($"{set.Variables.Count} vars")"
                                             BadgeStyle="BadgeStyle.Light" IsPill="true" />
                            </RadzenStack>
                            <RequirePermission Permission="Permission.VariableEdit">
                                <RadzenButton Icon="link_off" Text="Remove"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RemoveIncludedSetAsync(set.Id))" />
                            </RequirePermission>
                        </RadzenStack>
                    }
                </RadzenStack>
            }
        </RadzenCard>
        }
        else
        {
            @* ── Preview mode ─────────────────────────────────────────────── *@
            <RadzenCard class="rz-mb-3">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">
                    Resolve variables for a deployment context
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem"
                             AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <div>
                        <RadzenLabel Text="Environment" />
                        <RadzenDropDown TValue="Guid?" @bind-Value="_previewEnvId"
                                        Data="@_environments" TextProperty="Name" ValueProperty="Id"
                                        AllowClear="true" AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Select…" Style="width: 180px;" />
                    </div>
                    <div>
                        <RadzenLabel Text="Target" />
                        <RadzenDropDown TValue="Guid?" @bind-Value="_previewTargetId"
                                        Data="@_targets" TextProperty="Name" ValueProperty="Id"
                                        AllowClear="true" AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="(any)" Style="width: 180px;" />
                    </div>
                    <div>
                        <RadzenLabel Text="Tenant" />
                        <RadzenDropDown TValue="Guid?" @bind-Value="_previewTenantId"
                                        Data="@_tenants" TextProperty="Name" ValueProperty="Id"
                                        AllowClear="true" AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="(any)" Style="width: 160px;" />
                    </div>
                    <RadzenButton Text="Resolve" Icon="play_arrow"
                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Disabled="@(!_previewEnvId.HasValue)"
                                  Click="RunPreviewAsync" />
                </RadzenStack>
            </RadzenCard>

            @if (_previewLoading)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Resolving…</RadzenText>
            }
            else if (_previewResult is not null)
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">
                        Resolved variables (@_previewResult.Count)
                    </RadzenText>
                    @if (_previewResult.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                            No variables match the selected context.
                        </RadzenText>
                    }
                    else
                    {
                        <KrakenGrid SettingsKey="var-preview" Data="@_previewRows" TItem="PreviewRow"
                                    AllowSorting="true" AllowPaging="true" PageSize="50"
                                    AllowColumnResize="true" AllowFiltering="true"
                                    FilterMode="FilterMode.Simple"
                                    GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="PreviewRow" Property="Name" Title="Name" Width="280px" />
                                <RadzenDataGridColumn TItem="PreviewRow" Property="Value" Title="Value">
                                    <Template Context="r">
                                        @if (r.Sensitive)
                                        {
                                            <RadzenBadge Text="*** sensitive ***"
                                                         BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                                        }
                                        else
                                        {
                                            <code class="kraken-var-value">@r.Value</code>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </KrakenGrid>
                    }
                </RadzenCard>
            }
        }
    }
</ProjectShell>

@* ── Array-as-list editor popup ──────────────────────────────────────────── *@
@if (_arrayPopupOpen)
{
    <div class="kraken-scope-popup-backdrop" @onclick="CloseArrayEditor"></div>
    <div class="kraken-scope-popup kraken-array-popup"
         style="@($"top: {_arrayPopupTop}px; left: {_arrayPopupLeft}px;")"
         @onclick:stopPropagation="true">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                Edit array — one value per line
            </RadzenText>
            <RadzenTextArea @bind-Value="_arrayLines" Rows="14"
                            class="kraken-array-textarea"
                            Placeholder="line1&#10;line2&#10;line3" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                Stored as a JSON array. Empty lines are kept as empty entries.
                Drag the bottom-right corner to resize.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" Click="CloseArrayEditor" />
                <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Click="SaveArrayAsync" />
            </RadzenStack>
        </RadzenStack>
    </div>
}

@* ── Scope popup (custom div, positioned at click site) ──────────────────── *@
@if (_popupOpen)
{
    <div class="kraken-scope-popup-backdrop" @onclick="ClosePopup"></div>
    <div class="kraken-scope-popup"
         style="@($"top: {_popupTop}px; left: {_popupLeft}px;")"
         @onclick:stopPropagation="true">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                @(_popupEditingVar is null ? "Define scope" : "Edit scope")
            </RadzenText>

            <div>
                <RadzenLabel Text="Environments" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popEnvIds"
                                Data="@_environments" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any environment)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Tenants" />
                <RadzenDropDown TValue="IEnumerable<Guid>" Value="@_popTenantIds"
                                ValueChanged="@OnPopTenantsChanged"
                                Data="@_tenants" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any tenant)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Targets" />
                <RadzenDropDown TValue="IEnumerable<Guid>" @bind-Value="_popTargetIds"
                                Data="@PopTargetOptions" TextProperty="Name" ValueProperty="Id"
                                Multiple="true" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any target)"
                                Style="width: 100%;" />
                @if (CountOf(_popTenantIds) > 0)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                        Showing only targets tagged for the selected tenant(s).
                    </RadzenText>
                }
            </div>
            <div>
                <RadzenLabel Text="Channel" />
                <RadzenDropDown TValue="Guid?" @bind-Value="_popChannelId"
                                Data="@_channels" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="(any channel)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Step" />
                <RadzenDropDown TValue="Guid?" @bind-Value="_popProcessStepId"
                                Data="@_projectStepNames" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="(any step)"
                                Style="width: 100%;" />
            </div>
            <div>
                <RadzenLabel Text="Target Roles" />
                <RadzenDropDown TValue="IEnumerable<string>" @bind-Value="_popRoles"
                                Data="@_availableRoles"
                                Multiple="true" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Chips="true" Placeholder="(any role)"
                                Style="width: 100%;" />
            </div>

            @if (_popupEditingVar?.Type == VariableType.Sensitive
                 && (CountOf(_popEnvIds) > 1 || CountOf(_popTenantIds) > 1
                     || CountOf(_popTargetIds) > 1))
            {
                <div class="kraken-scope-popup-warning">
                    Multi-scope expansion is disabled for sensitive variables —
                    only the first selection of each dimension will be applied.
                </div>
            }

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <button type="button" class="kraken-vargrid-link"
                        @onclick="OpenAdvancedEditorAsync">Open editor</button>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="ClosePopup" />
                    <RadzenButton Text="Done" ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small" Click="SaveScopeAsync" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private enum VarMode { Edit, Preview }
    private VarMode _mode = VarMode.Edit;

    private RadzenDataGrid<Variable> _grid = default!;
    private Project? _project;
    private List<Variable> _variables = [];
    private List<VariableSet> _includedSets = [];
    private Dictionary<Guid, string> _sourceNames = [];
    private HashSet<Guid> _lockedIds = [];
    private List<DeploymentEnvironment> _environments = [];
    private List<Tenant> _tenants = [];
    private List<DeploymentTarget> _targets = [];
    private Dictionary<Guid, HashSet<Guid>> _targetTenantMap = [];
    private List<Channel> _channels = [];
    private List<(Guid Id, string Name)> _projectStepNames = [];
    private Dictionary<Guid, string> _envNames = [];
    private Dictionary<Guid, string> _tenantNames = [];
    private Dictionary<Guid, string> _targetNames = [];
    private bool _loaded;
    private string? _loadError;

    // ── Filter state ──────────────────────────────────────────────────────
    private Guid? _filterEnvId;
    private Guid? _filterTenantId;
    private string _filterRole = "";
    private Guid? _filterStepId;

    private List<Variable> _filteredVariables
    {
        get
        {
            var result = new List<Variable>(_variables.Count);
            foreach (var v in _variables)
            {
                if (_filterEnvId.HasValue && v.Scope.EnvironmentId.HasValue
                    && v.Scope.EnvironmentId != _filterEnvId) continue;
                if (_filterTenantId.HasValue && v.Scope.TenantId.HasValue
                    && v.Scope.TenantId != _filterTenantId) continue;
                if (_filterRole?.Length > 0)
                {
                    var roles = v.Scope.Roles;
                    if (roles is { Count: > 0 }
                        && !roles.Contains(_filterRole, StringComparer.OrdinalIgnoreCase)) continue;
                }
                if (_filterStepId.HasValue && v.Scope.ProcessStepId.HasValue
                    && v.Scope.ProcessStepId != _filterStepId) continue;
                result.Add(v);
            }
            return result;
        }
    }

    private void ClearFilters()
    {
        _filterEnvId = null;
        _filterTenantId = null;
        _filterRole = "";
        _filterStepId = null;
    }

    private bool IsLocked(Variable v) => _lockedIds.Contains(v.Id);
    private string SourceLabel(Variable v) =>
        _sourceNames.TryGetValue(v.Id, out var s) ? s : "Project";

    // ── Preview mode state ────────────────────────────────────────────────
    private Guid? _previewEnvId;
    private Guid? _previewTargetId;
    private Guid? _previewTenantId;
    private bool _previewLoading;
    private Dictionary<string, string>? _previewResult;
    private List<PreviewRow> _previewRows = [];

    private sealed record PreviewRow(string Name, string Value, bool Sensitive);

    private async Task RunPreviewAsync()
    {
        if (_project is null || !_previewEnvId.HasValue) return;
        _previewLoading = true;
        _previewResult = null;
        _previewRows = [];
        StateHasChanged();

        try
        {
            var targetRoles = _previewTargetId.HasValue
                ? _targets.FirstOrDefault(t => t.Id == _previewTargetId)?.Roles ?? []
                : [];

            IReadOnlyList<Guid>? tenantTagIds = null;
            if (_previewTenantId.HasValue)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                tenantTagIds = await TagService.GetTenantTagIdsAsync(db, _previewTenantId.Value);
            }

            var resolved = await VariableSvc.ResolveAsync(
                _project.Id,
                _previewEnvId.Value,
                _previewTargetId,
                targetRoles,
                tenantId: _previewTenantId,
                tenantTagIds: tenantTagIds);

            var sensitive = await VariableSvc.GetSensitiveNamesAsync(_project.Id);

            _previewResult = resolved;
            _previewRows = resolved
                .OrderBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase)
                .Select(kv => new PreviewRow(kv.Key, kv.Value, sensitive.Contains(kv.Key)))
                .ToList();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Preview failed", ex.Message, 5000);
        }
        finally
        {
            _previewLoading = false;
        }
    }

    // Always group by Name. Single-value groups still render a header — the
    // count next to the name makes that obvious.
    private readonly List<GroupDescriptor> _groups =
    [
        new() { Property = nameof(Variable.Name) }
    ];
    private bool? _allExpanded = true;

    // ── Always-visible new-variable row state ─────────────────────────────
    private string _newName = "";
    private string _newValue = "";
    private VariableType _newType = VariableType.Text;
    private VariableScope _newScope = new();

    private record TypeOption(VariableType Value, string Label);
    private readonly TypeOption[] _typeOptions =
    [
        new(VariableType.Text,        "Text"),
        new(VariableType.Sensitive,   "Sensitive"),
        new(VariableType.StringArray, "Array"),
    ];

    // ── Scope popup state ──────────────────────────────────────────────────
    private bool _popupOpen;
    private double _popupTop;
    private double _popupLeft;
    private Variable? _popupEditingVar;
    private IEnumerable<Guid> _popEnvIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTenantIds = Array.Empty<Guid>();
    private IEnumerable<Guid> _popTargetIds = Array.Empty<Guid>();
    private Guid? _popChannelId;
    private Guid? _popProcessStepId;
    private IEnumerable<string> _popRoles = [];
    private List<string> _availableRoles = [];

    // ── Array-as-list editor state ─────────────────────────────────────────
    private bool _arrayPopupOpen;
    private double _arrayPopupTop;
    private double _arrayPopupLeft;
    private Variable? _arrayEditingVar;     // null = staged new-row value
    private string _arrayLines = "";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _project = await ProjectSvc.GetBySlugAsync(Slug);
            if (_project is null) return;

            _environments = await EnvironmentSvc.GetAllOrderedAsync(includeArchived: true);
            _envNames = _environments.ToDictionary(e => e.Id, e => e.Name);

            _tenants = await TenantSvc.GetAllAsync();
            _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);

            _targets = await TargetSvc.GetAllAsync();
            _targetNames = _targets.ToDictionary(t => t.Id, t => t.Name);
            _targetTenantMap = await TargetSvc.GetTenantAssociationMapAsync();

            _channels = await ChannelSvc.GetForProjectAsync(_project.Id);

            var process = await ProcessSvc.GetAsync(_project.Id);
            _projectStepNames = process?.Steps.Select(s => (s.Id, s.Name)).ToList() ?? [];

            _availableRoles = _targets.SelectMany(t => t.Roles)
                .Concat(process?.Steps.SelectMany(s => s.TargetRoles) ?? [])
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(r => r, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (!_loaded)
            {
                var uri = Nav.ToAbsoluteUri(Nav.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                if (Guid.TryParse(query["env"], out var envId)) _filterEnvId = envId;
                if (Guid.TryParse(query["tenant"], out var tenantId)) _filterTenantId = tenantId;
                if (!string.IsNullOrEmpty(query["role"])) _filterRole = query["role"]!;
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task ReloadAsync()
    {
        if (_project is null) return;

        _sourceNames.Clear();
        _lockedIds.Clear();

        _includedSets = await VariableSvc.GetIncludedSetsAsync(_project.Id);
        foreach (var set in _includedSets)
        {
            foreach (var v in set.Variables)
            {
                _sourceNames[v.Id] = set.Name ?? "Library";
                _lockedIds.Add(v.Id);
            }
        }

        var dtos = await VariableSvc.GetVariablesAsync(_project.Id);
        var entities = new List<Variable>(dtos.Count);
        foreach (var d in dtos)
        {
            var entity = await VariableSvc.GetVariableAsync(d.Id);
            if (entity is not null) entities.Add(entity);
        }

        var all = new List<Variable>(entities.Count + _lockedIds.Count);
        foreach (var set in _includedSets)
            all.AddRange(set.Variables);
        all.AddRange(entities);
        _variables = all;
    }

    /// <summary>
    /// Targets offered in the scope popup. With tenants selected, only
    /// targets directly ASSOCIATED with one of those tenants are shown
    /// (a target with no tenant association drops out too).
    /// </summary>
    private IEnumerable<DeploymentTarget> PopTargetOptions
    {
        get
        {
            var tenantIds = _popTenantIds.ToHashSet();
            if (tenantIds.Count == 0)
            {
                return _targets;
            }
            return _targets.Where(t =>
                _targetTenantMap.TryGetValue(t.Id, out var serves)
                && serves.Overlaps(tenantIds));
        }
    }

    /// <summary>Tenant selection changed → drop selected targets that no
    /// longer serve the selection, so a hidden option can't stay selected.</summary>
    private void OnPopTenantsChanged(IEnumerable<Guid> tenantIds)
    {
        _popTenantIds = tenantIds;
        var allowed = PopTargetOptions.Select(t => t.Id).ToHashSet();
        _popTargetIds = _popTargetIds.Where(allowed.Contains).ToList();
    }

    private string EnvName(Guid id) =>
        _envNames.TryGetValue(id, out var n) ? n : "?";
    private string TenantName(Guid id) =>
