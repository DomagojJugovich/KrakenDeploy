@page "/projects/{Slug}/variable-preview"
@attribute [Authorize]

<ProjectShell Slug="@Slug">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-3">
        Variable Preview
    </RadzenText>
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
        Preview resolved variable values for a chosen environment / tenant / channel — pending.
    </RadzenAlert>
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
}
