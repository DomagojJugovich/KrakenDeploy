@page "/projects/{Slug}/triggers"
@attribute [Authorize]

<ProjectShell Slug="@Slug">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-3">
        Triggers
    </RadzenText>
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
        Deployment triggers (auto-deploy on package push, scheduled, etc.) — pending.
    </RadzenAlert>
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
}
