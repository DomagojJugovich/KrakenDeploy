@page "/projects/{Slug}/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Deployments
@inject ProjectService ProjectSvc
@inject DeploymentService DeploymentSvc
@inject DialogService Dialog
@inject NotificationService Notifications

<ProjectShell Slug="@Slug">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0">
            Project Dashboard
        </RadzenText>
        <RequirePermission Permission="Permission.ReleaseCreate">
            <RadzenButton Text="Create Release" Icon="add_circle_outline"
                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click="OpenCreateAsync" />
        </RequirePermission>
    </RadzenStack>

    @* Filter row *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 Gap="1rem" class="rz-mb-3">
        <div style="min-width: 220px;">
            <RadzenLabel Text="Filter by release" />
            <RadzenDropDown @bind-Value="_filterReleaseId" Data="@_releaseOptions"
                            TextProperty="Label" ValueProperty="Value"
                            AllowClear="true" Placeholder="(all releases)"
                            Style="width: 100%;" />
        </div>
        <div style="min-width: 200px;">
            <RadzenLabel Text="Group by" />
            <RadzenDropDown TValue="string" Value="@_groupBy"
                            ValueChanged="@((string v) => _groupBy = v)"
                            Data="@_groupByOptions"
                            TextProperty="Label" ValueProperty="Value"
                            Style="width: 100%;" />
        </div>
        <div class="rz-ml-auto" style="align-self: end;">
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                @if (_matrix is not null)
                {
                    <text>1 - @_matrix.Tenants.Count of @_matrix.Tenants.Count Tenants</text>
                }
            </RadzenText>
        </div>
    </RadzenStack>

    @if (!_loaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            Loading deployments...
        </RadzenText>
    }
    else if (_loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
            Failed to load dashboard: @_loadError
        </RadzenAlert>
    }
    else if (_matrix is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Project '@Slug' was not found.
        </RadzenAlert>
    }
    else if (_matrix.Tenants.Count == 0)
    {
        <RadzenCard class="rz-p-5 rz-text-align-center">
            <RadzenIcon Icon="people_outline" Style="font-size: 3rem; opacity: 0.3;" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-mt-3">
                No tenants connected to this project
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                Connect tenants from the
                <RadzenLink Path="@($"/projects/{Slug}/tenants")" Text="Tenants" />
                tab to see them here.
            </RadzenText>
        </RadzenCard>
    }
    else if (_matrix.Environments.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            No environments are defined in this Space. Define environments first
            so deployments have somewhere to go.
        </RadzenAlert>
    }
    else
    {
        <h3 class="rz-text-h6 rz-mt-4 rz-mb-3">Deployments</h3>
        <div class="kraken-matrix-wrap">
            <table class="kraken-matrix">
                <thead>
                    <tr>
                        <th class="kraken-matrix-th-tenant">Tenant</th>
                        @foreach (var env in _matrix.Environments)
                        {
                            <th>@env.Name.ToUpperInvariant()</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in _matrix.Tenants)
                    {
                        <tr>
                            <td class="kraken-matrix-tenant-cell">
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             AlignItems="AlignItems.Center" Gap="0.6rem">
                                    <div class="kraken-tenant-avatar">
                                        @TenantInitials(tenant.Name)
                                    </div>
                                    <span class="kraken-tenant-name">
                                        @tenant.Name.ToUpperInvariant()
                                    </span>
                                </RadzenStack>
                            </td>
                            @foreach (var env in _matrix.Environments)
                            {
                                <td class="kraken-matrix-cell">
                                    @{
                                        _matrix.Cells.TryGetValue(
                                            (tenant.Id, env.Id), out var cell);
                                    }
                                    @if (cell is null)
                                    {
                                        <span class="kraken-matrix-empty">—</span>
                                    }
                                    else if (_filterReleaseId is null
                                             || ReleaseLabelById(_filterReleaseId)
                                                 == cell.ReleaseVersion)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal"
                                                     AlignItems="AlignItems.Start" Gap="0.5rem">
                                            <span class="@StatusClass(cell.Status)">
                                                <RadzenIcon Icon="@StatusIcon(cell.Status)" />
                                            </span>
                                            <div>
                                                <div class="kraken-matrix-version">
                                                    @cell.ReleaseVersion
                                                </div>
                                                @if (cell.ChannelName is not null)
                                                {
                                                    <RadzenBadge Text="@cell.ChannelName"
                                                                 BadgeStyle="BadgeStyle.Info"
                                                                 IsPill="true" />
                                                }
                                                <div class="kraken-matrix-date">
                                                    @cell.CreatedUtc.LocalDateTime
                                                        .ToString("MMM d, yyyy h:mm tt")
                                                </div>
                                            </div>
                                        </RadzenStack>
                                    }
                                    else
                                    {
                                        <span class="kraken-matrix-empty">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Project? _project;
    private ProjectDashboardMatrix? _matrix;
    private string? _filterReleaseId;
    private string _groupBy = "none";
    private bool _loaded;
    private string? _loadError;

    private record Option(string Value, string Label);

    private List<Option> _releaseOptions = [];
    private readonly Option[] _groupByOptions =
    [
        new("none", "(none)"),
        new("tenant-tag", "Tenant tag"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        // Load Project via Slug rather than relying on cascading from
        // ProjectShell — the cascade can't always cross the rendermode
        // boundary (ProjectShell is SSR, Dashboard is InteractiveServer).
        try
        {
            _project = await ProjectSvc.GetBySlugAsync(Slug);
            if (_project is null)
            {
                _matrix = null;
                _loaded = true;
                return;
            }

            _matrix = await DeploymentSvc.GetProjectMatrixAsync(_project.Id);

            // Distinct release versions present in this project's matrix become
            // the filter dropdown choices. Most recent first.
            _releaseOptions = _matrix.Cells.Values
                .OrderByDescending(c => c.CreatedUtc)
                .Select(c => c.ReleaseVersion)
                .Distinct()
                .Select(v => new Option(v, v))
                .ToList();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task OpenCreateAsync()
    {
        if (_project is null) return;
        var result = await Dialog.OpenAsync<CreateReleaseDialog>(
            "Create release",
            new Dictionary<string, object?>
            {
                [nameof(CreateReleaseDialog.ProjectId)] = _project.Id,
            },
            new DialogOptions { Width = "560px" });

        if (result is true)
        {
            await OnParametersSetAsync();
            Notifications.Notify(NotificationSeverity.Success, "Created", "Release was created.", 3000);
        }
    }

    private string ReleaseLabelById(string? id) => id ?? "";

    private static string TenantInitials(string name)
    {
        var parts = name.Split([' ', '-', '_'],
            StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private static string StatusIcon(DeploymentStatus s) => s switch
    {
        DeploymentStatus.Succeeded             => "check",
        DeploymentStatus.SucceededWithWarnings => "warning_amber",
        DeploymentStatus.Failed                => "close",
        DeploymentStatus.Cancelled             => "block",
        DeploymentStatus.Running               => "play_arrow",
        DeploymentStatus.Queued                => "schedule",
        DeploymentStatus.PendingOfflineResult  => "hourglass_empty",
        _                                       => "help",
    };

    private static string StatusClass(DeploymentStatus s) => s switch
    {
        DeploymentStatus.Succeeded             => "kraken-matrix-status kraken-matrix-status--ok",
        DeploymentStatus.SucceededWithWarnings => "kraken-matrix-status kraken-matrix-status--warn",
        DeploymentStatus.Failed                => "kraken-matrix-status kraken-matrix-status--err",
        DeploymentStatus.Cancelled             => "kraken-matrix-status kraken-matrix-status--cancelled",
        DeploymentStatus.Running               => "kraken-matrix-status kraken-matrix-status--running",
        _                                       => "kraken-matrix-status kraken-matrix-status--pending",
    };
}
