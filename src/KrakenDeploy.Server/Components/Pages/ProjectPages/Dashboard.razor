@page "/s/{SpaceSlug}/projects/{Slug}/dashboard"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]

@using KrakenDeploy.Server.Core.Domain.Deployments
@inject ProjectService ProjectSvc
@inject DeploymentService DeploymentSvc
@inject DashboardService DashboardSvc
@inject DialogService Dialog
@inject NotificationService Notifications
@inject NavigationManager Nav

<ProjectShell Slug="@Slug">
    @if (!_loaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            Loading deployments...
        </RadzenText>
    }
    else if (_loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
            Failed to load dashboard: @_loadError
        </RadzenAlert>
    }
    else if (_project is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Project '@Slug' was not found.
        </RadzenAlert>
    }
    else if (_releaseMatrix is null || _releaseMatrix.Environments.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            No environments are defined in this Space. Define environments first
            so deployments have somewhere to go.
        </RadzenAlert>
    }
    else
    {
        @* ── Release / environment matrix ── *@
        <div class="toolbar">
            <div class="section-title" style="margin: 0; align-self: center;">
                Release / environment matrix
            </div>
            <div style="margin-left: auto; display: flex; gap: 10px; align-items: center;">
                <div class="search" style="min-width: 200px;">
                    <RadzenIcon Icon="search" />
                    <input placeholder="Find release…" value="@_releaseSearch"
                           @oninput="@(e => _releaseSearch = e.Value?.ToString() ?? string.Empty)" />
                </div>
                <RequirePermission Permission="Permission.ReleaseCreate">
                    <RadzenButton Text="Create release" Icon="rocket_launch"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="OpenCreateAsync" />
                </RequirePermission>
            </div>
        </div>

        @if (FilteredReleases.Count == 0)
        {
            <div class="kr-card kr-card-pad kr-empty">
                @(_releaseMatrix.Releases.Count == 0
                    ? "No releases yet. Create a release to start deploying."
                    : "No releases match the search.")
            </div>
        }
        else
        {
            <div class="kraken-matrix-wrap">
                <table class="kraken-matrix">
                    <thead>
                        <tr>
                            <th class="kraken-matrix-th-tenant">Release</th>
                            @for (var i = 0; i < _releaseMatrix.Environments.Count; i++)
                            {
                                var env = _releaseMatrix.Environments[i];
                                <th>
                                    <span class="kraken-matrix-envhead @($"env-c{i % 6}")">
                                        <span class="dot"></span>@env.Name
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rel in FilteredReleases)
                        {
                            <tr>
                                <td class="kraken-matrix-tenant-cell">
                                    <a class="kraken-matrix-rel kraken-matrix-rel-link"
                                       href="@Sp($"/projects/{Slug}/releases/{rel.ReleaseId}")">
                                        <RadzenIcon Icon="sell" />
                                        <div>
                                            <div class="kraken-matrix-rel-version">
                                                @rel.Version
                                                @if (rel.ChannelName is { } ch)
                                                {
                                                    <span class="kraken-channel-pill">@ch</span>
                                                }
                                            </div>
                                            <div class="kraken-matrix-rel-meta">
                                                @rel.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd")
                                            </div>
                                        </div>
                                    </a>
                                </td>
                                @foreach (var env in _releaseMatrix.Environments)
                                {
                                    <td class="kraken-matrix-cell">
                                        @if (rel.Cells.TryGetValue(env.Id, out var cell))
                                        {
                                            <div class="kraken-matrix-cell-filled">
                                                <a class="kraken-matrix-celllink" href="@Sp($"/deployments/{cell.DeploymentId}")">
                                                    <span class="@DeploymentStatusVisuals.CssClass(cell.Status)">
                                                        <RadzenIcon Icon="@DeploymentStatusVisuals.Icon(cell.Status)"
                                                                    class="@(cell.Status == DeploymentStatus.Running ? "spin" : null)" />
                                                    </span>
                                                    <div>
                                                        <div class="kraken-matrix-cell-version">@rel.Version</div>
                                                        <div class="kraken-matrix-cell-time">
                                                            @(cell.Status == DeploymentStatus.Running
                                                                ? "deploying…"
                                                                : cell.When.ToLocalTime().ToString("dd MMM HH:mm"))
                                                        </div>
                                                    </div>
                                                </a>
                                                <RequirePermission Permission="Permission.DeploymentCreate">
                                                    <button type="button" class="kraken-matrix-deploy kraken-matrix-deploy-hover"
                                                            title="Deploy @rel.Version to @env.Name again"
                                                            @onclick="@(() => OpenDeployAsync(rel.ReleaseId, env.Id))">
                                                        <RadzenIcon Icon="rocket_launch" />
                                                    </button>
                                                </RequirePermission>
                                            </div>
                                        }
                                        else
                                        {
                                            <RequirePermission Permission="Permission.DeploymentCreate">
                                                <ChildContent>
                                                    <button type="button" class="kraken-matrix-deploy"
                                                            title="Deploy @rel.Version to @env.Name"
                                                            @onclick="@(() => OpenDeployAsync(rel.ReleaseId, env.Id))">
                                                        <RadzenIcon Icon="rocket_launch" />
                                                    </button>
                                                </ChildContent>
                                                <Fallback>
                                                    <span class="kraken-matrix-empty">—</span>
                                                </Fallback>
                                            </RequirePermission>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="kraken-matrix-hint">
                <RadzenIcon Icon="info" />
                Click a filled cell to open that deployment, or the
                <RadzenIcon Icon="rocket_launch" Style="font-size:14px;vertical-align:middle;" />
                in an empty cell to deploy that release there. Deployments must satisfy
                the lifecycle gate.
            </div>
        }

        @* ── Tenant / environment matrix (only when tenants are connected) ── *@
        @if (_tenantMatrix is not null && _tenantMatrix.Tenants.Count > 0)
        {
            <div class="section-title" style="margin-top: var(--section-gap);">
                Tenant / environment matrix
            </div>
            <div class="kraken-matrix-wrap">
                <table class="kraken-matrix">
                    <thead>
                        <tr>
                            <th class="kraken-matrix-th-tenant">Tenant</th>
                            @for (var i = 0; i < _tenantMatrix.Environments.Count; i++)
                            {
                                var env = _tenantMatrix.Environments[i];
                                <th>
                                    <span class="kraken-matrix-envhead @($"env-c{i % 6}")">
                                        <span class="dot"></span>@env.Name
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in _tenantMatrix.Tenants)
                        {
                            <tr>
                                <td class="kraken-matrix-tenant-cell">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center" Gap="0.6rem">
                                        <div class="kraken-tenant-avatar">
                                            @KrakenText.Initials(tenant.Name)
                                        </div>
                                        <span class="kraken-tenant-name">@tenant.Name</span>
                                    </RadzenStack>
                                </td>
                                @foreach (var env in _tenantMatrix.Environments)
                                {
                                    <td class="kraken-matrix-cell">
                                        @{
                                            _tenantMatrix.Cells.TryGetValue((tenant.Id, env.Id), out var cell);
                                        }
                                        @if (cell is null)
                                        {
                                            <span class="kraken-matrix-empty">—</span>
                                        }
                                        else
                                        {
                                            <div class="kraken-matrix-rel">
                                                <span class="@DeploymentStatusVisuals.CssClass(cell.Status)">
                                                    <RadzenIcon Icon="@DeploymentStatusVisuals.Icon(cell.Status)"
                                                                class="@(cell.Status == DeploymentStatus.Running ? "spin" : null)" />
                                                </span>
                                                <div>
                                                    <div class="kraken-matrix-cell-version">@cell.ReleaseVersion</div>
                                                    <div class="kraken-matrix-cell-time">
                                                        @cell.CreatedUtc.ToLocalTime().ToString("dd MMM HH:mm")@(cell.ChannelName is not null ? $" · {cell.ChannelName}" : null)
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="kraken-matrix-hint">
                <RadzenIcon Icon="people_outline" />
                No tenants connected — connect tenants from the
                <a class="primary-link" href="@Sp($"/projects/{Slug}/tenants")">Tenants</a>
                tab to get a per-tenant matrix.
            </div>
        }
    }
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Project? _project;
    private ReleaseMatrix? _releaseMatrix;
    private ProjectDashboardMatrix? _tenantMatrix;
    private string _releaseSearch = string.Empty;
    private bool _loaded;
    private string? _loadError;

    private List<ReleaseMatrixRow> FilteredReleases =>
        string.IsNullOrWhiteSpace(_releaseSearch)
            ? _releaseMatrix?.Releases.ToList() ?? []
            : (_releaseMatrix?.Releases ?? [])
                .Where(r => r.Version.Contains(_releaseSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnParametersSetAsync()
    {
        // Load Project via Slug rather than relying on cascading from
        // ProjectShell — the cascade can't always cross the rendermode
        // boundary (ProjectShell is SSR, Dashboard is InteractiveServer).
        try
        {
            _project = await ProjectSvc.GetBySlugAsync(Slug);
            if (_project is null)
            {
                _loaded = true;
                return;
            }

            _releaseMatrix = await DashboardSvc.GetReleaseMatrixAsync(_project.Id);
            _tenantMatrix = await DeploymentSvc.GetProjectMatrixAsync(_project.Id);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task OpenCreateAsync()
    {
        if (_project is null) return;
        var result = await Dialog.OpenAsync<CreateReleaseDialog>(
            "Create release",
            new Dictionary<string, object?>
            {
                [nameof(CreateReleaseDialog.ProjectId)] = _project.Id,
            },
            new DialogOptions { Width = "560px" });

        if (result is true)
        {
            await OnParametersSetAsync();
            Notifications.Notify(NotificationSeverity.Success, "Created", "Release was created.", 3000);
        }
    }

    private async Task OpenDeployAsync(Guid releaseId, Guid environmentId)
    {
        var result = await Dialog.OpenAsync<DeployReleaseDialog>(
            "Deploy release",
            new Dictionary<string, object?>
            {
                [nameof(DeployReleaseDialog.ReleaseId)] = releaseId,
                [nameof(DeployReleaseDialog.PresetEnvironmentId)] = environmentId,
            },
            DeployReleaseDialog.BuildOptions());

        // Dialog navigates to the new deployment on success; refresh if we stay.
        if (result is true)
        {
            await OnParametersSetAsync();
        }
    }
}
