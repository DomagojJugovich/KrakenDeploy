@page "/s/{SpaceSlug}/projects/{Slug}/runbook-triggers"
@inherits SpaceScopedComponentBase
@attribute [Authorize]

<ProjectShell Slug="@Slug">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-3">
        Runbook Triggers
    </RadzenText>
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
        Scheduled runbook executions — pending.
    </RadzenAlert>
</ProjectShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
}
