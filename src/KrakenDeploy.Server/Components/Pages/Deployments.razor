@page "/deployments"
@attribute [Authorize]
@using KrakenDeploy.Server.Core.Domain.Deployments
@using KrakenDeploy.Server.Data.Services
@inject DeploymentService DeploymentSvc
@inject NavigationManager Nav

<PageTitle>Deployments - KrakenDeploy</PageTitle>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-mb-4">Deployments</RadzenText>

<RadzenDataGrid Data="@_deployments" TItem="Deployment"
                AllowPaging="true" PageSize="25"
                AllowSorting="true"
                AllowColumnResize="true"
                RowClick="@(args => { if (args.Data is { } d) Nav.NavigateTo($"/deployments/{d.Id}"); })"
                EmptyText="No deployments yet.">
    <Columns>
        <RadzenDataGridColumn TItem="Deployment" Property="Status" Title="Status" Width="120px">
            <Template Context="d">
                <RadzenBadge Text="@d.Status.ToString()" BadgeStyle="@StatusStyle(d.Status)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Deployment" Title="Project / Release" Width="240px">
            <Template Context="d">
                @(d.Release?.Project?.Name ?? "—") / @(d.Release?.Version ?? "—")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Deployment" Title="Environment" Width="160px">
            <Template Context="d">@(d.Environment?.Name ?? "—")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Deployment" Title="Target" Width="160px">
            <Template Context="d">@(d.Target?.Name ?? "—")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Deployment" Property="StartedUtc" Title="Started"
                              Width="160px" FormatString="{0:yyyy-MM-dd HH:mm}" />
        <RadzenDataGridColumn TItem="Deployment" Property="CompletedUtc" Title="Completed"
                              Width="160px" FormatString="{0:yyyy-MM-dd HH:mm}" />
    </Columns>
</RadzenDataGrid>

@code {
    private List<Deployment> _deployments = [];

    protected override async Task OnInitializedAsync()
        => _deployments = await DeploymentSvc.GetAllAsync();

    private static BadgeStyle StatusStyle(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Succeeded             => BadgeStyle.Success,
        DeploymentStatus.SucceededWithWarnings => BadgeStyle.Warning,
        DeploymentStatus.Failed                => BadgeStyle.Danger,
        DeploymentStatus.Running               => BadgeStyle.Info,
        DeploymentStatus.Queued                => BadgeStyle.Warning,
        DeploymentStatus.PendingOfflineResult  => BadgeStyle.Warning,
        _                                      => BadgeStyle.Light,
    };
}
