@page "/s/{SpaceSlug}/deployments"
@inherits SpaceScopedComponentBase
@rendermode InteractiveServer
@attribute [Authorize]
@inject DeploymentService DeploymentSvc
@inject EnvironmentService EnvironmentSvc
@inject NavigationManager Nav
@inject UiActionGuard Guard
@inject DialogService Dialog
@inject NotificationService Notify
@inject IAuditLog Audit
@inject MaintenanceModeService MaintenanceSvc
@inject InterruptionService Interruptions
@* F6 — the page-level target-exclusion probe for Queued rows. *@
@inject KrakenDeploy.Server.Services.ServerTasksService TasksSvc
@inject ISpaceContext SpaceCtx

<PageTitle>Deployments - KrakenDeploy</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Deployments</h1>
        <p class="page-sub">@_filtered.Count of @_all.Count deployments</p>
    </div>
</div>

<div class="toolbar">
    <div class="search">
        <RadzenIcon Icon="search" />
        <input placeholder="Search project, release, target…" value="@_search"
               @oninput="@(e => { _search = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
    </div>

    @if (_envs.Count > 0)
    {
        <div class="seg">
            <button class="@(_envFilter is null ? "on" : "")" @onclick="@(() => SetEnv(null))">All envs</button>
            @for (var i = 0; i < _envs.Count; i++)
            {
                var e = _envs[i];
                <button class="@($"env-c{i % 6} {(_envFilter == e.Id ? "on" : "")}")" @onclick="@(() => SetEnv(e.Id))">
                    <span class="dot"></span>@e.Name
                </button>
            }
        </div>
    }

    <div class="seg">
        @foreach (var opt in _statusFilters)
        {
            <button class="@(_statusFilter == opt.Value ? "on" : "")" @onclick="@(() => SetStatus(opt.Value))">@opt.Label</button>
        }
    </div>
</div>

<KrakenGrid SettingsKey="deployments" @ref="_grid" Data="@_filtered" TItem="Deployment"
                AllowPaging="true" PageSize="25" AllowSorting="true" AllowColumnResize="true"
                RowClick="@(args => { if (args.Data is { } d) Nav.NavigateTo(Sp($"/deployments/{d.Id}")); })"
                GridLines="DataGridGridLines.Horizontal"
                EmptyText="No deployments match the current filters.">
    <Columns>
        <RadzenDataGridColumn TItem="Deployment" Property="Status" Title="Status" Width="160px">
            <Template Context="d">
                <StatusPill Deployment="d.Status" />
                @* WP3 — an unanswered approval gate. Gated on InterruptionView (the
                   service returns an empty set without it), so the chip only appears
                   for users who may actually look at interventions. *@
                @if (_awaitingApproval.Contains(d.Id))
                {
                    <div style="margin-top:3px;">
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat"
                                     Text="Approval pending" />
                    </div>
                }
                @if (QueueWaitReason(d) is { } reason)
                {
                    <div class="cell-muted" style="font-size:11px; line-height:1.3; margin-top:3px;">@reason</div>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" UniqueID="project-release" Title="Project / Release" Width="260px" Sortable="false">
            <Template Context="d">
                <span class="cell-strong">@(d.Release?.Project?.Name ?? "—")</span>
                @if (d.Release?.Version is { Length: > 0 } v)
                {
                    <span class="mono cell-muted">&nbsp;@v</span>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" UniqueID="environment" Title="Environment" Width="160px" Sortable="false">
            <Template Context="d">
                <span class="env-cell @EnvColor(d.EnvironmentId)">
                    <span class="dot"></span>@(d.Environment?.Name ?? "—")
                </span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" UniqueID="target" Title="Target" Width="160px" Sortable="false">
            <Template Context="d">@TargetLabel(d)</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" Property="StartedUtc" Title="Started" Width="160px">
            <Template Context="d">
                <span class="mono cell-muted">@(d.StartedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" UniqueID="duration" Title="Duration" Width="110px" Sortable="false">
            <Template Context="d"><span class="mono cell-muted">@Duration(d)</span></Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" Property="CreatedByDisplay" Title="Initiated by" Width="150px">
            <Template Context="d">
                <span title="@(d.Cause.ToString() + (string.IsNullOrEmpty(d.CauseDetail) ? "" : " (" + d.CauseDetail + ")"))">@d.CreatedByDisplay</span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" UniqueID="actions" Title="" Width="52px" Sortable="false" TextAlign="TextAlign.Center">
            <Template Context="d">
                @* WP3 — Paused is non-terminal and HOLDS the (project, environment,
                   tenant) slot for up to the approval timeout, so an operator with
                   TaskCancel must be able to release it. ServerTaskCanceller already
                   accepted it; only the UI gate was missing. *@
                @if (d.Status is DeploymentStatus.Queued or DeploymentStatus.Running
                              or DeploymentStatus.Paused)
                {
                    @* stopPropagation: the row's RowClick navigates to detail — the
                       button must not also trigger it (VariableSets.razor pattern). *@
                    <RequirePermission Permission="Permission.TaskCancel">
                        <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Variant="Variant.Text"
                                      Click="@(async () => await CancelDeploymentAsync(d))"
                                      @onclick:stopPropagation="true"
                                      title="Cancel deployment" />
                    </RequirePermission>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Deployment" UniqueID="open" Title="" Width="48px" Sortable="false" TextAlign="TextAlign.Center">
            <Template Context="d"><RadzenIcon Icon="chevron_right" Style="color: var(--text-3);" /></Template>
        </RadzenDataGridColumn>
    </Columns>
</KrakenGrid>

@code {
    private RadzenDataGrid<Deployment>? _grid;
    private List<Deployment> _all = [];
    private List<Deployment> _filtered = [];
    private List<DeploymentEnvironment> _envs = [];
    private Dictionary<Guid, int> _envColor = [];

    private string _search = string.Empty;
    private Guid? _envFilter;
    private DeploymentStatus? _statusFilter;

    private readonly (string Label, DeploymentStatus? Value)[] _statusFilters =
    [
        ("All", null),
        ("Running", DeploymentStatus.Running),
        ("Failed", DeploymentStatus.Failed),
        ("Succeeded", DeploymentStatus.Succeeded),
        ("Queued", DeploymentStatus.Queued),
        ("Awaiting approval", DeploymentStatus.Paused),
    ];

    // Non-null while instance-wide maintenance is on: the claim gate refuses EVERY
    // task, so it outranks the per-key serialization rule as the queue-wait reason.
    private MaintenanceState? _maintenanceHold;

    // WP3 — task ids with an unanswered manual-intervention gate. One query for the
    // whole page rather than a per-row probe; empty when the user lacks
    // InterruptionView.
    private HashSet<Guid> _awaitingApproval = [];

    // Why each Queued row has not started, resolved once at load by the shared
    // ServerTasksService resolver (the same one both detail pages use). The row
    // renders the short form; the detail page names the blocking machine and queue
    // position.
    private Dictionary<Guid, ServerTasksService.QueueWaitResolution> _queueWaits = [];

    protected override async Task OnInitializedAsync()
    {
        _all = await DeploymentSvc.GetAllAsync();
        var maintenance = await MaintenanceSvc.GetStateAsync();
        _maintenanceHold = maintenance.Enabled ? maintenance : null;
        // Include archived: historical deployments to a since-retired
        // environment must still filter and colour-map correctly.
        _envs = await EnvironmentSvc.GetAllOrderedAsync(includeArchived: true);
        _envColor = _envs.Select((e, i) => (e.Id, i)).ToDictionary(x => x.Id, x => x.i);

        // Only Paused rows can carry a pending gate, so scope the probe to them.
        var pausedIds = _all
            .Where(d => d.Status == DeploymentStatus.Paused)
            .Select(d => d.Id)
            .ToList();
        _awaitingApproval = await Interruptions.FindTasksAwaitingResponseAsync(
            pausedIds, SpaceCtx.CurrentSpaceId, await Guard.CurrentCallerAsync());

        // Same treatment for the queue reasons: resolve the Queued rows once here
        // so a backlog explains itself on the list, not only on each row's detail
        // page — and so the grid template stays a dictionary lookup. Skipped
        // entirely while maintenance is on (that gate refuses every claim, so it is
        // the binding reason for every row). The candidate carries the fields the
        // resolver needs, which this page already holds on its loaded rows.
        if (_maintenanceHold is null)
        {
            var queued = _all
                .Where(d => d.Status == DeploymentStatus.Queued)
                .Select(d => new ServerTasksService.QueueWaitCandidate(
                    d.Id,
                    KrakenDeploy.Server.Core.Domain.Deployments.ServerTaskKind.Deployment,
                    d.ProjectId, d.EnvironmentId, d.TenantId, d.CreatedUtc))
                .ToList();
            _queueWaits = await TasksSvc.ResolveQueueWaitsAsync(queued, withBlockerDetail: false);
        }

        ApplyFilters();
    }

    private void SetEnv(Guid? id) { _envFilter = id; ApplyFilters(); }
    private void SetStatus(DeploymentStatus? s) { _statusFilter = s; ApplyFilters(); }

    private async Task CancelDeploymentAsync(Deployment d)
    {
        // Server-authoritative re-check — the row button's visibility is cosmetic.
        if (!await Guard.AllowAsync(Permission.TaskCancel)) return;

        var running = d.Status == DeploymentStatus.Running;
        // WP3-b — Paused needs its own wording. The button's visibility gate gained Paused
        // but this ternary did not, so cancelling a PART-DEPLOYED release parked at an
        // approval gate asked "before it starts?" and then reported "the queued deployment
        // was cancelled" — for a task whose earlier waves had already run against
        // production targets.
        var paused = d.Status == DeploymentStatus.Paused;
        var confirmed = await Dialog.Confirm(
            running
                ? "Cancel this running deployment? The abort is pushed to the agent, which " +
                  "stops the running step; no further steps will start."
                : paused
                    ? "Cancel this deployment? It is waiting for a manual-intervention " +
                      "approval, and earlier steps may already have run against its " +
                      "targets. Cancelling also closes the unanswered approval and frees " +
                      "the project + environment for other deployments."
                    : "Cancel this queued deployment before it starts?",
            "Cancel deployment",
            new ConfirmOptions { OkButtonText = "Cancel deployment", CancelButtonText = "Keep running" });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            // The service records the semantic Deployment.Cancelled audit itself.
            var updated = await DeploymentSvc.CancelAsync(d.Id, await Guard.CurrentCallerAsync());
            if (updated is not null)
            {
                // Reflect the new terminal status in the loaded row + re-filter.
                var row = _all.FirstOrDefault(x => x.Id == d.Id);
                if (row is not null)
                {
                    row.Status       = updated.Status;
                    row.CompletedUtc = updated.CompletedUtc;
                }
                // The cancel closed any unanswered gate (ServerTaskCanceller), so drop the
                // "Approval pending" chip too — otherwise the row rendered Cancelled AND
                // advertised an outstanding approval until a full page reload.
                _awaitingApproval.Remove(d.Id);
                ApplyFilters();
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary  = "Cancelled",
                    Detail   = running
                        ? "The abort was pushed to the agent."
                        : paused
                            ? "The deployment was cancelled and its unanswered approval closed."
                            : "The queued deployment was cancelled.",
                    Duration = 4000,
                });
            }
        }
        catch (AuthorizationException)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Not allowed",
                Detail   = "You don't have permission to cancel this deployment.",
                Duration = 5000,
            });
        }
        catch (InvalidOperationException ex)
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary  = "Could not cancel",
                Detail   = ex.Message,
                Duration = 5000,
            });
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<Deployment> q = _all;

        if (_envFilter is { } envId)
        {
            q = q.Where(d => d.EnvironmentId == envId);
        }

        if (_statusFilter is { } st)
        {
            q = st == DeploymentStatus.Succeeded
                ? q.Where(d => d.Status is DeploymentStatus.Succeeded or DeploymentStatus.SucceededWithWarnings)
                : q.Where(d => d.Status == st);
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(d =>
                (d.Release?.Project?.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (d.Release?.Version?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || d.TargetNames().Any(n => n.Contains(s, StringComparison.OrdinalIgnoreCase))
                || (d.Environment?.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _filtered = q.ToList();
        _grid?.Reload();
    }

    // The queue-wait reason for a Queued deployment. Maintenance mode wins: while
    // the claim gate is closed no task can start, so reporting "another deployment
    // is running" would name the wrong constraint. Every other reason comes from
    // the shared resolver (ServerTasksService.ResolveQueueWaitsAsync), resolved
    // once at load — this method is a lookup, not a scan.
    private string? QueueWaitReason(Deployment d)
    {
        if (d.Status != DeploymentStatus.Queued)
        {
            return null;
        }
        if (_maintenanceHold is { } hold)
        {
            return QueueWaitMessage.MaintenanceHold(hold.Reason);
        }
        // Everything else was resolved ONCE at load by the shared resolver, which
        // applies the claim's own order (F1 in-flight → F1 earlier-queued → F6
        // target) using the claim's own predicates — so a row and its detail page
        // can never name different constraints, and this template stays a
        // dictionary lookup rather than re-scanning every loaded row per render.
        return _queueWaits.TryGetValue(d.Id, out var reason)
            ? reason.Block switch
            {
                QueueWaitBlock.InFlightPeer =>
                    QueueWaitMessage.RunningPeer(d.Release?.Project?.Name, d.Environment?.Name),
                QueueWaitBlock.EarlierQueuedPeer =>
                    QueueWaitMessage.QueuedPeer(d.Release?.Project?.Name, d.Environment?.Name),
                QueueWaitBlock.TargetBlocked => QueueWaitMessage.TargetWaitShort(),
                _ => null,
            }
            : null;
    }

    private string EnvColor(Guid envId)
        => _envColor.TryGetValue(envId, out var i) ? $"env-c{i % 6}" : "env-c0";

    private static string TargetLabel(Deployment d) => d.TargetLabel();

    private static string Duration(Deployment d)
    {
        if (d.StartedUtc is not { } start)
        {
            return "—";
        }

        var end = d.CompletedUtc
            ?? (d.Status == DeploymentStatus.Running ? DateTimeOffset.UtcNow : (DateTimeOffset?)null);
        return end is { } e ? TaskFormatting.Duration(e - start) : "—";
    }
}
