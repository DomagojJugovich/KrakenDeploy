@implements IDisposable
@using KrakenDeploy.Server.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject ThemeService ThemeSvc
@inject UserService UserSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

@* Two-button segmented light/dark toggle (same control as the login page),
   driving Radzen's ThemeService so the stylesheet swap + per-user persistence
   keep working exactly as with RadzenAppearanceToggle. *@
<div class="kraken-theme-toggle" role="group" aria-label="Theme">
    <button type="button" class="@(IsDark ? null : "on")" title="Light"
            @onclick="@(() => SetTheme("material"))">
        <RadzenIcon Icon="light_mode" />
    </button>
    <button type="button" class="@(IsDark ? "on" : null)" title="Dark"
            @onclick="@(() => SetTheme("material-dark"))">
        <RadzenIcon Icon="dark_mode" />
    </button>
</div>

@code {
    private Guid? _userId;
    private string? _lastSavedTheme;

    private bool IsDark =>
        ThemeSvc.Theme?.Contains("dark", StringComparison.OrdinalIgnoreCase) == true;

    private void SetTheme(string theme)
    {
        if (ThemeSvc.Theme != theme)
        {
            ThemeSvc.SetTheme(theme, triggerChange: true);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ThemeSvc.ThemeChanged += OnThemeChanged;

        var state = await AuthState.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (claim is null || !Guid.TryParse(claim, out var id))
        {
            return;
        }
        _userId = id;

        var user = await UserSvc.GetAsync(id);
        if (!string.IsNullOrEmpty(user?.Theme) && user.Theme != ThemeSvc.Theme)
        {
            _lastSavedTheme = user.Theme;
            ThemeSvc.SetTheme(user.Theme, triggerChange: true);
        }
        else
        {
            _lastSavedTheme = ThemeSvc.Theme;
        }
    }

    private async void OnThemeChanged()
    {
        var current = ThemeSvc.Theme;

        // Re-render so the segmented control's active marking follows the theme.
        await InvokeAsync(StateHasChanged);

        if (current == _lastSavedTheme)
        {
            return;
        }
        _lastSavedTheme = current;

        try
        {
            // Mirror to localStorage so the (static SSR) login page wakes up in
            // the same theme the user last used in the app.
            await JS.InvokeVoidAsync("localStorage.setItem", "kraken-theme", current);
        }
        catch
        {
            // JS interop unavailable (prerender) — harmless.
        }

        if (_userId is not { } id)
        {
            return;
        }
        try
        {
            await UserSvc.UpdateThemeAsync(id, current);
        }
        catch
        {
            // Persistence failure shouldn't break the UI.
        }
    }

    public void Dispose() => ThemeSvc.ThemeChanged -= OnThemeChanged;
}
