@using KrakenDeploy.Server.Data.Services
@using Radzen

@*
    Isolates the RadzenPivotDataGrid from the rest of the dashboard. The pivot's
    declarative field set is re-imposed on every render of its parent, which
    would clobber the user's live field-picker changes (e.g. switching a value
    to "Last" reverts to "Count" the next time Home re-renders for an unrelated
    reason like opening the drill dialog). ShouldRender() therefore re-renders
    ONLY when RenderToken changes — i.e. when the parent deliberately rebuilds
    the pivot (new facts / applied view), never for incidental re-renders.
*@

<RadzenPivotDataGrid @ref="_pivot" @key="@RenderToken" TItem="DeploymentFact" Data="@Facts"
                     AllowDrillDown="true" AllowFieldsPicking="true"
                     AllowSorting="true" AllowFiltering="true"
                     ShowRowsTotals="true" ShowColumnsTotals="true"
                     GridLines="DataGridGridLines.Horizontal">
    <Columns>
        @foreach (var c in Layout.Columns)
        {
            <RadzenPivotColumn TItem="DeploymentFact" Property="@c" Title="@PivotFields.Title(c)" />
        }
    </Columns>
    <Rows>
        @foreach (var r in Layout.Rows)
        {
            <RadzenPivotRow TItem="DeploymentFact" Property="@r" Title="@PivotFields.Title(r)" />
        }
    </Rows>
    <Aggregates>
        @foreach (var v in Layout.Values)
        {
            @if (v.Property == PivotFields.CountProperty)
            {
                <RadzenPivotAggregate TItem="DeploymentFact" Property="@v.Property"
                                      Title="Deployments" Aggregate="AggregateFunction.Count">
                    <RowTotalTemplate Context="cell">
                        <a class="primary-link" @onclick="@(() => OnDrill.InvokeAsync(cell.View))"
                           @onclick:stopPropagation="true">@cell.Value</a>
                    </RowTotalTemplate>
                </RadzenPivotAggregate>
            }
            else
            {
                <RadzenPivotAggregate TItem="DeploymentFact" Property="@v.Property"
                                      Title="@PivotFields.MeasureTitle(v)" Aggregate="@v.Function"
                                      FormatString="@PivotFields.MeasureFormat(v)" />
            }
        }
        @* Remaining fields, pre-declared (unselected) so the picker pool is
           complete and every pickable field already exists in
           allPivotAggregates — picking one then routes through Radzen's normal
           path instead of the fallback that recreates it with a default
           function (the "chip says Last, cells show Count" desync). *@
        @foreach (var f in PivotFields.Spare(Layout))
        {
            <RadzenPivotAggregate TItem="DeploymentFact" Property="@f" Title="@PivotFields.Title(f)"
                                  Selected="false" Aggregate="AggregateFunction.Count" />
        }
    </Aggregates>
</RadzenPivotDataGrid>

@code {
    [Parameter] public IReadOnlyList<DeploymentFact> Facts { get; set; } = [];
    [Parameter] public PivotLayout Layout { get; set; } = PivotFields.Default();

    /// <summary>Changes only when the parent deliberately rebuilds the pivot
    /// (range change / applied view). Drives both the @key remount and the
    /// render gate.</summary>
    [Parameter] public string RenderToken { get; set; } = "";

    /// <summary>Invoked with the underlying rows when a Count cell total is clicked.</summary>
    [Parameter] public EventCallback<IQueryable<DeploymentFact>> OnDrill { get; set; }

    private RadzenPivotDataGrid<DeploymentFact>? _pivot;
    private string? _rendered;

    protected override bool ShouldRender() => _rendered != RenderToken;

    protected override void OnAfterRender(bool firstRender) => _rendered = RenderToken;

    /// <summary>Reads the live picker arrangement back into a serializable
    /// layout (for "Save view"). RowsCollection/ColumnsCollection/
    /// AggregatesCollection reflect the field picker's current state.</summary>
    public PivotLayout ReadLiveLayout()
    {
        if (_pivot is null)
        {
            return Layout;
        }

        return new PivotLayout(
            Rows: _pivot.RowsCollection.Select(r => r.Property).Where(p => p is not null).Cast<string>().ToList(),
            Columns: _pivot.ColumnsCollection.Select(c => c.Property).Where(p => p is not null).Cast<string>().ToList(),
            Values: _pivot.AggregatesCollection
                .Where(a => a.Property is not null)
                .Select(a => new PivotMeasure(a.Property!, a.Aggregate))
                .ToList());
    }
}
