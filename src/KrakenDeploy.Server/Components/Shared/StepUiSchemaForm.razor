@using KrakenDeploy.Contracts.Steps
@using KrakenDeploy.Server.Core.Domain.Security
@using KrakenDeploy.Server.Core.Domain.Spaces
@using KrakenDeploy.Server.Data.Services

@* WP3 — the responsible-teams multiselect is the first widget in this form backed by
   server data, so this is the first service dependency here. Kept to one narrowly
   scoped case: no other widget's behaviour changes, and no general options-provider
   mechanism is introduced (that is a design call for whoever implements the remaining
   declared-but-unimplemented pickers). *@
@inject TeamService Teams
@inject ISpaceContext SpaceCtx

@*
    Pure-body schema renderer. Renders a StepUiSchema's groups + fields as a
    series of RadzenCards / inputs and raises ValuesChanged whenever any field
    edits. No dialog chrome (no title, no Cancel/Save buttons) — the caller
    composes that around it.

    Used by StepFormDialog (common Step fields + this form + dialog chrome).
    Centralising the rendering logic here keeps the consumer DRY and lets
    future surfaces — e.g. an inline "edit step" panel — reuse the same Razor.
*@

@{
    var ungrouped = Schema.Properties.Where(p => string.IsNullOrEmpty(p.Value.Group)).ToList();
}
<RadzenStack Gap="0.75rem">
    @if (ungrouped.Count > 0)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">General</RadzenText>
            <RadzenStack Gap="0.75rem">
                @foreach (var (key, field) in ungrouped)
                {
                    @if (IsVisible(field))
                    {
                        @RenderField(key, field)
                    }
                }
            </RadzenStack>
        </RadzenCard>
    }

    @foreach (var group in Schema.Groups)
    {
        var groupFields = Schema.Properties.Where(p => p.Value.Group == group.Id).ToList();
        if (groupFields.Count == 0) { continue; }
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Subtitle1">@group.Title</RadzenText>
                <RadzenButton Icon="@(IsCollapsed(group.Id) ? "expand_more" : "expand_less")"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => ToggleGroup(group.Id))" />
            </RadzenStack>
            @if (!string.IsNullOrEmpty(group.Description))
            {
                <RadzenText TextStyle="TextStyle.Caption"
                            class="rz-color-secondary rz-mb-2">
                    @group.Description
                </RadzenText>
            }
            @if (!IsCollapsed(group.Id))
            {
                <RadzenStack Gap="0.75rem">
                    @foreach (var (key, field) in groupFields)
                    {
                        @if (IsVisible(field))
                        {
                            @RenderField(key, field)
                        }
                    }
                </RadzenStack>
            }
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired] public StepUiSchema Schema { get; set; } = default!;

    /// <summary>
    /// The current form values. Mutated in place when the user edits a field;
    /// callers receive a callback via <see cref="ValuesChanged"/>.
    /// </summary>
    [Parameter, EditorRequired] public Dictionary<string, string> Values { get; set; } = default!;

    /// <summary>
    /// Raised whenever a field value changes. Carries the same dictionary
    /// reference held by <see cref="Values"/> — callers can re-render off
    /// it without copying.
    /// </summary>
    [Parameter] public EventCallback<Dictionary<string, string>> ValuesChanged { get; set; }

    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        // Honour the schema's "collapsed by default" hint on initial render.
        foreach (var g in Schema.Groups)
        {
            if (g.Collapsed) { _collapsedGroups.Add(g.Id); }
        }
    }

    private bool IsCollapsed(string groupId) => _collapsedGroups.Contains(groupId);

    private void ToggleGroup(string groupId)
    {
        if (!_collapsedGroups.Remove(groupId)) { _collapsedGroups.Add(groupId); }
    }

    /// <summary>
    /// Evaluates a field's <see cref="StepUiField.VisibleWhen"/> predicate
    /// against the current form values. <c>null</c> visibleWhen means
    /// "always visible".
    /// </summary>
    private bool IsVisible(StepUiField field)
    {
        if (field.VisibleWhen is null) { return true; }
        var v = field.VisibleWhen;
        Values.TryGetValue(v.Field, out var current);
        current ??= string.Empty;

        return v.Operator switch
        {
            "equals"     => string.Equals(current, v.Value, StringComparison.Ordinal),
            "not-equals" => !string.Equals(current, v.Value, StringComparison.Ordinal),
            "truthy"     => !string.IsNullOrEmpty(current)
                            && !current.Equals("false", StringComparison.OrdinalIgnoreCase)
                            && !current.Equals("0", StringComparison.Ordinal),
            "falsy"      => string.IsNullOrEmpty(current)
                            || current.Equals("false", StringComparison.OrdinalIgnoreCase)
                            || current.Equals("0", StringComparison.Ordinal),
            "in"         => SplitValues(v.Value).Contains(current, StringComparer.Ordinal),
            "not-in"     => !SplitValues(v.Value).Contains(current, StringComparer.Ordinal),
            _            => true,
        };
    }

    private static IEnumerable<string> SplitValues(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) { yield break; }
        foreach (var part in raw.Split(';',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            yield return part;
        }
    }

    private RenderFragment RenderField(string key, StepUiField field) => builder =>
    {
        var label = field.Label ?? key;
        builder.OpenComponent<RadzenFormField>(0);
        builder.AddAttribute(1, "Text", label);
        builder.AddAttribute(2, "Variant", Variant.Outlined);
        builder.AddAttribute(3, "Style", "width:100%");
        builder.AddAttribute(4, "ChildContent",
            (RenderFragment)(formInner => RenderWidget(formInner, key, field)));
        builder.CloseComponent();

        if (!string.IsNullOrEmpty(field.HelpText))
        {
            builder.OpenComponent<RadzenText>(10);
            builder.AddAttribute(11, "TextStyle", TextStyle.Caption);
            builder.AddAttribute(12, "class", "rz-color-secondary");
            builder.AddAttribute(13, "ChildContent",
                (RenderFragment)(t => t.AddContent(0, field.HelpText)));
            builder.CloseComponent();
        }
    };

    private void RenderWidget(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        string key,
        StepUiField field)
    {
        var widget = field.Widget;
        var value  = Values.GetValueOrDefault(key, string.Empty);

        switch (widget)
        {
            case StepUiWidgets.Textarea:
            case StepUiWidgets.JsonEditor:
                builder.OpenComponent<RadzenTextArea>(0);
                builder.AddAttribute(1, "Value", value);
                builder.AddAttribute(2, "Rows", widget == StepUiWidgets.JsonEditor ? 8 : 4);
                builder.AddAttribute(3, "Style",
                    widget == StepUiWidgets.JsonEditor
                        ? "width:100%; font-family: var(--rz-mono-font, monospace);"
                        : "width:100%;");
                builder.AddAttribute(4, "Placeholder", field.Placeholder);
                builder.AddAttribute(5, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<string>(
                        this, async v => await SetValueAsync(key, v ?? string.Empty)));
                builder.CloseComponent();
                break;

            case StepUiWidgets.Sensitive:
                builder.OpenComponent<RadzenPassword>(0);
                builder.AddAttribute(1, "Value", value);
                builder.AddAttribute(2, "Style", "width:100%;");
                builder.AddAttribute(3, "Placeholder", field.Placeholder);
                builder.AddAttribute(4, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<string>(
                        this, async v => await SetValueAsync(key, v ?? string.Empty)));
                builder.CloseComponent();
                break;

            case StepUiWidgets.Select:
                builder.OpenComponent<RadzenDropDown<string>>(0);
                builder.AddAttribute(1, "Value", value);
                builder.AddAttribute(2, "Data", field.EnumValues);
                builder.AddAttribute(3, "TextProperty", nameof(StepUiEnumValue.Label));
                builder.AddAttribute(4, "ValueProperty", nameof(StepUiEnumValue.Value));
                builder.AddAttribute(5, "Style", "width:100%;");
                builder.AddAttribute(6, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<string>(
                        this, async v => await SetValueAsync(key, v ?? string.Empty)));
                builder.CloseComponent();
                break;

            case StepUiWidgets.ResponsibleTeams:
                // Multi-select over the Space's visible teams, serialised back to the
                // config as a comma-separated GUID list — the same shape the gate reads,
                // so an imported process keeps round-tripping. Replaces a free-text GUID
                // field where a typo was indistinguishable from "no restriction" until a
                // deployment actually reached the gate.
                builder.OpenComponent<RadzenDropDown<IEnumerable<Guid>>>(0);
                builder.AddAttribute(1, "Value", ParseTeamIds(value));
                builder.AddAttribute(2, "Data", _selectableTeams);
                builder.AddAttribute(3, "TextProperty", nameof(ApproverTeamOption.Name));
                builder.AddAttribute(4, "ValueProperty", nameof(ApproverTeamOption.Id));
                builder.AddAttribute(5, "Multiple", true);
                builder.AddAttribute(6, "Chips", true);
                builder.AddAttribute(7, "AllowClear", true);
                builder.AddAttribute(8, "Style", "width:100%;");
                builder.AddAttribute(9, "Placeholder",
                    "Anyone with the approve permission");
                builder.AddAttribute(10, "ValueChanged",
                    // `value` is captured as the PREVIOUS raw string so tokens the picker
                    // cannot represent are carried through — see UnrepresentableTokens.
                    Microsoft.AspNetCore.Components.EventCallback.Factory
                        .Create<IEnumerable<Guid>>(this, async ids =>
                            await SetValueAsync(key, FormatTeamIds(ids, value))));
                builder.CloseComponent();

                // Name what the picker is holding on to but cannot show. Without this the
                // operator sees a partially-filled control with no hint that the config
                // still carries an id nothing resolves — and the save refusal that follows
                // names teams they cannot see in the form.
                var stranded = UnrepresentableTokens(value);
                if (stranded.Count > 0)
                {
                    builder.OpenElement(11, "div");
                    builder.AddAttribute(12, "class", "rz-mt-2");
                    builder.OpenComponent<RadzenAlert>(13);
                    builder.AddAttribute(14, "AlertStyle", AlertStyle.Warning);
                    builder.AddAttribute(15, "Variant", Variant.Flat);
                    builder.AddAttribute(16, "Shade", Shade.Lighter);
                    builder.AddAttribute(17, "AllowClose", false);
                    builder.AddAttribute(18, "Size", AlertSize.Small);
                    builder.AddAttribute(19, "ChildContent",
                        (RenderFragment)(inner =>
                        {
                            inner.AddContent(0,
                                $"Kept but unusable: {string.Join(", ", stranded)}. " +
                                "These do not name a team visible in this Space — most " +
                                "likely Octopus ids from an import, or a deleted team. " +
                                "They are preserved on purpose: dropping them would turn " +
                                "\"only these teams\" into \"anyone with the approve " +
                                "permission\". Pick the real teams and remove them, or the " +
                                "step will not save.");
                        }));
                    builder.CloseComponent();
                    builder.CloseElement();
                }
                break;

            case StepUiWidgets.Checkbox:
                builder.OpenComponent<RadzenCheckBox<bool>>(0);
                builder.AddAttribute(1, "Value",
                    bool.TryParse(value, out var b) && b);
                builder.AddAttribute(2, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<bool>(
                        this, async v => await SetValueAsync(key, v ? "true" : "false")));
                builder.CloseComponent();
                break;

            case StepUiWidgets.NumberInput:
                builder.OpenComponent<RadzenNumeric<double>>(0);
                builder.AddAttribute(1, "Value",
                    double.TryParse(value, System.Globalization.NumberStyles.Float,
                        System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0.0);
                builder.AddAttribute(2, "Style", "width:100%;");
                builder.AddAttribute(3, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<double>(
                        this, async v => await SetValueAsync(key,
                            v.ToString(System.Globalization.CultureInfo.InvariantCulture))));
                builder.CloseComponent();
                break;

            // Richer widgets fall back to a plain text input in v1.
            case StepUiWidgets.Text:
            case StepUiWidgets.VariableRef:
            case StepUiWidgets.CertificateRef:
            case StepUiWidgets.PackageRef:
            case StepUiWidgets.TargetRoles:
            case StepUiWidgets.FilePicker:
            default:
                builder.OpenComponent<RadzenTextBox>(0);
                builder.AddAttribute(1, "Value", value);
                builder.AddAttribute(2, "Style", "width:100%;");
                builder.AddAttribute(3, "Placeholder", field.Placeholder);
                builder.AddAttribute(4, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<string>(
                        this, async v => await SetValueAsync(key, v ?? string.Empty)));
                builder.CloseComponent();
                break;
        }
    }

    /// <summary>
    /// Teams offerable as approvers: visible in the active Space, and NOT an "Everyone"
    /// team. Everyone is excluded at the source rather than merely rejected on save,
    /// because offering it would invite an operator to pick a "restriction" that
    /// restricts nobody — every authenticated user belongs to it.
    /// </summary>
    private List<ApproverTeamOption> _selectableTeams = [];

    private bool _teamsLoaded;

    /// <summary>
    /// Loads the team list in <c>OnParametersSetAsync</c>, not <c>OnInitializedAsync</c>
    /// (WP3-b). <c>StepFormDialog</c> assigns a new <c>Schema</c> in place on the same
    /// component instance when the step-package version changes, and the child has no
    /// <c>@key</c> — so it is never re-created and <c>OnInitializedAsync</c> never re-runs.
    /// A schema swap that introduced the widget therefore rendered a permanently EMPTY
    /// picker whose placeholder reads "Anyone with the approve permission", i.e. it
    /// displayed the unrestricted semantics over a value that was still restricting.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Only pay for the read when the rendered schema actually has the widget, and only
        // once — parameters are set on every render.
        if (_teamsLoaded
            || !Schema.Properties.Any(pr => pr.Value.Widget == StepUiWidgets.ResponsibleTeams))
        {
            return;
        }
        _teamsLoaded = true;
        // No ConfigureAwait(false) — component lifecycle must resume on the Dispatcher.
        // Projected (Id, Name) read — GetAllAsync pulls the whole RBAC graph (members,
        // external groups, role assignments and their scopes), which any process-editor
        // can trigger. Everyone-teams are excluded server-side.
        _selectableTeams = await Teams.GetSelectableApproverTeamsAsync(SpaceCtx.CurrentSpaceId);
    }

    /// <summary>Reads the stored CSV/semicolon list (the Octopus serialiser uses either
    /// separator), keeping only the tokens this picker can actually represent — a GUID
    /// naming a team in <see cref="_selectableTeams"/>. Everything else is preserved
    /// separately by <see cref="UnrepresentableTokens"/> rather than dropped.</summary>
    private IEnumerable<Guid> ParseTeamIds(string? raw)
        => ManualInterventionConfigKeys.ParseTeamTokens(raw)
            .Select(t => Guid.TryParse(t, out var id) ? id : (Guid?)null)
            .Where(id => id is not null && _selectableTeams.Any(t => t.Id == id.Value))
            .Select(id => id!.Value)
            .ToList();

    /// <summary>
    /// Tokens the dropdown cannot show: non-GUIDs (an Octopus import carries
    /// <c>"teams-123"</c>) and GUIDs that name no team visible in this Space — a deleted
    /// team, or one belonging to another Space.
    /// <para>
    /// These MUST survive an edit. Dropping them was a fail-OPEN bug: the picker can only
    /// write back what it holds, so any interaction with the control — even selecting a
    /// team and clearing it again — rewrote an unresolvable list to EMPTY, and empty means
    /// "anyone holding the approve permission". That silently WIDENED the approver set and
    /// defeated the save-time refusal, which is the one thing keeping an imported gate
    /// fail-closed. Preserving them keeps the save refused until an operator deals with
    /// them deliberately.
    /// </para>
    /// </summary>
    private List<string> UnrepresentableTokens(string? raw)
        => [.. ManualInterventionConfigKeys.ParseTeamTokens(raw)
            .Where(t => !Guid.TryParse(t, out var id)
                        || !_selectableTeams.Any(team => team.Id == id))];

    /// <summary>Re-serialises the picker's selection, re-appending anything it could not
    /// represent so an edit never widens the approver set.</summary>
    private string FormatTeamIds(IEnumerable<Guid>? ids, string? previousRaw)
    {
        var selected = ids?.Select(id => id.ToString()) ?? [];
        return string.Join(", ", selected.Concat(UnrepresentableTokens(previousRaw)));
    }

    private async Task SetValueAsync(string key, string value)
    {
        Values[key] = value;
        if (ValuesChanged.HasDelegate)
        {
            await ValuesChanged.InvokeAsync(Values);
        }
        StateHasChanged();
    }
}
