@using KrakenDeploy.Server.Spaces
@using KrakenDeploy.Server.Core.Domain.Common
@implements IDisposable
@inject HttpSpaceContext SpaceCtx
@inject IPermissionEvaluator Perms
@inject AuthenticationStateProvider AuthProvider
@inject PersistentComponentState Pcs

@*
    Carries the active Space across the prerender -> interactive-circuit boundary.
    On the prerender (RendererInfo.IsInteractive == false) the resolution
    middleware has stamped the validated Space into HttpContext.Items; we capture
    it and persist it. On the interactive circuit we recover that hint and
    RE-VALIDATE it against the user's accessible Spaces, then push it into the
    circuit-scoped HttpSpaceContext via SetResolved. Child content is gated until
    that completes so pages never load against a stale/Default Space. We branch on
    RendererInfo, NOT HttpContext: IHttpContextAccessor can stay non-null on the
    circuit's first render, which previously made both renders take the prerender
    branch — so SetResolved never ran and the circuit fell back to Default.
*@
@if (_ready)
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Key for the prerender->circuit hint. Treated as untrusted (re-validated).
    private const string CarryKey = "kraken.active-space";

    private bool _ready;
    private PersistingComponentStateSubscription? _subscription;

    protected override async Task OnInitializedAsync()
    {
        // Branch on the render context, NOT on HttpContext: IHttpContextAccessor
        // can stay non-null on the interactive circuit's first render, so a
        // null-check would take the prerender branch on the circuit too and
        // never SetResolved (the active Space would fall back to Default).
        if (!RendererInfo.IsInteractive)
        {
            // SSR / prerender: the resolution middleware already validated the
            // active Space into HttpContext.Items. Capture it (HttpSpaceContext
            // reads Items here) and persist it for the circuit to recover.
            var current = SpaceCtx.CurrentSpaceId;
            _subscription = Pcs.RegisterOnPersisting(() =>
            {
                Pcs.PersistAsJson(CarryKey, current);
                return Task.CompletedTask;
            }, InteractiveServer);
        }
        else
        {
            // Interactive circuit: the cookie isn't readable here (and
            // HttpContext, if present, carries no validated Space for this
            // render). Recover the carried candidate and RE-VALIDATE it — the
            // persisted blob is client-tamperable, so honour it only if the user
            // can access it; otherwise it falls back per ActiveSpaceResolver.
            var candidate = Pcs.TryTakeFromJson<Guid>(CarryKey, out var carried)
                ? carried
                : (Guid?)null;
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            var accessible = await Perms.GetAccessibleSpaceIdsAsync(user);
            SpaceCtx.SetResolved(
                ActiveSpaceResolver.Resolve(candidate, accessible, WellKnown.DefaultSpaceId));
        }

        _ready = true;
    }

    public void Dispose() => _subscription?.Dispose();
}
