@using KrakenDeploy.Server.Spaces
@using KrakenDeploy.Server.Core.Domain.Common
@implements IDisposable
@inject IHttpContextAccessor Http
@inject HttpSpaceContext SpaceCtx
@inject IPermissionEvaluator Perms
@inject AuthenticationStateProvider AuthProvider
@inject PersistentComponentState Pcs

@*
    Carries the active Space across the prerender -> interactive-circuit boundary.
    During prerender HttpContext (and the validated Space in HttpContext.Items) is
    available; the circuit has neither, so we persist the validated id and, on the
    circuit, RE-VALIDATE it against the user's accessible Spaces before any
    Space-scoped query runs. Child content is gated on the circuit until that
    completes so pages never load against a stale/default Space.
*@
@if (_ready)
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Key for the prerender->circuit hint. Treated as untrusted (re-validated).
    private const string CarryKey = "kraken.active-space";

    private bool _ready;
    private PersistingComponentStateSubscription? _subscription;

    protected override async Task OnInitializedAsync()
    {
        if (Http.HttpContext is not null)
        {
            // SSR / prerender: the resolution middleware already validated the
            // active Space into HttpContext.Items. Capture it (HttpSpaceContext
            // reads Items here) and persist it for the circuit to recover.
            var current = SpaceCtx.CurrentSpaceId;
            _subscription = Pcs.RegisterOnPersisting(() =>
            {
                Pcs.PersistAsJson(CarryKey, current);
                return Task.CompletedTask;
            }, InteractiveServer);
        }
        else
        {
            // Interactive circuit: no HttpContext, so no cookie. Recover the
            // carried candidate and re-validate it — the persisted blob is
            // client-tamperable, so honour it only if the user can access it.
            var candidate = Pcs.TryTakeFromJson<Guid>(CarryKey, out var carried)
                ? carried
                : (Guid?)null;
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            var accessible = await Perms.GetAccessibleSpaceIdsAsync(user);
            SpaceCtx.SetResolved(
                ActiveSpaceResolver.Resolve(candidate, accessible, WellKnown.DefaultSpaceId));
        }

        _ready = true;
    }

    public void Dispose() => _subscription?.Dispose();
}
