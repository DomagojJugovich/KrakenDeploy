@using KrakenDeploy.Server.Core.Domain.Security
@using KrakenDeploy.Server.Core.Domain.Spaces
@using KrakenDeploy.Server.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject SpaceService SpaceSvc
@inject ISpaceContext SpaceContext
@inject IPermissionEvaluator Perms
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

@* Hidden entirely when only the Default Space exists — keeps the on-prem
   single-Space install free of UI clutter. *@
@if (_spaces.Count > 1)
{
    <RadzenDropDown TValue="Guid"
                    Data="@_spaces"
                    Value="@_currentSpaceId"
                    ValueProperty="Id"
                    TextProperty="Name"
                    Change="@OnSpaceChanged"
                    Style="min-width: 180px;"
                    title="Switch active Space" />
}

@code {
    private List<Space> _spaces = [];
    private Guid _currentSpaceId;

    protected override async Task OnInitializedAsync()
    {
        // Show only the Active Spaces the user can actually access — the hard
        // tenant boundary. Space is platform-level (not ISpaceScoped) so the
        // global filter doesn't apply; we filter explicitly by the accessible set.
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        var accessible = await Perms.GetAccessibleSpaceIdsAsync(user);
        _spaces = (await SpaceSvc.GetAllAsync())
            .Where(s => s.Status == SpaceStatus.Active && accessible.Contains(s.Id))
            .ToList();

        _currentSpaceId = SpaceContext.CurrentSpaceId;

        // Snap the selection to an accessible Space if the resolved one isn't in
        // the list (e.g. cookie pointed elsewhere). Prefer the Default Space when
        // the user can access it.
        if (_spaces.Count > 0 && _spaces.All(s => s.Id != _currentSpaceId))
        {
            _currentSpaceId = (_spaces.FirstOrDefault(s => s.IsDefault) ?? _spaces[0]).Id;
        }
    }

    private void OnSpaceChanged(object value)
    {
        if (value is Guid newSpaceId && newSpaceId != _currentSpaceId)
        {
            // Switch via the API endpoint so the cookie is set, then full
            // reload so server-side state (DI scopes, query filters) picks up
            // the new active Space everywhere.
            Nav.NavigateTo($"/space/switch?id={newSpaceId}", forceLoad: true);
        }
    }
}
