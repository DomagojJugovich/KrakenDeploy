@using KrakenDeploy.Server.Core.Domain.Security
@using KrakenDeploy.Server.Core.Domain.Spaces
@using KrakenDeploy.Server.Data.Services
@using KrakenDeploy.Server.Spaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject SpaceService SpaceSvc
@inject IPermissionEvaluator Perms
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

@* Hidden entirely when only the Default Space exists — keeps the on-prem
   single-Space install free of UI clutter. *@
@if (_spaces.Count > 1)
{
    <RadzenDropDown TValue="Guid"
                    Data="@_spaces"
                    Value="@CurrentSpaceId"
                    ValueProperty="Id"
                    TextProperty="Name"
                    Change="@OnSpaceChanged"
                    Style="min-width: 180px;"
                    title="Switch active Space" />
}

@code {
    private List<Space> _spaces = [];

    // The selected Space is derived from the URL slug — the single source of truth.
    // We deliberately do NOT read ISpaceContext here: this switcher lives in the
    // layout chrome, which renders before the routed page sets the ambient Space,
    // so reading the context races and flips the dropdown back to Default on the
    // interactive circuit (the "blink to Default" bug).
    private Guid CurrentSpaceId
    {
        get
        {
            var slug = Nav.CurrentSpaceSlug();
            var match = _spaces.FirstOrDefault(s => s.Slug == slug);
            return match?.Id
                ?? (_spaces.FirstOrDefault(s => s.IsDefault) ?? _spaces.FirstOrDefault())?.Id
                ?? Guid.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Show only the Active Spaces the user can actually access — the hard
        // tenant boundary. Space is platform-level (not ISpaceScoped) so the
        // global filter doesn't apply; we filter explicitly by the accessible set.
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        var accessible = await Perms.GetAccessibleSpaceIdsAsync(user);
        _spaces = (await SpaceSvc.GetAllAsync())
            .Where(s => s.Status == SpaceStatus.Active && accessible.Contains(s.Id))
            .ToList();

        // Keep the dropdown in sync if the URL Space changes under us (e.g. an
        // in-app link into another Space within the same circuit).
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnSpaceChanged(object value)
    {
        if (value is not Guid newSpaceId)
        {
            return;
        }
        var target = _spaces.FirstOrDefault(s => s.Id == newSpaceId);
        if (target is null || target.Id == CurrentSpaceId)
        {
            return;
        }

        // Switching Space is a plain navigation to the new Space's URL root — the
        // Space then rides in the URL (per-tab, refresh-stable). We go to the root
        // (not the current page) so we never land on a detail URL whose entity
        // lives in the OLD Space. forceLoad tears down the circuit so a clean one
        // resolves the new Space; SpaceScopedComponentBase re-validates the slug
        // against the caller's accessible Spaces on arrival.
        Nav.NavigateTo(SpaceRouting.BuildPath(target.Slug, "/"), forceLoad: true);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
