@* D1 Phase 2 — the captured output-variables view both detail pages share
   (extracted verbatim from the deployment page's Output variables tab):
   grouped per step, sensitive values masked server-side (only the badge
   renders), multi-line values in a wrapped <pre>, plus the copy-paste
   reference expression. *@

@if (Variables.Count == 0)
{
    <RadzenText class="rz-color-secondary rz-mt-4">
        No output variables captured.
        Steps emit them with <code>Set-OctopusVariable -name X -value Y</code> in
        PowerShell or <code>##octopus[setVariable name='base64' value='base64']</code>
        on stdout from any language. They're then available to later steps as
        <code>#{Octopus.Action[StepName].Output.X}</code> or
        <code>$OctopusParameters["Octopus.Action[StepName].Output.X"]</code>.
    </RadzenText>
}
else
{
    @foreach (var group in Variables.GroupBy(o => o.StepName)
                                    .OrderBy(g => g.Min(o => o.CapturedUtc)))
    {
        <RadzenCard class="rz-mt-3">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">
                <RadzenIcon Icon="play_arrow" Style="vertical-align:middle;margin-right:4px;" />
                @group.Key
                <span class="rz-color-secondary rz-text-body2 rz-ml-2">
                    (@group.Count() variable@(group.Count() == 1 ? "" : "s"))
                </span>
            </RadzenText>
            <KrakenGrid SettingsKey="@SettingsKey" Data="@group.OrderBy(o => o.Name)"
                            TItem="TaskOutputVariable"
                            AllowSorting="false" AllowColumnResize="true">
                <Columns>
                    <RadzenDataGridColumn TItem="TaskOutputVariable"
                                          Property="Name" Title="Name" Width="280px">
                        <Template Context="o">
                            <code>@o.Name</code>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskOutputVariable"
                                          Property="Value" Title="Value">
                        <Template Context="o">
                            @if (o.IsSensitive)
                            {
                                @* T0-6: value is masked server-side; only the badge renders here. *@
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Shade="Shade.Light"
                                             Icon="lock" Text="Sensitive" />
                            }
                            else if (o.Value.Contains('\n'))
                            {
                                <pre style="margin:0; white-space: pre-wrap; word-break: break-word;
                                            font-family: var(--rz-mono-font, monospace);
                                            font-size: 0.85rem;">@o.Value</pre>
                            }
                            else
                            {
                                <span style="font-family: var(--rz-mono-font, monospace);
                                             font-size: 0.85rem;
                                             word-break: break-word;">@o.Value</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskOutputVariable"
                                          Title="Reference"
                                          Width="320px" Sortable="false">
                        <Template Context="o">
                            <code>#{Octopus.Action[@(group.Key)].Output.@(o.Name)}</code>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskOutputVariable"
                                          Property="CapturedUtc" Title="Captured"
                                          Width="160px">
                        <Template Context="o">
                            @o.CapturedUtc.ToString("yyyy-MM-dd HH:mm:ss")
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </KrakenGrid>
        </RadzenCard>
    }
}

@code {
    /// <summary>Captured output variables (sensitive values already masked at the
    /// service boundary), ordered by capture time then name.</summary>
    [Parameter, EditorRequired] public List<TaskOutputVariable> Variables { get; set; } = [];

    /// <summary>KrakenGrid persisted-settings key — per page.</summary>
    [Parameter, EditorRequired] public string SettingsKey { get; set; } = "";
}
