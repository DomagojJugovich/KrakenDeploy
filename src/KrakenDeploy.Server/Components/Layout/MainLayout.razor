@inherits LayoutComponentBase
@using KrakenDeploy.Server.Components.Shared

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height: 100%; padding: 0 1rem;">
            <RadzenSidebarToggle />
            <span class="kraken-brand-name">KrakenDeploy</span>
            <span class="kraken-env-badge">@EnvironmentName</span>
            <AuthorizeView>
                <Authorized>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-left: auto;">
                        <SpaceSwitcher />
                        <ThemeToggle @rendermode="InteractiveServer" />
                        <span class="kraken-user-email">@context.User.Identity?.Name</span>
                        <form method="post" action="/logout" style="display:inline;">
                            <AntiforgeryToken />
                            <button type="submit" class="kraken-signout-btn">Sign out</button>
                        </form>
                    </RadzenStack>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>

    <LicenseWarningBanner />

    <RadzenSidebar>
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" />

            <RadzenPanelMenuItem Text="Deploy" Icon="rocket_launch" Expanded="true">
                <RadzenPanelMenuItem Text="Projects"     Icon="folder_open"  Path="/projects" />
                <RadzenPanelMenuItem Text="Releases"     Icon="tag"          Path="/releases" />
                <RadzenPanelMenuItem Text="Deployments"  Icon="play_circle"  Path="/deployments" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Infrastructure" Icon="dns" Expanded="true">
                <RadzenPanelMenuItem Text="Targets"      Icon="computer"     Path="/targets" />
                <RadzenPanelMenuItem Text="Environments" Icon="layers"       Path="/environments" />
                <RadzenPanelMenuItem Text="Tenants"      Icon="people"       Path="/tenants" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Library" Icon="library_books" Expanded="true">
                <RadzenPanelMenuItem Text="Packages"         Icon="inventory_2"             Path="/packages" />
                <RadzenPanelMenuItem Text="Variable Sets"    Icon="data_object"             Path="/variable-sets" />
                <RadzenPanelMenuItem Text="Step Templates"   Icon="extension"               Path="/step-templates" />
                <RadzenPanelMenuItem Text="Lifecycles"       Icon="timeline"                Path="/lifecycles" />
                <RadzenPanelMenuItem Text="Channels"         Icon="alt_route"               Path="/channels" />
                <RadzenPanelMenuItem Text="Runbooks"         Icon="menu_book"               Path="/runbooks" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Configuration" Icon="admin_panel_settings">
                <RadzenPanelMenuItem Text="Spaces"              Icon="workspaces"  Path="/configuration/spaces" />
                <RadzenPanelMenuItem Text="Users"               Icon="person"    Path="/configuration/users" />
                <RadzenPanelMenuItem Text="Teams"               Icon="groups"    Path="/configuration/teams" />
                <RadzenPanelMenuItem Text="Roles"               Icon="badge"     Path="/configuration/roles" />
                <RadzenPanelMenuItem Text="Identity Providers"  Icon="vpn_key"   Path="/configuration/identity-providers" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="System" Icon="settings_applications" Expanded="true">
                <RadzenPanelMenuItem Text="Tasks"       Icon="task"            Path="/tasks" />
                <RadzenPanelMenuItem Text="Audit"       Icon="history"         Path="/audit" />
                <RadzenPanelMenuItem Text="AI Settings" Icon="psychology"      Path="/settings/ai" />
                <RadzenPanelMenuItem Text="Settings"    Icon="tune"            Path="/settings" />
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="kraken-page-body">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    private string EnvironmentName => Configuration["Environment:Name"] ?? "dev";
}
