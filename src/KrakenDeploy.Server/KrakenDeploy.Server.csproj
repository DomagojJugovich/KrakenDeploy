<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>kraken-server-d3a4b6e1-2f9c-4a17-8a43-2b1e9c5f7a02</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KrakenDeploy.Server.Core\KrakenDeploy.Server.Core.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Server.Data\KrakenDeploy.Server.Data.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Server.Transport\KrakenDeploy.Server.Transport.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Mcp\KrakenDeploy.Mcp.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakenDeploy.Server.Tests" />
  </ItemGroup>

  <!-- Phase D-8: built-in step packages. Each Steps.* project produces a
       {id}-{version}.kdeploy-step archive in its bin/. We take "no-link"
       project references so the Steps projects are built before Server,
       then a copy target gathers their archives into seed/step-packages/
       under the server's output dir. On first startup the
       BuiltInStepPackageSeeder installs anything new from that directory. -->
  <ItemGroup>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.Manual\KrakenDeploy.Steps.Manual.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.SubstituteVariables\KrakenDeploy.Steps.SubstituteVariables.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.JsonConfigurationVariables\KrakenDeploy.Steps.JsonConfigurationVariables.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.Script\KrakenDeploy.Steps.Script.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.OctopusTentaclePackage\KrakenDeploy.Steps.OctopusTentaclePackage.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.KrakenIis\KrakenDeploy.Steps.KrakenIis.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\steps\KrakenDeploy.Steps.OctopusWindowsService\KrakenDeploy.Steps.OctopusWindowsService.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\KrakenDeploy.ControlPlane\KrakenDeploy.ControlPlane.csproj" />
  </ItemGroup>

  <Target Name="CollectBuiltInStepPackages" AfterTargets="Build">
    <ItemGroup>
      <_KrakenSeedPackages Include="..\..\steps\**\bin\$(Configuration)\$(TargetFramework)\*.kdeploy-step" />
    </ItemGroup>
    <Copy SourceFiles="@(_KrakenSeedPackages)" DestinationFolder="$(OutputPath)seed\step-packages\" SkipUnchangedFiles="true" Condition="'@(_KrakenSeedPackages)' != ''" />
    <Message Importance="high" Text="Seeded %(_KrakenSeedPackages.Filename)%(_KrakenSeedPackages.Extension) → $(OutputPath)seed\step-packages\" Condition="'@(_KrakenSeedPackages)' != ''" />
  </Target>

</Project>
