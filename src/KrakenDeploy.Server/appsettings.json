{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KrakenDb": ""
  },
  "Agent": {
    "JwtSigningKey": ""
  },
  "Server": {
    "BaseUrl": ""
  },
  "Database": {
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 6,
    "MaxRetryDelaySeconds": 30,
    "MaxPoolSize": 50
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Otel": {
    "Enabled": false,
    "OtlpEndpoint": "",
    "Protocol": "grpc",
    "Headers": "",
    "SeqServerUrl": ""
  }
}
