<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for IHttpContextAccessor / HttpContext used by audit interceptor -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Octodiff" />
    <!-- M11.E.3 — PowerShell AST parser for the ad-hoc static-analysis gate. -->
    <PackageReference Include="System.Management.Automation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KrakenDeploy.Server.Core\KrakenDeploy.Server.Core.csproj" />
    <ProjectReference Include="..\KrakenDeploy.Contracts\KrakenDeploy.Contracts.csproj" />
    <!-- M11.A — Server.Data hosts the EF-backed DbKrakenAiCallSink that
         persists IKrakenAi audit rows into the AiCallLog table. -->
    <ProjectReference Include="..\KrakenDeploy.Ai\KrakenDeploy.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakenDeploy.Server.Data.Tests" />
  </ItemGroup>

</Project>
