# ── Build stage ──────────────────────────────────────────────────────────────
# Debian-based (glibc), NOT Alpine: KrakenDeploy.Contracts compiles .proto via
# Grpc.Tools, whose bundled protoc is a glibc binary that fails to exec under
# Alpine's musl libc (MSB6003).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central Package Management + the SDK pin + .editorconfig first (rarely change
# → cached layer). .editorconfig is required at build time: it carries the
# analyzer suppressions (e.g. CA1861 on generated EF migrations) without which
# the Release build fails under TreatWarningsAsErrors.
COPY Directory.Build.props Directory.Packages.props global.json .editorconfig ./

# Copy the full source the server's project graph needs. That graph spans src/
# (Server, Server.*, Mcp, Ai, Contracts, Execution, …) and steps/ (the built-in
# step packages the server references). Copy both wholesale rather than listing
# ~15 individual .csproj files, which drifts out of date and silently breaks the
# restore whenever a project is added. .dockerignore keeps bin/obj out.
COPY src/ ./src/
COPY steps/ ./steps/

RUN dotnet restore src/KrakenDeploy.Server/KrakenDeploy.Server.csproj

# SC7: when signing is requested, every built-in step package archive is signed
# during publish — the global -p:KrakenSigningKey property flows into the steps/*
# project builds, whose SignKrakenStepPackage target invokes the in-repo kraken
# CLI (built first so the targets' _KrakenCliInRepoRelease path resolves). A
# production server (AllowUnsignedUploads=false) refuses to seed unsigned
# built-ins, so a prod image must be built with BOTH the flag and the secret:
#   docker build --build-arg SIGN_STEP_PACKAGES=true \
#     --build-arg SIGNING_KEY_FINGERPRINT="$(sha256sum kraken-signing.pem | cut -d' ' -f1)" \
#     --secret id=kraken_signing_key,src=./kraken-signing.pem ...
#
# SIGN_STEP_PACKAGES is a real build ARG, and that is load-bearing: BuildKit
# deliberately excludes SECRETS from the layer cache key, so keying the decision
# only on the presence of /run/secrets/... meant a prod build reused a cached
# unsigned dev layer — same command string, no cache miss, no warning replayed,
# exit 0 — and the unsigned archives only surfaced when kraken-init refused to
# seed them. The ARG changes the cache key so signed/unsigned don't share a layer.
# Fail-closed on a set flag without a mounted secret comes from the explicit
# file check below, NOT from the mount (kept required=false so an unsigned dev
# build with no --secret still succeeds).
#
# SIGNING_KEY_FINGERPRINT is ALSO referenced in the RUN so a KEY ROTATION busts
# the cache: the secret's content is not part of the cache key, so without this a
# rebuild with a rotated key on a warm cache would reuse the layer signed by the
# OLD key. Pass the new key's fingerprint (any value that changes with the key).
ARG SIGN_STEP_PACKAGES=false
ARG SIGNING_KEY_FINGERPRINT=""
RUN --mount=type=secret,id=kraken_signing_key,required=false \
    SIGN_ARG=""; \
    echo "Signing key fingerprint (cache-key input): ${SIGNING_KEY_FINGERPRINT:-<none>}"; \
    if [ "$SIGN_STEP_PACKAGES" = "true" ]; then \
      if [ ! -f /run/secrets/kraken_signing_key ]; then \
        echo "ERROR: SIGN_STEP_PACKAGES=true but no kraken_signing_key secret was mounted."; \
        echo "       Re-run with --secret id=kraken_signing_key,src=<path to the PEM>."; \
        exit 1; \
      fi; \
      echo "Signing built-in step packages with the provided key."; \
      dotnet build src/KrakenDeploy.Cli/KrakenDeploy.Cli.csproj \
        --configuration Release --nologo -v:q; \
      SIGN_ARG="-p:KrakenSigningKey=/run/secrets/kraken_signing_key"; \
    else \
      echo "WARNING: SIGN_STEP_PACKAGES is not true — built-ins keep the unsigned dev sentinel."; \
      echo "         This image is for local/dev use only; a Production server will refuse to seed it."; \
    fi; \
    dotnet publish src/KrakenDeploy.Server/KrakenDeploy.Server.csproj \
      --configuration Release \
      --no-restore \
      --output /app $SIGN_ARG

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# curl is needed for the Docker health check; run as a non-root user.
# /var/lib/krakendeploy is the canonical containerised Server:DataPath mount
# point, pre-created and chowned so a named volume mounted there inherits the
# kraken user's ownership (a fresh named volume is otherwise root-owned and the
# non-root process cannot write the secret store / DP key ring / packages).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system kraken \
 && useradd --system --gid kraken kraken \
 && mkdir -p /var/lib/krakendeploy \
 && chown kraken:kraken /var/lib/krakendeploy

COPY --from=build /app ./

USER kraken
EXPOSE 5080

ENTRYPOINT ["dotnet", "KrakenDeploy.Server.dll"]
