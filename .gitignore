*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
# Domain entity folders must not be excluded by the NuGet/build rules above
!src/**/Domain/Packages/
!src/**/Domain/Packages/**
!src/**/Domain/Releases/
!src/**/Domain/Releases/**
*.nuget.props
*.nuget.targets

