<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Identity / tokens">
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup Label="SignalR">
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Integration testing">
    <!-- In-process ASP.NET Core host for integration tests (TestServer +
         CreateHandler). Used by the multi-account agent-transport E2E to drive
         the real SignalR hub pipeline over the in-memory transport. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="gRPC">
    <!-- Google.Protobuf + Grpc.Tools generate code from .proto files.
         Grpc.Net.Client is the managed .NET gRPC client (agent-side).
         Grpc.AspNetCore provides AddGrpc() and MapGrpcService<T>() for the server. -->
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.Tools" Version="2.70.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.70.0" />
  </ItemGroup>

  <ItemGroup Label="Entity Framework Core / Postgres">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.0" />
    <!-- Raw ADO.NET driver — used directly by KrakenDeploy.Router, which reads
         two catalog tables and deliberately avoids the EF/Server.Data project
         graph to stay a minimal deployable. EFCore.PG resolves its own Npgsql
         transitively; this central pin keeps both on the same line. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Reverse proxy (blue-green slot router)">
    <!-- Per-node release→slot router (docs/blue-green-slot-deployment.md).
         Direct forwarding via IHttpForwarder — no proxy config exists, so a
         default-release flip can never trigger a config reload (D-bg-3). -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="UI components">
    <PackageVersion Include="Radzen.Blazor" Version="11.1.1" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <!-- Logging abstractions only — step packages reference this so handler
         code can take ILogger without pulling in a concrete logger backend.
         Bumped to 10.0.8 because Microsoft.Extensions.AI 10.6.0 requires it
         transitively (M11.A). Older transitives auto-resolve up. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
  </ItemGroup>

  <ItemGroup Label="Hosting / generic">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <!-- Bumped 10.0.0 → 10.0.8 to satisfy Microsoft.Extensions.AI 10.6.0's
         transitive requirement (M11.A). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="Variables / templating">
    <!-- Octostache: Octopus Deploy's #{VarName} template engine -->
    <PackageVersion Include="Octostache" Version="3.9.2" />
    <!-- Octodiff: binary delta/patching library (signature + delta build + delta apply) -->
    <PackageVersion Include="Octodiff" Version="1.3.23" />
    <!-- Microsoft.Web.Xdt: XDT (XML Document Transform) engine; drives the
         Octopus.Features.ConfigurationTransforms feature on Octopus.TentaclePackage
         steps (and any future Kraken-native XDT use). -->
    <PackageVersion Include="Microsoft.Web.Xdt" Version="3.2.8" />
  </ItemGroup>

  <ItemGroup Label="Hangfire">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.17" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.20.9" />
  </ItemGroup>

  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup Label="Email / SMTP (M13.B.1)">
    <!-- MailKit / MimeKit — modern .NET SMTP client. System.Net.Mail.SmtpClient
         is documented as "not recommended for new development" because it
         doesn't speak TLS 1.2+ STARTTLS properly. State-institution SMTP
         relays (the LAUS audience) often run older Exchange or sendmail
         with quirky STARTTLS handshakes; MailKit handles those cleanly. -->
    <PackageVersion Include="MailKit" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup Label="Sample dependencies">
    <!-- AWSSDK.S3 v4 targets net10.0 directly. Only consumed by the
         examples/AwsS3UploadStepPackage sample — the main KrakenDeploy
         binaries do NOT depend on this. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup Label="AI integration (M11)">
    <!-- Microsoft.Extensions.AI — IChatClient abstraction. Pluggable
         providers register an IChatClient adapter; KrakenDeploy.Ai
         wraps the unified surface with audit / sanitisation / budget.
         Both packages target net10.0 directly. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <!-- Official Anthropic .NET SDK; exposes .AsIChatClient(model) for
         the Microsoft.Extensions.AI abstraction. -->
    <PackageVersion Include="Anthropic" Version="12.22.0" />
    <!-- M11.E.3 — PowerShell AST parser (System.Management.Automation.Language.Parser)
         for the ad-hoc static-analysis gate. 7.6.x targets net10.0. -->
    <PackageVersion Include="System.Management.Automation" Version="7.6.2" />
    <!-- Official MCP C# SDK — co-maintained Microsoft + Anthropic.
         Server-side packages, in-process MCP host inside the Kraken
         server. Used by M11.B (MCP server). -->
    <PackageVersion Include="ModelContextProtocol" Version="1.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <!-- Core only (client + stdio transports, no hosting/DI). Used by the
         standalone kraken-mcp stdio↔HTTP proxy exe (M11.B.4) so its
         single-file binary stays minimal. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.3.0" />
  </ItemGroup>

</Project>
